+			/* the top layer whole (0236: only the island's box, mapped from source to logical pixels) */
+			tx0 = dx;
+			ty0 = dy;
+			tx1 = dx + w;
+			ty1 = dy + h;
+			if (has_island) {
+				/* 0239: each strip, mapped with one rounding so neighbouring strips meet exactly */
+#define SWEET_LX(v)     (dx + (int32_t)(((int64_t)((v) - sx) * w) / aw))
+#define SWEET_LY(v)     (dy + (int32_t)(((int64_t)((v) - sy) * h) / ah))
+				tx0 = dx + w;
+				tx1 = dx;
+				for (int32_t q = 0; q < island.n; q++) {
+					ly0[q] = SWEET_LY(island.y0[q]);
+					ly1[q] = SWEET_LY(island.y1[q]);
+					lx0[q] = SWEET_LX(island.x0[q]);
+					lx1[q] = SWEET_LX(island.x1[q]);
+					ly0[q] = ly0[q] < dy ? dy : (ly0[q] > dy + h ? dy + h : ly0[q]);
+					ly1[q] = ly1[q] < dy ? dy : (ly1[q] > dy + h ? dy + h : ly1[q]);
+					lx0[q] = lx0[q] < dx ? dx : (lx0[q] > dx + w ? dx + w : lx0[q]);
+					lx1[q] = lx1[q] < dx ? dx : (lx1[q] > dx + w ? dx + w : lx1[q]);
+					if (lx1[q] > lx0[q]) {
+						tx0 = lx0[q] < tx0 ? lx0[q] : tx0;
+						tx1 = lx1[q] > tx1 ? lx1[q] : tx1;
+					}
+					if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, lx0[q], ly0[q], lx1[q], ly1[q],
+					    &blits[nblits])) {
+						nblits++;
+					}
+				}
+#undef SWEET_LX
+#undef SWEET_LY
+				ty0 = island.n ? ly0[0] : dy;
+				ty1 = island.n ? ly1[island.n - 1] : dy;
+				if (sweet_fb_island_logged < 4 || (sweet_fb_stats.island % 600) == 1) {
+					sweet_fb_island_logged++;
+					IOLog("SWEET FB: island: %d strips, logical box %d,%d - %d,%d (top layer b %d,%d %dx%d, a %dx%d)\n",
+					    island.n, tx0, ty0, tx1, ty1, dx, dy, w, h, aw, ah);
+				}
+			} else if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, tx0, ty0, tx1, ty1, &blits[nblits])) {
+				nblits++;
+			}
+		} else {
+			/*
+			 * the bottom layer only where the top one is not: every panel pixel written once, so the panel
+			 * never scans the bottom layer where the game is (no black flash between two blits)
+			 */
+			int32_t bx0 = dx, by0 = dy, bx1 = dx + w, by1 = dy + h;
+			if (has_island) {
+				/* 0239: above and below the island's rows, then left and right of it in each strip */
+				int32_t c2[2][4] = {
+					{ bx0, by0, bx1, by1 < ty0 ? by1 : ty0 },
+					{ bx0, by0 > ty1 ? by0 : ty1, bx1, by1 },
