+#define SWEET_FB_SWAP_REC_SIZE          0x46c
+#define SWEET_FB_LAYERS                 4
+#define SWEET_FB_NOTIFY_TYPES           8
+#define SWEET_FB_NOTIFY_VSYNC           5
+#define SWEET_FB_VSYNC_US               16667
+static uint32_t sweet_fb_vsync_us = SWEET_FB_VSYNC_US; /* adjustable synthetic display tick */
+/*
+ * 0198: the panel's own refresh. The OnePlus 7 Pro's panel runs in DSI command mode and paces itself: the display
+ * controller's INTF1 tear check (0x0ae6b800 + 0x280..) sends a frame each time the panel's TE says so (autorefresh
+ * +0x2b4 = 80000001), measured 16.706-16.712 ms = 59.84-59.86 Hz (vsyncprobe, 2026-11-09). The 60.000 Hz this
+ * driver published made CoreAnimation's own frame clock (it never asks for vsync notifications, 0154) drift one
+ * frame against the panel every ~7 s. At start the line counter (+0x2b0, 0 .. height once a frame) is read for
+ * ~100 ms: the measured period is published (IOMFBDisplayRefresh, modes) and runs the vsync timer, which also keeps
+ * its ticks at the frame's start from then on. Boot-arg sweetfblock=0: as before (60 Hz timer, nothing read).
+ */
+#define SWEET_FB_INTF1_PAGE     0x0ae6b000ull
+#define SWEET_FB_INTF1_OFF      0x800u
+#define SWEET_FB_TE_HEIGHT      0x294u          /* tear check: the frame's lines (0c30 = 3120) */
+#define SWEET_FB_TE_LINE        0x2b0u          /* line counter */
+#define SWEET_FB_TE_AUTOREFRESH 0x2b4u          /* bit 31: autorefresh on */
+static volatile uint32_t *sweet_fb_te;          /* INTF1's registers, mapped for good (NULL: not locked) */
+static uint32_t sweet_fb_te_height;
+static uint64_t sweet_fb_period_ns;             /* measured frame period (0: none) */
+
+static bool
+sweet_fb_measure_refresh(void)
+{
+	uint32_t lock = 1;
+	(void)PE_parse_boot_argn("sweetfblock", &lock, sizeof(lock));
+	if (!lock) {
+		IOLog("SWEET FB: panel refresh not measured (sweetfblock=0)\n");
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(SWEET_FB_INTF1_PAGE, 0x1000, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapInhibitCache) : NULL;
+	if (map == NULL) {
+		IOLog("SWEET FB: panel refresh: INTF1 not mapped\n");
+		OSSafeReleaseNULL(md);
+		return false;
+	}
+	volatile uint32_t *te = (volatile uint32_t *)(map->getVirtualAddress() + SWEET_FB_INTF1_OFF);
+	uint32_t height = te[SWEET_FB_TE_HEIGHT / 4] & 0xffff, autorefresh = te[SWEET_FB_TE_AUTOREFRESH / 4];
+	if (!(autorefresh & 0x80000000u) || height < 1000 || height > 4000) {
+		IOLog("SWEET FB: panel refresh: INTF1 tear check not as probed (autorefresh %08x, height %u): 60 Hz\n",
+		    autorefresh, height);
+		map->release();
+		md->release();
+		return false;
+	}
+	/* frame starts = the line counter going back down; 7 of them (~100 ms), at most 300 ms */
+	uint64_t began = mach_absolute_time(), limit, first = 0, last = 0, t;
+	nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &limit);
+	unsigned starts = 0;
+	uint32_t prev = te[SWEET_FB_TE_LINE / 4] & 0xffff;
+	while (starts < 7 && (t = mach_absolute_time()) - began < limit) {
+		uint32_t line = te[SWEET_FB_TE_LINE / 4] & 0xffff;
+		if (line + 16 < prev) {
+			if (starts++ == 0) {
+				first = t;
+			}
+			last = t;
+		}
+		prev = line;
+	}
+	uint64_t ns = 0;
+	if (starts >= 3) {
+		absolutetime_to_nanoseconds(last - first, &ns);
+		ns /= starts - 1;
+	}
+	if (ns < 8000000 || ns > 25000000) {       /* 40 - 125 Hz, or nothing */
+		IOLog("SWEET FB: panel refresh: %u frame starts in 300 ms (%llu ns each): 60 Hz\n", starts, ns);
+		map->release();
+		md->release();
+		return false;
+	}
+	sweet_fb_te = te;                       /* md and map stay for good */
+	sweet_fb_te_height = height;
+	sweet_fb_period_ns = ns;
+	IOLog("SWEET FB: panel refresh measured: %llu ns a frame = %llu.%03llu Hz (%u lines, %u frame starts)\n", ns,
+	    1000000000000ull / ns / 1000, 1000000000000ull / ns % 1000, height, starts);
+	return true;
+}
+
+/*
+ * 0199: the panel's 90 Hz mode. The OnePlus 7 Pro's Samsung panel takes DCS 0x53 (write CTRL display) 0x30 for
+ * 90 Hz and 0x20 for 60 Hz, as the Pixel 4 XL's S6E3HC2 (Google kernel/msm dsi-panel-s6e3hc2-dsc-wqhd-cmd.dtsi; same
+ * link clock in both modes). Tested by hand 2026-11-09 (userland/jb/panelbright raw 53 30): frames 11.368 ms apart
+ * (87.97 Hz), each sent in 10.41 ms. Sent here before the refresh is measured, so 0198 finds and publishes 88 Hz.
+ * The command goes over DSI0 as the bootloader's own (its last packet: c0390003 89b80051, DCS long write 0x51):
+ * embedded DMA from a buffer just past the splash frame, software trigger, CMD_DMA_DONE awaited (<= 100 ms),
+ * the DSI registers put back. Boot-arg sweetfb90=0: the bootloader's 60 Hz.
+ */
+#define SWEET_FB_DSI0_PAGE      0x0ae94000ull
+#define SWEET_FB_DSI_CTRL       0x004u
+#define SWEET_FB_DSI_DMA_CTRL   0x03cu
+#define SWEET_FB_DSI_DMA_BASE   0x048u
+#define SWEET_FB_DSI_DMA_LEN    0x04cu
+#define SWEET_FB_DSI_TRIG_CTRL  0x084u
+#define SWEET_FB_DSI_TRIG_DMA   0x090u
+#define SWEET_FB_DSI_INTR_CTRL  0x110u
+#define SWEET_FB_DSI_BUF        0x9d124000ull   /* 0x9c000000 + 3120 * 5760, page up: never used by XNU */
+
+static void
+sweet_fb_panel_90hz(void)
+{
+	uint32_t want = 1;
+	(void)PE_parse_boot_argn("sweetfb90", &want, sizeof(want));
+	if (!want) {
+		IOLog("SWEET FB: panel left at the bootloader's refresh (sweetfb90=0)\n");
+		return;
+	}
+	IOMemoryDescriptor *dmd = IOMemoryDescriptor::withPhysicalAddress(SWEET_FB_DSI0_PAGE, 0x1000, kIODirectionInOut);
+	IOMemoryMap *dmap = dmd != NULL ? dmd->map(kIOMapInhibitCache) : NULL;
+	IOMemoryDescriptor *bmd = IOMemoryDescriptor::withPhysicalAddress(SWEET_FB_DSI_BUF, 0x1000, kIODirectionInOut);
+	IOMemoryMap *bmap = bmd != NULL ? bmd->map(kIOMapInhibitCache) : NULL;
+	if (dmap == NULL || bmap == NULL) {
+		IOLog("SWEET FB: 90 Hz: DSI0 or the command buffer not mapped\n");
+	} else {
+		volatile uint32_t *dsi = (volatile uint32_t *)dmap->getVirtualAddress();
+		volatile uint32_t *buf = (volatile uint32_t *)bmap->getVirtualAddress();
+		uint32_t ver = dsi[0], ctrl = dsi[SWEET_FB_DSI_CTRL / 4];
+		if ((ver >> 24) != 0x20 || !(ctrl & 1) || !(ctrl & 4)) {
+			IOLog("SWEET FB: 90 Hz: DSI0 not as probed (version %08x, CTRL %08x): left at 60 Hz\n", ver, ctrl);
+		} else {
+			/* header: WC 2, DCS long write 0x39, last + long; payload 0x53 0x30, 0xff 0xff */
+			buf[0] = 0xc0390002u;
+			buf[1] = 0xffff3053u;
+			__builtin_arm_dsb(0xf);
+			uint32_t dmaCtrl = dsi[SWEET_FB_DSI_DMA_CTRL / 4], trig = dsi[SWEET_FB_DSI_TRIG_CTRL / 4];
+			dsi[SWEET_FB_DSI_INTR_CTRL / 4] = dsi[SWEET_FB_DSI_INTR_CTRL / 4] | 1;
+			dsi[SWEET_FB_DSI_DMA_CTRL / 4] = (dmaCtrl & ~((1u << 31) | (1u << 30) | (1u << 26))) | (1u << 28);
+			if ((trig & 7) != 4) {
+				dsi[SWEET_FB_DSI_TRIG_CTRL / 4] = (trig & ~7u) | 4;
+			}
+			dsi[SWEET_FB_DSI_DMA_BASE / 4] = (uint32_t)SWEET_FB_DSI_BUF;
+			dsi[SWEET_FB_DSI_DMA_LEN / 4] = 8;
+			__builtin_arm_dsb(0xf);
+			dsi[SWEET_FB_DSI_TRIG_DMA / 4] = 1;
+			bool done = false;
+			for (int i = 0; i < 500 && !(done = (dsi[SWEET_FB_DSI_INTR_CTRL / 4] & 1) != 0); i++) {
+				IODelay(200);
+			}
+			dsi[SWEET_FB_DSI_INTR_CTRL / 4] = dsi[SWEET_FB_DSI_INTR_CTRL / 4] | 1;
+			if ((trig & 7) != 4) {
+				dsi[SWEET_FB_DSI_TRIG_CTRL / 4] = trig;
+			}
+			dsi[SWEET_FB_DSI_DMA_CTRL / 4] = dmaCtrl;
+			if (done) {
+				IOSleep(60);            /* a few frames at the new rate before 0198 times them */
+				IOLog("SWEET FB: panel switched to 90 Hz (DCS 53 30)\n");
+			} else {
+				IOLog("SWEET FB: 90 Hz: no CMD_DMA_DONE after 100 ms (INTR_CTRL %08x): left as it was\n",
+				    dsi[SWEET_FB_DSI_INTR_CTRL / 4]);
+			}
+		}
+	}
+	OSSafeReleaseNULL(dmap);
+	OSSafeReleaseNULL(dmd);
+	OSSafeReleaseNULL(bmap);
+	OSSafeReleaseNULL(bmd);
+}
+
+/* 0198: the vsync timer's next timeout, so that it fires at the start of the panel's next frame */
+static uint32_t
+sweet_fb_next_tick_us(void)
+{
+	if (sweet_fb_te == NULL) {
+		return sweet_fb_vsync_us;
+	}
+	uint32_t line = sweet_fb_te[SWEET_FB_TE_LINE / 4] & 0xffff;
+	if (line > sweet_fb_te_height) {
+		line = sweet_fb_te_height;
+	}
+	uint64_t us = (uint64_t)sweet_fb_vsync_us * (sweet_fb_te_height - line) / sweet_fb_te_height;
+	if (us < sweet_fb_vsync_us / 4) {
+		us += sweet_fb_vsync_us;        /* nearly there: the one after (no double tick) */
+	}
+	return (uint32_t)us + 50;               /* just past the start */
+}
+#define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
+/*
+ * The iOS userland only has status bar / layout data for real iPhone
+ * screens (UIKit: "No status bar visual provider for screen", the red
+ * rdar://45025538 bar for 360x800 points). The display is therefore
+ * presented as the iPhone X panel, 1125x2436 (375x812 points @3x), and the
+ * centered 1080x2400 part of it is shown on the 1080x2400 panel.
+ * Boot-arg sweetfb_native=1 presents the real panel size instead.
+ *
+ * A panel LARGER than the iPhone X (OnePlus 7 Pro: 1440x3120, the same
+ * 19.5:9 aspect) is driven the other way round: userland still sees
+ * 1125x2436 and present() scales every layer up by panel/logical
+ * (x1.28) with a nearest-neighbour column table. A native 1440x3120 @3x
+ * screen (480x1040 points) matches no iPhone (first guacamole boot:
+ * PosterBoard trapped with sig 5, likely because of it).
+ */
+/*
+ * 0240: boot-arg sweetfb_scale=2 presents the iPhone X screen at @2x, 750x1624 (the same 375x812 points), as
+ * hakios does: 2.25x fewer pixels for CoreAnimation and the apps to draw, upscaled to the panel by the GPU blit.
+ * Needs an ADT with display-scale 2 and canvas 750x1624 (mkadt.py --scale2) and MobileGestalt's cache cleared.
+ */
+#define SWEET_FB_LOGICAL_W              sweet_fb_logical_w
+#define SWEET_FB_LOGICAL_H              sweet_fb_logical_h
+static uint32_t sweet_fb_logical_w = 1125, sweet_fb_logical_h = 2436;
+#define SWEET_FB_FORMAT_BGRA            0x42475241
+
+class IOMobileFramebuffer : public IOService {
+	OSDeclareDefaultStructors(IOMobileFramebuffer);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+
+class IOMobileFramebufferUserClient;
+
+class AppleCLCD : public IOMobileFramebuffer {
+	OSDeclareDefaultStructors(AppleCLCD);
+
+	IOWorkLoop         *fWorkLoop;
+	IOTimerEventSource *fVsync;
+	uint64_t            fVsyncCount;
+
+	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
+
+public:
+	uint64_t      fPhys;
+	uint32_t      fWidth, fHeight, fRowBytes;
+	uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
+	int32_t       fOffX, fOffY;             /* logical origin of the panel */
+	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
+	IOMemoryMap  *fMap;
+	SweetSurface *fSurface;         /* the panel memory as an IOSurface */
+	IOLock       *fLock;            /* swaps and client list */
+	IOLock       *fPresentLock;     /* 0150: one GPU present at a time (swap and vsync both present) */
+	OSArray      *fClients;
+	uint32_t      fSwapID;
+	bool          fConsolePaused;
+	uint8_t       fPending[SWEET_FB_SWAP_REC_SIZE];     /* latest swap, not yet shown */
+	bool          fDirty;
+	uint32_t      fPendingFence;  /* 0145: the GPU's last submit when that swap came */
+	uint32_t      fFenceTicks;    /* 0145: vsyncs it has waited for that fence */
+	bool          fScaleUp;       /* panel > logical: scale layers up */
+	uint16_t     *fColMap;        /* panel x -> logical x (fScaleUp) */
+	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
+	bool          fPowerOff;      /* RequestPowerChange(0) */
+	uint32_t      fShownSwapID;   /* 0169: the latest swap on the panel (or queued on the GPU behind its drawing) */
+	uint32_t      fSwapSubmits;   /* 0169: the swapping process's GPU job count at its previous swap */
+	uint8_t       fLayers[SWEET_FB_SWAP_REC_SIZE];  /* 0184: the screen's layers as the swaps so far left them */
+	uint32_t      fLayerMask;     /* 0184: layers in fLayers that are on (a surface set) */
+	void          shown(const uint8_t *rec);
+	uint32_t      fFadeStep;      /* fade-out steps done while off */
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void addClient(IOMobileFramebufferUserClient *client);
+	void removeClient(IOMobileFramebufferUserClient *client);
+	void swap(const uint8_t *rec);
+	void present(const uint8_t *rec);
+	int presentGPU(const uint8_t *rec);
+	bool presentComposed(const uint8_t *rec);
+	uint32_t     *fCompose;       /* 0170: fLogicalW x fLogicalH BGRA, cached */
+	uint32_t     *fComposeX;      /* 0170: per destination column of a layer, its source column */
+	void pauseConsole(void);
+	void publishRefresh(void);
+	void presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+	    int32_t w, int32_t h);
+};
