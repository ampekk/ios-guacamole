diff -ruN ci-base/bsd/kern/sweet_amfi.c ci-sweet/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/kern/sweet_amfi.c	2026-11-20 20:53:28.559093963 +0100
@@ -0,0 +1,758 @@
+/*
+ * Built-in AMFI interface for SWEET.
+ *
+ * On Apple platforms AppleMobileFileIntegrity registers this interface and
+ * provides entitlements through the closed CoreEntitlements library. SWEET
+ * has neither, and code signing reaches it on every exec (ubc_cs_blob_add).
+ *
+ * Entitlements: when a code signature is added, its XML entitlements blob
+ * (already checked against the code directory) is parsed into a
+ * SweetEntitlements object (iokit/Kernel/arm/SweetEntitlements.cpp), set as
+ * the blob's csb_entitlements, and every query is answered from it. DER-only
+ * signatures get none. Code signature and page hash validation stay with the
+ * kernel. Trust caches remain unavailable (no Image4), so the TrustCache
+ * interface is left at version 0.
+ *
+ * Platform binaries: AMFI marks binaries whose cdhash is in a trust cache
+ * as platform binaries from its vnode_check_signature MAC hook. Without
+ * trust caches, the SWEET policy below marks every binary on the root
+ * filesystem instead (the iOS system binaries are ad-hoc signed and are
+ * platform binaries only through the static trust cache).
+ *
+ * Interfaces no kernel path uses on SWEET (they serve other Apple kexts)
+ * panic with a clear message instead of being NULL.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/debug.h>
+#include <kern/locks.h>
+#include <kern/startup.h>
+#include <libkern/amfi/amfi.h>
+#include <mach/kern_return.h>
+#include <sys/codesign.h>
+#include <sys/mount.h>
+#include <sys/priv.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+#include <sys/ubc_internal.h>
+#include <sys/vnode.h>
+#include <security/mac_policy.h>
+
+/* iokit/Kernel/arm/SweetEntitlements.cpp */
+void *sweet_entitlements_create(const CS_GenericBlob *blob, size_t blob_len);
+void *sweet_entitlements_copy_dict(const void *ent);
+bool sweet_entitlements_copy_xml(const void *ent, CS_GenericBlob **out);
+bool sweet_entitlements_bool(const void *ent, const char *name);
+bool sweet_entitlements_string(const void *ent, const char *name, const char *value);
+void *sweet_entitlements_copy_object(const void *ent, const char *name);
+unsigned int sweet_entitlements_count(const void *ent);
+extern void osobject_release(void *object);
+
+/* boot-arg sweet_amfi_debug=1: log the entitlements attached to each signature. */
+static TUNABLE(uint32_t, sweet_amfi_debug, "sweet_amfi_debug", 0);
+
+/* The entitlements object of a process's main binary, or NULL. */
+static void *
+sweet_proc_entitlements(proc_t proc)
+{
+	struct cs_blob *blob = csproc_get_blob(proc);
+	return blob != NULL ? csblob_os_entitlements_get(blob) : NULL;
+}
+
+static void
+sweet_amfi_entitlements_invalidate(__unused void *os_entitlements)
+{
+	/* Queries already require a valid signature (csblob_get_entitlements). */
+}
+
+static void *
+sweet_amfi_entitlements_as_dict(void *os_entitlements)
+{
+	return sweet_entitlements_copy_dict(os_entitlements);
+}
+
+static CEError_t
+sweet_amfi_entitlements_query(__unused void *os_entitlements,
+    __unused uint8_t cdhash[CS_CDHASH_LEN], __unused CEQuery_t query,
+    __unused size_t query_length)
+{
+	panic("SWEET AMFI: CoreEntitlements queries are not implemented");
+}
+
+static bool
+sweet_amfi_entitlements_get_transmuted(__unused void *os_entitlements,
+    __unused const CS_GenericBlob **blob)
+{
+	return false;
+}
+
+static bool
+sweet_amfi_entitlements_get_xml(void *os_entitlements, CS_GenericBlob **blob)
+{
+	return sweet_entitlements_copy_xml(os_entitlements, blob);
+}
+
+static bool
+sweet_amfi_get_legacy_profile_exemptions(__unused const uint8_t **profile,
+    __unused size_t *profile_length)
+{
+	return false;
+}
+
+static bool
+sweet_amfi_get_udid(__unused const uint8_t **udid, __unused size_t *udid_length)
+{
+	return false;
+}
+
+static void *
+sweet_amfi_query_context_to_object(__unused CEQueryContext_t ctx)
+{
+	panic("SWEET AMFI: CoreEntitlements query contexts are not implemented");
+}
+
+static kern_return_t
+sweet_amfi_adjust_with_monitor(__unused void *os_entitlements,
+    __unused const CEQueryContext_t ce_ctx, __unused const void *monitor_sig_obj,
+    __unused const char *identity, __unused const uint32_t code_signing_flags)
+{
+	/* SWEET has no code signing monitor. */
+	return KERN_NOT_SUPPORTED;
+}
+
+/*
+ * Attach the parsed XML entitlements to a code signature being added. This
+ * must happen in the vnode_check_signature MAC hook, like AMFI does: later,
+ * converting a 4K-page signature to multilevel hashes drops the XML blob.
+ * Nothing is granted when the blob is missing, unreadable or does not match
+ * its code directory hash.
+ */
+static void
+sweet_amfi_attach_entitlements(struct cs_blob *code_signing_blob)
+{
+	void *xml = NULL;
+	size_t xml_len = 0;
+
+	if (csblob_get_entitlements(code_signing_blob, &xml, &xml_len) != 0) {
+		printf("SWEET AMFI: %s: entitlements do not match the code directory, granting none\n",
+		    csblob_get_identity(code_signing_blob));
+		return;
+	}
+	if (xml == NULL) {
+		return;                 /* no XML entitlements */
+	}
+	void *ent = sweet_entitlements_create(xml, xml_len);
+	if (ent == NULL) {
+		printf("SWEET AMFI: %s: unreadable entitlements (%zu bytes), granting none\n",
+		    csblob_get_identity(code_signing_blob), xml_len);
+		return;
+	}
+	if (sweet_amfi_debug) {
+		/* The test keys only exist in tools/mkinit.py test signatures. */
+		printf("SWEET AMFI: %s: %u entitlements (test: bool %d string %d array %d)\n",
+		    csblob_get_identity(code_signing_blob), sweet_entitlements_count(ent),
+		    sweet_entitlements_bool(ent, "com.apple.private.sweet.test-bool"),
+		    sweet_entitlements_string(ent, "com.apple.private.sweet.test-string", "hello"),
+		    sweet_entitlements_string(ent, "com.apple.private.sweet.test-array", "two"));
+	}
+	csblob_os_entitlements_set(code_signing_blob, ent);    /* takes a reference */
+	osobject_release(ent);
+}
+
+static kern_return_t
+sweet_amfi_adjust_without_monitor(__unused void *os_entitlements,
+    __unused struct cs_blob *code_signing_blob)
+{
+	/* Entitlements were attached in sweet_amfi_vnode_check_signature. */
+	return KERN_SUCCESS;
+}
+
+static kern_return_t
+sweet_amfi_query_boolean(const void *os_entitlements, const char *entitlement_name)
+{
+	return sweet_entitlements_bool(os_entitlements, entitlement_name) ? KERN_SUCCESS : KERN_DENIED;
+}
+
+static kern_return_t
+sweet_amfi_query_boolean_with_proc(const proc_t proc, const char *entitlement_name)
+{
+	return sweet_amfi_query_boolean(sweet_proc_entitlements(proc), entitlement_name);
+}
+
+static kern_return_t
+sweet_amfi_query_string(const void *os_entitlements,
+    const char *entitlement_name, const char *entitlement_value)
+{
+	return sweet_entitlements_string(os_entitlements, entitlement_name, entitlement_value) ?
+	       KERN_SUCCESS : KERN_DENIED;
+}
+
+static kern_return_t
+sweet_amfi_query_string_with_proc(const proc_t proc,
+    const char *entitlement_name, const char *entitlement_value)
+{
+	return sweet_amfi_query_string(sweet_proc_entitlements(proc), entitlement_name,
+	           entitlement_value);
+}
+
+static kern_return_t
+sweet_amfi_copy_object(const void *os_entitlements,
+    const char *entitlement_name, void **entitlement_object)
+{
+	void *obj = sweet_entitlements_copy_object(os_entitlements, entitlement_name);
+	if (entitlement_object) {
+		*entitlement_object = obj;
+	} else if (obj) {
+		osobject_release(obj);
+	}
+	return obj ? KERN_SUCCESS : KERN_NOT_FOUND;
+}
+
+static kern_return_t
+sweet_amfi_copy_object_with_proc(const proc_t proc,
+    const char *entitlement_name, void **entitlement_object)
+{
+	return sweet_amfi_copy_object(sweet_proc_entitlements(proc), entitlement_name,
+	           entitlement_object);
+}
+
+static const amfi_t sweet_amfi = {
+	.OSEntitlements_invalidate = sweet_amfi_entitlements_invalidate,
+	.OSEntitlements_asdict = sweet_amfi_entitlements_as_dict,
+	.OSEntitlements_query = sweet_amfi_entitlements_query,
+	.OSEntitlements_get_transmuted = sweet_amfi_entitlements_get_transmuted,
+	.OSEntitlements_get_xml = sweet_amfi_entitlements_get_xml,
+	/* CoreEntitlements is only used by the PMAP_CS code signing monitor. */
+	.get_legacy_profile_exemptions = sweet_amfi_get_legacy_profile_exemptions,
+	.get_udid = sweet_amfi_get_udid,
+	.query_context_to_object = sweet_amfi_query_context_to_object,
+	/* .TrustCache stays version 0: trust caches are unavailable without Image4. */
+	.OSEntitlements = {
+		.version = OSENTITLEMENTS_INTERFACE_VERSION,
+		.adjustContextWithMonitor = sweet_amfi_adjust_with_monitor,
+		.adjustContextWithoutMonitor = sweet_amfi_adjust_without_monitor,
+		.queryEntitlementBoolean = sweet_amfi_query_boolean,
+		.queryEntitlementBooleanWithProc = sweet_amfi_query_boolean_with_proc,
+		.queryEntitlementString = sweet_amfi_query_string,
+		.queryEntitlementStringWithProc = sweet_amfi_query_string_with_proc,
+		.copyEntitlementAsOSObject = sweet_amfi_copy_object,
+		.copyEntitlementAsOSObjectWithProc = sweet_amfi_copy_object_with_proc,
+	},
+};
+
+__startup_func
+static void
+sweet_amfi_register(void)
+{
+	amfi_interface_register(&sweet_amfi);
+	printf("SWEET AMFI: built-in interface registered (XML entitlements)\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, sweet_amfi_register);
+
+/*
+ * The signature reached this hook validated, so mark it CS_SIGNED like AMFI
+ * does: exec copies the flag to the process, and csproc_get_blob() (csops
+ * status, cdhash, platform and entitlement queries by process) ignores
+ * processes without it. Every signed binary on the root filesystem is a
+ * platform binary. New signatures (ubc_cs_blob_add passes its writable copy;
+ * revalidation passes the read-only blob itself) get their entitlements here.
+ */
+static int
+sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
+    __unused cpu_type_t cpu_type, struct cs_blob *cs_blob,
+    unsigned int *cs_flags, __unused unsigned int *signer_type,
+    __unused int flags, __unused unsigned int platform,
+    __unused char **fatal_failure_desc, __unused size_t *fatal_failure_desc_len)
+{
+	mount_t mp = vnode_mount(vp);
+	*cs_flags |= CS_SIGNED;
+	if (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
+		*cs_flags |= CS_PLATFORM_BINARY;
+	}
+	if (cs_blob != cs_blob->csb_ro_addr && cs_blob->csb_entitlements == NULL) {
+		sweet_amfi_attach_entitlements(cs_blob);
+	}
+	return 0;
+}
+
+/*
+ * Policy "Sandbox": libsystem_sandbox calls __mac_syscall("Sandbox", op,
+ * arg). Without a policy of that name every call fails with ENOPOLICY and
+ * launchd reports mach lookups as "error = 159: Sandbox restriction"
+ * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
+ * "profile not found"). SWEET runs without a sandbox: operations succeed
+ * (checks allow, profile init is accepted); container paths fail with
+ * ENOENT. The first use of each operation number is logged.
+ *
+ * Sandbox extensions are tokens a daemon issues so that a sandboxed client
+ * may reach something. tccd issues one with every grant ("Failed to issue
+ * Sandbox Extension for kTCCServicePhotos" when issuing fails), and assetsd
+ * aborts without it ("assetsd requires TCCPhotosService access": Photos
+ * never opens). libsystem_sandbox (iOS 16.7.16) passes op 5 (issue) seven
+ * u64: extension class, -, name, flags, a 2048-byte buffer for the token,
+ * pid, -; and op 6 (consume) { token, length, u64 *handle }, the handle being
+ * what sandbox_extension_consume() returns. With no sandbox to extend, any
+ * token will do: issue writes "sweet;<class>", consume accepts every token
+ * and hands out handle 1.
+ */
+static uint64_t sweet_sandbox_seen;
+
+static int
+sweet_sandbox_extension_issue(user_addr_t arg)
+{
+	uint64_t args[7];
+	int error = copyin(arg, args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	char class[128] = "";
+	size_t done;
+	if (args[0] != 0 && copyinstr((user_addr_t)args[0], class, sizeof(class), &done) != 0) {
+		class[0] = '\0';
+	}
+	char token[sizeof(class) + 8];
+	int len = snprintf(token, sizeof(token), "sweet;%s", class);
+	return copyout(token, (user_addr_t)args[4], (size_t)len + 1);
+}
+
+static int
+sweet_sandbox_extension_consume(user_addr_t arg)
+{
+	uint64_t args[3];               /* token, length, user address of the handle */
+	int error = copyin(arg, args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	uint64_t handle = 1;
+	return copyout(&handle, (user_addr_t)args[2], sizeof(handle));
+}
+
+/*
+ * 0201: container paths. An app extension asks for its own data container (libsystem_sandbox
+ * sandbox_container_path_for_pid / _for_audit_token: op 4, { pid, pidversion, buffer, size, by token }) and
+ * ExtensionFoundation aborts when there is none: Photos' picker (PhotosPicker.appex, needed to choose a photo
+ * for a wallpaper) died on "plugin has invalid sandbox or container: error 2 path ?" because this stand-in
+ * answered ENOENT. Its container exists (containermanagerd made it); only the kernel did not know it.
+ * On iOS the launcher hands the path to the Sandbox policy at exec: sandbox_spawnattrs_setcontainer() puts it
+ * in the "Sandbox" mac policy info of posix_spawn (length at +0xc, the path at +0x50), and the policy keeps it
+ * with the process. Here it is kept in a small table (pid + unique id, so a reused pid is not mistaken), also
+ * from op 0x42 (sandbox_set_container_path_for_audit_token: { pid, pidversion, path }), and answered by op 4
+ * and op 0x43 (sandbox_get_container_expected: { u64 *expected, u64 * }). A process without one gets ENOENT,
+ * as before. The first 40 paths are logged ("SWEET Sandbox: <name>[pid] container (spawn|set) <path>").
+ */
+#define SWEET_CONTAINERS        128
+static struct {
+	pid_t    pid;
+	uint64_t uniqueid;
+	char     path[MAXPATHLEN];
+} sweet_containers[SWEET_CONTAINERS];
+static unsigned sweet_containers_next, sweet_containers_said;
+static LCK_GRP_DECLARE(sweet_containers_grp, "sweet_containers");
+static LCK_MTX_DECLARE(sweet_containers_lock, &sweet_containers_grp);
+/*
+ * 0202: containers by code signing identity. 0201 learned none (sbpath, 2026-11-09: 0 of 301 processes): this
+ * iOS's launcher gives the Sandbox no container at exec. The other way iOS has is
+ * sandbox_set_container_path_for_signing_id[_with_persona] / _for_application_group (op 0xd: { identity, path,
+ * kind (0 signing id, 1 app group), persona }), which containermanagerd can call and userland/jb/sweet-containers
+ * calls for every container's metadata (MCMMetadataIdentifier -> its directory). A process with no container of
+ * its own (0201) gets the one of its code signing identity (cs_identity_get). App groups are kept apart.
+ */
+#define SWEET_IDENT_CONTAINERS  640
+static struct {
+	char ident[128];
+	char path[192];
+} sweet_ident_containers[SWEET_IDENT_CONTAINERS];
+static unsigned sweet_ident_count, sweet_ident_said;
+
+/* path of len bytes for p (len 0: p has none any more) */
+static void
+sweet_container_note(proc_t p, const char *path, size_t len, const char *how)
+{
+	if (p == NULL) {
+		return;
+	}
+	pid_t pid = proc_pid(p);
+	uint64_t uniqueid = proc_uniqueid(p);
+	int say = 0;
+	lck_mtx_lock(&sweet_containers_lock);
+	unsigned slot = SWEET_CONTAINERS;
+	for (unsigned i = 0; i < SWEET_CONTAINERS; i++) {
+		if (sweet_containers[i].pid == pid && sweet_containers[i].path[0] != '\0') {
+			slot = i;
+			break;
+		}
+	}
+	if (len == 0) {
+		if (slot < SWEET_CONTAINERS) {
+			sweet_containers[slot].path[0] = '\0';
+		}
+	} else {
+		if (slot == SWEET_CONTAINERS) {
+			slot = sweet_containers_next++ % SWEET_CONTAINERS;
+		}
+		if (len >= MAXPATHLEN) {
+			len = MAXPATHLEN - 1;
+		}
+		sweet_containers[slot].pid = pid;
+		sweet_containers[slot].uniqueid = uniqueid;
+		memcpy(sweet_containers[slot].path, path, len);
+		sweet_containers[slot].path[len] = '\0';
+		if (sweet_containers_said < 40) {
+			sweet_containers_said++;
+			say = 1;
+		}
+	}
+	lck_mtx_unlock(&sweet_containers_lock);
+	if (say) {
+		char name[32];
+		proc_name(pid, name, sizeof(name));
+		printf("SWEET Sandbox: %s[%d] container (%s) %.*s\n", name, pid, how, (int)len, path);
+	}
+}
+
+/* the path kept for pid, if it is still the same process; 0 when there is one */
+static int
+sweet_container_lookup(pid_t pid, char *out, size_t size)
+{
+	proc_t p = proc_find(pid);
+	if (p == NULL) {
+		return ESRCH;
+	}
+	uint64_t uniqueid = proc_uniqueid(p);
+	char ident[128] = "";
+	const char *signing = cs_identity_get(p);     /* 0202 */
+	if (signing != NULL) {
+		strlcpy(ident, signing, sizeof(ident));
+	}
+	proc_rele(p);
+	int error = ENOENT;
+	lck_mtx_lock(&sweet_containers_lock);
+	for (unsigned i = 0; i < SWEET_CONTAINERS; i++) {
+		if (sweet_containers[i].pid == pid && sweet_containers[i].uniqueid == uniqueid &&
+		    sweet_containers[i].path[0] != '\0') {
+			strlcpy(out, sweet_containers[i].path, size);
+			error = 0;
+			break;
+		}
+	}
+	for (unsigned i = 0; error != 0 && ident[0] != '\0' && i < sweet_ident_count; i++) {
+		if (strcmp(sweet_ident_containers[i].ident, ident) == 0) {
+			strlcpy(out, sweet_ident_containers[i].path, size);
+			error = 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_containers_lock);
+	return error;
+}
+
+/* exec: the launcher's container for the new image (no transition is asked for: always 0) */
+static int
+sweet_sandbox_check_execve(kauth_cred_t old __unused, struct vnode *vp __unused, off_t offset __unused,
+    struct vnode *scriptvp __unused, struct label *vnodelabel __unused, struct label *scriptvnodelabel __unused,
+    struct label *execlabel __unused, struct proc *p, void *macpolicyattr, size_t macpolicyattrlen)
+{
+	const uint8_t *attr = (const uint8_t *)macpolicyattr;
+	uint32_t len = 0;
+	if (attr != NULL && macpolicyattrlen > 0x51) {
+		memcpy(&len, attr + 0xc, sizeof(len));
+		if (len >= MAXPATHLEN || 0x50 + (size_t)len > macpolicyattrlen || attr[0x50] != '/') {
+			len = 0;
+		}
+	}
+	sweet_container_note(p, len ? (const char *)attr + 0x50 : NULL, len, "spawn");
+	return 0;
+}
+
+static int
+sweet_sandbox_container_set(user_addr_t arg)
+{
+	uint64_t args[3];               /* pid, pidversion, path */
+	char path[MAXPATHLEN];
+	size_t done = 0;
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		error = copyinstr((user_addr_t)args[2], path, sizeof(path), &done);
+	}
+	if (error) {
+		return error;
+	}
+	proc_t p = proc_find((pid_t)args[0]);
+	if (p == NULL) {
+		return ESRCH;
+	}
+	sweet_container_note(p, path, strlen(path), "set");
+	proc_rele(p);
+	return 0;
+}
+
+/* 0202: op 0xd, { identity, path, kind, persona }: signing identities only (kind 0), the last path wins */
+static int
+sweet_sandbox_container_for_identity(struct proc *p, user_addr_t arg)
+{
+	uint64_t args[4];
+	char ident[128], path[192];
+	size_t done = 0;
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		error = copyinstr((user_addr_t)args[0], ident, sizeof(ident), &done);
+	}
+	if (error == 0) {
+		error = copyinstr((user_addr_t)args[1], path, sizeof(path), &done);
+	}
+	if (error) {
+		return error == ENAMETOOLONG ? 0 : error;   /* too long to keep: accepted, not kept */
+	}
+	if (args[2] != 0 || ident[0] == '\0' || path[0] != '/') {
+		return 0;                       /* app groups: not asked for here */
+	}
+	int said = 0, added = 0;
+	lck_mtx_lock(&sweet_containers_lock);
+	unsigned i;
+	for (i = 0; i < sweet_ident_count; i++) {
+		if (strcmp(sweet_ident_containers[i].ident, ident) == 0) {
+			break;
+		}
+	}
+	if (i == sweet_ident_count && sweet_ident_count < SWEET_IDENT_CONTAINERS) {
+		sweet_ident_count++;
+		added = 1;
+	}
+	if (i < sweet_ident_count) {
+		strlcpy(sweet_ident_containers[i].ident, ident, sizeof(sweet_ident_containers[i].ident));
+		strlcpy(sweet_ident_containers[i].path, path, sizeof(sweet_ident_containers[i].path));
+	}
+	if (added && sweet_ident_said < 12) {
+		sweet_ident_said++;
+		said = 1;
+	}
+	unsigned count = sweet_ident_count;
+	lck_mtx_unlock(&sweet_containers_lock);
+	if (said) {
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s: container of %s is %s (%u known)\n", name, ident, path, count);
+	}
+	return 0;
+}
+
+static int
+sweet_sandbox_container_path(user_addr_t arg)
+{
+	uint64_t args[5];               /* pid, pidversion, buffer, size, by audit token */
+	char path[MAXPATHLEN];
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		error = sweet_container_lookup((pid_t)args[0], path, sizeof(path));
+	}
+	if (error) {
+		return error;
+	}
+	size_t need = strlen(path) + 1;
+	if (args[3] < need) {
+		return ERANGE;
+	}
+	return copyout(path, (user_addr_t)args[2], need);
+}
+
+static int
+sweet_sandbox_container_expected(struct proc *p, user_addr_t arg)
+{
+	uint64_t args[2];               /* u64 *expected, u64 * */
+	char path[MAXPATHLEN];
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		error = sweet_container_lookup(proc_pid(p), path, sizeof(path));
+	}
+	if (error) {
+		return ENOENT;          /* as before 0201 */
+	}
+	const uint64_t yes = 1, no = 0;
+	error = copyout(&yes, (user_addr_t)args[0], sizeof(yes));
+	if (error == 0 && args[1] != 0) {
+		error = copyout(&no, (user_addr_t)args[1], sizeof(no));
+	}
+	return error;
+}
+
+static int
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
+		sweet_sandbox_seen |= 1ULL << call;
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:         /* container path (audit token / pid) */
+		return sweet_sandbox_container_path(arg);
+	case 0x43:      /* container expected */
+		return sweet_sandbox_container_expected(p, arg);
+	case 0x42:      /* set container path for audit token */
+		return sweet_sandbox_container_set(arg);
+	case 0xd:       /* set container path for signing identity / application group (0202) */
+		return sweet_sandbox_container_for_identity(p, arg);
+	case 5:
+		return sweet_sandbox_extension_issue(arg);
+	case 6:
+		return sweet_sandbox_extension_consume(arg);
+	default:
+		return 0;
+	}
+}
+
+/*
+ * dyld asks AMFI what it may do for the process it is starting:
+ * amfi_check_dyld_policy_self() in iOS 16.7.16's /usr/lib/dyld is
+ * __sandbox_ms("AMFI", 90, { u64 in_flags, u64 *out_flags }). With no
+ * policy of that name the call fails and dyld runs restricted: no @ path
+ * expansion ("security policy does not allow @ path expansion", G3 run),
+ * DYLD_* variables ignored. Answer with the AMFI_DYLD_OUTPUT_* flags of
+ * dyld's ProcessConfig::Security (open-source dyld): everything except a
+ * custom shared cache.
+ *
+ * installd (InstalledContentLibrary, -[MIDaemonConfiguration
+ * codeSigningEnforcementIsDisabled]) and FrontBoardServices ask for the
+ * boot-arg state: amfi_interface_query_bootarg_state() in libmis is
+ * __sandbox_ms("AMFI", 96, u64 *flags), and installd takes code signing
+ * enforcement as disabled when (flags & 0x86) != 0. Otherwise it checks each
+ * app's signature with libmis, whose trust cache query (op 95) we cannot
+ * answer, and system apps (/private/var/staged_system_apps) never install.
+ * Boot-arg sweetcsoff=1 answers op 96 with SWEET_AMFI_BOOTARG_CS_OFF.
+ *
+ * Other AMFI operations stay unsupported (ENOSYS); the first use of each is
+ * logged.
+ */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    90
+#define SWEET_AMFI_QUERY_BOOTARG_STATE  96
+#define SWEET_AMFI_DYLD_ALLOW_AT_PATH           (1ULL << 0)
+#define SWEET_AMFI_DYLD_ALLOW_PATH_VARS         (1ULL << 1)
+#define SWEET_AMFI_DYLD_ALLOW_FALLBACK_PATHS    (1ULL << 3)
+#define SWEET_AMFI_DYLD_ALLOW_PRINT_VARS        (1ULL << 4)
+#define SWEET_AMFI_DYLD_ALLOW_FAILED_INSERTION  (1ULL << 5)
+#define SWEET_AMFI_DYLD_ALLOW_INTERPOSING       (1ULL << 6)
+#define SWEET_AMFI_DYLD_ALLOW_EMBEDDED_VARS     (1ULL << 7)
+#define SWEET_AMFI_BOOTARG_CS_OFF               (1ULL << 1)     /* one of installd's 0x86 */
+
+static TUNABLE(uint32_t, sweet_cs_off, "sweetcsoff", 0);
+
+static uint64_t sweet_amfi_syscall_seen[2];     /* AMFI's ops go past 64 (90, 95, 96) */
+
+static int
+sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call == SWEET_AMFI_CHECK_DYLD_POLICY) {
+		uint64_t args[2];               /* in_flags, user address of out_flags */
+		int error = copyin(arg, args, sizeof(args));
+		if (error) {
+			return error;
+		}
+		uint64_t allow = SWEET_AMFI_DYLD_ALLOW_AT_PATH | SWEET_AMFI_DYLD_ALLOW_PATH_VARS |
+		    SWEET_AMFI_DYLD_ALLOW_FALLBACK_PATHS | SWEET_AMFI_DYLD_ALLOW_PRINT_VARS |
+		    SWEET_AMFI_DYLD_ALLOW_FAILED_INSERTION | SWEET_AMFI_DYLD_ALLOW_INTERPOSING |
+		    SWEET_AMFI_DYLD_ALLOW_EMBEDDED_VARS;
+		return copyout(&allow, (user_addr_t)args[1], sizeof(allow));
+	}
+	bool answered = call == SWEET_AMFI_QUERY_BOOTARG_STATE && sweet_cs_off;
+	if (call >= 0 && call < 128 && !(sweet_amfi_syscall_seen[call / 64] & (1ULL << (call % 64)))) {
+		sweet_amfi_syscall_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET AMFI: %s op %d %s\n", name, call,
+		    answered ? "answered: code signing enforcement off (sweetcsoff=1)" : "unsupported");
+	}
+	if (!answered) {
+		return ENOSYS;
+	}
+	uint64_t flags = SWEET_AMFI_BOOTARG_CS_OFF;
+	return copyout(&flags, arg, sizeof(flags));
+}
+
+static const struct mac_policy_ops sweet_amfi_mac_ops = {
+	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_syscall,
+};
+
+/*
+ * Privileges for non-root processes come from MAC policies (priv_check_cred
+ * -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a grant UIKit
+ * apps die in CoreAnimation setup: work_interval_create(CA_CLIENT) needs
+ * PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
+ * Grant that one; log the first denial of each other privilege per process.
+ */
+#define SWEET_PRIV_LOG_MAX      64
+static struct {
+	int  priv;
+	char name[20];
+} sweet_priv_logged[SWEET_PRIV_LOG_MAX];
+static int sweet_priv_logged_count;
+
+static int
+sweet_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
+{
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+	/*
+	 * 0223: Skywalk user pipes. bluetoothd (uid 501) builds its A2DP audio path as a user-pipe
+	 * nexus ("Device supports Skywalk Path", provider slot 2048, 1/1 rings, 8/8 slots) and
+	 * exits on "Failed to alloc a nexus provider" (2026-11-09, Beats Solo 4 at AVDTP OPEN).
+	 * On iOS AMFI grants PRIV_SKYWALK_REGISTER_USER_PIPE from its entitlement; this kernel has no
+	 * entitlements (0025), so it is granted here (userland/bt/nxprobe: root register + alloc
+	 * work, mobile gets EPERM). Kernel pipes, interfaces and flow switches stay privileged.
+	 */
+	if (priv == PRIV_SKYWALK_REGISTER_USER_PIPE) {
+		return 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < sweet_priv_logged_count; i++) {
+		if (sweet_priv_logged[i].priv == priv &&
+		    strncmp(sweet_priv_logged[i].name, name, sizeof(name)) == 0) {
+			return EPERM;
+		}
+	}
+	if (sweet_priv_logged_count < SWEET_PRIV_LOG_MAX) {
+		sweet_priv_logged[sweet_priv_logged_count].priv = priv;
+		strlcpy(sweet_priv_logged[sweet_priv_logged_count].name, name, sizeof(name));
+		sweet_priv_logged_count++;
+		printf("SWEET Sandbox: %s privilege %d denied\n", name, priv);
+	}
+	return EPERM;
+}
+
+static const struct mac_policy_ops sweet_sandbox_mac_ops = {
+	.mpo_policy_syscall = sweet_sandbox_syscall,
+	.mpo_priv_grant = sweet_sandbox_priv_grant,
+	.mpo_cred_check_label_update_execve = sweet_sandbox_check_execve,
+};
+
+static struct mac_policy_conf sweet_sandbox_mac_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "SWEET permissive sandbox stand-in",
+	.mpc_ops = &sweet_sandbox_mac_ops,
+};
+
+static mac_policy_handle_t sweet_sandbox_mac_handle;
+
+static struct mac_policy_conf sweet_amfi_mac_conf = {
+	.mpc_name = "AMFI",             /* the name __mac_syscall callers (dyld) use */
+	.mpc_fullname = "SWEET built-in Mobile File Integrity",
+	.mpc_ops = &sweet_amfi_mac_ops,
+};
+
+static mac_policy_handle_t sweet_amfi_mac_handle;
+
+/* Called from bsd_init once MAC policies can register, before any exec. */
+void sweet_amfi_policy_register(void);
+
+void
+sweet_amfi_policy_register(void)
+{
+	int error = mac_policy_register(&sweet_amfi_mac_conf, &sweet_amfi_mac_handle, NULL);
+	printf("SWEET AMFI: platform binary policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
+	printf("SWEET Sandbox: permissive policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
