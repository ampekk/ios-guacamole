+/*!
+ * @typedef IOHIDReportType
+ *
+ * @abstract
+ * Describes different type of HID reports.
+ */
+enum IOHIDReportType {
+    kIOHIDReportTypeInput = 0,
+    kIOHIDReportTypeOutput,
