+    kIOHIDElementTypeInput_Button      = 2,
+    kIOHIDElementTypeInput_Axis        = 3,
+    kIOHIDElementTypeInput_ScanCodes   = 4,
+    kIOHIDElementTypeInput_NULL        = 5,
+    kIOHIDElementTypeOutput            = 129,
+    kIOHIDElementTypeFeature           = 257,
