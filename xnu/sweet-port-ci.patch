+bool
+AppleCLCD::start(IOService *provider)
+{
+	PE_Video video;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	PE_current_console(&video);
+	fPhys = video.v_baseAddr;
+	fWidth = (uint32_t)video.v_width;
+	fHeight = (uint32_t)video.v_height;
+	fRowBytes = (uint32_t)video.v_rowBytes;
+	if (fPhys == 0 || fWidth == 0 || fHeight == 0 || fRowBytes < fWidth * 4) {
+		IOLog("SWEET FB: no boot framebuffer\n");
+		return false;
+	}
+	int native = 0;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	uint32_t pscale = 3;
+	PE_parse_boot_argn("sweetfb_scale", &pscale, sizeof(pscale));
+	if (pscale == 2) {
+		/*
+		 * 0241: 828x1792 (414x896 points @2x, iPhone XR / 11), not 750x1624: UIKit has status bar layouts only
+		 * for real iPhone screens, and 375x812 @2x is none (image B showed the red rdar://45025538 bar).
+		 */
+		sweet_fb_logical_w = 828;
+		sweet_fb_logical_h = 1792;
+	}
+	IOLog("SWEET FB: presented screen %ux%u (@%ux, 0240)\n", sweet_fb_logical_w, sweet_fb_logical_h, pscale == 2 ? 2u : 3u);
+	fLogicalW = fWidth;
+	fLogicalH = fHeight;
+	if (!native && fWidth <= SWEET_FB_LOGICAL_W && fHeight <= SWEET_FB_LOGICAL_H) {
+		fLogicalW = SWEET_FB_LOGICAL_W;
+		fLogicalH = SWEET_FB_LOGICAL_H;
+	}
+	fScaleUp = false;
+	fColMap = NULL;
+	if (!native && fWidth > SWEET_FB_LOGICAL_W && fHeight > SWEET_FB_LOGICAL_H &&
+	    fWidth < 0x10000 && fHeight < 0x10000) {
+		fColMap = (uint16_t *)IOMalloc(fWidth * sizeof(uint16_t));
+		if (fColMap != NULL) {
+			for (uint32_t x = 0; x < fWidth; x++) {
+				fColMap[x] = (uint16_t)(((uint64_t)x * SWEET_FB_LOGICAL_W) / fWidth);
+			}
+			fLogicalW = SWEET_FB_LOGICAL_W;
+			fLogicalH = SWEET_FB_LOGICAL_H;
+			fScaleUp = true;
+		}
+	}
+	fOffX = fScaleUp ? 0 : (int32_t)(fLogicalW - fWidth) / 2;
+	fOffY = fScaleUp ? 0 : (int32_t)(fLogicalH - fHeight) / 2;
+	fLock = IOLockAlloc();
+	fPresentLock = IOLockAlloc();
+	fClients = OSArray::withCapacity(4);
+	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
+		IOLog("SWEET FB: setup failed\n");
+		OSSafeReleaseNULL(fSurface);    /* stays published: also held by the table */
+		OSSafeReleaseNULL(fWorkLoop);
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		IOLog("SWEET FB: no vsync timer\n");
+		return false;
+	}
+	uint32_t hz = 10;
+	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	uint32_t vsyncHz = 60;
+	bool vsyncArg = PE_parse_boot_argn("sweetfb_vsync", &vsyncHz, sizeof(vsyncHz));
+	if (vsyncHz < 1 || vsyncHz > 240) {
+		vsyncHz = 60;
+	}
+	sweet_fb_vsync_us = 1000000 / vsyncHz;
+	sweet_fb_panel_90hz();                          /* 0199: before the panel's refresh is measured */
+	if (sweet_fb_measure_refresh() && !vsyncArg) {   /* 0198 */
+		sweet_fb_vsync_us = (uint32_t)(sweet_fb_period_ns / 1000);
+		IOLog("SWEET FB: vsync from the panel: %u us, at each frame's start\n", sweet_fb_vsync_us);
+	} else {
+		if (vsyncArg) {
+			sweet_fb_te = NULL;     /* the boot-arg's rate: no phase lock to a different panel rate */
+		}
+		IOLog("SWEET FB: synthetic vsync %u Hz (%u us)\n", vsyncHz, sweet_fb_vsync_us);
+	}
+	uint32_t presentAtSwap = 1;
+	(void)PE_parse_boot_argn("sweetfbatswap", &presentAtSwap, sizeof(presentAtSwap));
+	sweet_fb_present_at_swap = presentAtSwap != 0;
+	uint32_t sync = 1;
+	(void)PE_parse_boot_argn("sweetfbsync", &sync, sizeof(sync));
+	sweet_fb_sync = sync != 0;
+	uint32_t compose = 1;
+	(void)PE_parse_boot_argn("sweetfbcompose", &compose, sizeof(compose));
+	sweet_fb_compose = compose != 0;
+	uint32_t opaqueFlag = 1;
+	(void)PE_parse_boot_argn("sweetfbopaqueflag", &opaqueFlag, sizeof(opaqueFlag));
+	sweet_fb_opaque_flag = opaqueFlag != 0;
+	uint32_t persist = 1;
+	(void)PE_parse_boot_argn("sweetfbpersist", &persist, sizeof(persist));
+	sweet_fb_persist = persist != 0;
+	uint32_t highTop = 1;
+	(void)PE_parse_boot_argn("sweetfbtop", &highTop, sizeof(highTop));
+	sweet_fb_high_on_top = highTop != 0;
+	uint32_t island = 1;
+	(void)PE_parse_boot_argn("sweetfbisland", &island, sizeof(island));
+	sweet_fb_island = island != 0;
+	IOLog("SWEET FB: layers persist across swaps %s (0184)\n", sweet_fb_persist ? "on" : "off");
+	IOLog("SWEET FB: multi-layer composition %s (0170)\n", sweet_fb_compose ? "on" : "off");
+	IOLog("SWEET FB: frame hand-over sync %s (0169)\n", sweet_fb_sync ? "on" : "off");
+	IOLog("SWEET FB: GPU present mode %s\n", sweet_fb_present_at_swap ? "at-swap" : "vsync-only");
+	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	fVsync->setTimeoutUS(sweet_fb_next_tick_us());
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	uint32_t scanoutDiag = 0;
+	(void)PE_parse_boot_argn("sweetfb_scanoutdiag", &scanoutDiag, sizeof(scanoutDiag));
+	sweet_fb_scanout_diag = scanoutDiag != 0;
+	if (sweet_fb_scanout_diag)
+		IOLog("SWEET FB: scanout memory sampling enabled at %ux%u stride %u address 0x%llx\n",
+		    fWidth, fHeight, fRowBytes, (uint64_t)fPixels);
+	setProperty("external", false);
+	publishRefresh();
+	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	/*
+	 * 0256: VideoToolbox's _FigGetAlignmentForIOSurfaceOutputToDisplayService reads AppleCLCD's
+	 * DisplayPipePlaneBaseAlignment as a DICTIONARY (key PlaneBaseAlignmentLinear) and DisplayPipeStrideRequirements
+	 * (key StrideLinearHorizontal): a plain number made mediaserverd abort on "-[__NSCFNumber objectForKey:]" for
+	 * every video (Safari, 2026-11-11; research/video/README.md). 64 is the framework's own fallback for both.
+	 */
+	{
+		OSDictionary *align = OSDictionary::withCapacity(1), *stride = OSDictionary::withCapacity(1);
+		OSNumber *n64 = OSNumber::withNumber(64ULL, 32);
+		if (align != NULL && stride != NULL && n64 != NULL) {
+			align->setObject("PlaneBaseAlignmentLinear", n64);
+			stride->setObject("StrideLinearHorizontal", n64);
+			setProperty("DisplayPipePlaneBaseAlignment", align);
+			setProperty("DisplayPipeStrideRequirements", stride);
+		}
+		OSSafeReleaseNULL(align);
+		OSSafeReleaseNULL(stride);
+		OSSafeReleaseNULL(n64);
+	}
+	registerService();
+	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u%s\n",
+	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH,
+	    fScaleUp ? " (scaled up)" : "");
+	uint32_t accelOn = 1;
+	(void)PE_parse_boot_argn("sweetaccel", &accelOn, sizeof(accelOn));
+	IOAcceleratorES *accel = accelOn ? OSTypeAlloc(IOAcceleratorES) : NULL;
+	if (accel != NULL && accel->init()) {
+		accel->setName("sgx");
+		/*
+		 * 0144, sweetmtl=2: Metal's device. Metal loads /System/Library/Extensions/<MetalPluginName>.bundle,
+		 * takes MetalPluginClassName and opens this service's user client (SweetAccelerator.cpp: Turnip's
+		 * darwin backend, under metal2vulkan in SweetMetal2.bundle). As ios-flame's SweetAccelerator::start.
+		 */
+		uint32_t mtl = 0;
+		(void)PE_parse_boot_argn("sweetmtl", &mtl, sizeof(mtl));
+		if (mtl == 2) {
+			sweet_fb_metal = true;
+			accel->setProperty("MetalPluginName", "SweetMetal2");
+			accel->setProperty("MetalPluginClassName", "SweetMTL2Device");
+			accel->setProperty("IOGLBundleName", "SweetMetal2");
+			accel->setProperty("model", "Adreno 640");
+			accel->setProperty(kIOUserClientClassKey, "SweetAcceleratorUserClient");
+		}
+		if (accel->attach(this)) {
+			accel->registerService();
+			IOLog("SWEET FB: IOAcceleratorES published (%s)\n", mtl == 2 ? "Metal: SweetMetal2" :
+			    "empty: no 30 s wait in CAMetalContextCreate");
+		}
+	}
+	OSSafeReleaseNULL(accel);
+	return true;
+}
+
+/* Read-only probe of the physical framebuffer scanned by the panel. Five bands,
+ * each four full-width rows; run once a second only when explicitly enabled. */
+static void
+sweet_fb_scanout_sample(AppleCLCD *fb, uint64_t tick)
+{
+	if (!sweet_fb_scanout_diag || tick % 60 != 0 || fb->fPixels == 0 ||
+	    fb->fWidth == 0 || fb->fHeight < 16 || fb->fRowBytes < fb->fWidth * 4) {
+		return;
+	}
+	volatile const uint32_t *base = (volatile const uint32_t *)fb->fPixels;
+	static const uint32_t bandPermille[5] = { 80, 250, 500, 750, 920 };
+	for (unsigned band = 0; band < 5; band++) {
+		uint32_t y0 = (uint32_t)((uint64_t)(fb->fHeight - 4) * bandPermille[band] / 1000);
+		uint64_t hash = 1469598103934665603ull;
+		uint64_t light = 0;
+		uint32_t nonblack = 0;
+		for (uint32_t y = y0; y < y0 + 4; y++) {
+			volatile const uint32_t *row = base + (uint64_t)y * fb->fRowBytes / 4;
+			for (uint32_t x = 0; x < fb->fWidth; x++) {
+				uint32_t px = row[x];
+				uint32_t rgb = ((px >> 16) & 0xff) + ((px >> 8) & 0xff) + (px & 0xff);
+				hash = (hash ^ px) * 1099511628211ull;
+				light += rgb;
+				if (rgb > 24) nonblack++;
+			}
+		}
+		IOLog("SWEET FB: scanout tick %llu band %u y=%u hash=%016llx nonblack=%u/%u mean=%llu\n",
+		    tick, band, y0, hash, nonblack, fb->fWidth * 4, light / ((uint64_t)fb->fWidth * 4 * 3));
+	}
+}
+
+void
+AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t count = ++fb->fVsyncCount;
+	sweet_fb_scanout_sample(fb, count);
+	if (sweet_fb_stats.window_start == 0) {
+		sweet_fb_stats.window_start = now;
+	}
+	/* 0155: is the GPU still on what was last submitted (anyone's)? Sampled 60 times a second */
+	sweet_fb_stats.ticks++;
+	{
+		uint32_t last = redwood_gpu_last();
+		if (last != 0 && sweet_gpu_wait_fence_ns(last, 0) != 0) {
+			sweet_fb_stats.gpu_busy_ticks++;
+		}
+	}
+	uint64_t window_ns = 0;
+	absolutetime_to_nanoseconds(now - sweet_fb_stats.window_start, &window_ns);
+	if (window_ns >= 5000000000ull) {
+		if (sweet_fb_stats.swaps != 0) {
+			uint64_t gap_us = 0;
+			absolutetime_to_nanoseconds(sweet_fb_stats.max_gap, &gap_us);
+			IOLog("SWEET FB: 5s: %u swaps (%u.%u/s), shown at swap %u, at vsync %u, GPU busy %u; longest gap %llu ms\n",
+			    sweet_fb_stats.swaps, (uint32_t)(sweet_fb_stats.swaps * 10ull * 1000000000ull / window_ns) / 10,
+			    (uint32_t)(sweet_fb_stats.swaps * 10ull * 1000000000ull / window_ns) % 10, sweet_fb_stats.at_swap,
+			    sweet_fb_stats.at_vsync, sweet_fb_stats.busy, gap_us / 1000000);
+			char sels[256];
+			int at = 0;
+			for (unsigned i = 0; i < 128 && at < (int)sizeof(sels) - 16; i++) {
+				if (sweet_fb_stats.sel[i] != 0) {
+					at += snprintf(sels + at, sizeof(sels) - (size_t)at, " %u:%u", i, sweet_fb_stats.sel[i]);
+				}
+			}
+			sels[at] = 0;
+			IOLog("SWEET FB: 5s: vsyncs sent %u; swap gaps <17 ms %u, <34 %u, <50 %u, more %u; GPU busy at %u%% of vsyncs; selectors%s\n",
+			    sweet_fb_stats.vsync_sent, sweet_fb_stats.gap17, sweet_fb_stats.gap34, sweet_fb_stats.gap50,
+			    sweet_fb_stats.gap_more, sweet_fb_stats.ticks ? sweet_fb_stats.gpu_busy_ticks * 100 / sweet_fb_stats.ticks : 0,
+			    sels);
+			IOLog("SWEET FB: 5s: sync %u; no new GPU work at swap %u (late %u); forced unfinished %u; re-swapped pending surface %u; "
+			    "CPU-copied Metal frames %u (skip setup %u, layers %u, none %u, surface %u, bounds %u, slot %u); SwapWait %u (timed out %u)\n",
+			    sweet_fb_sync, sweet_fb_stats.nowork, sweet_fb_stats.late, sweet_fb_stats.forced, sweet_fb_stats.reswap,
+			    sweet_fb_stats.cpu_metal, sweet_fb_stats.gpu_skip[0], sweet_fb_stats.gpu_skip[1], sweet_fb_stats.gpu_skip[2],
+			    sweet_fb_stats.gpu_skip[3], sweet_fb_stats.gpu_skip[4], sweet_fb_stats.gpu_skip[5], sweet_fb_stats.swapwait,
+			    sweet_fb_stats.swapwait_to);
+			if (sweet_fb_stats.composed != 0) {
+				uint64_t us = 0;
+				absolutetime_to_nanoseconds(sweet_fb_stats.comp_time, &us);
+				us /= 1000;
+				IOLog("SWEET FB: 5s: composed %u frames (%llu us each): layers opaque %u, blended %u, skipped %u; waited for GPU blit %u\n",
+				    sweet_fb_stats.composed, us / sweet_fb_stats.composed, sweet_fb_stats.comp_opaque,
+				    sweet_fb_stats.comp_blend, sweet_fb_stats.comp_skipped, sweet_fb_stats.comp_gpu_wait);
+			}
+			IOLog("SWEET FB: 5s: display-time samples: game layer %u frames, %u black; other top layer %u frames, %u black\n",
+			    sweet_fb_stats.seen_game, sweet_fb_stats.black_game, sweet_fb_stats.seen_other, sweet_fb_stats.black_other);
+			if (sweet_fb_stats.top_clear != 0) {
+				IOLog("SWEET FB: 5s: two-layer frames with a transparent top layer (lower layer alone): %u\n",
+				    sweet_fb_stats.top_clear);
+			}
+			if (sweet_fb_stats.island != 0) {
+				IOLog("SWEET FB: 5s: of those, drawn with the top layer's island box (0236): %u\n", sweet_fb_stats.island);
+			}
+			if (sweet_fb_stats.persisted != 0) {
+				IOLog("SWEET FB: 5s: swaps that kept an earlier layer: %u\n", sweet_fb_stats.persisted);
+			}
+			if (sweet_fb_stats.top_only != 0) {
+				IOLog("SWEET FB: 5s: multi-layer frames shown on the GPU (opaque top layer, bottom layer around it): %u\n",
+				    sweet_fb_stats.top_only);
+			}
+		}
+		uint64_t keep = sweet_fb_stats.last_swap;
+		bzero(&sweet_fb_stats, sizeof(sweet_fb_stats));
+		sweet_fb_stats.window_start = now;
+		sweet_fb_stats.last_swap = keep;
+	}
+	/*
+	 * 0147: the refresh period after the vsync time: CoreAnimation's IOMFBServer::vsync_callback takes
+	 * the next vsync as time + period, and with 0 every frame deadline was already past (ios-flame 0121:
+	 * 15.8 -> 21 fps there).
+	 */
+	static uint64_t period;
+	if (period == 0) {
+		nanoseconds_to_absolutetime((uint64_t)sweet_fb_vsync_us * 1000, &period);
+	}
+	uint64_t values[6] = {
+		(uint32_t)count, (uint32_t)(count >> 32),
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)period, (uint32_t)(period >> 32),
+	};
+
+	IOLockLock(fb->fLock);
+	for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
+	}
+	if (fb->fPowerOff) {
+		/*
+		 * Black. 0132: the fade (halving every pixel on 7 vsyncs) read back the
+		 * write-combined panel memory, slowly enough to be seen frame by frame.
+		 * 0259: not just once: a GPU present that was already queued when the display went off (backboardd's
+		 * dimmed last frame, 0150 presents at swap time) can land after the first clear and stay on the panel
+		 * ("locks, dims a bit, does not go black"). So clear again on the next SWEET_FB_OFF_CLEARS vsyncs
+		 * (~0.5 s), each under fPresentLock so no present runs at the same time; nothing presents while off.
+		 */
+		uint32_t step = fb->fFadeStep;
+		if (step < SWEET_FB_OFF_CLEARS) {
+			fb->fFadeStep = step + 1;
+		}
+		IOLockUnlock(fb->fLock);
+		if (step < SWEET_FB_OFF_CLEARS) {
+			if (fb->fPresentLock != NULL) {
+				IOLockLock(fb->fPresentLock);
+			}
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				bzero((void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes), (size_t)fb->fWidth * 4);
+			}
+			if (fb->fPresentLock != NULL) {
+				IOLockUnlock(fb->fPresentLock);
+			}
+		}
+		sender->setTimeoutUS(sweet_fb_next_tick_us());   /* 0198 */
+		return;
+	}
+	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
+	/*
+	 * 0145: with Metal (sweetmtl=2) backboardd swaps once CoreAnimation has submitted a frame, not once
+	 * the GPU has drawn it (eagl.c finished every frame first): the copy below showed frames half drawn
+	 * (mtl2 run 7: flicker whenever something moves). The frame waits for the GPU's last submit at its
+	 * swap, the previous one staying on the panel; after 6 vsyncs it is shown anyway (a hung GPU).
+	 */
+	if (flush && fb->fPendingFence != 0 && sweet_gpu_wait_fence_ns(fb->fPendingFence, 0) != 0) {
+		/* 0169: with sweetfbsync an unfinished frame waits up to a second (a hung GPU), not 6 vsyncs */
+		if (++fb->fFenceTicks < (sweet_fb_sync ? 60u : 6u)) {
+			flush = false;
+		} else {
+			sweet_fb_stats.forced++;
+		}
+	}
+	uint8_t *rec = NULL;
+	if (flush) {
+		rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+		if (rec != NULL) {
+			memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+			fb->fDirty = false;
+		}
+	}
+	IOLockUnlock(fb->fLock);
+	if (rec != NULL) {
+		/* 0132: what showing a frame costs (sweetfb_hz: can the CPU keep up at 60?) */
+		static uint64_t shown, spent;
+		uint64_t began = mach_absolute_time();
+		int gpu = -1;
+		if (fb->fPresentLock == NULL || IOLockTryLock(fb->fPresentLock)) {
+			gpu = fb->presentGPU(rec);
+			if (fb->fPresentLock != NULL) {
+				IOLockUnlock(fb->fPresentLock);
+			}
+		}
+		if (gpu < 0) {
+			sweet_fb_stats.busy++;
+			/* 0149: the GPU's previous blit still runs: this frame waits for the next vsync */
+			IOLockLock(fb->fLock);
+			fb->fDirty = true;
+			IOLockUnlock(fb->fLock);
+			IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+			sender->setTimeoutUS(sweet_fb_next_tick_us());   /* 0198 */
+			return;
+		}
+		if (gpu == 0) {
+			if (sweet_fb_metal) {
+				sweet_fb_stats.cpu_metal++;
+			}
+			if (!fb->presentComposed(rec)) {        /* 0170 */
+				fb->present(rec);
+			}
+		}
+		fb->shown(rec);                         /* 0169 */
+		sweet_fb_stats.at_vsync++;
+		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+		spent += mach_absolute_time() - began;
+		if (++shown % 300 == 0) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(spent, &ns);
+			IOLog("SWEET FB: %llu frames shown, %llu us each (last 300), every %u vsync(s)\n", shown,
+			    ns / 1000 / 300, fb->fFlushTicks);
+			spent = 0;
+		}
+	}
+	sender->setTimeoutUS(sweet_fb_next_tick_us());   /* 0198 */
+}
+
+void
+AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	fClients->setObject(client);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::removeClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	unsigned int i = fClients->getNextIndexOfObject(client, 0);
+	if (i != (unsigned int)-1) {
+		fClients->removeObject(i);
+	}
+	IOLockUnlock(fLock);
+}
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+static uint32_t sweet_fb_swaps_logged;
+static uint64_t sweet_fb_swap_count;
+
+/* 0169: this swap (and every earlier one) is on the panel, or queued on the GPU behind its own drawing */
+void
+AppleCLCD::shown(const uint8_t *rec)
+{
+	uint32_t id = get32(rec, 0x50);
+	IOLockLock(fLock);
+	if ((int32_t)(id - fShownSwapID) > 0) {
+		fShownSwapID = id;
+	}
+	IOLockWakeup(fLock, &fShownSwapID, false);
+	IOLockUnlock(fLock);
+}
+
+/* 0169: does layer surface id appear among rec's enabled layers? */
+static bool
+sweet_fb_rec_has_surface(const uint8_t *rec, uint32_t id)
+{
+	uint32_t mask = get32(rec, 0x104);
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) == id) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Copy each enabled layer's surface into the panel memory (no scaling). */
+/*
+ * A swap only records the frame: copying 10 MB into the panel on every
+ * swap (backboardd presents at 60 Hz) took the whole CPU. The vsync timer
+ * shows the latest frame every fFlushTicks ticks (boot-arg sweetfb_hz,
+ * default 10 Hz).
+ */
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+static uint32_t sweet_fb_persist_logged;
+
+void
+AppleCLCD::swap(const uint8_t *rec_in)
+{
+	/*
+	 * 0184: the layers this swap does not set keep what earlier swaps gave them (surface, rects, transform, the
+	 * opaque flag byte); rec+0x108 (cleared by kern_SwapSetLayer) is taken as "turn this layer off".
+	 */
+	uint8_t merged[SWEET_FB_SWAP_REC_SIZE];
+	const uint8_t *rec = rec_in;
+	if (sweet_fb_persist) {
+		memcpy(merged, rec_in, sizeof(merged));
+		uint32_t set = get32(rec_in, 0x104), clear = get32(rec_in, 0x108), mask = set, kept = 0;
+		IOLockLock(fLock);
+		for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+			uint32_t bit = 1u << l;
+			if ((set & bit) || (clear & bit) || !(fLayerMask & bit)) {
+				continue;
+			}
+			memcpy(merged + 0x54 + 4 * l, fLayers + 0x54 + 4 * l, 4);
+			memcpy(merged + 0x64 + 16 * l, fLayers + 0x64 + 16 * l, 16);
+			memcpy(merged + 0xc4 + 16 * l, fLayers + 0xc4 + 16 * l, 16);
+			memcpy(merged + 0x114 + 4 * l, fLayers + 0x114 + 4 * l, 4);
+			merged[0x467 + l] = fLayers[0x467 + l];
+			mask |= bit;
+			kept |= bit;
+		}
+		put32(merged, 0x104, mask);
+		memcpy(fLayers, merged, sizeof(merged));
+		fLayerMask = 0;
+		for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+			if ((mask & (1u << l)) && get32(merged, 0x54 + 4 * l) != 0) {
+				fLayerMask |= 1u << l;
+			}
+		}
+		uint32_t on = fLayerMask;
+		IOLockUnlock(fLock);
+		if (kept) {
+			sweet_fb_stats.persisted++;
+		}
+		if ((kept || clear) && sweet_fb_persist_logged < 30) {
+			sweet_fb_persist_logged++;
+			IOLog("SWEET FB: swap %u sets %#x, off %#x, kept %#x -> layers on %#x (surfaces %u %u %u %u)\n",
+			    get32(rec_in, 0x50), set, clear, kept, on, get32(merged, 0x54), get32(merged, 0x58), get32(merged, 0x5c),
+			    get32(merged, 0x60));
+		}
+		rec = merged;
+	}
+	/*
+	 * 0169: which GPU job ends this frame's drawing. The global last job (0145) is anyone's: a game's frames
+	 * kept CPU copies of backboardd's frames waiting. And CoreAnimation may swap before its Metal command
+	 * buffer reached the ring (metal2vulkan submits on its own thread): no job of the swapping process since its
+	 * previous swap then means the frame's drawing is still on its way, and a blit queued now would run before
+	 * it. Wait for it briefly (sweetfbsync); count it either way.
+	 */
+	uint32_t fence = redwood_gpu_last();
+	if (sweet_fb_metal) {
+		int pid = proc_selfpid();
+		uint32_t pidFence = 0;
+		uint32_t submits = sweet_mtl_pid_submits(pid, &pidFence);
+		if (submits != 0) {
+			if (submits == fSwapSubmits) {
+				sweet_fb_stats.nowork++;
+				if (sweet_fb_sync) {
+					uint64_t deadline = 0;
+					clock_interval_to_deadline(4, NSEC_PER_MSEC, &deadline);
+					while (submits == fSwapSubmits && mach_absolute_time() < deadline) {
+						IODelay(100);
+						submits = sweet_mtl_pid_submits(pid, &pidFence);
+					}
+					if (submits != fSwapSubmits) {
+						sweet_fb_stats.late++;
+					}
+				}
+			}
+			fSwapSubmits = submits;
+			if (sweet_fb_sync && pidFence != 0) {
+				fence = pidFence;
+			}
+		}
+	}
+	IOLockLock(fLock);
+	if (fDirty) {
+		/* the frame still waiting names a surface CoreAnimation now swaps again: it drew into it meanwhile */
+		uint32_t mask = get32(fPending, 0x104);
+		for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+			uint32_t id = get32(fPending, 0x54 + 4 * l);
+			if ((mask & (1u << l)) && id != 0 && sweet_fb_rec_has_surface(rec, id)) {
+				sweet_fb_stats.reswap++;
+				break;
+			}
+		}
+	}
+	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
+	fDirty = true;
+	fPendingFence = fence;
+	fFenceTicks = 0;
+	IOLockUnlock(fLock);
+	if ((++sweet_fb_swap_count % 1000) == 0) {
+		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+	}
+	uint64_t now = mach_absolute_time();
+	if (sweet_fb_stats.last_swap != 0 && now - sweet_fb_stats.last_swap > sweet_fb_stats.max_gap) {
+		sweet_fb_stats.max_gap = now - sweet_fb_stats.last_swap;
+	}
+	if (sweet_fb_stats.last_swap != 0) {
+		uint64_t gap_ns = 0;
+		absolutetime_to_nanoseconds(now - sweet_fb_stats.last_swap, &gap_ns);
+		if (gap_ns < 17000000ull) {
+			sweet_fb_stats.gap17++;
+		} else if (gap_ns < 34000000ull) {
+			sweet_fb_stats.gap34++;
+		} else if (gap_ns < 50000000ull) {
+			sweet_fb_stats.gap50++;
+		} else {
+			sweet_fb_stats.gap_more++;
+		}
+	}
+	sweet_fb_stats.last_swap = now;
+	sweet_fb_stats.swaps++;
+	/*
+	 * 0150: the GPU present right away. The blit goes on the ring behind the frame's own drawing, which
+	 * CoreAnimation submitted before this swap, so the GPU orders them and nothing waits here; the vsync
+	 * timer waited for the next tick and then for the fence (0145), and a frame whose GPU work missed a
+	 * tick waited a whole one more: 30 fps with backboardd and SpringBoard both idle 2/3 of the time
+	 * (mtl2 run 12, tsample). The panel refreshes on its own clock anyway. A busy blit slot (or another
+	 * present under way) leaves the frame to the vsync timer, as before.
+	 */
+	if (sweet_fb_metal && sweet_fb_present_at_swap && !fPowerOff && fPresentLock != NULL && IOLockTryLock(fPresentLock)) {
+		int shown = presentGPU(rec);
+		IOLockUnlock(fPresentLock);
+		if (shown > 0) {
+			sweet_fb_stats.at_swap++;
+			IOLockLock(fLock);
+			if (memcmp(fPending, rec, SWEET_FB_SWAP_REC_SIZE) == 0) {
+				fDirty = false;
+			}
+			IOLockUnlock(fLock);
+			this->shown(rec);               /* 0169 */
+		}
+	}
+}
+
+/*
+ * One layer, logical rect (dx,dy,w,h) <- surface rect (sx,sy), drawn on a
+ * panel bigger than the logical display: every panel pixel takes the
+ * logical pixel it falls in (nearest neighbour). Pixels go directly
+ * from the (cached) surface into the panel, so the
+ * write-combined panel memory is never read back.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	uintptr_t src = s->kernelAddress();
+	uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL || sx < 0 || sy < 0) {
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	/* clip in logical space: to the surface and to the logical display */
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	/* panel range covered: first panel pixel whose logical coord >= d,
+	 * up to the first whose logical coord >= d + w */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	if (px1 > fWidth) {
+		px1 = fWidth;
+	}
+	if (py1 > fHeight) {
+		py1 = fHeight;
+	}
+	const uintptr_t base = src + s->offset + (uint64_t)sx * 4;
+	for (uint32_t py = py0; py < py1; py++) {
+		uint32_t ly = (uint32_t)(((uint64_t)py * fLogicalH) / fHeight);
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + (int32_t)ly - dy) * s->bytesPerRow);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			drow[px] = srow[fColMap[px] - (uint32_t)dx];
+		}
+	}
+}
+
+/*
+ * 0149: the present on the GPU's 2D engine (CP_BLIT, BLIT_OP_SCALE: bilinear scale of CoreAnimation's
+ * 1125x2436 surface onto the 1440x3120 panel), queued behind the frame's own drawing on the same ring.
+ * The CPU copy (present/presentScaled) took 21 ms a frame (mtl2 run 9: cache flush of 11 MB, nearest-
+ * neighbour scale, 18 MB into write-combined panel memory), more than a 60 Hz vsync. Register values:
+ * ios-flame's a6_blit_ib (NWylynko/ios-flame, MIT: turnip's r2d path for vkCmdBlitImage captured on the
+ * same A640), field layouts in Mesa's a6xx.xml. Only for one enabled BGRA layer with 64-byte rows while
+ * Metal draws (sweetmtl=2); anything else takes the CPU path. Boot-arg sweetfbgpu=0 keeps the CPU path.
+ *
+ * GPU VA: one 256 MB window of 0144's: +0 the command buffers and scratch (64 KB of the pool),
+ * +16 MB the panel memory, +64 MB four 16 MB slots for CoreAnimation's surfaces (it rotates three).
+ */
+#define FBGPU_IB_BYTES          0x4000u
+#define FBGPU_PANEL_OFF         0x1000000ull
+#define FBGPU_SLOT_OFF          0x4000000ull
+#define FBGPU_SLOT_BYTES        0x1000000ull
+#define FBGPU_SLOTS             8       /* 0172: was 4; two layers of three surfaces each rotate */
+
+static struct {
+	bool tried, ok;
+	uint64_t win;
+	uint32_t *ib[2];                /* CPU view (write-combined) */
+	uint32_t fence[2];
+	unsigned next;
+	struct { uint32_t id; uint64_t pa0, len; } slot[FBGPU_SLOTS];
+	unsigned victim;
+	uint64_t *pages;                /* FBGPU_SLOT_BYTES / 4K */
+} sweet_fbgpu;
+
+static uint32_t
+fbgpu_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	    (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+fbgpu_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | cnt | (fbgpu_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (fbgpu_parity(reg) << 27);
+}
+
+static uint32_t
+fbgpu_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (fbgpu_parity(cnt) << 15) | ((op & 0x7fu) << 16) | (fbgpu_parity(op) << 23);
+}
+
+/* Map n bytes of physically contiguous memory at iova */
+static bool
+fbgpu_map_contig(uint64_t iova, uint64_t pa, uint64_t bytes)
+{
+	for (uint64_t off = 0; off < bytes;) {
+		uint32_t n = 0;
+		uint64_t start = off;
+		for (; n < FBGPU_SLOT_BYTES / 4096 && off < bytes; n++, off += 4096) {
+			sweet_fbgpu.pages[n] = pa + off;
+		}
+		if (sweet_gpu_map_at(iova + start, sweet_fbgpu.pages, n)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Once: the window, the command buffers, the panel mapping */
+static bool
+fbgpu_setup(uint64_t panel_pa, uint64_t panel_bytes)
+{
+	if (sweet_fbgpu.tried) {
+		return sweet_fbgpu.ok;
+	}
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfbgpu", &on, sizeof(on));
+	if (!on || !redwood_gpu_ready()) {
+		if (!on) {
+			sweet_fbgpu.tried = true;
+		}
+		return false;
+	}
+	sweet_fbgpu.tried = true;
+	uint64_t pa = 0;
+	sweet_fbgpu.pages = IONew(uint64_t, FBGPU_SLOT_BYTES / 4096);
+	IOMemoryDescriptor *md = NULL;
+	IOMemoryMap *map = NULL;
+	if (sweet_fbgpu.pages == NULL || panel_bytes > FBGPU_SLOT_OFF - FBGPU_PANEL_OFF ||
+	    sweet_gpu_window_alloc(0x10000000ull, &sweet_fbgpu.win) || sweet_gpu_pool_alloc(0x10000, &pa) ||
+	    (md = IOMemoryDescriptor::withPhysicalAddress(pa, 0x10000, kIODirectionInOut)) == NULL ||
+	    (map = md->map(kIOMapWriteCombineCache)) == NULL ||
+	    !fbgpu_map_contig(sweet_fbgpu.win, pa, 0x10000) ||
+	    !fbgpu_map_contig(sweet_fbgpu.win + FBGPU_PANEL_OFF, panel_pa, round_page_64(panel_bytes))) {
+		IOLog("SWEET FB: GPU present unavailable: the CPU copies frames\n");
+		return false;
+	}
+	uint8_t *cpu = (uint8_t *)map->getVirtualAddress();
+	bzero(cpu, 0x10000);
+	sweet_fbgpu.ib[0] = (uint32_t *)cpu;
+	sweet_fbgpu.ib[1] = (uint32_t *)(cpu + FBGPU_IB_BYTES);
+	sweet_fbgpu.ok = true;
+	IOLog("SWEET FB: GPU present: window %#llx, panel at +%#llx (%llu KB)\n", sweet_fbgpu.win, FBGPU_PANEL_OFF,
+	    panel_bytes >> 10);
+	return true;            /* md and map stay for good */
+}
+
+/*
+ * The slot holding this surface (mapped now if it is new): the GPU VA of its byte 0, or 0. A slot is
+ * remapped only while no blit of ours is queued (busy: *busy, the frame waits a vsync).
+ */
+static uint64_t
+fbgpu_surface_va(SweetSurface *s, bool *busy, int avoid, int *slot)
+{
+	IOByteCount seg = 0;
+	uint64_t len = round_page_64(s->memory->getLength());
+	uint64_t pa0 = s->memory->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+	if (pa0 == 0 || len > FBGPU_SLOT_BYTES) {
+		return 0;
+	}
+	for (unsigned i = 0; i < FBGPU_SLOTS; i++) {
+		if (sweet_fbgpu.slot[i].id == s->id && sweet_fbgpu.slot[i].pa0 == pa0 && sweet_fbgpu.slot[i].len == len) {
+			*slot = (int)i;
+			return sweet_fbgpu.win + FBGPU_SLOT_OFF + i * FBGPU_SLOT_BYTES;
+		}
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+			*busy = true;
+			return 0;
+		}
+	}
+	unsigned i = sweet_fbgpu.victim++ % FBGPU_SLOTS;
+	if ((int)i == avoid) {
+		i = sweet_fbgpu.victim++ % FBGPU_SLOTS;  /* 0172: not the slot this frame's other layer is in */
+	}
+	uint32_t n = 0;
+	for (uint64_t off = 0; off < len; off += 4096, n++) {
+		addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || (pa & 4095)) {
+			return 0;
+		}
+		sweet_fbgpu.pages[n] = pa;
+	}
+	uint64_t va = sweet_fbgpu.win + FBGPU_SLOT_OFF + i * FBGPU_SLOT_BYTES;
+	sweet_fbgpu.slot[i].id = 0;
+	if (sweet_gpu_map_at(va, sweet_fbgpu.pages, n)) {
+		return 0;
+	}
+	sweet_fbgpu.slot[i].id = s->id;
+	sweet_fbgpu.slot[i].pa0 = pa0;
+	sweet_fbgpu.slot[i].len = len;
+	*slot = (int)i;
+	return va;
+}
