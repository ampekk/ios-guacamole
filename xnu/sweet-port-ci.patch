+#ifndef _DEV_EVIO_H
+#define _DEV_EVIO_H
+
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+
+#if KERNEL
+#include <IOKit/system.h>
+#else /* !KERNEL */
