+/*
+ * From ios-topaz 0138 (topaz-0138, MakrSas/ios-topaz): the graphics
+ * accelerator's service class. QuartzCore (CAMetalContextCreate, once per
+ * process) polls IOServiceMatching("IOAcceleratorES") 300 times, 100 ms
+ * apart: thirty seconds at every backboardd start. One without
+ * MetalPluginName/MetalPluginClassName is found and then passed over by
+ * Metal (MTLRegisterDevices), which leaves the renderers as they were.
+ * Boot-arg sweetaccel=0 turns it off.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
+
+class IOMobileFramebufferUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
+
+public:
+	AppleCLCD          *fFB;
+	task_t              fTask;
+	mach_port_t         fPort;
+	io_user_reference_t fFunc[SWEET_FB_NOTIFY_TYPES];
+	io_user_reference_t fRefcon[SWEET_FB_NOTIFY_TYPES];
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn registerNotificationPort(mach_port_t port, UInt32 type,
+	    io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	void notify(uint32_t type, const uint64_t *values, uint32_t count);
+};
