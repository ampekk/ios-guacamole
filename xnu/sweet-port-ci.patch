+/*
+ * 0171: are all 64 alpha samples of this layer's source rectangle 255? Each sampled row is cache-invalidated
+ * on its own (the GPU wrote it), not the whole surface.
+ */
+static bool
+sweet_fb_layer_opaque(SweetSurface *s, const uint8_t *a)
+{
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	uintptr_t src = s->kernelAddress();
+	if (sw <= 0 || sh <= 0) {
+		sw = (int32_t)s->width;
+		sh = (int32_t)s->height;
+	}
+	if (src == 0 || s->memory == NULL || s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    sx < 0 || sy < 0 || sx + sw > (int32_t)s->width || sy + sh > (int32_t)s->height ||
+	    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 > s->memory->getLength()) {
+		return false;
+	}
+	for (int32_t j = 0; j < 8; j++) {
+		uint64_t off = (uint64_t)s->offset + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * s->bytesPerRow + (uint64_t)sx * 4;
+		s->memory->performOperation(kIOMemoryIncoherentIOFlush, off, (uint64_t)sw * 4);
+		const uint32_t *row = (const uint32_t *)(src + off);
+		for (int32_t i = 0; i < 8; i++) {
+			if ((row[(sw * (2 * i + 1)) / 16] >> 24) != 255u) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+/*
+ * 0172: is layer l opaque? The flag byte rec[0x467 + l] (kern_SwapSetLayer flag bit 9) is set on the game's
+ * Metal layer only, whose alpha is not all 255 (Subway Surfers: 255:61 mid:3): read as CoreAnimation's "opaque"
+ * (alpha ignored). Boot-arg sweetfbopaqueflag=0 ignores the byte (alpha samples only).
+ */
+static bool
+sweet_fb_layer_is_opaque(const uint8_t *rec, uint32_t l, SweetSurface *s)
+{
+	if (sweet_fb_opaque_flag && rec[0x467 + l] != 0) {
+		return true;
+	}
+	return s != NULL && sweet_fb_layer_opaque(s, rec + 0x64 + 16 * l);
+}
+
+/* 0172: one CP_BLIT: a source rectangle (24.8 fixed, inclusive) scaled onto a panel rectangle [px0,px1) x [py0,py1) */
+struct sweet_fb_blit {
+	uint64_t src;
+	uint32_t sw, sh, spitch;
+	uint32_t sx0, sx1, sy0, sy1;
+	uint32_t px0, px1, py0, py1;
+};
+
+/*
+ * 0172: a layer's part [x0,x1) x [y0,y1) of the logical display (inside its rect b) as a blit: the matching part
+ * of its source rect a, the panel pixels presentScaled's rounding gives that logical part. False: empty.
+ */
+static bool
+sweet_fb_part(const AppleCLCD *fb, uint64_t src, SweetSurface *s, int32_t sx, int32_t sy, int32_t aw, int32_t ah,
+    int32_t dx, int32_t dy, int32_t w, int32_t h, int32_t x0, int32_t y0, int32_t x1, int32_t y1, struct sweet_fb_blit *o)
+{
+	if (x1 <= x0 || y1 <= y0) {
+		return false;
+	}
+	o->px0 = (uint32_t)(((uint64_t)x0 * fb->fWidth + fb->fLogicalW - 1) / fb->fLogicalW);
+	o->px1 = (uint32_t)(((uint64_t)x1 * fb->fWidth + fb->fLogicalW - 1) / fb->fLogicalW);
+	o->py0 = (uint32_t)(((uint64_t)y0 * fb->fHeight + fb->fLogicalH - 1) / fb->fLogicalH);
+	o->py1 = (uint32_t)(((uint64_t)y1 * fb->fHeight + fb->fLogicalH - 1) / fb->fLogicalH);
+	o->px1 = o->px1 > fb->fWidth ? fb->fWidth : o->px1;
+	o->py1 = o->py1 > fb->fHeight ? fb->fHeight : o->py1;
+	if (o->px1 <= o->px0 || o->py1 <= o->py0) {
+		return false;
+	}
+	o->src = src;
+	o->sw = s->width;
+	o->sh = s->height;
+	o->spitch = s->bytesPerRow;
+	/* source edges in 1/256 pixel; the end is inclusive as before ((sx + aw - 1) << 8 for the whole layer) */
+	o->sx0 = (uint32_t)(sx * 256 + (int32_t)(((int64_t)(x0 - dx) * aw * 256) / w));
+	o->sx1 = (uint32_t)(sx * 256 + (int32_t)(((int64_t)(x1 - dx) * aw * 256) / w) - 256);
+	o->sy0 = (uint32_t)(sy * 256 + (int32_t)(((int64_t)(y0 - dy) * ah * 256) / h));
+	o->sy1 = (uint32_t)(sy * 256 + (int32_t)(((int64_t)(y1 - dy) * ah * 256) / h) - 256);
+	if ((int32_t)o->sx1 < (int32_t)o->sx0) {
+		o->sx1 = o->sx0;
+	}
+	if ((int32_t)o->sy1 < (int32_t)o->sy0) {
+		o->sy1 = o->sy0;
+	}
+	return true;
+}
+
+/* 0185: are all 64 alpha samples of the layer 0 (rows cache-invalidated): nothing of it would show */
+static bool
+sweet_fb_layer_transparent(SweetSurface *s, const uint8_t *a)
+{
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	uintptr_t src = s->kernelAddress();
+	if (sw <= 0 || sh <= 0) {
+		sw = (int32_t)s->width;
+		sh = (int32_t)s->height;
+	}
+	if (src == 0 || s->memory == NULL || s->bytesPerElement != 4 || sx < 0 || sy < 0 || sx + sw > (int32_t)s->width ||
+	    sy + sh > (int32_t)s->height ||
+	    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 > s->memory->getLength()) {
+		return false;
+	}
+	for (int32_t j = 0; j < 8; j++) {
+		uint64_t off = (uint64_t)s->offset + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * s->bytesPerRow + (uint64_t)sx * 4;
+		s->memory->performOperation(kIOMemoryIncoherentIOFlush, off, (uint64_t)sw * 4);
+		const uint32_t *row = (const uint32_t *)(src + off);
+		for (int32_t i = 0; i < 8; i++) {
+			if ((row[(sw * (2 * i + 1)) / 16] >> 24) != 0) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+/* 0173: of 64 samples of the layer's source rectangle (rows cache-invalidated), how many are black (RGB sum <= 24) */
+static uint32_t
+sweet_fb_layer_black(SweetSurface *s, const uint8_t *a)
+{
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	uintptr_t src = s->kernelAddress();
+	if (sw <= 0 || sh <= 0) {
+		sw = (int32_t)s->width;
+		sh = (int32_t)s->height;
+	}
+	if (src == 0 || s->memory == NULL || s->bytesPerElement != 4 || sx < 0 || sy < 0 || sx + sw > (int32_t)s->width ||
+	    sy + sh > (int32_t)s->height ||
+	    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 > s->memory->getLength()) {
+		return 0;
+	}
+	uint32_t black = 0;
+	for (int32_t j = 0; j < 8; j++) {
+		uint64_t off = (uint64_t)s->offset + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * s->bytesPerRow + (uint64_t)sx * 4;
+		s->memory->performOperation(kIOMemoryIncoherentIOFlush, off, (uint64_t)sw * 4);
+		const uint32_t *row = (const uint32_t *)(src + off);
+		for (int32_t i = 0; i < 8; i++) {
+			uint32_t p = row[(sw * (2 * i + 1)) / 16];
+			if (((p >> 16) & 0xff) + ((p >> 8) & 0xff) + (p & 0xff) <= 24) {
+				black++;
+			}
+		}
+	}
+	return black;
+}
+
+static uint32_t sweet_fb_black_logged;
+static uint32_t sweet_fb_island_logged;   /* 0239 */
+
+/* 1 shown (queued on the GPU), 0 not for the GPU (the CPU path shows it), -1 the GPU is busy: next vsync */
+int
+AppleCLCD::presentGPU(const uint8_t *rec)
+{
+	if (!sweet_fb_metal) {
+		return 0;
+	}
+	if (!fScaleUp || !fbgpu_setup(fPhys, (uint64_t)fRowBytes * fHeight)) {
+		sweet_fb_stats.gpu_skip[0]++;           /* 0169: why a Metal frame took the CPU path */
+		return 0;
+	}
+	pauseConsole();
+	/* 0171: the lowest index is the top layer. 0172: up to two layers, the top one opaque */
+	uint32_t mask = get32(rec, 0x104), order[SWEET_FB_LAYERS], layers = 0;
+	for (uint32_t n = 0; n < SWEET_FB_LAYERS; n++) {
+		uint32_t l = sweet_fb_high_on_top ? SWEET_FB_LAYERS - 1 - n : n;      /* 0185: order[0] is the top */
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			order[layers++] = l;
+		}
+	}
+	if (layers == 0) {
+		sweet_fb_stats.gpu_skip[2]++;
+		return 0;
+	}
+	struct sweet_fb_island island;
+	island.n = 0;
+	bool has_island = false;
+	/* 0239: the island's strips in logical pixels (rows [ly0, ly1), island [lx0, lx1)) */
+	int32_t ly0[SWEET_FB_ISLAND_STRIPS], ly1[SWEET_FB_ISLAND_STRIPS], lx0[SWEET_FB_ISLAND_STRIPS], lx1[SWEET_FB_ISLAND_STRIPS];
+	if (layers == 2 && sweet_fb_compose) {
+		/* 0185: a top layer with nothing visible (all alpha 0, not flagged opaque): the lower layer alone */
+		SweetSurface *top = sweet_surface_copy(get32(rec, 0x54 + 4 * order[0]));
+		bool clear = top != NULL && !(sweet_fb_opaque_flag && rec[0x467 + order[0]] != 0) &&
+		    sweet_fb_layer_transparent(top, rec + 0x64 + 16 * order[0]);
+		/* 0236: a visible island in its top band: drawn as a box over the lower layer (below) */
+		has_island = clear && sweet_fb_island && sweet_fb_top_band_box(top, rec + 0x64 + 16 * order[0], &island);
+		OSSafeReleaseNULL(top);
+		if (has_island) {
+			sweet_fb_stats.top_clear++;
+			sweet_fb_stats.island++;
+		} else if (clear) {
+			order[0] = order[1];
+			layers = 1;
+			sweet_fb_stats.top_clear++;
+		}
+	}
+	if (layers > 2 || (layers == 2 && !sweet_fb_compose)) {
+		sweet_fb_stats.gpu_skip[1]++;
+		return 0;
+	}
+	unsigned k = sweet_fbgpu.next;
+	if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+		return -1;
+	}
+	struct sweet_fb_blit blits[4 + 3 * SWEET_FB_ISLAND_STRIPS];
+	unsigned nblits = 0;
+	int32_t tx0 = 0, ty0 = 0, tx1 = 0, ty1 = 0;     /* the top layer's logical rectangle (clipped) */
+	int avoid = -1;
+	for (uint32_t i = 0; i < layers; i++) {
+		uint32_t l = order[i];
+		SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * l));
+		if (s == NULL || s == fSurface || s->memory == NULL || s->pixelFormat != 0x42475241u ||
+		    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 || (s->bytesPerRow & 63) ||
+		    (s->offset & 63)) {
+			OSSafeReleaseNULL(s);
+			sweet_fb_stats.gpu_skip[3]++;
+			return 0;
+		}
+		if (i == 0 && layers == 2 && !has_island && !sweet_fb_layer_is_opaque(rec, l, s)) {
+			s->release();
+			sweet_fb_stats.gpu_skip[1]++;   /* a translucent top layer: the CPU path blends it */
+			return 0;
+		}
+		const uint8_t *a = rec + 0x64 + 16 * l;
+		const uint8_t *b = rec + 0xc4 + 16 * l;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		/* 0170: the source rectangle's own size (rect a); the blit scales it onto rect b */
+		int32_t aw = (int32_t)get32(a, 8), ah = (int32_t)get32(a, 12);
+		if (!sweet_fb_compose || aw <= 0 || ah <= 0) {
+			aw = w;
+			ah = h;
+		}
+		if (sx < 0 || sy < 0 || dx < 0 || dy < 0 || aw > (int32_t)s->width - sx || ah > (int32_t)s->height - sy ||
+		    w > (int32_t)fLogicalW - dx || h > (int32_t)fLogicalH - dy) {
+			OSSafeReleaseNULL(s);
+			sweet_fb_stats.gpu_skip[4]++;
+			return 0;
+		}
+		bool busy = false;
+		int slot = -1;
+		uint64_t src = fbgpu_surface_va(s, &busy, avoid, &slot);
+		src += src ? s->offset : 0;
+		if (src == 0) {
+			s->release();
+			if (!busy) {
+				sweet_fb_stats.gpu_skip[5]++;
+			}
+			return busy ? -1 : 0;
+		}
+		avoid = slot;
+		if (i == 0) {
+			/* 0173: is the picture the display is about to copy black already? */
+			uint32_t black = has_island ? 0 : sweet_fb_layer_black(s, a);
+			bool game = rec[0x467 + l] != 0;
+			if (game) {
+				sweet_fb_stats.seen_game++;
+			} else {
+				sweet_fb_stats.seen_other++;
+			}
+			if (black >= 16) {
+				if (game) {
+					sweet_fb_stats.black_game++;
+				} else {
+					sweet_fb_stats.black_other++;
+				}
+				/* 0183: the first 40, then every 150th (the first ones had rolled out of the log by the time it was read) */
+				uint32_t nb = ++sweet_fb_black_logged;
+				if (nb <= 40 || nb % 150 == 0) {
+					IOLog("SWEET FB: black at display #%u: swap %u layer %u surface %u (%s, %u layer(s)) %u/64 black\n",
+					    nb, get32(rec, 0x50), l, s->id, game ? "game" : "other", layers, black);
+					/* every enabled layer of that swap: surface, size, rects, the flag bytes */
+					uint32_t m = get32(rec, 0x104);
+					for (uint32_t q = 0; q < SWEET_FB_LAYERS; q++) {
+						uint32_t qid = get32(rec, 0x54 + 4 * q);
+						if (!(m & (1u << q))) {
+							continue;
+						}
+						const uint8_t *qa = rec + 0x64 + 16 * q, *qb = rec + 0xc4 + 16 * q;
+						IOLog("SWEET FB:   layer %u surface %u a %d,%d %dx%d b %d,%d %dx%d xform %u flags %02x %02x %02x %02x %02x %02x\n",
+						    q, qid, (int32_t)get32(qa, 0), (int32_t)get32(qa, 4), (int32_t)get32(qa, 8), (int32_t)get32(qa, 12),
+						    (int32_t)get32(qb, 0), (int32_t)get32(qb, 4), (int32_t)get32(qb, 8), (int32_t)get32(qb, 12),
+						    get32(rec, 0x114 + 4 * q), rec[0x2ca + q], rec[0x2cc + q], rec[0x2e3 + q], rec[0x2e5 + q],
