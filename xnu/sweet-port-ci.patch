+ */
+static bool sweet_fb_island = true;
+/*
+ * 0171: layer order. Subway Surfers (0170 log): layer 0 = the game's drawable (flag byte 0x467+layer = 1),
+ * layer 1 = CoreAnimation's own framebuffer surface (2/3), fully opaque or fully transparent. Drawing layer 0
+ * lowest hid the game (all black). The record's layer 0 is the TOP: composition goes from the highest
+ * index up. And a top layer covering the whole display with opaque samples needs nothing below it: the GPU
+ * blits it alone (no CPU composition).
+ */
+extern "C" int proc_selfpid(void);
+extern "C" uint32_t sweet_mtl_pid_submits(int pid, uint32_t *last_fence);      /* SweetAccelerator.cpp, 0169 */
+/* 0151: frame statistics, logged every 5 s while frames come (swaps; shown at the swap, at a vsync; GPU busy) */
+static struct {
+	uint64_t window_start, last_swap, max_gap;
+	uint32_t swaps, at_swap, at_vsync, busy;
+	/* 0153: what CoreAnimation does between frames: vsyncs delivered, gaps between swaps, every selector */
+	uint32_t vsync_sent, gap17, gap34, gap50, gap_more;
+	uint32_t ticks, gpu_busy_ticks;         /* 0155: vsync ticks, and those with GPU work still running */
+	/*
+	 * 0169: nowork: swaps with no GPU job from the swapping process since its previous swap; late: of those, a
+	 * job came within the 4 ms wait; forced: frames copied by the CPU before their drawing finished; reswap: a
+	 * swap naming a surface of the frame still waiting to be shown (CoreAnimation draws into it again);
+	 * cpu_metal: Metal frames the CPU copied; gpu_skip: why (setup, layers, no layer, surface, bounds, slot);
+	 * swapwait / swapwait_to: SwapWait calls, and those that ran out.
+	 */
+	uint32_t nowork, late, forced, reswap, cpu_metal, gpu_skip[6], swapwait, swapwait_to;
+	/* 0170: composed frames, their layers drawn opaque / blended, GPU blits still running before one, its cost */
+	uint32_t composed, comp_opaque, comp_blend, comp_skipped, comp_gpu_wait;
+	uint32_t top_only;                      /* 0171: multi-layer frames shown as their opaque top layer, on the GPU */
+	uint32_t persisted;                     /* 0184: swaps that kept a layer from earlier swaps */
+	uint32_t top_clear;                     /* 0185: two-layer frames whose top layer was all transparent */
+	uint32_t island;                        /* 0236: of those, frames drawn with the top band's visible box */
+	/*
