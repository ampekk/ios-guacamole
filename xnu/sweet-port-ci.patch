 #endif
 
@@ -8656,6 +8727,16 @@
 #endif /* CONFIG_SCHED_SMT */
 			}
 		} else {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* 0156: a realtime thread takes an idle A76, else any idle CPU, before it preempts a busy one */
+	if (sweet_sched_big() != 0 && !avoid_cpu0) {
+		cpumap_t sw_idle = primary_map & pset->cpu_state_map[PROCESSOR_IDLE];
