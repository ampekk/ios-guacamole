+				for (unsigned c = 0; c < 2; c++) {
+					if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, c2[c][0], c2[c][1], c2[c][2],
+					    c2[c][3], &blits[nblits])) {
+						nblits++;
+					}
+				}
+				for (int32_t q = 0; q < island.n; q++) {
+					int32_t r0 = ly0[q] < by0 ? by0 : ly0[q], r1 = ly1[q] > by1 ? by1 : ly1[q];
+					int32_t l1 = lx1[q] > lx0[q] ? lx0[q] : bx1;    /* an empty strip: the whole row */
+					l1 = l1 > bx1 ? bx1 : l1;
+					int32_t rt0 = lx1[q] > lx0[q] ? lx1[q] : bx1;
+					rt0 = rt0 < bx0 ? bx0 : rt0;
+					if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, bx0, r0, l1, r1, &blits[nblits])) {
+						nblits++;
+					}
+					if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, rt0, r0, bx1, r1, &blits[nblits])) {
+						nblits++;
+					}
+				}
+				s->release();
+				continue;
+			}
+			int32_t my0 = by0 > ty0 ? by0 : ty0, my1 = by1 < ty1 ? by1 : ty1;
+			int32_t cut[4][4] = {
+				{ bx0, by0, bx1, by1 < ty0 ? by1 : ty0 },                       /* above */
+				{ bx0, by0 > ty1 ? by0 : ty1, bx1, by1 },                       /* below */
+				{ bx0, my0, bx1 < tx0 ? bx1 : tx0, my1 },                       /* left */
+				{ bx0 > tx1 ? bx0 : tx1, my0, bx1, my1 },                       /* right */
+			};
+			for (unsigned c = 0; c < 4; c++) {
+				if (sweet_fb_part(this, src, s, sx, sy, aw, ah, dx, dy, w, h, cut[c][0], cut[c][1], cut[c][2],
+				    cut[c][3], &blits[nblits])) {
+					nblits++;
+				}
+			}
+		}
+		s->release();
+	}
+	if (nblits == 0) {
+		sweet_fb_stats.gpu_skip[4]++;
+		return 0;
+	}
+	uint64_t dst = sweet_fbgpu.win + FBGPU_PANEL_OFF;
+	uint64_t border = sweet_fbgpu.win + 2 * FBGPU_IB_BYTES, ts = border + 0x100;
+	uint32_t *dw = sweet_fbgpu.ib[k], n = 0;
+#define EV(e)           do { dw[n++] = fbgpu_pkt7(0x46, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)        do { dw[n++] = fbgpu_pkt7(0x46, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; \
+	                     dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)       do { dw[n++] = fbgpu_pkt4((r), 1); dw[n++] = (v); } while (0)
+	EV(0x31);                               /* CACHE_INVALIDATE */
+	REG(0xbb08, 0xfffff);                   /* SP_UPDATE_CNTL */
+	dw[n++] = fbgpu_pkt7(0x26, 0);          /* CP_WAIT_FOR_IDLE */
+	for (unsigned i = 0; i < sizeof(fbgpu_init) / sizeof(fbgpu_init[0]); i++) {
+		REG(fbgpu_init[i][0], fbgpu_init[i][1]);
+	}
+	dw[n++] = fbgpu_pkt4(0xb302, 2);        /* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = fbgpu_pkt4(0xb180, 2);        /* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	EV(0x19);                               /* PC_CCU_INVALIDATE_COLOR */
+	EV(0x31);
+	dw[n++] = fbgpu_pkt7(0x26, 0);
+	REG(0x8c01, 0);                         /* RB_A2D_PIXEL_CNTL: no blend */
+	REG(0x8c00, 0x00f03000);                /* RB_A2D_BLT_CNTL: 8888 UNORM, mask f */
+	REG(0x8400, 0x00f03000);                /* GRAS_A2D_BLT_CNTL */
+	REG(0xacc0, 0xf180);                    /* SP_A2D_OUTPUT_INFO */
+	for (unsigned j = 0; j < nblits; j++) {
+		const struct sweet_fb_blit *o = &blits[j];
+		dw[n++] = fbgpu_pkt4(0x8405, 2);        /* GRAS_A2D_DEST_TL, _BR (inclusive) */
+		dw[n++] = o->px0 | (o->py0 << 16);
+		dw[n++] = (o->px1 - 1) | ((o->py1 - 1) << 16);
+		dw[n++] = fbgpu_pkt4(0x8401, 4);        /* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+		dw[n++] = o->sx0;
+		dw[n++] = o->sx1;
+		dw[n++] = o->sy0;
+		dw[n++] = o->sy1;
+		dw[n++] = fbgpu_pkt4(0xb4c0, 5);        /* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+		dw[n++] = 0x00500430 | 0x10000;         /* 8888, linear, WXYZ; bilinear */
+		dw[n++] = o->sw | (o->sh << 15);
+		dw[n++] = (uint32_t)o->src;
+		dw[n++] = (uint32_t)(o->src >> 32);
+		dw[n++] = o->spitch << 3;
+		dw[n++] = fbgpu_pkt4(0xb4ca, 3);        /* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+		dw[n++] = (uint32_t)o->src;
+		dw[n++] = (uint32_t)(o->src >> 32);
+		dw[n++] = 0;
+		dw[n++] = fbgpu_pkt4(0x8c17, 4);        /* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+		dw[n++] = 0x430;
+		dw[n++] = (uint32_t)dst;
+		dw[n++] = (uint32_t)(dst >> 32);
+		dw[n++] = fRowBytes >> 6;
+		dw[n++] = fbgpu_pkt4(0x8c20, 3);        /* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+		dw[n++] = (uint32_t)dst;
+		dw[n++] = (uint32_t)(dst >> 32);
+		dw[n++] = 0;
+		dw[n++] = fbgpu_pkt7(0x2c, 1);          /* CP_BLIT */
+		dw[n++] = 3;                            /* BLIT_OP_SCALE */
+	}
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	EV_TS(0x1c);                            /* PC_CCU_FLUSH_DEPTH_TS */
+	EV_TS(0x04);                            /* CACHE_FLUSH_TS */
+#undef EV
+#undef EV_TS
+#undef REG
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t iova = sweet_fbgpu.win + (uint64_t)k * FBGPU_IB_BYTES;
+	bool busy = false;
+	uint32_t fence = sweet_gpu_submit_v2(&iova, &n, 1, &busy);
+	if (fence == 0) {
+		return busy ? -1 : 0;
+	}
+	sweet_fbgpu.fence[k] = fence;
+	sweet_fbgpu.next = k ^ 1;
+	if (layers > 1) {
+		sweet_fb_stats.top_only++;
+	}
+	static bool said, said2;
+	if (!said || (layers > 1 && nblits > 1 && !said2)) {
+		said = true;
+		said2 = said2 || (layers > 1 && nblits > 1);
+		IOLog("SWEET FB: GPU present: %u layer(s), %u blit(s), first -> panel %u,%u-%u,%u (%u dwords, fence %u)\n",
+		    layers, nblits, blits[0].px0, blits[0].py0, blits[0].px1, blits[0].py1, n, fence);
+	}
+	return 1;
+}
+
+/*
+ * 0170: alpha of a layer's source rectangle, sampled on an 8x8 grid: how many samples are 0, 255, between.
+ * CoreAnimation's surfaces are premultiplied BGRA. An upper layer whose samples are all 0 carries no alpha
+ * at all (an opaque Metal drawable may leave it 0): it is drawn opaque, not blended away.
+ */
+static void
+sweet_fb_alpha_samples(const uint8_t *base, uint32_t bpr, int32_t sx, int32_t sy, int32_t sw, int32_t sh,
+    uint32_t *zero, uint32_t *full, uint32_t *part)
+{
+	*zero = *full = *part = 0;
+	for (int32_t j = 0; j < 8; j++) {
+		const uint32_t *row = (const uint32_t *)(base + (uint64_t)(sy + (sh * (2 * j + 1)) / 16) * bpr);
+		for (int32_t i = 0; i < 8; i++) {
+			uint32_t alpha = row[sx + (sw * (2 * i + 1)) / 16] >> 24;
+			if (alpha == 0) {
+				(*zero)++;
+			} else if (alpha == 255) {
+				(*full)++;
+			} else {
+				(*part)++;
+			}
+		}
+	}
+}
+
+/* premultiplied source-over, one channel pair at a time (a = 1..254) */
+static inline uint32_t
+sweet_fb_over(uint32_t src, uint32_t dst)
+{
+	uint32_t inv = 255u - (src >> 24);
+	uint32_t rb = (dst & 0x00ff00ffu) * inv;
+	uint32_t ag = ((dst >> 8) & 0x00ff00ffu) * inv;
+	rb = ((rb + 0x00800080u + ((rb >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+	ag = ((ag + 0x00800080u + ((ag >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+	uint32_t out = rb | (ag << 8);
+	/* add the source with per-channel saturation */
+	uint32_t sum = 0;
+	for (unsigned c = 0; c < 32; c += 8) {
+		uint32_t v = ((out >> c) & 0xffu) + ((src >> c) & 0xffu);
+		sum |= (v > 255u ? 255u : v) << c;
+	}
+	return sum;
+}
+
+static uint32_t sweet_fb_comp_logged;
+
+/*
+ * 0170: a frame of two or more layers (or one whose source and destination sizes differ), composed in the
+ * cached fCompose from the highest layer index up (0171: the record's layer 0 is the top), then copied once into the panel memory,
+ * scaled by fColMap. False: not for this path (present() shows it).
+ */
+bool
+AppleCLCD::presentComposed(const uint8_t *rec)
+{
+	if (!sweet_fb_compose || !fScaleUp || fColMap == NULL) {
+		return false;
+	}
+	uint32_t mask = get32(rec, 0x104), layers = 0;
+	bool scaled = false;
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			layers++;
+			const uint8_t *a = rec + 0x64 + 16 * l, *b = rec + 0xc4 + 16 * l;
+			if (get32(a, 8) != 0 && get32(a, 12) != 0 && (get32(a, 8) != get32(b, 8) || get32(a, 12) != get32(b, 12))) {
+				scaled = true;
+			}
+		}
+	}
+	if (layers == 0 || (layers == 1 && !scaled)) {
+		return false;
+	}
+	if (fCompose == NULL) {
+		fCompose = (uint32_t *)IOMallocData((vm_size_t)fLogicalW * fLogicalH * 4);
+		fComposeX = (uint32_t *)IOMallocData((vm_size_t)fLogicalW * 4);
+		if (fCompose == NULL || fComposeX == NULL) {
+			IOLog("SWEET FB: no memory to compose frames: layers pasted as before\n");
+			sweet_fb_compose = false;
+			return false;
+		}
+	}
+	pauseConsole();
+	uint64_t began = mach_absolute_time();
+	bzero(fCompose, (size_t)fLogicalW * fLogicalH * 4);
+	bool log = sweet_fb_comp_logged < 12 || (sweet_fb_stats.composed == 0 && sweet_fb_comp_logged < 200);
+	if (log) {
+		sweet_fb_comp_logged++;
+	}
+	bool first = true;
+	for (uint32_t n = 0; n < SWEET_FB_LAYERS; n++) {
+		/* 0185: drawn bottom first: layer 0 first when the higher index is on top (0171: the reverse) */
+		uint32_t l = sweet_fb_high_on_top ? n : SWEET_FB_LAYERS - 1 - n;
+		uint32_t id = get32(rec, 0x54 + 4 * l);
+		if (!(mask & (1u << l)) || id == 0) {
+			continue;
+		}
+		const uint8_t *a = rec + 0x64 + 16 * l, *b = rec + 0xc4 + 16 * l;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t dw = (int32_t)get32(b, 8), dh = (int32_t)get32(b, 12);
+		SweetSurface *s = sweet_surface_copy(id);
+		uintptr_t src = s != NULL ? s->kernelAddress() : 0;
+		if (s != NULL && (sw <= 0 || sh <= 0)) {
+			sw = (int32_t)s->width;
+			sh = (int32_t)s->height;
+		}
+		if (dw <= 0 || dh <= 0) {
+			dw = sw;
+			dh = sh;
+		}
+		bool ok = s != NULL && s != fSurface && src != 0 && s->memory != NULL && s->elementWidth == 1 &&
+		    s->elementHeight == 1 && (s->bytesPerElement == 4 || s->bytesPerElement == 0) && sx >= 0 && sy >= 0 &&
+		    sw > 0 && sh > 0 && sx + sw <= (int32_t)s->width && sy + sh <= (int32_t)s->height &&
+		    (uint64_t)s->offset + (uint64_t)(sy + sh - 1) * s->bytesPerRow + (uint64_t)(sx + sw) * 4 <= s->memory->getLength();
+		uint32_t zero = 0, full = 0, part = 0;
+		bool blend = false;
+		if (ok) {
+			s->memory->performOperation(kIOMemoryIncoherentIOFlush, 0, s->memory->getLength());
+			const uint8_t *base = (const uint8_t *)(src + s->offset);
+			sweet_fb_alpha_samples(base, s->bytesPerRow, sx, sy, sw, sh, &zero, &full, &part);
+			/* 0172: a layer flagged opaque is copied, its alpha ignored */
+			bool flagged = sweet_fb_opaque_flag && rec[0x467 + l] != 0;
+			blend = !first && !flagged && full != 64;
+			if (!first && !flagged && zero == 64) {
+				/* 0185: an upper layer with nothing visible is left out (0170 drew it opaque: black) */
+				sweet_fb_stats.comp_skipped++;
+				OSSafeReleaseNULL(s);
+				continue;
+			}
+			/* destination clipped to the logical display; each kept column/row maps back to the source */
+			int32_t x0 = dx < 0 ? 0 : dx, y0 = dy < 0 ? 0 : dy;
+			int32_t x1 = dx + dw > (int32_t)fLogicalW ? (int32_t)fLogicalW : dx + dw;
+			int32_t y1 = dy + dh > (int32_t)fLogicalH ? (int32_t)fLogicalH : dy + dh;
+			if (x1 <= x0 || y1 <= y0) {
+				x1 = x0;
+				y1 = y0;                /* off the display: nothing to draw */
+			}
+			for (int32_t x = x0; x < x1; x++) {
+				fComposeX[x] = (uint32_t)(sx + (int32_t)(((int64_t)(x - dx) * sw) / dw));
+			}
+			for (int32_t y = y0; y < y1; y++) {
+				const uint32_t *srow = (const uint32_t *)(base +
+				    (uint64_t)(sy + (int32_t)(((int64_t)(y - dy) * sh) / dh)) * s->bytesPerRow);
+				uint32_t *drow = fCompose + (uint64_t)y * fLogicalW;
+				if (!blend) {
+					if (sw == dw) {
+						memcpy(drow + x0, srow + fComposeX[x0], (size_t)(x1 - x0) * 4);
+					} else {
+						for (int32_t x = x0; x < x1; x++) {
+							drow[x] = srow[fComposeX[x]];
+						}
+					}
+					continue;
+				}
+				for (int32_t x = x0; x < x1; x++) {
+					uint32_t p = srow[fComposeX[x]];
+					uint32_t alpha = p >> 24;
+					if (alpha == 255u) {
+						drow[x] = p;
+					} else if (alpha != 0) {
+						drow[x] = sweet_fb_over(p, drow[x]);
+					}
+				}
+			}
+			if (blend) {
+				sweet_fb_stats.comp_blend++;
+			} else {
+				sweet_fb_stats.comp_opaque++;
+			}
+			first = false;
+		} else {
+			sweet_fb_stats.comp_skipped++;
+		}
+		if (log) {
+			/* per-layer flag bytes as kern_SwapSetLayer sets them (NOTES 2026-10-17), transform */
+			IOLog("SWEET FB: compose swap %u layer %u surface %u %ux%u fmt 0x%x bpe %u bpr %u a %d,%d %dx%d b %d,%d %dx%d "
+			    "xform %u flags %02x %02x %02x %02x %02x %02x alpha 0:%u 255:%u mid:%u -> %s\n",
+			    get32(rec, 0x50), l, id, s ? s->width : 0, s ? s->height : 0, s ? s->pixelFormat : 0,
+			    s ? s->bytesPerElement : 0, s ? s->bytesPerRow : 0, sx, sy, sw, sh, dx, dy, dw, dh,
+			    get32(rec, 0x114 + 4 * l), rec[0x2ca + l], rec[0x2cc + l], rec[0x2e3 + l], rec[0x2e5 + l],
+			    rec[0x2e6 + l], rec[0x467 + l], zero, full, part, !ok ? "skipped" : blend ? "blended" : "opaque");
+		}
+		OSSafeReleaseNULL(s);
+	}
+	/* a GPU blit of an earlier frame still running would land on top of this one later */
+	for (unsigned k = 0; k < 2; k++) {
+		if (sweet_fbgpu.fence[k] != 0 && sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 0) != 0) {
+			sweet_fb_stats.comp_gpu_wait++;
+			(void)sweet_gpu_wait_fence_ns(sweet_fbgpu.fence[k], 50000000ull);
+		}
+	}
+	for (uint32_t py = 0; py < fHeight; py++) {
+		uint32_t ly = (uint32_t)(((uint64_t)py * fLogicalH) / fHeight);
+		const uint32_t *srow = fCompose + (uint64_t)ly * fLogicalW;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = 0; px < fWidth; px++) {
+			drow[px] = srow[fColMap[px]];
+		}
+	}
+	sweet_fb_stats.composed++;
+	sweet_fb_stats.comp_time += mach_absolute_time() - began;
+	return true;
+}
+
+void
+AppleCLCD::present(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+
+
+	pauseConsole();
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (sweet_fb_swaps_logged < 16) {
+			sweet_fb_swaps_logged++;
+			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		if ((s->drawn != 0 || sweet_fb_metal) && s->memory != NULL) {
+			/*
+			 * 0131: the GPU draws into surfaces (RedwoodGPU) past this processor's cache;
+			 * what the cache still holds of this one is older than the memory. 0145: Metal's
+			 * draws (Turnip, through 0144's imports) do not mark the surface: every one then.
+			 */
+			s->memory->performOperation(kIOMemoryIncoherentIOFlush, 0, s->memory->getLength());
+		}
+		if (fScaleUp) {
+			presentScaled(s, sx, sy, dx, dy, w, h);
+			s->release();
+			continue;
+		}
+		/* Logical (presented) display coordinates -> panel coordinates. */
+		dx -= fOffX;
+		dy -= fOffY;
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fWidth - dx) {
+			w = (int32_t)fWidth - dx;
+		}
+		if (h > (int32_t)fHeight - dy) {
+			h = (int32_t)fHeight - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0 && bpe == 4) {
+			for (int32_t y = 0; y < h; y++) {
+				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
+				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
+				    (size_t)w * 4);
+			}
+		}
+		s->release();
+	}
+}
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= SWEET_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	if (type == SWEET_FB_NOTIFY_VSYNC) {
+		sweet_fb_stats.vsync_sent++;
+	}
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	if (selector < 128) {
+		sweet_fb_stats.sel[selector]++;           /* 0153 */
+	}
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kSweetFBGetLayerDefaultSurface:
+		out[0] = sweet_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kSweetFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kSweetFBSwapEnd: {
+		uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL ||
+		    args->structureInputSize < SWEET_FB_SWAP_REC_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(rec, args->structureInput, sizeof(rec));
+		fFB->swap(rec);
+		break;
+	}
+	case kSweetFBGetID:
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kSweetFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kSweetFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kSweetFBGetDotPitch:
+		out[0] = SWEET_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kSweetFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < SWEET_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("SWEET FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		}
+		break;
+	case kSweetFBRequestPowerChange:
+		if (args->scalarInputCount >= 1) {
+			bool off = args->scalarInput[0] == 0;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				fFB->fFadeStep = 0;
+				fFB->fDirty = true;     /* on: redraw the latest frame */
+			}
+			IOLockUnlock(fFB->fLock);
+			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
+		}
+		break;
+	case kSweetFBSwapWait:
+		/*
+		 * 0169: [swap id, timeout, 0]: back once that swap is on the panel (or queued on the GPU behind its
+		 * drawing), so CoreAnimation does not draw into a surface the display still has to read. At most
+		 * 50 ms whatever the timeout says (its unit is not known); a swap never begun returns at once.
+		 */
+		if (sweet_fb_sync && args->scalarInputCount >= 1) {
+			uint32_t want = (uint32_t)args->scalarInput[0];
+			AbsoluteTime deadline;          /* a UInt64 on arm64; filled through its address either way */
+			clock_interval_to_deadline(50, NSEC_PER_MSEC, (uint64_t *)&deadline);
+			sweet_fb_stats.swapwait++;
+			IOLockLock(fFB->fLock);
+			while (want != 0 && (int32_t)(fFB->fSwapID - want) >= 0 && !fFB->fPowerOff &&
+			    (int32_t)(fFB->fShownSwapID - want) < 0) {
+				if (IOLockSleepDeadline(fFB->fLock, &fFB->fShownSwapID, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+					sweet_fb_stats.swapwait_to++;
+					break;
+				}
+			}
+			IOLockUnlock(fFB->fLock);
+		}
+		break;
+	default:
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(sweet_fb_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_fb_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret);
+	}
+	return ret;
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetGPUABI.h ci-sweet/iokit/Kernel/arm/SweetGPUABI.h
--- a/iokit/Kernel/arm/SweetGPUABI.h	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetGPUABI.h	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_ABI_H
+#define NATIVE_ADRENO_ABI_H
+#include <stdint.h>
+
+/* Versioned kernel/user-client wire ABI for the native Adreno driver. This is
+ * NOT the Metal, IOKit or Turnip ABI and it does not describe an ioctl. The
+ * IOKit service will copy exactly these fixed-size records across its external
+ * methods. All fields are little endian; both participants are ARM64. Every
+ * array is inside one fixed record so a caller cannot pass a length that
+ * disagrees with the storage. Unknown versions, methods and flags are refused
+ * rather than ignored. */
+enum {
+    NativeAdrenoAbiVersion = 1,
+    NativeAdrenoAbiMaxBuffers = 16,
+    NativeAdrenoAbiMaxBoBytesShift = 28, /* 256MiB per object */
+    NativeAdrenoMethodQuery = 1,
+    NativeAdrenoMethodBoAlloc = 2,
+    NativeAdrenoMethodBoMap = 3,
+    NativeAdrenoMethodBoFree = 4,
+    NativeAdrenoMethodSubmit = 5,
+    NativeAdrenoMethodWaitFence = 6,
+    NativeAdrenoMethodGetTimestamp = 7,
+    NativeAdrenoMethodGetStatus = 8,
+    NativeAdrenoMethodSetMetadata = 9,
+    NativeAdrenoMethodGetMetadata = 10,
+    NativeAdrenoMethodCreateQueue = 11,
+    NativeAdrenoMethodCloseQueue = 12,
+    NativeAdrenoMethodBoCpuMap = 13,
+    NativeAdrenoMethodBoCpuUnmap = 14,
+    NativeAdrenoMethodGetDeviceInfo = 15,
+    NativeAdrenoMethodBoImport = 16,
+    NativeAdrenoAbiMetadataBytes = 64,
+    NativeAdrenoAbiMaxQueues = 8
+};
+struct NativeAdrenoAbiParams {
+    uint32_t abi_version;
+    uint32_t input_bits;          /* GPU VA bits below 2^input_bits */
+    uint32_t output_bits;         /* physical address bits */
+    uint32_t flags;               /* NativeAdrenoParamsHostImport or zero */
+    uint64_t max_bo_bytes;
+};
+enum {
+    NativeAdrenoParamsHostImport = 1  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+};
+struct NativeAdrenoAbiBoAlloc {
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+    uint32_t align_log2;          /* 12..24 */
+    uint32_t contiguous;          /* 1 requires one raw physical span */
+};
+struct NativeAdrenoAbiBoAllocReply {
+    uint64_t handle;              /* opaque to userspace, nonzero */
+};
+/* Pins [address, address + bytes) of the CALLING task and makes it a BO (reply: NativeAdrenoAbiBoAllocReply). The pages stay wired
+ * until BoFree; they keep the caller's own CPU mapping and cache mode, so the caller cleans its caches before GPU use and invalidates
+ * them after GPU writes (the GPU maps them non-cacheable). An imported BO has no CPU-map token. */
+struct NativeAdrenoAbiBoImport {
+    uint64_t address;             /* 4KiB aligned */
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+};
+struct NativeAdrenoAbiBoMap {
+    uint64_t handle;
+    uint64_t iova;                /* 4KiB aligned, inside the mounted aperture */
+    uint32_t permissions;         /* bit0 read, bit1 write; read required */
+    uint32_t writeback;           /* 0 normal non-coherent, 1 WB/WA */
+    uint32_t shareability;        /* 2 outer, 3 inner */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiBoMapReply {
+    uint64_t iova;
+};
+struct NativeAdrenoAbiBoFree {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    uint64_t bytes;               /* 4-byte multiple, dword count = bytes/4 */
+};
+struct NativeAdrenoAbiSubmit {
+    uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
+    uint32_t reserved;            /* zero */
+    uint64_t queue;               /* open queue; 0 is created by open() */
+    uint64_t wait_fence;          /* zero or an earlier fence of this client */
+    uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
+    NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+};
+struct NativeAdrenoAbiMetadata {
+    uint64_t handle;              /* object identity */
+    uint32_t bytes;               /* set: length; get: requested capacity */
+    uint32_t reserved;            /* zero */
+    char text[NativeAdrenoAbiMetadataBytes]; /* raw bytes, not NUL terminated */
+};
+struct NativeAdrenoAbiSubmitReply {
+    uint64_t fence;               /* nonzero CP timestamp value */
+};
+struct NativeAdrenoAbiWaitFence {
+    uint64_t fence;
+    uint64_t timeout_ns;          /* 0 polls once */
+};
+struct NativeAdrenoAbiTimestamp {
+    uint64_t ticks;               /* GPU always-on counter value */
+};
+struct NativeAdrenoAbiBoCpuMap {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiBoCpuMapReply {
+    uint32_t token;               /* clientMemoryForType selector */
+    uint32_t reserved;            /* zero */
+    uint64_t bytes;               /* bytes the mapping covers */
+};
+struct NativeAdrenoAbiBoCpuUnmap {
+    uint64_t handle;
+    uint32_t token;               /* exactly the token returned by map */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiQueue {
+    uint64_t queue;               /* zero for create, an open id for close */
+};
+struct NativeAdrenoAbiQueueReply {
+    uint64_t queue;               /* nonzero id of the created queue */
+};
+struct NativeAdrenoAbiStatus {
+    uint64_t faults;              /* monotonic; change means context lost */
+    uint64_t suspends;            /* monotonic suspend/reset count */
+};
+/* Fixed facts of the mounted GPU that the Vulkan driver needs and cannot derive: all come from the board code, which takes
+ * them from the pinned sources (a6xx catalog, UBWC config, the programmed UCHE ranges), never from a guess. */
+enum {
+    NativeAdrenoDeviceClientIova = 1,     /* flags: the client chooses BO addresses (BoMap iova) */
+    NativeAdrenoDeviceCachedCoherent = 2  /* flags: unused until IO-coherent BO memory exists */
+};
+struct NativeAdrenoAbiDeviceInfo {
+    uint32_t chip_id;             /* ADRENO_CHIPID, e.g. 0x43050a01 */
+    uint32_t gmem_bytes;
+    uint64_t gmem_base;           /* UCHE GMEM window start (GPU address) */
+    uint64_t uche_trap_base;
+    uint64_t va_start;            /* first GPU address the client may map */
+    uint64_t va_size;
+    uint32_t highest_bank_bit;
+    uint32_t ubwc_swizzle;        /* bit0 level 1, bit1 level 2, bit2 level 3 */
+    uint32_t macrotile_mode;      /* 0 four channel, 1 eight channel */
+    uint32_t ubwc_version;        /* encoder version, 4 for UBWC 4.0 */
+    uint32_t flags;
+    uint32_t reserved;            /* zero */
+};
+#if defined(__cplusplus)
+static_assert(sizeof(NativeAdrenoAbiDeviceInfo) == 64, "ABI device info layout");
+static_assert(sizeof(NativeAdrenoAbiParams) == 24, "ABI params layout");
+static_assert(sizeof(NativeAdrenoAbiBoAlloc) == 16, "ABI alloc layout");
+static_assert(sizeof(NativeAdrenoAbiBoMap) == 32, "ABI map layout");
+static_assert(sizeof(NativeAdrenoAbiBoImport) == 16, "ABI import layout");
+static_assert(sizeof(NativeAdrenoAbiSubmitBuffer) == 24, "ABI buffer layout");
+static_assert(sizeof(NativeAdrenoAbiSubmit) == 416, "ABI submit layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMap) == 8, "ABI cpu map layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMapReply) == 16, "ABI cpu map reply layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuUnmap) == 16, "ABI cpu unmap layout");
+static_assert(sizeof(NativeAdrenoAbiQueue) == 8, "ABI queue layout");
+static_assert(sizeof(NativeAdrenoAbiQueueReply) == 8, "ABI queue reply layout");
+static_assert(sizeof(NativeAdrenoAbiMetadata) == 80, "ABI metadata layout");
+static_assert(sizeof(NativeAdrenoAbiWaitFence) == 16, "ABI wait layout");
+static_assert(sizeof(NativeAdrenoAbiTimestamp) == 8, "ABI timestamp layout");
+static_assert(sizeof(NativeAdrenoAbiStatus) == 16, "ABI status layout");
+#endif
+#endif
diff -ruN ci-base/iokit/Kernel/arm/SweetIPAppender.cpp ci-sweet/iokit/Kernel/arm/SweetIPAppender.cpp
--- a/iokit/Kernel/arm/SweetIPAppender.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetIPAppender.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,92 @@
+/*
+ * 0253: a stand-in AppleIPAppender for CommCenter (research/commcenter).
+ *
+ * CommCenter's ApplePDPHelper looks this service up (Apple: the baseband IP data path's packet appender); without
+ * it, it logs "Could not find AppleIPAppender service" and its AQMController queue then dereferences NULL (sig 11),
+ * so CommCenter crash-loops. Every crash leaves CoreTelephony clients waiting: Settings > Sounds stalls ~1.2 s on
+ * -[SHSSoundsPrefController refreshShouldHideAllVoicemailUI] until the connection breaks (2026-11-10 log).
+ * There is no baseband here: this service only exists, and its user client accepts every call with zeroed
+ * outputs (as IOWatchdog, 0040); each selector is logged the first time, to learn what CommCenter expects.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class AppleIPAppender : public IOService {
+	OSDeclareDefaultStructors(AppleIPAppender);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppender, IOService);
+
+bool
+AppleIPAppender::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleIPAppenderUserClient");
+	registerService();
+	IOLog("SWEET IPAPPENDER: AppleIPAppender registered (stand-in for CommCenter, no baseband)\n");
+	return true;
+}
+
+class AppleIPAppenderUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleIPAppenderUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppenderUserClient, IOUserClient);
+
+IOReturn
+AppleIPAppenderUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_ipa_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+AppleIPAppenderUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(sweet_ipa_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_ipa_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET IPAPPENDER: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetKeyStore.cpp ci-sweet/iokit/Kernel/arm/SweetKeyStore.cpp
--- a/iokit/Kernel/arm/SweetKeyStore.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,284 @@
+/*
+ * Built-in AppleKeyStore for SWEET: a device without a passcode whose
+ * system keybag is always loaded and unlocked.
+ *
+ * Apple's AppleKeyStore kext (closed, SEP-backed) owns the keybags behind
+ * data protection. libaks (AppleKeyStore.framework, statically in keybagd)
+ * opens IOServiceMatching("AppleKeyStore") with type 0, calls selector 0,
+ * then one selector per aks_* function (iOS 16.7 numbering below). keybagd
+ * --init asks for the system bag (14) and only loads systembag.kb when the
+ * answer is kIOReturnNotFound; answering with a handle is the path a
+ * userspace reboot takes, so no bag file is needed.
+ *
+ * Every call is logged (selector, caller, argument shapes, result) so the
+ * next selectors the system needs show up on the console; unknown ones fail
+ * with kIOReturnUnsupported.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+/* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
+enum {
+	kAKSOpen             = 0,
+	kAKSCreateBag        = 2,
+	kAKSSaveBag          = 3,
+	kAKSUnloadBag        = 4,
+	kAKSSetSystem        = 5,
+	kAKSLoadBag          = 6,
+	kAKSGetLockState     = 7,
+	kAKSUnlockDevice     = 9,
+	kAKSWrapKey          = 10,
+	kAKSUnwrapKey        = 11,
+	kAKSUnlockBag        = 12,
+	kAKSLockBag          = 13,
+	kAKSGetSystem        = 14,
+	kAKSGetDeviceState   = 17,
+	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	kAKSAssertHold       = 26,
+	kAKSAssertDrop       = 27,
+	kAKSUnloadSessionBags = 55,
+	kAKSNotifyStateSet   = 102,
+	kAKSNotifyStateIsSet = 103,
+	kAKSAssertConsume    = 101,     /* aks_assert_consume */
+};
+
+/* The system (device) bag handle. */
+#define SWEET_AKS_SYSTEM_HANDLE 0
+
+/*
+ * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
+ * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ */
+#define SWEET_AKS_LOCK_STATE    0x4
+
+class AppleKeyStore : public IOService {
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	registerService();
+	IOLog("SWEET AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Copy len bytes to the caller's output structure (inband or descriptor). */
+static IOReturn
+sweet_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (short forms only). */
+static uint32_t
+sweet_aks_der_pair(uint8_t *p, const char *key, uint8_t value)
+{
+	uint32_t klen = (uint32_t)strlen(key);
+	uint32_t n = 0;
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 3);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = 0x01;
+	p[n++] = value;
+	return n;
+}
+
+/*
+ * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
+ * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
+ * 0 = unlocked), sb backoff, sfa failed attempts, sgs generation, sas
+ * assertions, sgpe grace period, srcd recovery countdown.
+ */
+static IOReturn
+sweet_aks_device_state(IOExternalMethodArguments *args)
+{
+	static const struct {
+		const char *key;
+		uint8_t value;
+	} fields[] = {
+		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
+	};
+	uint8_t buf[128];
+	uint32_t n = 2;
+	for (unsigned int i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+		n += sweet_aks_der_pair(buf + n, fields[i].key, fields[i].value);
+	}
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return sweet_aks_struct_out(args, buf, n);
+}
+
+static uint32_t
+sweet_aks_struct_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = sweet_aks_struct_out_size(args);
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kAKSOpen:
+	case kAKSUnloadBag:
+	case kAKSSetSystem:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSLockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertConsume:
+	case kAKSUnloadSessionBags:
+	case kAKSNotifyStateSet:
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSGetSystem:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_SYSTEM_HANDLE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetLockState:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_LOCK_STATE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSNotifyStateIsSet:
+		/* Nothing was ever set: answer "not set". */
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = 0;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetDeviceState:
+	case kAKSGetExtDeviceState:
+		args->scalarOutputCount = 0;
+		ret = sweet_aks_device_state(args);
+		break;
+	/*
+	 * (from HackiOS, via ios-flame 0123) kAKSWrapKey / kAKSUnwrapKey: securityd wraps each keychain item's key with
+	 * its protection class before storing it. No SEP, no secret: a mark, the class and the key
+	 * mixed with a fixed pattern, 8 bytes longer like AES key wrap. Without them no keychain item
+	 * (wifid's network passwords among them) could be stored.
+	 */
+	case kAKSWrapKey: {
+		uint8_t wrapped[8 + 64];
+		size_t len = args->structureInputSize;
+		if (args->structureInput == NULL || len == 0 || len > 64 || in_scalars < 2) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(wrapped, "HKwr", 4);
+		wrapped[4] = (uint8_t)args->scalarInput[1];
+		wrapped[5] = wrapped[6] = wrapped[7] = 0;
+		memcpy(wrapped + 8, args->structureInput, len);
+		for (size_t i = 0; i < len; i++) {
+			wrapped[8 + i] ^= (uint8_t)(0x5a + 37 * i);
+		}
+		if (out_scalars >= 1) {
+			args->scalarOutput[0] = args->scalarInput[1];
+			args->scalarOutputCount = 1;
+		}
+		ret = sweet_aks_struct_out(args, wrapped, (uint32_t)(8 + len));
+		break;
+	}
+	case kAKSUnwrapKey: {
+		uint8_t key[64];
+		const uint8_t *w = (const uint8_t *)args->structureInput;
+		size_t len = args->structureInputSize;
+		if (w == NULL || len <= 8 || len > 8 + sizeof(key) || memcmp(w, "HKwr", 4) != 0) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(key, w + 8, len - 8);
+		for (size_t i = 0; i < len - 8; i++) {
+			key[i] ^= (uint8_t)(0x5a + 37 * i);
+		}
+		args->scalarOutputCount = 0;
+		ret = sweet_aks_struct_out(args, key, (uint32_t)(len - 8));
+		break;
+	}
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetM2Scaler.cpp ci-sweet/iokit/Kernel/arm/SweetM2Scaler.cpp
--- a/iokit/Kernel/arm/SweetM2Scaler.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetM2Scaler.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,206 @@
+/*
+ * CPU stand-in for Apple's AppleM2ScalerCSCDriver / IOSurfaceAccelerator.
+ *
+ * IOSurfaceAccelerator.framework opens the service with type 0 and sends
+ * selector 1 via IOConnectCallStructMethod. The ordinary request contains
+ * destination/source IOSurface IDs at byte offsets 0 and 4; the request is
+ * 0x170 bytes. This fallback intentionally implements the common full-surface
+ * copy/scale path. It supports packed 32-bit BGRA/RGBA and 420f/420v input
+ * converted to packed output. Unknown options/rect encodings are logged and
+ * rejected instead of silently corrupting a surface.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+#include "SweetSurface.h"
+
+class AppleM2ScalerCSCDriver : public IOService {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+    setProperty(kIOUserClientClassKey, "AppleM2ScalerCSCDriverUserClient");
+    setProperty("IONameMatched", "AppleM2ScalerCSCDriver");
+    registerService();
+    IOLog("SWEET SCALER: AppleM2ScalerCSCDriver registered (CPU fallback)\n");
+    return true;
+}
+
+class AppleM2ScalerCSCDriverUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriverUserClient);
+public:
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+        IOExternalMethodDispatch *dispatch, OSObject *target,
+        void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriverUserClient, IOUserClient);
+
+static uint32_t sweet_scaler_log_count;
+static inline uint32_t
+sweet_scaler_u32(const uint8_t *p)
+{
+    uint32_t v;
+    bcopy(p, &v, sizeof(v));
+    return v;
+}
+
+static inline bool
+sweet_scaler_fourcc(uint32_t f, char a, char b, char c, char d)
+{
+    return f == (((uint32_t)(uint8_t)a << 24) | ((uint32_t)(uint8_t)b << 16) |
+        ((uint32_t)(uint8_t)c << 8) | (uint32_t)(uint8_t)d);
+}
+
+static uint8_t
+sweet_scaler_clamp(int v)
+{
+    return (uint8_t)(v < 0 ? 0 : (v > 255 ? 255 : v));
+}
+
+static bool
+sweet_scaler_convert(SweetSurface *src, SweetSurface *dst)
+{
+    if (src == NULL || dst == NULL || !src->width || !src->height ||
+        !dst->width || !dst->height || src->width > 16384 || src->height > 16384 ||
+        dst->width > 16384 || dst->height > 16384) return false;
+    uintptr_t sb = src->kernelAddress(), db = dst->kernelAddress();
+    if (!sb || !db) return false;
+    bool srcBGRA = sweet_scaler_fourcc(src->pixelFormat, 'B','G','R','A');
+    bool srcRGBA = sweet_scaler_fourcc(src->pixelFormat, 'R','G','B','A');
+    bool src420f = sweet_scaler_fourcc(src->pixelFormat, '4','2','0','f');
+    bool src420v = sweet_scaler_fourcc(src->pixelFormat, '4','2','0','v');
+    bool dstBGRA = sweet_scaler_fourcc(dst->pixelFormat, 'B','G','R','A');
+    bool dstRGBA = sweet_scaler_fourcc(dst->pixelFormat, 'R','G','B','A');
+    if ((!srcBGRA && !srcRGBA && !src420f && !src420v) || (!dstBGRA && !dstRGBA)) return false;
+
+    uint32_t sw = src->width, sh = src->height, dw = dst->width, dh = dst->height;
+    uint32_t sp = src->bytesPerRow, dp = dst->bytesPerRow;
+    if (srcBGRA || srcRGBA) {
+        if (sp < sw * 4 || dp < dw * 4) return false;
+    } else {
+        if (src->planeCount < 2 || src->planes[0].bytesPerRow < sw ||
+            src->planes[1].bytesPerRow < ((sw + 1) & ~1u)) return false;
+    }
+    uint8_t *s = (uint8_t *)sb + src->offset;
+    uint8_t *d = (uint8_t *)db + dst->offset;
+    uint64_t srcEnd, dstEnd;
+    uint64_t srcRowBytes = (srcBGRA || srcRGBA) ? (uint64_t)sw * 4 : sw;
+    uint64_t dstRowBytes = (uint64_t)dw * 4;
+    if (__builtin_mul_overflow((uint64_t)(sh - 1), (uint64_t)sp, &srcEnd) ||
+        __builtin_add_overflow(srcEnd, srcRowBytes, &srcEnd) ||
+        __builtin_add_overflow(srcEnd, (uint64_t)src->offset, &srcEnd) ||
+        srcEnd > src->allocSize ||
+        __builtin_mul_overflow((uint64_t)(dh - 1), (uint64_t)dp, &dstEnd) ||
+        __builtin_add_overflow(dstEnd, dstRowBytes, &dstEnd) ||
+        __builtin_add_overflow(dstEnd, (uint64_t)dst->offset, &dstEnd) ||
+        dstEnd > dst->allocSize) return false;
+    uint8_t *yplane = NULL, *uvplane = NULL;
+    uint32_t yp = 0, uvp = 0;
+    if (src420f || src420v) {
+        uint64_t yEnd, uvEnd;
+        yplane = (uint8_t *)sb + src->planes[0].offset;
+        uvplane = (uint8_t *)sb + src->planes[1].offset;
+        yp = src->planes[0].bytesPerRow;
+        uvp = src->planes[1].bytesPerRow;
+        uint64_t chromaRows = ((uint64_t)sh + 1) / 2;
+        uint64_t chromaBytes = ((uint64_t)sw + 1) & ~1ull;
+        if (__builtin_mul_overflow((uint64_t)(sh - 1), (uint64_t)yp, &yEnd) ||
+            __builtin_add_overflow(yEnd, (uint64_t)sw, &yEnd) ||
+            __builtin_add_overflow(yEnd, (uint64_t)src->planes[0].offset, &yEnd) ||
+            yEnd > src->allocSize ||
+            __builtin_mul_overflow(chromaRows - 1, (uint64_t)uvp, &uvEnd) ||
+            __builtin_add_overflow(uvEnd, chromaBytes, &uvEnd) ||
+            __builtin_add_overflow(uvEnd, (uint64_t)src->planes[1].offset, &uvEnd) ||
+            uvEnd > src->allocSize) return false;
+    }
+    /* Default API operation scales the full source to the full destination.
+     * Rectangles are retained in the public 0x58 request but CA's snapshot
+     * TransferSurface path supplies no rectangles; TransformSurface rectangle
+     * encoding differs by API generation and is logged until field evidence is
+     * available. */
+    for (uint32_t y = 0; y < dh; y++) {
+        uint32_t sy = (uint32_t)((uint64_t)y * sh / dh);
+        for (uint32_t x = 0; x < dw; x++) {
+            uint32_t sx = (uint32_t)((uint64_t)x * sw / dw);
+            uint8_t r, g, b, a = 255;
+            if (srcBGRA || srcRGBA) {
+                const uint8_t *p = s + (uint64_t)sy * sp + (uint64_t)sx * 4;
+                if (srcBGRA) { b=p[0]; g=p[1]; r=p[2]; a=p[3]; }
+                else { r=p[0]; g=p[1]; b=p[2]; a=p[3]; }
+            } else {
+                int yy = yplane[(uint64_t)sy * yp + sx];
+                const uint8_t *uv = uvplane + (uint64_t)(sy / 2) * uvp + (sx & ~1u);
+                int u = uv[0], v = uv[1];
+                int c = src420v ? yy - 16 : yy;
+                int d1 = u - 128, e1 = v - 128;
+                /* BT.601: 420v is video range; 420f is full range. */
+                if (src420v) {
+                    r = sweet_scaler_clamp((298*c + 409*e1 + 128) >> 8);
+                    g = sweet_scaler_clamp((298*c - 100*d1 - 208*e1 + 128) >> 8);
+                    b = sweet_scaler_clamp((298*c + 516*d1 + 128) >> 8);
+                } else {
+                    r = sweet_scaler_clamp(yy + ((359 * e1 + 128) >> 8));
+                    g = sweet_scaler_clamp(yy - ((88 * d1 + 183 * e1 + 128) >> 8));
+                    b = sweet_scaler_clamp(yy + ((454 * d1 + 128) >> 8));
+                }
+            }
+            uint8_t *q = d + (uint64_t)y * dp + (uint64_t)x * 4;
+            if (dstBGRA) { q[0]=b; q[1]=g; q[2]=r; q[3]=a; }
+            else { q[0]=r; q[1]=g; q[2]=b; q[3]=a; }
+        }
+    }
+    return true;
+}
+
+IOReturn
+AppleM2ScalerCSCDriverUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+    if (selector != 1 || args == NULL || args->structureInput == NULL ||
+        args->structureInputSize < 0x170) return kIOReturnBadArgument;
+    const uint8_t *in = (const uint8_t *)args->structureInput;
+    uint32_t dstID = sweet_scaler_u32(in + 0);
+    uint32_t srcID = sweet_scaler_u32(in + 4);
+    /* Rect fields are not fully decoded yet. TransferSurface's wrapper passes
+     * null rectangles (all zero) at internal offsets 0x28 and 0x58; reject any
+     * nonzero rect payload rather than silently ignoring a crop request. */
+    bool fullSurface = true;
+    for (uint32_t i = 0x28; i < 0x48; i++)
+        if (in[i] != 0) fullSurface = false;
+    for (uint32_t i = 0x58; i < 0x78; i++)
+        if (in[i] != 0) fullSurface = false;
+    SweetSurface *src = sweet_surface_copy(srcID);
+    SweetSurface *dst = sweet_surface_copy(dstID);
+    bool ok = fullSurface && sweet_scaler_convert(src, dst);
+    if (sweet_scaler_log_count++ < 32) {
+        char name[32]; proc_selfname(name, sizeof(name));
+        IOLog("SWEET SCALER: %s selector=%u src=%u dst=%u size=%u srcfmt=%08x %ux%u dstfmt=%08x %ux%u srcrect=%08x,%08x,%08x,%08x dstrect=%08x,%08x,%08x,%08x -> %s\n",
+            name, selector, srcID, dstID, (uint32_t)args->structureInputSize,
+            src ? src->pixelFormat : 0, src ? src->width : 0, src ? src->height : 0,
+            dst ? dst->pixelFormat : 0, dst ? dst->width : 0, dst ? dst->height : 0,
+            sweet_scaler_u32(in+0x28), sweet_scaler_u32(in+0x2c),
+            sweet_scaler_u32(in+0x30), sweet_scaler_u32(in+0x34),
+            sweet_scaler_u32(in+0x58), sweet_scaler_u32(in+0x5c),
+            sweet_scaler_u32(in+0x60), sweet_scaler_u32(in+0x64),
+            ok ? "copied" : "unsupported");
+    }
+    if (args->structureOutput != NULL && args->structureOutputSize)
+        bzero(args->structureOutput, args->structureOutputSize);
+    OSSafeReleaseNULL(src);
+    OSSafeReleaseNULL(dst);
+    return ok ? kIOReturnSuccess : kIOReturnUnsupported;
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetPlatformExpert.cpp ci-sweet/iokit/Kernel/arm/SweetPlatformExpert.cpp
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp	2026-11-20 20:53:28.567094095 +0100
@@ -0,0 +1,82 @@
+/*
+ * Minimal device-tree platform expert for Redmi Note 10 Pro (sweet).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class SweetPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(SweetPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
+
+bool
+SweetPlatformExpert::start(IOService *provider)
+{
+	IOLog("SWEET: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET: platform expert registered\n");
+	return true;
+}
+
+const char *
+SweetPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+SweetPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * SWEET has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/*
+	 * No AppleARMIO driver publishes the /arm-io children: do it here so
+	 * built-in drivers (the display, AppleCLCD) can match them. The GIC is
+	 * driven by the platform code and gets no nub. The nubs hang off this
+	 * platform expert: IOPlatformDevice::compareName asks its provider.
+	 */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+}
+
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetSurface.cpp ci-sweet/iokit/Kernel/arm/SweetSurface.cpp
--- a/iokit/Kernel/arm/SweetSurface.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetSurface.cpp	2026-11-20 20:53:28.567094095 +0100
@@ -0,0 +1,1272 @@
+/*
+ * Built-in IOSurface for SWEET.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * sweet_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values, notifications, accelerators and shared events are accepted and
+ * ignored (logged once per selector).
+ */
+#include "SweetSurface.h"
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/backtrace.h>
+#include <sys/proc.h>
+
+enum {
+	kSweetSurfaceCreate             = 0,
+	kSweetSurfaceLookup             = 4,
+	kSweetSurfaceWrapClientImage    = 6,
+	kSweetSurfaceWrapClientMemory   = 7,
+	kSweetSurfaceLimits             = 13,
+	kSweetSurfaceLookupFromPort     = 34,
+	kSweetSurfaceCreatePort         = 35,
+};
+
+enum {
+	kSweetSurfaceTrapIncrementUse   = 0,
+	kSweetSurfaceTrapDecrementUse   = 1,
+	kSweetSurfaceTrapLock           = 2,
+	kSweetSurfaceTrapUnlock         = 3,
+	kSweetSurfaceTrapRelease        = 4,
+	kSweetSurfaceTrapReleaseFailed  = 5,
+};
+
+#define SWEET_SURFACE_RESULT_SIZE       0xa68
+#define SWEET_SURFACE_MAX_ID            4096
+#define SWEET_SURFACE_MAX_DIM           16384
+#define SWEET_SURFACE_MAX_ALLOC         (256u << 20)
+#define SWEET_SURFACE_MAX_PROPS         (64u << 10)
+#define SWEET_SURFACE_ROW_ALIGN         64
+#define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *sweet_surface_lock;
+static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_users[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_next_id = 1;
+static uint32_t      sweet_surface_creates_logged;
+static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
+#define SWEET_SURFACE_WIRED_MAX         (1536ull << 20)
+
+OSDefineMetaClassAndStructors(SweetSurface, OSObject);
+
+void
+SweetSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	}
+	OSSafeReleaseNULL(kernelMap);
+	if (wrapped && memory != NULL) {
+		memory->complete();
+	}
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	OSObject::free();
+}
+
+uintptr_t
+SweetSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(sweet_surface_lock);
+	if (kernelMap == NULL && memory != NULL) {
+		/* a task's own (cached) memory keeps its cache mode: no WC alias */
+		kernelMap = memory->map((wrapped ? kIOMapDefaultCache : kIOMapWriteCombineCache) |
+		    (readOnly ? kIOMapReadOnly : 0));
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
+}
+
+static uint32_t *
+sweet_surface_seed(SweetSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+sweet_surface_insert_locked(SweetSurface *s)
+{
+	for (uint32_t n = 0; n < SWEET_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = sweet_surface_next_id;
+		sweet_surface_next_id = id + 1 < SWEET_SURFACE_MAX_ID ? id + 1 : 1;
+		if (sweet_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			sweet_surface_table[id] = s;
+			sweet_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+sweet_surface_get(SweetSurface *s)
+{
+	bool ok = true;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s) {
+		sweet_surface_users[s->id]++;
+	} else if (sweet_surface_table[s->id] == NULL) {
+		s->retain();
+		sweet_surface_table[s->id] = s;
+		sweet_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+sweet_surface_put(SweetSurface *s)
+{
+	bool drop = false;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s && --sweet_surface_users[s->id] == 0) {
+		sweet_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+SweetSurface *
+sweet_surface_copy(uint32_t id)
+{
+	SweetSurface *s = NULL;
+	if (id == 0 || id >= SWEET_SURFACE_MAX_ID || sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	s = sweet_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return s;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+sweet_surface_init_lock(void)
+{
+	if (sweet_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &sweet_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static SweetSurface *
+sweet_surface_alloc(void)
+{
+	sweet_surface_init_lock();
+	SweetSurface *s = OSTypeAlloc(SweetSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), page_size);
+	return s;
+}
+
+static bool
+sweet_surface_publish(SweetSurface *s)
+{
+	bool ok;
+	IOLockLock(sweet_surface_lock);
+	ok = sweet_surface_insert_locked(s);
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+SweetSurface *
+sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
+mach_port_name_t
+sweet_surface_port_in_task(SweetSurface *s, task_t task)
+{
+	mach_port_name_t name = 0;
+	IOUserClient::copyPortNameForObjectInTask(task, s, &name);
+	return name;
+}
+
+static uint32_t
+sweet_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, dict->getObject(key));
+	return n != NULL ? n->unsigned32BitValue() : def;
+}
+
+static uint32_t
+sweet_div_up(uint32_t a, uint32_t b)
+{
+	return b > 1 ? (a + b - 1) / b : a;
+}
+
+static uint32_t
+sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
+	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+}
+
+/* Geometry from the creation properties (IOSurface.h keys). */
+static IOReturn
+sweet_surface_layout(SweetSurface *s, OSDictionary *props)
+{
+	uint64_t end;
+
+	s->width = sweet_dict_u32(props, "IOSurfaceWidth", 0);
+	s->height = sweet_dict_u32(props, "IOSurfaceHeight", 0);
+	s->bytesPerElement = (uint16_t)sweet_dict_u32(props, "IOSurfaceBytesPerElement", 4);
+	s->elementWidth = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementWidth", 1);
+	s->elementHeight = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementHeight", 1);
+	s->pixelFormat = sweet_dict_u32(props, "IOSurfacePixelFormat", 0);
+	/*
+	 * 10-bit wide-colour formats the iPhone X userland asks for ('w30r',
+	 * 'l10r', 'w30R', and 'b3a8' with its separate alpha plane) become
+	 * one-plane BGRA: the panel is 8-bit sRGB, the display path copies 4-byte
+	 * BGRA pixels, and the GL renderer (userland/gpu/eagl.c) can only draw
+	 * into BGRA. The client reads the format back from the lock result and
+	 * draws accordingly. G4 run gl3: CoreAnimation's screen surface was
+	 * 'b3a8', eagl.c could not attach it, every frame went nowhere (black).
+	 * From topaz (MakrSas/ios-topaz) 0900, which took it from HackiOS; APSL.
+	 * Boot-arg sweetsurf10=1 keeps the formats as asked.
+	 */
+	bool one_plane = false;
+	static int keep10 = -1;
+	if (keep10 < 0) {
+		int v = 0;
+		keep10 = PE_parse_boot_argn("sweetsurf10", &v, sizeof(v)) ? v : 0;
+	}
+	/*
+	 * 0141: sweetsurf10=3 keeps the 10-bit formats for WebKit's GPU process only. It draws
+	 * Safari's page tiles ('w30r', 'b3a8') and leaves every remapped one empty (0140, wifi27/29:
+	 * "pixels set 0"), while the BGRA surfaces it asks for get pixels.
+	 */
+	char who10[32] = "";
+	if (keep10 == 3) {
+		proc_selfname(who10, sizeof(who10));
+	}
+	if (keep10 == 0 || (keep10 == 3 && strcmp(who10, "com.apple.WebKit.GPU") != 0)) {
+		if (s->pixelFormat == 0x77333072u || s->pixelFormat == 0x6C313072u ||
+		    s->pixelFormat == 0x77333052u) {
+			s->pixelFormat = 0x42475241u;           /* 'BGRA' */
+		} else if (s->pixelFormat == 0x62336138u) {
+			s->pixelFormat = 0x42475241u;
+			one_plane = true;
+		}
+	}
+	s->cacheMode = sweet_dict_u32(props, "IOSurfaceCacheMode", 0);
+	s->offset = sweet_dict_u32(props, "IOSurfaceOffset", 0);
+	if (s->width > SWEET_SURFACE_MAX_DIM || s->height > SWEET_SURFACE_MAX_DIM ||
+	    s->bytesPerElement > 64 || s->elementWidth == 0 || s->elementHeight == 0) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerRow = sweet_dict_u32(props, "IOSurfaceBytesPerRow",
+	    sweet_row_bytes(s->width, s->elementWidth, s->bytesPerElement));
+	if (s->bytesPerRow < (uint64_t)sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
+		return kIOReturnBadArgument;
+	}
+	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+
+	OSArray *planes = one_plane ? NULL : OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	s->planeCount = 0;
+	if (planes != NULL) {
+		uint64_t next = s->offset;
+		if (planes->getCount() > SWEET_SURFACE_MAX_PLANES) {
+			return kIOReturnBadArgument;
+		}
+		for (unsigned int i = 0; i < planes->getCount(); i++) {
+			OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+			struct sweet_surface_plane *p = &s->planes[i];
+			if (pd == NULL) {
+				return kIOReturnBadArgument;
+			}
+			p->width = sweet_dict_u32(pd, "IOSurfacePlaneWidth", s->width);
+			p->height = sweet_dict_u32(pd, "IOSurfacePlaneHeight", s->height);
+			p->bytesPerElement = (uint16_t)sweet_dict_u32(pd, "IOSurfacePlaneBytesPerElement", 1);
+			p->elementWidth = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementWidth", 1);
+			p->elementHeight = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementHeight", 1);
+			if (p->width > SWEET_SURFACE_MAX_DIM || p->height > SWEET_SURFACE_MAX_DIM ||
+			    p->bytesPerElement > 64 || p->elementWidth == 0 || p->elementHeight == 0) {
+				return kIOReturnBadArgument;
+			}
+			p->bytesPerRow = sweet_dict_u32(pd, "IOSurfacePlaneBytesPerRow",
+			    sweet_row_bytes(p->width, p->elementWidth, p->bytesPerElement));
+			p->offset = sweet_dict_u32(pd, "IOSurfacePlaneOffset", (uint32_t)next);
+			p->size = sweet_dict_u32(pd, "IOSurfacePlaneSize",
+			    p->bytesPerRow * sweet_div_up(p->height, p->elementHeight));
+			next = round_page((uint64_t)p->offset + p->size);
+			if ((uint64_t)p->offset + p->size > end) {
+				end = (uint64_t)p->offset + p->size;
+			}
+		}
+		s->planeCount = planes->getCount();
+	}
+	/*
+	 * 0143: a 'b3a8' made one-plane BGRA kept no plane at all, so IOSurfaceGetBytesPerRowOfPlane(0)
+	 * was 0 for it. WebKit's GPU process builds CGImages from plane 0 of its 'b3a8' tiles: 526
+	 * "CGImageCreate: invalid image bits/pixel or bytes/row" in one Safari session (jb1), pages
+	 * black. For WebKit's processes that plane is the whole BGRA surface (backboardd's GL path
+	 * keeps the plane-less layout it was written for).
+	 */
+	if (one_plane && s->planeCount == 0) {
+		char who[32] = "";
+		proc_selfname(who, sizeof(who));
+		if (strncmp(who, "com.apple.WebKit", 16) == 0) {
+			struct sweet_surface_plane *p = &s->planes[0];
+			p->width = s->width;
+			p->height = s->height;
+			p->bytesPerElement = s->bytesPerElement;
+			p->elementWidth = s->elementWidth;
+			p->elementHeight = s->elementHeight;
+			p->bytesPerRow = s->bytesPerRow;
+			p->offset = s->offset;
+			p->size = s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+			s->planeCount = 1;
+		}
+	}
+
+	uint64_t alloc = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
+	if (alloc < end) {
+		alloc = end;
+	}
+	alloc = round_page(alloc);
+	if (alloc == 0 || alloc > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnNoMemory;
+	}
+	s->allocSize = (uint32_t)alloc;
+	return kIOReturnSuccess;
+}
+
+/* Per-client mapping of one surface. */
+class SweetSurfaceRef : public OSObject {
+	OSDeclareDefaultStructors(SweetSurfaceRef);
+
+public:
+	SweetSurface *surface;
+	IOMemoryMap  *data;
+	IOMemoryMap  *state;
+	uint32_t      count;
+
+	bool init() APPLE_KEXT_OVERRIDE { return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetSurfaceRef, OSObject);
+
+void
+SweetSurfaceRef::free()
+{
+	OSSafeReleaseNULL(data);
+	OSSafeReleaseNULL(state);
+	if (surface != NULL) {
+		sweet_surface_put(surface);
+		surface->release();
+		surface = NULL;
+	}
+	OSObject::free();
+}
+
+class IOCoreSurfaceRoot : public IOService {
+	OSDeclareDefaultStructors(IOCoreSurfaceRoot);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOCoreSurfaceRoot, IOService);
+
