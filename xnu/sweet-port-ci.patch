diff -ruN ci-base/iokit/Kernel/arm/MiniIONetworkStack.cpp ci-sweet/iokit/Kernel/arm/MiniIONetworkStack.cpp
--- a/iokit/Kernel/arm/MiniIONetworkStack.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/MiniIONetworkStack.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,114 @@
+/*
+ * MiniIONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (bsd/dev/redwood_net.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid SpringBoard.
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" void MiniIONetworkStackStart(void);
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("MiniIONetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("MiniIONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIONetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("MiniIONetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
diff -ruN ci-base/iokit/Kernel/arm/RedwoodGPU.cpp ci-sweet/iokit/Kernel/arm/RedwoodGPU.cpp
--- a/iokit/Kernel/arm/RedwoodGPU.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,1235 @@
+/*
+ * From vcvkk/darwin-redwood (HackiOS), reused with the author's permission; topaz: the
+ * hardware is iokit/Kernel/arm/TopazAdreno.cpp (Adreno 610) and surfaces are SweetSurface.
+ *
+ * HackiOS kernel code (https://github.com/oosexgang/hackios-xnu-kernel) and the topaz changes
+ * (https://github.com/MakrSas/ios-topaz, xnu/patches/0901) are under the Apple Public Source
+ * License 2.0, like XNU; so is this file.
+ *
+ * guacamole (ios-sweet, OnePlus 7 Pro, Adreno 640): taken from topaz 0901 onto the
+ * redwood_gpu_* backend in bsd/dev/sweet_gpu.c (sweetgpu=11 runs it and calls
+ * RedwoodGPUStart(), replacing its weak stub). Changed here:
+ *  - buffers from any RAM the 36-bit SMMU reaches (this kernel's RAM is all above 4 GiB,
+ *    --highmem), and not physically contiguous: newBuffer() maps them page by page;
+ *  - the SweetSurface paths (surfaceBuffer(), surfaces' seed and drawn fence in submit(),
+ *    topaz_surface_drawn()) were off until 0131 (REDWOOD_SURFACES): SweetSurface now has
+ *    the drawn fence, its seed is at +0xc of the state page as here, and the display
+ *    (SweetFramebuffer) drops its cached copy of a surface the GPU drew before it shows it;
+ *  - redwood_tl() lines go to IOLog; gpu_log is the boot-arg of that name.
+ *
+ * RedwoodGPU: the phone's Adreno for programs to draw with.
+ *
+ * bsd/dev/redwood_adreno.c wakes the GPU and, with boot-arg adreno_keep=1, keeps it on and
+ * starts this service. A program that opens it speaks the interface of Linux's msm DRM driver,
+ * the one Mesa's freedreno knows: every request of that interface is a call of the user client
+ * with the request's number as the selector and the request's structure passed in and back
+ * (userland: tools/mesa/redwood-drm, which stands in for libdrm inside Mesa). What Linux does
+ * with mmap() on the device is the client memory of the type that is the buffer's handle.
+ *
+ * What there is of the interface is what freedreno uses to draw: parameters, buffers (made,
+ * told their address in the GPU's address space, mapped, given back), submission of command
+ * buffers, and waiting for one to be done. A buffer is wired kernel memory entered into the 3D
+ * core's SMMU context; it is zero when made, and write-combined: what the program writes goes to
+ * memory, where the GPU reads it, and not into this processor's cache (as Linux maps them for
+ * freedreno; boot-arg gpu_cached=1 makes them ordinary memory, pushed out of the cache whenever
+ * the GPU is given something to do: see submit()).
+ *
+ * One request is not Linux's: a buffer that is the memory of an IOSurface (surfaceBuffer()), for
+ * drawing into what the display shows and for reading pictures where other programs have drawn
+ * them. Linux hands such memory around as file descriptors; here it has a name already. That
+ * memory is ordinary, cached memory, which everybody else reads and writes as such.
+ *
+ * Not here yet: interrupts (waiting is asking again five times a millisecond), more than one
+ * program's worth of care (every client's buffers are in the one address space; a client that
+ * goes takes its own away), recovery of a GPU that has stopped answering (it is reported, see
+ * redwood_gpu_report(), and stays stopped), fences and buffers as file descriptors.
+ */
