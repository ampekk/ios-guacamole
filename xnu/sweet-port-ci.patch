+                                        IOOptionBits            options)
+{
+    IOHIDEvent *            event   = NULL;
+    IOHIDButtonEventData *  data    = NULL;
+    bool                    state   = (pressure>>16) & 0x1;
+
+    event = buttonEvent(timeStamp, mask, number, state, options);
