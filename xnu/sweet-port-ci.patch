+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+	vm_offset_t gcc, south, east, se;
+	unsigned clk_sel, mode;
+	bool dead, ready;
+	bool fresh;             /* 0252: set up by a play-time (re)configure since boot */
+	unsigned idle_s;        /* 0252: boot-arg sweethapticidle: set up again before a play after this many idle s */
+	uint64_t last;          /* 0252: mach_absolute_time of the last play */
+	unsigned sent, got;
+	uint32_t irq_last;
+	lck_grp_t *grp;
+	lck_mtx_t *lock;
+} hp;
+static int hap_sleep_chan;
+static volatile unsigned hi_taps, hi_loops, hi_capped, hi_wedged;
+static volatile uint32_t hi_last_peak, hi_last_wave;
+static int hap_configure_locked(bool full, bool click);
+
+static uint32_t
+hap_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+hap_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+hap_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&hap_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+hap_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(hap_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM: mux, pull (0 none, 1 down, 3 up), drive code (0 = 2 mA), output, level */
+static void
+hap_gpio(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = HAP_GPIO_CFG(pin);
+	if (out) {
+		hap_wr(tile, HAP_GPIO_IO(pin), (hap_rd(tile, HAP_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = hap_rd(tile, off) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	hap_wr(tile, off, cfg);
+}
+
+static bool
+hap_clocks(void)
+{
+	hap_wr(hp.gcc, HAP_GCC_VOTE, hap_rd(hp.gcc, HAP_GCC_VOTE) | HAP_GCC_MASK);
+	uint32_t dfs = hap_rd(hp.gcc, HAP_RCG + 0x14u), cfg = hap_rd(hp.gcc, HAP_RCG + 4u);
+	printf("SWEET HAPTIC: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n", hap_rd(hp.gcc, HAP_GCC_VOTE),
+	    hap_rd(hp.gcc, HAP_RCG), cfg, dfs);
+	hp.clk_sel = 0;
+	if (dfs & 1u) {
+		int level = -1;
+		for (unsigned l = 0; l < 8; ++l) {
+			uint32_t lc = hap_rd(hp.gcc, HAP_RCG + 0x1cu + 4u * l);
+			if (level < 0 && (lc & 0x371fu) == 1u) {
+				level = (int)l;
+			}
+		}
+		if (level < 0) {
+			printf("SWEET HAPTIC: no XO/1 DFS level\n");
+			return false;
+		}
+		hp.clk_sel = (unsigned)level;
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		hap_wr(hp.gcc, HAP_RCG + 4u, cfg);
+		hap_wr(hp.gcc, HAP_RCG, hap_rd(hp.gcc, HAP_RCG) | 1u);
+		if (!hap_wait_clear(hp.gcc, HAP_RCG, 1u)) {
+			printf("SWEET HAPTIC: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x17004, 0x17008, 0x17994};
+	for (unsigned i = 0; i < 3; ++i) {
+		if (hap_wait_clear(hp.gcc, branches[i], 1u << 31)) {
+			continue;
+		}
+		uint32_t v = hap_rd(hp.gcc, branches[i]);
+		if (branches[i] == 0x17008u && (v & 2u)) {
+			continue;               /* S_AHB in HW clock gating: not polled (Linux) */
+		}
+		printf("SWEET HAPTIC: GCC branch %#x halted (%#x)\n", branches[i], v);
+		return false;
+	}
+	return true;
+}
+
+static void
+hap_abort(void)
+{
+	hap_wr(hp.se, SE_CTRL, 2);
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (hap_rd(hp.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !hap_wait_clear(hp.se, SE_STATUS, 1u)) {
+		hp.dead = true;
+		printf("SWEET HAPTIC: abort failed; stopping\n");
+	}
+	for (unsigned i = 0; i < 64 && (hap_rd(hp.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)hap_rd(hp.se, SE_RX);
+	}
+	hap_wr(hp.se, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* one FIFO message: TX at most 3 bytes or RX at most 64 */
+static int
+hap_msg(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	if (hp.dead || nt > 3 || nr > 64 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	hp.sent = hp.got = 0;
+	if (!hap_wait_clear(hp.se, SE_STATUS, 1u)) {
+		hp.dead = true;
+		return EBUSY;
+	}
+	hap_wr(hp.se, SE_IRQ_CLR, 0xffffffffu);
+	hap_wr(hp.se, SE_TX_WM, nt ? 1u : 0u);
+	hap_wr(hp.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	hap_wr(hp.se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)HAP_ADDR << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = hp.irq_last = hap_rd(hp.se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = hap_rd(hp.se, SE_IRQ);
+			}
+			if ((irq & SE_DONE) && !(hap_rd(hp.se, SE_STATUS) & 1u) &&
+			    !(hap_rd(hp.se, SE_TX_COUNT) & 0xfffffffu) && !(hap_rd(hp.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				hap_wr(hp.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !hp.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			hap_wr(hp.se, SE_TX, word);
+			hp.sent = nt;
+			hap_wr(hp.se, SE_TX_WM, 0);
+		}
+		uint32_t count = hap_rd(hp.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 16 || (nr && count > (nr - hp.got + 3u) / 4u)) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = hap_rd(hp.se, SE_RX);
+			for (unsigned j = 0; j < 4 && hp.got < nr; ++j) {
+				rx[hp.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			irq = hap_rd(hp.se, SE_IRQ);
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			hap_wr(hp.se, SE_IRQ_CLR, irq);
+			if (hp.got == nr && hp.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		hap_wr(hp.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	hap_abort();
+	return err;
+}
+
+static int
+hap_read(uint8_t reg, uint8_t *val)
+{
+	int err = hap_msg(&reg, 1, NULL, 0, true);
+	return err ? err : hap_msg(NULL, 0, val, 1, false);
+}
+
+static int
+hap_write(uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = {reg, val};
+	return hap_msg(tx, 2, NULL, 0, false);
+}
+
+/* reg = (reg & ~mask) | val */
+static int
+hap_bits(uint8_t reg, uint8_t mask, uint8_t val)
+{
+	uint8_t v = 0;
+	int err = hap_read(reg, &v);
+	return err ? err : hap_write(reg, (uint8_t)((v & ~mask) | val));
+}
+
+static bool
+hap_se_init(void)
+{
+	uint32_t fw = hap_rd(hp.se, SE_FW);
+	uint32_t tx = hap_rd(hp.se, SE_HW_TX), rx = hap_rd(hp.se, SE_HW_RX);
+	printf("SWEET HAPTIC: se fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n", fw, (fw >> 8) & 0xffu,
+	    hap_rd(hp.se, SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || (hap_rd(hp.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u) {
+		/* Linux's geni-i2c would load the SE's I2C firmware here; we cannot (yet): report and stop */
+		printf("SWEET HAPTIC: SE7 has no I2C protocol firmware loaded by the boot chain (proto %u); stopping\n",
+		    (fw >> 8) & 0xffu);
+		return false;
+	}
+	if (hap_rd(hp.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET HAPTIC: SE7 busy; stopping\n");
+		return false;
+	}
+	hap_wr(hp.se, 0xe18, 0);
+	hap_wr(hp.se, 0xe1c, 0);
+	hap_wr(hp.se, 0x644, 0);
+	hap_wr(hp.se, SE_IRQ_CLR, 0xffffffffu);
+	hap_wr(hp.se, 0x648, 0xffffffffu);
+	hap_wr(hp.se, SE_DMA, 0);
+	hap_wr(hp.se, 0x28, hap_rd(hp.se, 0x28) | 0x7fu);
+	hap_wr(hp.se, 0xe30, hap_rd(hp.se, 0xe30) | 0x0fu);
+	hap_wr(hp.se, 0x24, 0x7f);
+	hap_wr(hp.se, 0x20, 1);
+	hap_wr(hp.se, SE_CLK_SEL, hp.clk_sel);
+	hap_wr(hp.se, SE_MCLK, (2u << 4) | 1u);             /* 400 kHz from 19.2 MHz (as touch) */
+	hap_wr(hp.se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	hap_wr(hp.se, 0x254, 0);
+	hap_wr(hp.se, 0x260, SE_PACK0);
+	hap_wr(hp.se, 0x264, SE_PACK1);
+	hap_wr(hp.se, 0x284, SE_PACK0);
+	hap_wr(hp.se, 0x288, SE_PACK1);
+	hap_wr(hp.se, SE_TX_WM, 0);
+	hap_wr(hp.se, 0x810, 0);
+	hap_wr(hp.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	hap_wr(hp.se, SE_IRQ_EN, SE_EVENTS);
+	return hap_rd(hp.se, 0x260) == SE_PACK0 && hap_rd(hp.se, 0x284) == SE_PACK0 &&
+	       !(hap_rd(hp.se, SE_TX_COUNT) & 0xfffffffu) && !(hap_rd(hp.se, SE_RX_COUNT) & 0x1ffffffu);
+}
+
+static void
+hap_dump(void)
+{
+	for (unsigned r = 0; r < 0x80; r += 16) {
+		uint8_t v[16];
+		memset(v, 0xee, sizeof(v));
+		for (unsigned i = 0; i < 16; ++i) {
+			(void)hap_read((uint8_t)(r + i), &v[i]);
+		}
+		printf("SWEET HAPTIC: reg %02x: %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    r, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11], v[12], v[13], v[14], v[15]);
+	}
+}
+
+/*
+ * Configuration as OnePlus's driver left it on Android (dtb/haptics/aw8697-registers-android.txt, idle):
+ * the writable configuration registers only; not ID/status/interrupts (00-03 except SYSINTM), SYSCTRL/GO/RTP
+ * (04-06, set per play), the RAM base / FIFO thresholds (21-26, set by the RAM load), RAM address/data (40-42),
+ * GLB_STATE (46), the detection results (60-6b) and the undocumented 70-7f.
+ */
+static const uint8_t hap_cfg[][2] = {
+	{0x03, 0xb9},
+	{0x07, 0x0a}, {0x08, 0x00}, {0x09, 0x00}, {0x0a, 0x00}, {0x0b, 0x00}, {0x0c, 0x00}, {0x0d, 0x00},
+	{0x0e, 0x00}, {0x0f, 0xf0}, {0x10, 0x00}, {0x11, 0x00}, {0x12, 0x00}, {0x13, 0x00},
+	{0x14, 0x01}, {0x15, 0x01}, {0x16, 0x01}, {0x17, 0x02}, {0x18, 0x02}, {0x19, 0x02}, {0x1a, 0x1b},
+	{0x1b, 0x2a}, {0x1c, 0x40},
+	{0x20, 0xa4},
+	{0x27, 0x3f}, {0x28, 0x05}, {0x29, 0x00}, {0x2a, 0x00}, {0x2b, 0xe0}, {0x2c, 0x00}, {0x2d, 0x20},
+	{0x2e, 0xc1}, {0x2f, 0x20}, {0x31, 0x30}, {0x32, 0xeb}, {0x33, 0xd4}, {0x34, 0x07}, {0x35, 0x1f},
+	{0x36, 0x29}, {0x37, 0x18}, {0x38, 0x00}, {0x39, 0x29}, {0x3a, 0x7e}, {0x3b, 0x00}, {0x3c, 0x04},
+	{0x3d, 0x00}, {0x3e, 0x3f}, {0x3f, 0x12},
+	{0x47, 0x01}, {0x48, 0x99}, {0x49, 0x08}, {0x4a, 0xd6}, {0x4b, 0x00}, {0x4c, 0x5d}, {0x4d, 0x12},
+	{0x5b, 0x00}, {0x5d, 0x68}, {0x5e, 0x2c}, {0x5f, 0x60},
+	{0x6d, 0x7f}, {0x6f, 0x87},
+};
+
+static int
+hap_standby(void)
+{
+	int err = hap_bits(R_SYSINTM, INTM_UVLO_OFF, INTM_UVLO_OFF);
+	return err ? err : hap_bits(R_SYSCTRL, SYS_STANDBY, SYS_STANDBY);
+}
+
+static int
+hap_stop(void)
+{
+	int err = hap_bits(R_GO, 1, 0);
+	bool idle = false;
+	for (unsigned i = 0; !err && i < 60; ++i) {
+		uint8_t st = 0;
+		err = hap_read(R_GLBSTATE, &st);
+		if (err) {
+			break;
+		}
+		if ((st & 0x0f) == 0) {
+			idle = true;
+			break;
+		}
+		hap_wait(2);
+	}
+	if (err) {
+		return err;
+	}
+	if (!idle) {
+		uint8_t go = 0, ctrl = 0, state = 0;
+		(void)hap_read(R_GO, &go);
+		(void)hap_read(R_SYSCTRL, &ctrl);
+		(void)hap_read(R_GLBSTATE, &state);
+		++hi_wedged;
+		printf("SWEET HAPTIC: wedged (GO %u SYSCTRL %#x GLB %#x), set up again\n", go & 1, ctrl, state);
+		err = hap_configure_locked(true, false);
+		return err ? err : ETIMEDOUT;
+	}
+	return hap_standby();
+}
+
+/* aw8697_haptic_play_mode(RAM) without auto boost, then the sequence and GO */
+static int
+hap_play_gain(uint8_t wave, uint8_t loops, uint8_t gain)
+{
+	uint8_t junk = 0;
+	int err = hap_stop();
+	err = err ? err : hap_bits(R_SYSCTRL, SYS_MODE_MASK | SYS_BOOST, 0);        /* RAM mode, boost bypass */
+	err = err ? err : hap_bits(R_SYSCTRL, SYS_STANDBY, 0);                       /* active */
+	err = err ? err : hap_read(R_SYSINT, &junk);                                 /* clear interrupts */
+	err = err ? err : hap_bits(R_SYSINTM, INTM_UVLO_OFF, 0);
+	err = err ? err : hap_bits(R_SYSCTRL, SYS_BOOST, SYS_BOOST);
+	if (!err) {
+		hap_wait(2);
+	}
+	err = err ? err : hap_write(R_WAVSEQ1, wave);
+	err = err ? err : hap_write(R_WAVSEQ2, 0);
+	err = err ? err : hap_bits(R_WAVLOOP1, 0xf0, (uint8_t)(loops << 4));
+	err = err ? err : hap_write(R_MAINLOOP, 0);
+	err = err ? err : (gain ? hap_write(R_DATDBG, gain) : 0);
+	err = err ? err : hap_bits(R_GO, 1, 1);
+	return err;
+}
+
+static int
+hap_play(uint8_t wave, uint8_t loops)
+{
+	return hap_play_gain(wave, loops, 0);
+}
+
+/*
+ * 0251: what the chip did with a play, 5 and 25 ms after GO: SYSST (01) / SYSINT (02), bits (aw8697_reg.h)
+ * 7 BSTERR boost error, 6 OV, 5 UVL under-voltage, 4 FF_AE, 3 FF_AF, 2 OCD over-current, 1 OT over-temperature,
+ * 0 DONE; GLB_STATE (46, low nibble 0 = standby / idle) and SYSCTRL (04). A play that never leaves state 0, or
+ * that sets BSTERR / UVL / OCD / OT, is what a silent motor looks like.
+ */
+static void
+hap_report(const char *what)
+{
+	uint8_t s1 = 0, i1 = 0, g1 = 0, c1 = 0, g2 = 0, i2 = 0;
+	hap_wait(5);
+	(void)hap_read(0x01, &s1);
+	(void)hap_read(R_SYSINT, &i1);
+	(void)hap_read(R_GLBSTATE, &g1);
+	(void)hap_read(R_SYSCTRL, &c1);
+	hap_wait(20);
+	(void)hap_read(R_GLBSTATE, &g2);
+	(void)hap_read(R_SYSINT, &i2);
+	printf("SWEET HAPTIC: %s: +5ms sysst %#x sysint %#x glb %#x sysctrl %#x, +25ms glb %#x sysint %#x\n", what, s1, i1, g1,
+	    c1, g2, i2);
+}
+
+static int
+hap_ram_load(void)
+{
+	DTEntry node;
+	const void *prop;
+	unsigned int sz;
+	if (SecureDTLookupEntry(NULL, "/sweet-haptic", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "ram", &prop, &sz) != kSuccess || sz < 8) {
+		printf("SWEET HAPTIC: no ADT /sweet-haptic ram (mkadt: dtb/haptics/aw8697_haptic_168.bin)\n");
+		return ENOENT;
+	}
+	const uint8_t *b = prop;
+	unsigned sum = 0;
+	for (unsigned i = 2; i < sz; ++i) {
+		sum += b[i];
+	}
+	if ((sum & 0xffffu) != (((unsigned)b[0] << 8) | b[1])) {
+		printf("SWEET HAPTIC: RAM image checksum mismatch\n");
+		return EINVAL;
+	}
+	unsigned base = ((unsigned)b[2] << 8) | b[3];
+	int err = hap_bits(R_SYSCTRL, SYS_RAMINIT, SYS_RAMINIT);
+	err = err ? err : hap_write(R_BASEH, b[2]);
+	err = err ? err : hap_write(R_BASEL, b[3]);
+	err = err ? err : hap_write(R_FIFO_AEH, (uint8_t)((base >> 1) >> 8));
+	err = err ? err : hap_write(R_FIFO_AEL, (uint8_t)((base >> 1) & 0xff));
+	err = err ? err : hap_write(R_FIFO_AFH, (uint8_t)((base - (base >> 2)) >> 8));
+	err = err ? err : hap_write(R_FIFO_AFL, (uint8_t)((base - (base >> 2)) & 0xff));
+	err = err ? err : hap_write(R_RAMADDRH, b[2]);
+	err = err ? err : hap_write(R_RAMADDRL, b[3]);
+	for (unsigned i = 4; !err && i < sz; ++i) {
+		err = hap_write(R_RAMDATA, b[i]);
+	}
+	int err2 = hap_bits(R_SYSCTRL, SYS_RAMINIT, 0);
+	printf("SWEET HAPTIC: RAM: %u bytes at base %#x: %s\n", sz - 4, base, (err || err2) ? "FAILED" : "loaded");
+	return err ? err : err2;
+}
+
+/*
+ * 0251: reset + identify + (configure: soft reset, hap_cfg, RAM) + one click, then the register dump; at boot
+ * (hap_thread, 50 s) and on demand (sysctl kern.sweet_haptic = 200, `haptic init`), so a cold-booted chip can be
+ * inspected and set up again without catching the boot log. Called without hp.lock held. 0 = configured.
+ */
+static int hap_configure_locked(bool full, bool click);
+
+static int
+hap_configure(bool full, bool click)
+{
+	lck_mtx_lock(hp.lock);                                   /* 0252: the reset pulse too (vibrator thread vs sysctl) */
+	int err = hap_configure_locked(full, click);
+	lck_mtx_unlock(hp.lock);
+	if (!err) {
+		hp.fresh = true;
+	}
+	return err;
+}
+
+static int
+hap_configure_locked(bool full, bool click)
+{
+	hap_gpio(hp.south, HAP_SDA, 1, 0, 0, false, false);      /* qup7, 2 mA, no bias */
+	hap_gpio(hp.south, HAP_SCL, 1, 0, 0, false, false);
+	hap_gpio(hp.east, HAP_IRQ, 0, 0, 0, false, false);       /* input */
+	hap_gpio(hp.south, HAP_RST, 0, 0, 0, true, false);       /* reset: low 1 ms, high (aw8697_hw_reset) */
+	hap_wait(2);
+	hap_gpio(hp.south, HAP_RST, 0, 0, 0, true, true);
+	hap_wait(3);
+	uint8_t id = 0;
+	int err = hap_read(R_ID, &id);
+	printf("SWEET HAPTIC: AW8697 at %#x: id %#x (want %#x) err %d irq %#x\n", HAP_ADDR, id, HAP_ID, err, hp.irq_last);
+	if (err || id != HAP_ID) {
+		return err ? err : ENODEV;
+	}
+	hap_dump();
+	if (!full) {
+		printf("SWEET HAPTIC: probe only (sweethaptic=2 configures and plays)\n");
+		return ENODEV;
+	}
+	err = hap_write(R_ID, 0xaa);                              /* soft reset (aw8697_haptic_softreset) */
+	hap_wait(2);
+	err = err ? err : hap_standby();
+	for (unsigned i = 0; !err && i < sizeof(hap_cfg) / sizeof(hap_cfg[0]); ++i) {
+		err = hap_write(hap_cfg[i][0], hap_cfg[i][1]);
+	}
+	err = err ? err : hap_ram_load();
+	if (!err && click) {
+		err = hap_play(1, 0);                             /* one short click as the sign */
+		hap_report("click");
+		hap_wait(60);
+		(void)hap_stop();
+	}
+	printf("SWEET HAPTIC: configured %s (sysctl kern.sweet_haptic: N plays waveform N, -ms buzzes, 0 stops, 200 init)\n",
+	    err ? "with ERRORS" : "OK");
+	if (!err && click) {
+		hap_dump();
+	}
+	return err;
+}
+
+/*
+ * 0252: the chip set up at boot (50 s) is silent until `haptic init` sets it up again: plays run (GLB_STATE 7,
+ * DONE, no faults) but the motor does not move. Not yet understood (haptic dump, 0251, before/after will say).
+ * So the first play after boot sets the chip up again (hp.fresh), and with boot-arg sweethapticidle=S any play
+ * after S idle seconds does too (default 0: off). ~0.7 s, mostly the RAM load. Called without hp.lock.
+ */
+static void
+hap_ensure(const char *who)
+{
+	if (!hp.ready || hp.mode < 2) {
+		return;
+	}
+	bool need = !hp.fresh;
+	uint64_t now = mach_absolute_time();
+	if (!need && hp.idle_s != 0 && hp.last != 0) {
+		uint64_t idle_ns = 0;
+		absolutetime_to_nanoseconds(now - hp.last, &idle_ns);
+		need = idle_ns / NSEC_PER_SEC >= hp.idle_s;
+	}
+	if (need) {
+		printf("SWEET HAPTIC: setting the chip up again before a play (%s, %s)\n", who, hp.fresh ? "idle" : "first since boot");
+		if (hap_configure(true, false) != 0) {
+			printf("SWEET HAPTIC: set-up FAILED\n");
+		}
+	}
+	hp.last = mach_absolute_time();
+}
+
+/*
+ * 0255: the motor for iOS's haptics as waveforms. The audio plug-in HakiosAudio.driver (userland/audio, from
+ * ios-apollo / hakios-apollo) gives mediaserverd an "Actuator" device, the Taptic Engine of an iPhone X; iOS (VibeSynth,
+ * Core Haptics, UIKit level 2, system sounds) plays its haptics on it as 48 kHz int16 mono, and the plug-in writes them
+ * to /dev/apollo-haptic or /dev/hakios-haptic. Made here as /dev/hakios-haptic (0666). The service is ios-apollo's
+ * (xnu 0146 sweet_haptic.c's serve(), from hakios-apollo's hakios.apollo_haptic.c, APSL 2.0) for the same AW8697,
+ * on this driver's functions and OnePlus's RAM waveforms (research/haptics/README.md):
+ *   a waveform of iOS's after a pause is a tap, once its first SETTLE_US say how strong: waveform 20 (heavy) from
+ *   two thirds of full scale, 5 from a third, else 2; one that goes on past TAP_US, the looped buzz (waveform 10)
+ *   until iOS stops, at most HAPTIC_MAX_MS; the gain (DATDBG) follows its strength. At most HAPTIC_MAX_MS of driving
+ *   in any DUTY_WINDOW_MS, then a rest as long. iOS plays on the Actuator only with MobileGestalt
+ *   DeviceSupportsClosedLoopHaptics true (ADT /product/haptics, tools/mkadt.py --guacamole).
+ * Boot-arg sweethapticios=0 leaves /dev/hakios-haptic out.
+ */
+#define HI_ACTIVE_US            30000
+#define HI_SILENT_BELOW         256
+#define HI_TAP_US               60000
+#define HI_SETTLE_US            8000
+#define HI_FOLLOW_US            20000
+#define HI_MAX_MS               1000
+#define HI_WINDOW_MS            2000
+#define HI_SLOT_MS              100
+#define HI_SLOTS                (HI_WINDOW_MS / HI_SLOT_MS + 1)
+#define HI_GAIN_TOP             0x80    /* Android's strongest (aw8697_haptic_effect_strength) */
+#define HI_TOLD                 24
+#define R_DATDBG                0x39
+
+static volatile uint64_t hi_heard_us, hi_quiet_us, hi_onset_us;
+static volatile uint32_t hi_peak;
+static unsigned hi_taps, hi_loops, hi_capped;
+
+static uint64_t
+hi_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+static int
+hi_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+			peak = v > peak ? v : peak;
+		}
+		uint64_t now = hi_now_us();
+		if (peak > HI_SILENT_BELOW) {
+			if (hi_heard_us == 0 || hi_quiet_us > hi_heard_us || now - hi_heard_us >= HI_ACTIVE_US) {
+				hi_onset_us = now;
+				hi_peak = 0;
+			}
+			hi_heard_us = now;
+			if (peak > hi_peak) {
+				hi_peak = peak;
+			}
+		} else {
+			hi_quiet_us = now;
+		}
+	}
+	return error;
+}
+
+static int
+hi_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw hi_cdevsw = {
+	.d_open = hi_open, .d_close = hi_open, .d_read = eno_rdwrt, .d_write = hi_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static uint8_t
+hi_gain(uint32_t peak)
+{
+	uint32_t top = HI_GAIN_TOP, low = top / 4, third = 32767 / 3;
+	return (uint8_t)(peak >= third ? top : low + (top - low) * peak / third);
+}
+
+/* hp.lock held */
+static int
+hi_start(uint8_t wave, bool forever, uint8_t gain)
+{
+	return hap_play_gain(wave, forever ? 15 : 0, gain);
+}
+
+static void
+hi_thread(__unused void *arg, __unused wait_result_t result)
+{
+	enum { IDLE, TAP, LOOP, REST } state = IDLE;
+	uint64_t since = 0, rest_until = 0, tap_onset = 0, followed = 0, oneshot_at = 0, health_at = 0;
+	uint8_t playing_gain = 0;
+	uint32_t driven[HI_SLOTS] = { 0 };
+	uint64_t duty_slot = hi_now_us() / (HI_SLOT_MS * 1000), duty_last = hi_now_us();
+	int major = cdevsw_add(-1, &hi_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		printf("SWEET HAPTIC: /dev/hakios-haptic cannot be made\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	printf("SWEET HAPTIC: /dev/hakios-haptic: the motor plays iOS's Actuator (HakiosAudio.driver)\n");
+	for (;;) {
+		uint64_t now = hi_now_us(), slot = now / (HI_SLOT_MS * 1000), window = 0;
+		bool active = hi_heard_us != 0 && now - hi_heard_us < HI_ACTIVE_US;
+		uint32_t peak = hi_peak;
+		uint8_t gain = hi_gain(peak);
+		int err = 0;
+
+		for (uint64_t s = duty_slot + 1; s <= slot && s <= duty_slot + HI_SLOTS; s++) {
+			driven[s % HI_SLOTS] = 0;
+		}
+		duty_slot = slot;
+		if (state == TAP || state == LOOP) {
+			uint64_t spent = now - duty_last;
+			driven[slot % HI_SLOTS] += spent > HI_WINDOW_MS * 1000ull ? HI_WINDOW_MS * 1000u : (uint32_t)spent;
+		}
+		duty_last = now;
+		for (unsigned i = 0; i < HI_SLOTS; i++) {
+			window += driven[i];
+		}
+		if ((state == TAP || state == LOOP) && window >= HI_MAX_MS * 1000ull) {
+			lck_mtx_lock(hp.lock);
+			(void)hap_stop();
+			lck_mtx_unlock(hp.lock);
+			++hi_capped;
+			rest_until = now + HI_MAX_MS * 1000ull;
+			state = REST;
+			printf("SWEET HAPTIC: ios: %llu ms of driving in %u ms: stopped, rests %u ms\n", window / 1000, HI_WINDOW_MS,
+			    HI_MAX_MS);
+			hap_wait(4);
+			continue;
+		}
+		switch (state) {
+		case IDLE:
+		case TAP:
+			if (state == IDLE && oneshot_at && now - oneshot_at >= 300000 && now - health_at >= 250000) {
+				uint8_t go = 0, glb = 0;
+				health_at = now;
+				lck_mtx_lock(hp.lock);
+				(void)hap_read(R_GO, &go);
+				(void)hap_read(R_GLBSTATE, &glb);
+				if ((go & 1) && (glb & 0x0f) == 7) {
+					uint8_t ctrl = 0;
+					(void)hap_read(R_SYSCTRL, &ctrl);
+					++hi_wedged;
+					printf("SWEET HAPTIC: wedged (GO %u SYSCTRL %#x GLB %#x), set up again\n", go & 1, ctrl, glb);
+					int rc = hap_configure_locked(true, false);
+					hp.ready = rc == 0;
+					hp.fresh = hp.ready;
+				} else {
+					oneshot_at = 0;
+				}
+				lck_mtx_unlock(hp.lock);
+			}
+			if (active && hi_onset_us != tap_onset && now - hi_onset_us >= HI_SETTLE_US) {
+				uint64_t began = hi_onset_us;
+				tap_onset = began;
+				if (window >= HI_MAX_MS * 1000ull || !hp.ready) {
+					break;
+				}
+				uint8_t wave = peak >= 32767u * 2 / 3 ? 20 : peak >= 32767u / 3 ? 5 : 2;
+				hap_ensure("ios");
+				lck_mtx_lock(hp.lock);
+				err = hi_start(wave, false, gain ? gain : 1);
+				lck_mtx_unlock(hp.lock);
+				if (err) {
+					break;
+				}
+				state = TAP;
+				since = now;
+				++hi_taps;
+				hi_last_peak = peak;
+				hi_last_wave = wave;
+				if (now - hi_last_log_us >= 1000000) {
+					printf("SWEET HAPTIC: ios: tap %u: peak %u of 32768 -> waveform %u gain %#x\n", hi_taps, peak, wave,
+					    gain);
+					hi_last_log_us = now;
+				}
+				break;
+			}
+			if (state == IDLE) {
+				break;
+			}
+			if (active && hi_quiet_us < tap_onset && now - since > HI_TAP_US) {
+				lck_mtx_lock(hp.lock);
+				err = hi_start(10, true, gain ? gain : 1);
+				lck_mtx_unlock(hp.lock);
+				if (!err) {
+					state = LOOP;
+					since = followed = now;
+					playing_gain = gain ? gain : 1;
+					hi_peak = 0;
+					++hi_loops;
+					hi_last_peak = peak;
+					hi_last_wave = 10;
+					if (now - hi_last_log_us >= 1000000) {
+						printf("SWEET HAPTIC: ios: vibration %u: peak %u -> waveform 10 looped, gain %#x\n", hi_loops,
+						    peak, playing_gain);
+						hi_last_log_us = now;
+					}
+				}
+			} else if (!active && now - since > HI_TAP_US) {
+				lck_mtx_lock(hp.lock);
+				(void)hap_stop();
+				lck_mtx_unlock(hp.lock);
+				state = IDLE;
+			}
+			break;
+		case LOOP:
+			if (active && now - followed >= HI_FOLLOW_US) {
+				followed = now;
+				hi_peak = 0;
+				if (peak != 0 && (gain > playing_gain + 8 || gain + 8 < playing_gain)) {
+					lck_mtx_lock(hp.lock);
+					(void)hap_write(R_DATDBG, gain);
+					lck_mtx_unlock(hp.lock);
+					playing_gain = gain;
+				}
+			}
+			if (!active || now - since > HI_MAX_MS * 1000ull) {
+				bool cut = now - since > HI_MAX_MS * 1000ull;
+				if (cut) {
+					++hi_capped;
+					rest_until = now + HI_MAX_MS * 1000ull;
+				}
+				lck_mtx_lock(hp.lock);
+				(void)hap_stop();
+				lck_mtx_unlock(hp.lock);
+				state = rest_until > now ? REST : IDLE;
+			}
+			break;
+		case REST:
+			if (now >= rest_until) {
+				state = IDLE;
+			}
+			break;
+		}
+		hap_wait(4);
+	}
+}
+
+static void
+hi_start_service(void)
+{
+	uint32_t on = 1;
+	thread_t t;
+	(void)PE_parse_boot_argn("sweethapticios", &on, sizeof(on));
+	if (on && kernel_thread_start(hi_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
+static void
+hap_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 50;
+	(void)PE_parse_boot_argn("sweethapticdelay", &delay_s, sizeof(delay_s));
+	hap_wait(delay_s * 1000u);
+	hp.gcc = ml_io_map(HAP_GCC_PA, 0x60000);
+	hp.south = ml_io_map(HAP_SOUTH_PA, HAP_GPIO_CFG(HAP_RST + 1));
+	hp.east = ml_io_map(HAP_EAST_PA, HAP_GPIO_CFG(HAP_IRQ + 1));
+	hp.se = ml_io_map(HAP_SE_PA, 0x4000);
+	if (!hp.gcc || !hp.south || !hp.east || !hp.se) {
+		printf("SWEET HAPTIC: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET HAPTIC: TLMM before: sda %#x scl %#x rst %#x/%#x irq %#x/%#x\n",
+	    hap_rd(hp.south, HAP_GPIO_CFG(HAP_SDA)), hap_rd(hp.south, HAP_GPIO_CFG(HAP_SCL)),
+	    hap_rd(hp.south, HAP_GPIO_CFG(HAP_RST)), hap_rd(hp.south, HAP_GPIO_IO(HAP_RST)),
+	    hap_rd(hp.east, HAP_GPIO_CFG(HAP_IRQ)), hap_rd(hp.east, HAP_GPIO_IO(HAP_IRQ)));
+	if (!hap_clocks() || !hap_se_init()) {
+		goto out;
+	}
+	if (hap_configure(hp.mode >= 2, true) == 0) {
+		hp.ready = true;
+		hp.fresh = false;                               /* 0252: set up again at the first play */
+	}
+	if (hp.ready) {
+		hi_start_service();                             /* 0255: /dev/hakios-haptic */
+	}
+out:
+	thread_terminate(current_thread());
+}
+
+/*
+ * 0249: for iokit/Kernel/arm/SweetVibrator.cpp (the "vibrator" FigVibrator drives). 0 = done, else an errno;
+ * ENODEV until the motor is configured (sweethaptic=2).
+ */
+int sweet_haptic_ready(void);
+int sweet_haptic_wave(unsigned wave);
+int sweet_haptic_buzz(int on);
+unsigned sweet_haptic_stops(void);
+/* 0250: `haptic stop` (sysctl 0) count: the vibrator's pattern player gives up when it changes */
+static volatile unsigned hap_stops;
+
+unsigned
+sweet_haptic_stops(void)
+{
+	return hap_stops;
+}
+
+int
+sweet_haptic_ready(void)
+{
+	return hp.ready;
+}
+
+int
+sweet_haptic_wave(unsigned wave)
+{
+	if (!hp.ready || wave == 0 || wave > 127) {
+		return ENODEV;
+	}
+	hap_ensure("vibrator");
+	lck_mtx_lock(hp.lock);
+	int err = hap_play((uint8_t)wave, 0);
+	lck_mtx_unlock(hp.lock);
+	return err;
+}
+
+/* on: waveform 10 looped until buzz(0); off: stop whatever plays */
+int
+sweet_haptic_buzz(int on)
+{
+	if (!hp.ready) {
+		return ENODEV;
+	}
+	if (on) {
+		hap_ensure("vibrator");
+	}
+	lck_mtx_lock(hp.lock);
+	int err = on ? hap_play(10, 15) : hap_stop();
+	lck_mtx_unlock(hp.lock);
+	return err;
+}
+
+static int
+sysctl_sweet_haptic SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = hp.ready ? HAP_ID : 0;
+	int err = sysctl_handle_int(oidp, &value, 0, req);
+	if (err || !req->newptr) {
+		return err;
+	}
+	if (value == 201) {                                             /* 0251: `haptic dump`: nothing changed */
+		if (hp.south == 0 || hp.gcc == 0 || hp.se == 0) {
+			return ENODEV;
+		}
+		printf("SWEET HAPTIC: dump: gcc vote %#x (want bits %#x) rcg %#x branches %#x %#x %#x\n",
+		    hap_rd(hp.gcc, HAP_GCC_VOTE), HAP_GCC_MASK, hap_rd(hp.gcc, HAP_RCG), hap_rd(hp.gcc, 0x17004),
+		    hap_rd(hp.gcc, 0x17008), hap_rd(hp.gcc, 0x17994));
+		printf("SWEET HAPTIC: dump: tlmm sda %#x scl %#x rst %#x/%#x irq %#x/%#x\n",
+		    hap_rd(hp.south, HAP_GPIO_CFG(HAP_SDA)), hap_rd(hp.south, HAP_GPIO_CFG(HAP_SCL)),
+		    hap_rd(hp.south, HAP_GPIO_CFG(HAP_RST)), hap_rd(hp.south, HAP_GPIO_IO(HAP_RST)),
+		    hap_rd(hp.east, HAP_GPIO_CFG(HAP_IRQ)), hap_rd(hp.east, HAP_GPIO_IO(HAP_IRQ)));
+		printf("SWEET HAPTIC: dump: se status %#x irq %#x fw %#x clk_sel %#x mclk %#x scl %#x dead %d ready %d\n",
+		    hap_rd(hp.se, SE_STATUS), hap_rd(hp.se, SE_IRQ), hap_rd(hp.se, SE_FW), hap_rd(hp.se, SE_CLK_SEL),
+		    hap_rd(hp.se, SE_MCLK), hap_rd(hp.se, SE_SCL), hp.dead, hp.ready);
+		lck_mtx_lock(hp.lock);
+		uint8_t id = 0;
+		err = hap_read(R_ID, &id);
+		printf("SWEET HAPTIC: dump: id %#x err %d irq %#x\n", id, err, hp.irq_last);
+		if (!err) {
+			hap_dump();
+		}
+		lck_mtx_unlock(hp.lock);
+		return 0;
+	}
+	if (value == 200) {                                             /* 0251: `haptic init` */
+		if (hp.mode < 2 || hp.south == 0) {
+			return ENODEV;
+		}
+		hp.ready = false;
+		err = hap_configure(true, true);
+		hp.ready = err == 0;
+		return err;
+	}
+	if ((value & ~0x1ffff) == 0x100000 && hp.south != 0) {      /* 0251: `haptic reg R [V]`: 0x100000 | w<<16 | R<<8 | V */
+		uint8_t r = (uint8_t)(value >> 8), v = (uint8_t)value, now = 0;
+		lck_mtx_lock(hp.lock);
+		err = (value & 0x10000) ? hap_write(r, v) : 0;
+		err = err ? err : hap_read(r, &now);
+		lck_mtx_unlock(hp.lock);
+		printf("SWEET HAPTIC: reg %#04x%s = %#04x (err %d)\n", r, (value & 0x10000) ? " written" : "", now, err);
+		return err;
+	}
+	if (!hp.ready) {
+		return ENODEV;
+	}
+	if (value > 127 || value < -10000) {
+		return EINVAL;
+	}
+	if (value != 0) {
+		hap_ensure("sysctl");                                   /* 0252 */
+	}
+	lck_mtx_lock(hp.lock);
+	if (value == 0) {
+		hap_stops++;                                            /* 0250: also ends SweetVibrator's pattern */
+		err = hap_stop();
+	} else if (value > 0) {
+		err = hap_play((uint8_t)value, 0);
+		hap_report("play");                                      /* 0251 */
+	} else {
+		err = hap_play(10, 15);                                  /* waveform 10, looped (OnePlus "activate") */
+		hap_report("buzz");                                      /* 0251 */
+		if (!err) {
+			hap_wait((unsigned)-value);
+			err = hap_stop();
+		}
+	}
+	lck_mtx_unlock(hp.lock);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_haptic, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_haptic, "I", "AW8697 haptics: N plays RAM waveform N, -ms buzzes, 0 stops, 200 sets the chip up again, 201 dumps");
+
+static int
+sysctl_sweet_haptic_ios SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char status[128];
+	snprintf(status, sizeof(status), "taps %u loops %u capped %u wedged %u last_peak %u last_wave %u",
+	    hi_taps, hi_loops, hi_capped, hi_wedged, hi_last_peak, hi_last_wave);
+	return sysctl_handle_string(oidp, status, sizeof(status), req);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_haptic_ios, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_haptic_ios, "A", "iOS AW8697 Actuator counters");
+
+void
+sweet_haptic_init(void)
+{
+	uint32_t mode = 1;
+	(void)PE_parse_boot_argn("sweethaptic", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	hp.mode = mode;
+	(void)PE_parse_boot_argn("sweethapticidle", &hp.idle_s, sizeof(hp.idle_s));
+	hp.grp = lck_grp_alloc_init("sweet-haptic", LCK_GRP_ATTR_NULL);
+	hp.lock = lck_mtx_alloc_init(hp.grp, LCK_ATTR_NULL);
+	thread_t t;
+	if (kernel_thread_start(hap_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif
diff -ruN ci-base/bsd/dev/sweet_keys.c ci-sweet/bsd/dev/sweet_keys.c
--- a/bsd/dev/sweet_keys.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_keys.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,298 @@
+/*
+ * Minimal polled SWEET keys. Call once after the scheduler is running.
+ * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * GUACAMOLE (OnePlus 7 Pro, PM8150): power = PON KPDPWR (SID0 0x810 bit0),
+ * volume-up = PM8150 GPIO6 (SID0 periph 0xc5), volume-down = PM8150 GPIO7
+ * (periph 0xc6, gpio-keys in the live DT) OR PON RESIN (bit1, qcom,pon_2
+ * linux,code 114 in the same DT); both GPIOs are active low.
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
+ * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ * Alert Slider (DT tri_state_key, "oneplus, tri-state-key"): TLMM gpio125
+ * (top), gpio134 (middle), gpio27 (bottom; physical order checked on the
+ * phone: silent at the top, ring at the bottom), function gpio, bias-disable,
+ * active low: exactly one pin reads 0 per position. Tiles from Linux
+ * pinctrl-sm8150.c (27 EAST, 125 WEST, 134 SOUTH; one 0x1000 page per pin,
+ * GPIO_IN_OUT at +4 bit 0). The bootloader leaves them pulled down (cfg 0x1),
+ * which reads 0 on all three; the one write is GPIO_CFG = 0 (gpio function,
+ * 2 mA, input, no pull), the DT's tri_state_key_active that Android applies.
+ * Top and middle (OnePlus silent / vibrate) are iOS silent, bottom rings.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+extern unsigned sweet_hid_ringer(int silent);
+void sweet_keys_init(void);
+
+#define KEYS_CORE_PA     0x0c440000u
+#define KEYS_OBS_PA      0x0e600000u
+#define KEYS_CNFG_PA     0x0c40a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_VUP_RT      0xc510u    /* PM8150 GPIO6 INT_RT_STS */
+#define KEYS_VDN_RT      0xc610u    /* PM8150 GPIO7 INT_RT_STS */
+#define KEYS_NO_APID     0xffffu
+
+#define SLIDER_PINS      3
+static const uint32_t slider_pa[SLIDER_PINS] = {
+	0x03100000u + 125u * 0x1000u,   /* top, WEST */
+	0x03d00000u + 134u * 0x1000u,   /* middle, SOUTH */
+	0x03500000u + 27u * 0x1000u,    /* bottom, EAST */
+};
+static vm_offset_t slider_cfg[SLIDER_PINS];
+static int slider_mode;             /* sweetslider: 0 off, 1 on, 2 inverted (silent rings) */
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_vup_apid = KEYS_NO_APID,
+    keys_vdn_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* Position 0 top, 1 middle, 2 bottom; -1 while moving (no pin or two low). */
+static int
+slider_read(uint32_t *bits)
+{
+	int pos = -1, low = 0;
+	*bits = 0;
+	for (int i = 0; i < SLIDER_PINS; ++i) {
+		uint32_t v = keys_rd(slider_cfg[i], 4) & 1u;
+		*bits |= v << i;
+		if (!v) {
+			pos = i;
+			++low;
+		}
+	}
+	return low == 1 ? pos : -1;
+}
+
+/*
+ * Reports a stable position once after it changes (three equal reads,
+ * 60 ms), and keeps repeating the first one until a HID client (backboardd)
+ * is listening, so iOS starts with the real switch state.
+ */
+static void
+slider_poll(void)
+{
+	static int last = -2, count, sent = -2;
+	static unsigned retries;
+	uint32_t bits;
+	int pos = slider_read(&bits);
+	if (pos != last) {
+		last = pos;
+		count = 0;
+		return;
+	}
+	if (pos < 0 || ++count < 3 || pos == sent) {
+		return;
+	}
+	int silent = pos != 2;
+	if (slider_mode == 2) {
+		silent = !silent;
+	}
+	unsigned clients = sweet_hid_ringer(silent);
+	if (sent != -2 || clients || (retries++ % 250u) == 0) {
+		printf("SWEET KEYS: slider %s (pins %#x) -> %s, %u HID clients\n",
+		    pos == 0 ? "top" : pos == 1 ? "middle" : "bottom", bits,
+		    silent ? "silent" : "ring", clients);
+	}
+	if (clients) {
+		sent = pos;
+	}
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, vup = 0xff, vdn = 0xff;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool uok = keys_read(keys_vup_apid, KEYS_VUP_RT, &vup);
+		bool dok = keys_read(keys_vdn_apid, KEYS_VDN_RT, &vdn);
+		/* 0 power, 1 volume up, 2 volume down (sweet_hid_key numbering) */
+		int now[3] = {
+			pok && (pon & 1u),
+			uok && !(vup & 1u),
+			(pok && (pon & 2u)) || (dok && !(vdn & 1u)),
+		};
+		bool ok[3] = {pok, uok, pok || dok};
+		if (!pok || (keys_vup_apid != KEYS_NO_APID && !uok) ||
+		    (keys_vdn_apid != KEYS_NO_APID && !dok)) {
+			if ((errors++ % 250u) == 0) {
+				printf("SWEET KEYS: read error pon-ok=%d vup-ok=%d vdn-ok=%d arb-status=%#x\n",
+				    pok, uok, dok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if (ok[k] && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio6=%#x gpio7=%#x\n",
+				    k, state[k], pon, vup, vdn);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		if (slider_mode) {
+			slider_poll();
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS: MMIO mapping failed\n");
+		return;
+	}
+	slider_mode = 1;
+	(void)PE_parse_boot_argn("sweetslider", &slider_mode, sizeof(slider_mode));
+	for (int i = 0; slider_mode && i < SLIDER_PINS; ++i) {
+		slider_cfg[i] = ml_io_map(slider_pa[i], 0x1000);
+		if (!slider_cfg[i]) {
+			printf("SWEET KEYS: slider MMIO mapping failed\n");
+			slider_mode = 0;
+		}
+	}
+	if (slider_mode) {
+		uint32_t was[SLIDER_PINS], bits;
+		for (int i = 0; i < SLIDER_PINS; ++i) {
+			was[i] = keys_rd(slider_cfg[i], 0);
+			*(volatile uint32_t *)slider_cfg[i] = 0;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		delay(1000);
+		int pos = slider_read(&bits);
+		printf("SWEET KEYS: slider cfg %#x/%#x/%#x -> 0, pins %#x position %d (mode %d)\n",
+		    was[0], was[1], was[2], bits, pos, slider_mode);
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("SWEET KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(0x008, count);
+	keys_vup_apid = keys_find_apid(0x0c5, count);
+	keys_vdn_apid = keys_find_apid(0x0c6, count);
+	uint8_t pon = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u pon=%#x/%d gpio6-apid=%u gpio7-apid=%u\n",
+	    keys_version, count, keys_pon_apid, pon, pok, keys_vup_apid, keys_vdn_apid);
+	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+	uint16_t *apids[2] = {&keys_vup_apid, &keys_vdn_apid};
+	for (int g = 0; g < 2; ++g) {
+		uint16_t base = (uint16_t)(0xc500u + 0x100u * (unsigned)g);
+		uint8_t st = 0, mode = 0, en = 0, subtype = 0;
+		bool rok = keys_read(*apids[g], base + 0x10u, &st);
+		bool mok = keys_read(*apids[g], base + 0x40u, &mode);
+		bool eok = keys_read(*apids[g], base + 0x46u, &en);
+		bool sok = keys_read(*apids[g], base + 0x05u, &subtype);
+		unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+		    mode & 3u : (mode >> 4) & 7u;
+		printf("SWEET KEYS: gpio%d rt=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d dir=%u\n",
+		    6 + g, st, rok, mode, mok, en, eok, subtype, sok, dir);
+		if (!rok || !eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+			printf("SWEET KEYS: gpio%d not confirmed enabled as input; withheld, PMIC unchanged\n", 6 + g);
+			*apids[g] = KEYS_NO_APID;
+		}
+	}
+	if (!pok && keys_vup_apid == KEYS_NO_APID && keys_vdn_apid == KEYS_NO_APID) {
+		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_mailbox.c ci-sweet/bsd/dev/sweet_mailbox.c
--- a/bsd/dev/sweet_mailbox.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_mailbox.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,299 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEETBOX: kernel-side extractor for files deployed via the logdump partition.
+ *
+ * tools/sweet-mailbox.py packs files into a raw image:
+ *   [SWEETBOX magic 8 B][file count 4 B][name_len 2 B][name][data_len 4 B][data]...
+ * sweet_mailbox_probe() (boot-arg sweetmailbox=1) reads that image from
+ * "logdump" via sweet_ufs_read_partition(), extracts each file to
+ * /private/var/tmp/<name> on the iOS root (flat: "/" in names becomes "_";
+ * the kernel has no mkdir KPI), then stamps the partition with
+ * SWEETDNE so the kernel skips it on the next boot.
+ *
+ * Entries named ROOT/<path> are not extracted there. With boot-arg
+ * sweetboxroot=1, sweet_mailbox_root_install() writes them to /<path> on
+ * the root right after it mounts (bsd_init, before launchd), so a
+ * launchd.plist from the box is used by this very boot, and a broken one
+ * can be replaced the same way. The parent directory must exist.
+ *
+ * After each extraction the thread writes BOX_DONE_FILE (its text: how many
+ * files). /usr/libexec/sweet-autorun waits for it before it runs
+ * /private/var/tmp/autorun.sh, so every file from the box is in place.
+ * Before launchd the root pass empties it: there is no RTC, the clock starts
+ * at 0 on every boot, so the last boot's file looked newer than this boot
+ * (0116 on the phone: autorun found it before the box was extracted).
+ * sweet-autorun waits for it to be non-empty.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/uio.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_ufs_read_partition(const char *part, uint64_t offset,
+    uint32_t size, void **buf_out);
+extern int sweet_ufs_stamp_partition(const char *part, const uint8_t sector[512]);
+
+#define BOX_MAGIC      "SWEETBOX"
+#define BOX_MAGIC_DONE "SWEETDNE"
+#define BOX_MAGIC_LEN  8
+#define BOX_MAX_SIZE   (64u * 1024u * 1024u)
+#define BOX_BASE_DIR   "/private/var/tmp"
+#define BOX_DONE_FILE  BOX_BASE_DIR "/SWEETBOX.done"
+#define BOX_ROOT       "ROOT/"
+#define BOX_ROOT_LEN   5
+
+/* ROOT/ entries the root pass wrote this boot (for the SWEETDNE stamp). */
+static unsigned box_root_installed;
+
+static void
+box_wait_ms(unsigned ms)
+{
+	uint64_t d;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &d);
+	assert_wait_deadline((event_t)&box_wait_ms, THREAD_UNINT, d);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+box_write_file(const char *path, const uint8_t *data, uint32_t size, vfs_context_t ctx)
+{
+	struct vnode *vp = NULLVP;
+	/* vnode_open takes kernel F-flags (FWRITE), not O_WRONLY. */
+	int err = vnode_open(path, FWRITE | O_CREAT, 0755, 0, &vp, ctx);
+	if (err || vp == NULLVP) {
+		printf("SWEET BOX: open %s: %d\n", path, err);
+		return err ? err : ENOENT;
+	}
+	/*
+	 * vnode_open() ignores O_TRUNC (vn_open_auth leaves it to the open
+	 * syscall), so a shorter file kept the old one's tail and 0118 did not
+	 * empty SWEETBOX.done. Truncate like kern_core.c does.
+	 */
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, 0);
+	err = vnode_setattr(vp, &va, ctx);
+	if (err) {
+		printf("SWEET BOX: truncate %s: %d\n", path, err);
+	}
+	if (!err && size) {
+		uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+		uio_addiov(uio, (user_addr_t)(uintptr_t)data, size);
+		err = VNOP_WRITE(vp, uio, 0, ctx);
+		uio_free(uio);
+	}
+	int cerr = vnode_close(vp, FWRITE, ctx);
+	return err ? err : cerr;
+}
+
+/* No empty, "." or ".." components: ROOT/ paths stay what they say. */
+static bool
+box_root_path_ok(const char *path)
+{
+	const char *c = path;
+	for (;;) {
+		const char *e = strchr(c, '/');
+		size_t n = e ? (size_t)(e - c) : strlen(c);
+		if (n == 0 || (n == 1 && c[0] == '.') || (n == 2 && c[0] == '.' && c[1] == '.')) {
+			return false;
+		}
+		if (!e) {
+			return true;
+		}
+		c = e + 1;
+	}
+}
+
+/*
+ * Reads the box from the partition in boot-arg sweetboxpart (default
+ * logdump). Returns the buffer (BOX_MAX_SIZE, kmem_free it) when it holds an
+ * unextracted box, else NULL.
+ */
+static void *
+box_read(const char *part, uint32_t *nfiles_out)
+{
+	void *buf = NULL;
+	int err = sweet_ufs_read_partition(part, 0, BOX_MAX_SIZE, &buf);
+	if (err || !buf) {
+		printf("SWEET BOX: read %s: %d%s\n", part, err,
+		    err == ENOENT ? " (not on UFS LUN 0; pick one with sweetboxpart=)" : "");
+		return NULL;
+	}
+	printf("SWEET BOX: using partition %s\n", part);
+	const uint8_t *p = (const uint8_t *)buf;
+	uint32_t nfiles = 0;
+	if (memcmp(p, BOX_MAGIC_DONE, BOX_MAGIC_LEN) == 0) {
+		printf("SWEET BOX: SWEETDNE â€” already extracted, skipping\n");
+	} else if (memcmp(p, BOX_MAGIC, BOX_MAGIC_LEN) != 0) {
+		printf("SWEET BOX: no SWEETBOX magic, skipping\n");
+	} else {
+		memcpy(&nfiles, p + BOX_MAGIC_LEN, 4);
+		if (nfiles == 0 || nfiles > 512) {
+			printf("SWEET BOX: bad file count %u\n", nfiles);
+			nfiles = 0;
+		}
+	}
+	if (!nfiles) {
+		kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+		return NULL;
+	}
+	*nfiles_out = nfiles;
+	return buf;
+}
+
+/*
+ * One pass over the box. root_pass: write only the ROOT/ entries, to their
+ * path on the root. Otherwise extract the rest flat to BOX_BASE_DIR.
+ * Returns how many entries of that kind were written; *total gets how many
+ * there are.
+ */
+static unsigned
+box_walk(const uint8_t *p, uint32_t nfiles, bool root_pass, unsigned *total)
+{
+	const uint8_t *cur = p + BOX_MAGIC_LEN + 4;
+	const uint8_t *end = p + BOX_MAX_SIZE;
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned written = 0, mine = 0;
+
+	for (uint32_t i = 0; i < nfiles; i++) {
+		if (cur + 2 > end) { printf("SWEET BOX: truncated\n"); break; }
+		uint16_t namelen;
+		memcpy(&namelen, cur, 2); cur += 2;
+		if (!namelen || namelen > 255 || cur + namelen + 4 > end) {
+			printf("SWEET BOX: bad entry %u\n", i); break;
+		}
+		char name[256];
+		memcpy(name, cur, namelen); name[namelen] = '\0'; cur += namelen;
+		uint32_t size;
+		memcpy(&size, cur, 4); cur += 4;
+		if (cur + size > end) { printf("SWEET BOX: %s: overrun\n", name); break; }
+		const uint8_t *data = cur;
+		cur += size;
+
+		bool is_root = strncmp(name, BOX_ROOT, BOX_ROOT_LEN) == 0;
+		if (is_root != root_pass) {
+			continue;
+		}
+		mine++;
+		char dest[512];
+		if (is_root) {
+			if (!box_root_path_ok(name + BOX_ROOT_LEN)) {
+				printf("SWEET BOX: %s: bad root path, skipped\n", name);
+				continue;
+			}
+			snprintf(dest, sizeof(dest), "/%s", name + BOX_ROOT_LEN);
+		} else {
+			for (unsigned k = 0; name[k]; k++) {
+				if (name[k] == '/') {
+					name[k] = '_';         /* flat: no directories */
+				}
+			}
+			if (name[0] == '.') {
+				name[0] = '_';             /* no ".." or hidden names */
+			}
+			snprintf(dest, sizeof(dest), BOX_BASE_DIR "/%s", name);
+		}
+		if (box_write_file(dest, data, size, ctx) == 0) {
+			printf("SWEET BOX: %s %s (%u B)\n", is_root ? "installed" : "extracted", dest, size);
+			written++;
+		}
+	}
+	*total = mine;
+	return written;
+}
+
+static void
+box_part(char part[40])
+{
+	/* The UFS driver only talks to LUN 0 (where userdata is). 0113 asked
+	 * for logdump and got ENOENT: it lives on another LUN. The partition
+	 * is a boot-arg so no rebuild is needed to move it. */
+	strlcpy(part, "logdump", 40);
+	(void)PE_parse_boot_arg_str("sweetboxpart", part, 40);
+}
+
+static void
+box_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	box_wait_ms(30000);
+
+	char part[40];
+	box_part(part);
+	uint32_t nfiles = 0;
+	void *buf = box_read(part, &nfiles);
+	if (!buf) {
+		goto out;
+	}
+	printf("SWEET BOX: %u file(s) to extract\n", nfiles);
+	unsigned total = 0;
+	unsigned extracted = box_walk(buf, nfiles, false, &total);
+	unsigned root_total = nfiles - total;
+	printf("SWEET BOX: done, %u/%u files, %u/%u root files\n",
+	    extracted, total, box_root_installed, root_total);
+	char done[32];
+	int n = snprintf(done, sizeof(done), "%u/%u\n", extracted, total);
+	int derr = box_write_file(BOX_DONE_FILE, (const uint8_t *)done, (uint32_t)n, vfs_context_kernel());
+	printf("SWEET BOX: wrote " BOX_DONE_FILE ": %d\n", derr);
+	if (extracted == total && box_root_installed == root_total) {
+		uint8_t stamp[512];
+		bzero(stamp, sizeof(stamp));
+		memcpy(stamp, BOX_MAGIC_DONE, BOX_MAGIC_LEN);
+		int err = sweet_ufs_stamp_partition(part, stamp);
+		printf("SWEET BOX: stamped SWEETDNE: %d\n", err);
+	}
+	kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* bsd_init, right after the root is mounted and before launchd runs. */
+void
+sweet_mailbox_root_install(void)
+{
+	unsigned enabled = 0, root = 0;
+	(void)PE_parse_boot_argn("sweetmailbox", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetboxroot", &root, sizeof(root));
+	if (!enabled) {
+		return;
+	}
+	int err = box_write_file(BOX_DONE_FILE, NULL, 0, vfs_context_kernel());
+	printf("SWEET BOX: emptied " BOX_DONE_FILE ": %d\n", err);
+	if (!root) {
+		return;
+	}
+	char part[40];
+	box_part(part);
+	uint32_t nfiles = 0;
+	void *buf = box_read(part, &nfiles);
+	if (!buf) {
+		return;
+	}
+	unsigned total = 0;
+	box_root_installed = box_walk(buf, nfiles, true, &total);
+	printf("SWEET BOX: root pass, %u/%u files installed\n", box_root_installed, total);
+	kmem_free(kernel_map, (vm_offset_t)buf, BOX_MAX_SIZE);
+}
+
+void
+sweet_mailbox_probe(void)
+{
+	unsigned enabled = 0;
+	(void)PE_parse_boot_argn("sweetmailbox", &enabled, sizeof(enabled));
+	if (!enabled) return;
+	printf("SWEET BOX: enabled, will extract logdump -> /private/var/tmp/ after root mount\n");
+	thread_t t;
+	if (kernel_thread_start(box_thread, NULL, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_pmem.c ci-sweet/bsd/dev/sweet_pmem.c
--- a/bsd/dev/sweet_pmem.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_pmem.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,387 @@
+/*
+ * /dev/pmem: physical memory for userland hardware experiments (the GPU
+ * bring-up in work/userland/gpu runs on it over SSH, no reboot per try).
+ * Root only (0600); boot-arg sweetpmem=0 leaves the node out.
+ *
+ *   pread/pwrite at offset = physical address.
+ *     Managed DRAM goes through the physical aperture with the lines
+ *     cleaned+invalidated to the point of coherency before and after, so
+ *     data a device wrote is seen and CPU writes reach memory (IO is not
+ *     coherent here). Anything else (MMIO, carve-outs such as the panel
+ *     framebuffer) is mapped as device memory and accessed with 32-bit
+ *     loads/stores only: offset and length must be multiples of 4.
+ *     Reading an unclocked block hangs the SoC, as with poke scripts.
+ *   ioctl PMEM_ALLOC   {size, align} -> {pa}: zeroed, physically contiguous
+ *                      kernel memory (stays until PMEM_FREE, survives exit)
+ *   ioctl PMEM_FREE    {pa}
+ *   ioctl PMEM_SMC     x0..x7 in, x0..x3 out (SMCCC; e.g. SCM PAS calls)
+ *   ioctl PMEM_LIST    allocation table, for tools that lost their state
+ *   ioctl PMEM_RPMH    one RPMh active vote: resource name, 1-4 (offset, value) commands
+ *                      (ARC levels, VRM rails; bsd/dev/sweet_rpmh.c)
+ *
+ * Userland side: userland/wland/pmem.h (same structs and numbers).
+ *
+ * guacamole (0138): from ios-flame (NWylynko/ios-flame) patches 0094 and
+ * 0102, for its userland Wi-Fi daemon wland (modem boot over SCM, SMEM,
+ * GLINK, the WLAN copy engines). Changes: off unless boot-arg sweetpmem=1
+ * (root gets all of physical memory and SMC); MMIO goes through mmio_rd/
+ * mmio_wr, single base-register ldr/str, because the hypervisor traps some
+ * SMMU registers and decodes only that form (as sweet_gpu.c's rd/wr).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+void sweet_pmem_init(void);
+
+struct pmem_alloc {
+	uint64_t size;          /* in: bytes (rounded up to pages) */
+	uint64_t align;         /* in: bytes, power of 2, 0 = page */
+	uint64_t pa;            /* out */
+};
+struct pmem_smc {
+	uint64_t x[8];
+};
+#define PMEM_LIST_MAX   64
+struct pmem_list {
+	uint32_t count;
+	uint32_t pad;
+	struct {
+		uint64_t pa, size;
+	} ent[PMEM_LIST_MAX];
+};
+#define PMEM_ALLOC      _IOWR('P', 1, struct pmem_alloc)
+#define PMEM_FREE       _IOW('P', 2, uint64_t)
+#define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
+#define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name, e.g. "mss.lvl", "ldoa1" */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+#define PMEM_MAPS       16              /* 2 MB device windows, round robin */
+#define PMEM_WIN        0x200000ULL
+
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} pm_alloc[PMEM_LIST_MAX];
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} pm_map[PMEM_MAPS];
+static unsigned pm_map_next;
+static uint32_t pm_bounce[PAGE_SIZE / 4];
+
+static inline uint32_t
+mmio_rd(volatile uint32_t *p)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	return v;
+}
+
+static inline void
+mmio_wr(volatile uint32_t *p, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"(p) : "memory");
+}
+
+static LCK_GRP_DECLARE(sweet_pmem_grp, "sweet_pmem");
+static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
+
+/*
+ * Device mapping of the 2 MB window holding pa, from a small round-robin
+ * cache. ml_io_map's mappings are permanent (unmapping one panics) and come
+ * from the small io_submap (a 2 MB one panicked "kmem_alloc failed"), so
+ * windows use ml_io_map_unmappable: kernel_map, freed by ml_io_unmap.
+ */
+static volatile uint32_t *
+pm_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(PMEM_WIN - 1);
+	for (unsigned i = 0; i < PMEM_MAPS; i++) {
+		if (pm_map[i].va && pm_map[i].win == win) {
+			return (volatile uint32_t *)(pm_map[i].va + (pa - win));
+		}
+	}
+	unsigned i = pm_map_next++ % PMEM_MAPS;
+	if (pm_map[i].va) {
+		ml_io_unmap(pm_map[i].va, PMEM_WIN);
+	}
+	pm_map[i].va = ml_io_map_unmappable((vm_offset_t)win, PMEM_WIN, VM_WIMG_IO);
+	pm_map[i].win = win;
+	return pm_map[i].va ? (volatile uint32_t *)(pm_map[i].va + (pa - win)) : NULL;
+}
+
+static int
+pm_rw(struct uio *uio, bool write)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	while (!err && uio_resid(uio) > 0) {
+		uint64_t pa = (uint64_t)uio_offset(uio);
+		uint64_t off = pa & PAGE_MASK;
+		unsigned n = (unsigned)MIN((user_ssize_t)(PAGE_SIZE - off), uio_resid(uio));
+		if (pmap_valid_address(pa)) {
+			caddr_t va = (caddr_t)phystokv(pa);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			err = uiomove(va, (int)n, uio);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			continue;
+		}
+		if ((pa | n) & 3) {
+			err = EINVAL;
+			break;
+		}
+		volatile uint32_t *r = pm_io(pa);
+		if (r == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		if (write) {
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			for (unsigned i = 0; !err && i < n / 4; i++) {
+				mmio_wr(r + i, pm_bounce[i]);
+			}
+			__asm__ volatile ("dsb osh" ::: "memory");
+		} else {
+			for (unsigned i = 0; i < n / 4; i++) {
+				pm_bounce[i] = mmio_rd(r + i);
+			}
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+		}
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static int
+pm_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, false);
+}
+
+static int
+pm_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, true);
+}
+
+static int
+pm_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+pm_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+pm_smc_once(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x[0] = x0;
+	x[1] = x1;
+	x[2] = x2;
+	x[3] = x3;
+	x[6] = x6;
+}
+
+/*
+ * Qualcomm TZ returns QCOM_SCM_INTERRUPTED (1) when a non-secure interrupt
+ * arrives during a call (the shim never saw it: interrupts off). Like
+ * Linux's __scm_smc_do_quirk: call again with x0 = 1, the same arguments
+ * and the x6 TZ handed back (ARM_SMCCC_QUIRK_QCOM_A6), on the same CPU,
+ * until a final result.
+ */
+#define QCOM_SCM_INTERRUPTED    1
+
+static void
+pm_smc(struct pmem_smc *s)
+{
+	uint64_t x[8], fn = s->x[0];
+	unsigned resumes = 0;
+	memcpy(x, s->x, sizeof(x));
+	_disable_preemption();
+	for (;;) {
+		pm_smc_once(x);
+		if (x[0] != QCOM_SCM_INTERRUPTED || resumes >= 100000) {
+			break;
+		}
+		uint64_t a6 = x[6];
+		memcpy(x, s->x, sizeof(x));
+		x[0] = QCOM_SCM_INTERRUPTED;
+		x[6] = a6;
+		resumes++;
+	}
+	_enable_preemption();
+	memcpy(s->x, x, 4 * sizeof(uint64_t));
+	if (resumes) {
+		printf("SWEET PMEM: smc %llx resumed %u times -> %llx\n", fn, resumes, x[0]);
+	}
+}
+
+static int
+pm_do_alloc(struct pmem_alloc *a)
+{
+	vm_size_t size = round_page(a->size);
+	uint64_t align = a->align > PAGE_SIZE ? a->align : PAGE_SIZE;
+	if (size == 0 || (align & (align - 1))) {
+		return EINVAL;
+	}
+	int slot = -1;
+	for (int i = 0; i < PMEM_LIST_MAX; i++) {
+		if (!pm_alloc[i].va) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		return ENOSPC;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, size, PAGE_MASK, 0, (ppnum_t)(atop_64(align) - 1),
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (!pn) {
+		kmem_free(kernel_map, va, size);
+		return ENOMEM;
+	}
+	a->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)a->pa, (unsigned)size, TRUE);
+	pm_alloc[slot].va = va;
+	pm_alloc[slot].pa = a->pa;
+	pm_alloc[slot].size = size;
+	printf("SWEET PMEM: alloc %llu bytes at 0x%llx (pid %d)\n", (uint64_t)size, a->pa, proc_selfpid());
+	return 0;
+}
+
+static int
+pm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	switch (cmd) {
+	case PMEM_ALLOC:
+		err = pm_do_alloc((struct pmem_alloc *)data);
+		break;
+	case PMEM_FREE: {
+		uint64_t pa = *(uint64_t *)data;
+		err = ENOENT;
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va && pm_alloc[i].pa == pa) {
+				kmem_free(kernel_map, pm_alloc[i].va, (vm_size_t)pm_alloc[i].size);
+				pm_alloc[i].va = 0;
+				err = 0;
+				break;
+			}
+		}
+		break;
+	}
+	case PMEM_SMC:
+		pm_smc((struct pmem_smc *)data);
+		break;
+	case PMEM_LIST: {
+		struct pmem_list *l = (struct pmem_list *)data;
+		bzero(l, sizeof(*l));
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va) {
+				l->ent[l->count].pa = pm_alloc[i].pa;
+				l->ent[l->count].size = pm_alloc[i].size;
+				l->count++;
+			}
+		}
+		break;
+	}
+	case PMEM_RPMH: {
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		lck_mtx_unlock(&sweet_pmem_lock);       /* waits up to 100 ms; not under our lock */
+		err = sweet_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("SWEET PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
+	default:
+		err = ENOTTY;
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static const struct cdevsw sweet_pmem_cdevsw = {
+	.d_open       = pm_open,
+	.d_close      = pm_close,
+	.d_read       = pm_read,
+	.d_write      = pm_write,
+	.d_ioctl      = pm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+sweet_pmem_init(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetpmem", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sweet_pmem_cdevsw);
+	if (major < 0) {
+		printf("SWEET PMEM: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "pmem");
+	printf("SWEET PMEM: /dev/pmem ready (major %d)\n", major);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_rpmh.c ci-sweet/bsd/dev/sweet_rpmh.c
--- a/bsd/dev/sweet_rpmh.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_rpmh.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,451 @@
+/*
+ * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+int sweet_cmd_db_aux(const char *res, uint16_t *out, unsigned max, unsigned *count);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_ARC          3u
+#define RH_BCM          5u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("SWEET RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("SWEET RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("SWEET RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			/* 0147: BCM (bus clock manager) resources too: the GPU's DDR vote (sweet_gpu.c) */
+			if ((slave != RH_VRM && slave != RH_ARC && slave != RH_BCM) || (addr >> 16) != slave ||
+			    (addr & 15u) || !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("SWEET RPMH: invalid VRM/ARC/BCM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * GUACAMOLE: cmd-db auxiliary data of one resource (any slave type), as
+ * the little-endian 16-bit words Linux's cmd_db_read_aux_data() returns:
+ * the ARC levels ("gfx.lvl", "cx.lvl", "mx.lvl") the GMU perf table needs.
+ * Read-only; no RSC traffic.
+ */
+int
+sweet_cmd_db_aux(const char *res, uint16_t *out, unsigned max, unsigned *count)
+{
+	int err = rh_map();
+	if (err) {
+		return err;
+	}
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned n = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, n * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < n; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t len = rh_db16(e + 20), off = aux + rh_db16(e + 22);
+			if ((len & 1u) || !rh_range(off, len)) {
+				return EINVAL;
+			}
+			unsigned words = len / 2u;
+			for (unsigned k = 0; k < words && k < max; ++k) {
+				out[k] = rh_db16(off + 2u * k);
+			}
+			*count = words < max ? words : max;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited request for %#x in TCS%u\n", address, t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	uint32_t mask = (1u << n) - 1u;
+	printf("SWEET RPMH: TCS%u ACTIVE %u commands at %#x (first %#x=%u) irq-enable=%#x\n", t, n, address,
+	    offsets[0], values[0], irq_en);
+	for (unsigned c = 0; c < n; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, mask) || !rh_sync(b + RH_ENABLE, mask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[4] = {0, 0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < n; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	return rh_send_cmds(address, 3, offsets, values);
+}
+
+/*
+ * Any VRM or ARC resource, 1-4 commands (offset from the resource address,
+ * value): for /dev/pmem's PMEM_RPMH (userland bring-up of the modem and
+ * WLAN: ARC levels of cx/mss, WLAN rails). No policy: a debugging path.
+ */
+int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+int
+sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	if (!res || n == 0 || n > 4) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, &address);
+		}
+		if (!error) {
+			error = rh_send_cmds(address, n, offsets, values);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	/* GUACAMOLE: the touch rail is pm8150 L17A, DT range 2856..3008 mV. */
+	if (!res || strcmp(res, "ldoa17") || mv < 2856 || mv > 3008) {
+		printf("SWEET RPMH: expected ldoa17 and 2856..3008 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_rtc.c ci-sweet/bsd/dev/sweet_rtc.c
--- a/bsd/dev/sweet_rtc.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_rtc.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,136 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Wall clock from the PM8150 RTC (guacamole).
+ *
+ * The PMIC's RTC (SPMI SID 0, peripheral 0x60; live DT qcom,pm8150_rtc_rw@6000)
+ * keeps counting seconds while the phone is off, but not from 1970: Android
+ * set its clock to "1970-04-22 01:34:15 UTC (9596055)" from it and kept the
+ * offset to real time in userdata (QTI time_daemon), which iOS has replaced.
+ * So the time is RTC + an offset of ours, kept in OFFSET_FILE on the iOS root.
+ *
+ * Boot-arg sweettime=<unix seconds> (tools/guac-mkboot.sh puts the Mac's time
+ * there when it builds an image) gives the offset afresh when it is later
+ * than what the stored offset says; then it is stored. Without either, the
+ * clock stays as it was (1970).
+ *
+ * Registers (Linux drivers/rtc/qpnp-rtc.c): RTC_CTRL +0x46 (bit 7 enabled),
+ * RTC_READ +0x48..0x4b, little endian; the low byte is read again and the four
+ * read anew if it moved on in between.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+#define RTC_BASE        0x6000u
+#define RTC_CTRL        (RTC_BASE + 0x46u)
+#define RTC_READ        (RTC_BASE + 0x48u)
+#define OFFSET_FILE     "/private/var/db/sweet-rtc-offset"
+#define SANE_TIME       1600000000ll    /* 2020: anything earlier is not the time */
+
+void sweet_rtc_init(void);
+
+static int
+rtc_read(uint32_t *secs)
+{
+	uint8_t b[4], again;
+	for (int tries = 0; tries < 3; tries++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (sweet_spmi_read(0, RTC_READ + i, &b[i]) != 0) {
+				return -1;
+			}
+		}
+		if (sweet_spmi_read(0, RTC_READ, &again) != 0) {
+			return -1;
+		}
+		if (again == b[0]) {
+			*secs = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int
+offset_load(int64_t *offset)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode *vp = NULLVP;
+	char text[32];
+	if (vnode_open(OFFSET_FILE, FREAD, 0, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	uio_addiov(uio, (user_addr_t)(uintptr_t)text, sizeof(text) - 1);
+	int err = VNOP_READ(vp, uio, 0, ctx);
+	size_t got = sizeof(text) - 1 - (size_t)uio_resid(uio);
+	uio_free(uio);
+	vnode_close(vp, FREAD, ctx);
+	if (err != 0 || got == 0) {
+		return -1;
+	}
+	text[got] = 0;
+	*offset = (int64_t)strtoq(text, NULL, 10);
+	return 0;
+}
+
+static void
+offset_store(int64_t offset)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode *vp = NULLVP;
+	char text[32];
+	int n = snprintf(text, sizeof(text), "%lld\n", (long long)offset);
+	int err = vnode_open(OFFSET_FILE, FWRITE | O_CREAT, 0644, 0, &vp, ctx);
+	if (err == 0) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, 0);       /* vnode_open does not truncate (0119) */
+		err = vnode_setattr(vp, &va, ctx);
+		if (err == 0) {
+			uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+			uio_addiov(uio, (user_addr_t)(uintptr_t)text, (user_size_t)n);
+			err = VNOP_WRITE(vp, uio, 0, ctx);
+			uio_free(uio);
+		}
+		vnode_close(vp, FWRITE, ctx);
+	}
+	printf("SWEET RTC: offset %lld stored in " OFFSET_FILE ": %d\n", (long long)offset, err);
+}
+
+/* bsd_init, after the root is mounted (the offset file lives there). */
+void
+sweet_rtc_init(void)
+{
+	uint8_t ctrl = 0;
+	uint32_t rtc;
+	if (sweet_spmi_init() != 0 || sweet_spmi_read(0, RTC_CTRL, &ctrl) != 0 || rtc_read(&rtc) != 0) {
+		printf("SWEET RTC: PM8150 RTC not readable\n");
+		return;
+	}
+	int64_t offset = 0;
+	bool stored = offset_load(&offset) == 0;
+	long long given = 0;
+	char arg[24] = "";
+	if (PE_parse_boot_arg_str("sweettime", arg, sizeof(arg))) {
+		given = strtoq(arg, NULL, 10);
+	}
+	const char *from = stored ? "file" : "none";
+	if (given >= SANE_TIME && (!stored || given > (long long)rtc + offset)) {
+		offset = (int64_t)given - (int64_t)rtc;
+		offset_store(offset);
+		from = "boot-arg sweettime";
+	}
+	int64_t now = (int64_t)rtc + offset;
+	printf("SWEET RTC: PM8150 RTC %u s (ctrl %#x), offset %lld (%s), time %lld\n", rtc, ctrl,
+	    (long long)offset, from, (long long)now);
+	if (now >= SANE_TIME) {
+		clock_set_calendar_microtime((clock_sec_t)now, 0);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_sample.c ci-sweet/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_sample.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,88 @@
+/*
+ * SWEET process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/sweet-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void sweet_sample_start(void);
+
+static char sweet_sample_names[128];
+
+static bool
+sweet_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+sweet_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	if (sweet_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	}
+}
+
+void
+sweet_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff -ruN ci-base/bsd/dev/sweet_spmi.c ci-sweet/bsd/dev/sweet_spmi.c
--- a/bsd/dev/sweet_spmi.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_spmi.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,178 @@
+/*
+ * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
+ * Reads through the observer channels; 0167 adds sweet_spmi_write for five
+ * PM8150B charger registers alone (input and charge current limits), through
+ * the write channel of an APID EE0 owns (shim/spmi.c's PON write: a write to
+ * another layout went to CrashDump on guac-probe v3). No interrupt clear,
+ * peripheral enable or other PMIC writes.
+ * Init is serialized by the single built-in SweetBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_CORE_PA 0x0c440000u
+#define SP_OBS_PA  0x0e600000u
+#define SP_CFG_PA  0x0c40a000u
+#define SP_CHN_PA  0x0c600000u   /* write channels: + 0x10000 * APID (Linux spmi-pmic-arb.c, v5) */
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+static vm_offset_t sp_chn[512];   /* write channels mapped so far */
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+sweet_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("SWEET BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("SWEET BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+int
+sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	bool charger = peripheral >= 0x10 && peripheral <= 0x13;       /* SMB5 CHGR, DCDC, BATIF, USBIN */
+	bool allowed = sid == 0 ? charger || peripheral == 0x48 ||     /* PM6150 QG */
+	    peripheral == 0x60 :                                        /* 0133: PM8150 RTC (sweet_rtc.c) */
+	    sid == 2 && (charger || peripheral == 0x15 ||                /* 0167: PM8150B Type-C (Rp) */
+	    peripheral == 0x40 || peripheral == 0x41);                  /* 0136: PM8150B FG gen4 */
+	if (!sp_ready || !out || !allowed || addr > 0xffffu) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	static const unsigned writable[] = { 0x1061, 0x1342, 0x1365, 0x1366, 0x1370 };
+	bool allowed = false;
+	for (unsigned i = 0; i < sizeof(writable) / sizeof(writable[0]); ++i) {
+		allowed |= sid == 2 && addr == writable[i];
+	}
+	if (!sp_ready || !allowed) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET CHARGE: no EE0 write channel for sid=%u addr=%#x\n", sid, addr);
+		return -1;
+	}
+	if (!sp_chn[apid]) {
+		sp_chn[apid] = ml_io_map(SP_CHN_PA + 0x10000u * apid, 0x1000);
+	}
+	vm_offset_t ch = sp_chn[apid];
+	if (!ch) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = value;                    /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4;      /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET CHARGE: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_spmi.h ci-sweet/bsd/dev/sweet_spmi.h
--- a/bsd/dev/sweet_spmi.h	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_spmi.h	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,19 @@
+/* Shared C/C++ interface. Init once, on the SweetBattery start thread. */
+#ifndef SWEET_BATTERY_SPMI_H
+#define SWEET_BATTERY_SPMI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
+int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/*
+ * 0167: one byte to a PM8150B charger register (SID 2: 0x1061 FCC, 0x1342 ICL override, 0x1365 load cfg,
+ * 0x1366 ICL options, 0x1370 USB ICL; nothing else), through a write channel owned by EE0. Thread context; 0 success.
+ */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN ci-base/bsd/dev/sweet_touch.c ci-sweet/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_touch.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,673 @@
+/*
+ * GUACAMOLE (OnePlus 7 Pro, SM8150) touch: Samsung S6SY761 at 0x48 on the
+ * QUP wrapper-2 SE0 (DT qupv3_se17 i2c@0xc80000), ported from SWEET's SE7
+ * FIFO I2C driver. Call once after the scheduler is running; all work runs
+ * on one thread. Requires boot-firmware-loaded GENI I2C firmware (Android's
+ * geni-i2c uses the same SE); votes L17A through sweet_rpmh.c.
+ * Live-DT facts: reset GPIO54, IRQ GPIO122 (active low), 1.8 V load switch
+ * GPIO119 (pull-up = on), SDA/SCL GPIO55/56 function qup17 (mux 1), all in
+ * the TLMM SOUTH tile; vdd_2v8 = pm8150_l17 at 3.008 V; panel 1440x3120.
+ * Protocol per Linux drivers/input/touchscreen/s6sy761.c. Only IC writes:
+ * TOUCH_FUNCTION=touch and SENSE_ON. No firmware upload, no PMIC writes.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+#define TOUCH_SE_PA      0x00c80000u /* QUP wrapper 2, SE0 (qupv3_se17) */
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_SOUTH_PA   0x03d00000u /* TLMM SOUTH tile (ctl = 0x1000 * gpio) */
+#define TOUCH_GCC_VOTE   0x52014u    /* APCS vote for QUP wrapper 2 */
+/* bit1 S_AHB, bit2 M_AHB, bit4 S0 (Linux gcc-sm8150.c); bits 0/3 are the
+ * wrapper-2 CORE/CORE_2X votes (same bits as sm8250's wrapper-2 register). */
+#define TOUCH_GCC_MASK   0x1fu
+#define TOUCH_RCG        0x1e148u    /* gcc_qupv3_wrap2_s0_clk_src */
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TP_ADDR          0x48u
+#define TP_RST           54u
+#define TP_IRQ           122u
+#define TP_1V8           119u
+#define TP_SDA           55u
+#define TP_SCL           56u
+#define TP_W             1440u
+#define TP_H             3120u
+/* S6SY761 commands (Linux s6sy761.c) */
+#define SY_SENSE_ON      0x10u
+#define SY_FW_INTEGRITY  0x21u
+#define SY_PANEL_INFO    0x23u
+#define SY_TOUCH_FUNC    0x30u
+#define SY_DEVICE_ID     0x52u
+#define SY_BOOT_STATUS   0x55u
+#define SY_READ_ONE      0x60u
+#define SY_READ_ALL      0x61u
+#define SY_CLEAR_STACK   0x62u
+#define SY_EVENT         8u
+#define SY_MORE_MAX      10u         /* 10 * 8 = 80 bytes <= 90-byte RX limit */
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead, probing;
+	int irq_hint;
+	unsigned clk_sel;
+	uint32_t irq_status, irq_last, active;
+	unsigned sent, got;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/* Vote on wrapper 2 + its SE0 only, preserving other clock users. */
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | TOUCH_GCC_MASK);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	printf("SWEET TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+	st.clk_sel = 0;
+	if (dfs & 1u) {
+		/* DFS: pick a performance level that is XO/1 (19.2 MHz) via the SE's
+		 * CLK_SEL; never rewrite the tables. */
+		int level = -1;
+		for (unsigned l = 0; l < 8; ++l) {
+			uint32_t lc = touch_rd(st.gcc, TOUCH_RCG + 0x1cu + 4u * l);
+			printf("SWEET TOUCH: DFS level%u cfg=%#x\n", l, lc);
+			if (level < 0 && (lc & 0x371fu) == 1u) {
+				level = (int)l;
+			}
+		}
+		if (level < 0) {
+			printf("SWEET TOUCH: no XO/1 DFS level; need clock integration\n");
+			return false;
+		}
+		st.clk_sel = (unsigned)level;
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+			printf("SWEET TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* M_AHB, S_AHB, S0 branch halt bits (BRANCH_HALT_VOTED in Linux). */
+	const uint32_t branches[] = {0x1e004, 0x1e008, 0x1e144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			continue;
+		}
+		uint32_t v = touch_rd(st.gcc, branches[i]);
+		/* S_AHB has hardware clock gating (Linux: hwcg_reg 0x1e008, bit 1).
+		 * In HWCG mode CLK_OFF follows bus activity, so Linux skips the halt
+		 * check (branch_in_hwcg_mode); do the same. */
+		if (branches[i] == 0x1e008u && (v & 2u)) {
+			printf("SWEET TOUCH: GCC branch %#x in HW gating mode (%#x); not polled\n",
+			    branches[i], v);
+			continue;
+		}
+		printf("SWEET TOUCH: GCC branch %#x halted (%#x)\n", branches[i], v);
+		return false;
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("SWEET TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+touch_irq(void)
+{
+	st.irq_last = touch_rd(st.se, SE_IRQ);
+	st.irq_status |= st.irq_last;
+	return st.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_irq();
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			st.sent = nt;
+			touch_wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = touch_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (st.got == nr && st.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	st.irq_status = st.irq_last = 0;
+	st.sent = st.got = 0;
+	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (st.probing) {
+		printf("SWEET TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, st.irq_last, st.irq_status, st.sent, st.got,
+		    touch_rd(st.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_write(const uint8_t *tx, unsigned nt)
+{
+	return touch_msg(TP_ADDR, tx, nt, NULL, 0, false);
+}
+
+static void
+touch_hex(const char *what, const uint8_t *b, unsigned n)
+{
+	char line[3 * 16 + 1];
+	unsigned k = n > 16 ? 16 : n;
+	for (unsigned j = 0; j < k; ++j) {
+		(void)snprintf(line + j * 3u, 4, "%02x ", b[j]);
+	}
+	line[k * 3u] = 0;
+	printf("SWEET TOUCH: %s: %s\n", what, line);
+}
+
+/* One S6SY761 coordinate/status event; updates the running contact set. */
+static int
+touch_event(const uint8_t *e, uint32_t *mask, int *x, int *y)
+{
+	if ((e[0] & 3u) != 0) {
+		return 0; /* status / info event: ignore */
+	}
+	unsigned tid = (e[0] & 0x3cu) >> 2;
+	if (tid == 0 || tid > TOUCH_MAX) {
+		return 0;
+	}
+	tid -= 1;
+	unsigned state = e[0] >> 6;
+	if (state == 3u) {          /* RELEASE */
+		*mask &= ~(1u << tid);
+	} else if (state == 1u || state == 2u) { /* PRESS / MOVE */
+		unsigned px = ((unsigned)e[1] << 4) | (e[3] >> 4);
+		unsigned py = ((unsigned)e[2] << 4) | (e[3] & 15u);
+		if (px >= TP_W || py >= TP_H) {
+			return EIO;
+		}
+		*mask |= 1u << tid;
+		x[tid] = (int)px;
+		y[tid] = (int)py;
+	}
+	return 0;
+}
+
+static int
+touch_s6sy(void)
+{
+	uint8_t buf[SY_EVENT * (1u + SY_MORE_MAX)];
+	int err = touch_read(TP_ADDR, SY_READ_ONE, false, buf, SY_EVENT);
+	if (err) {
+		return err;
+	}
+	if (buf[0] == 0) {
+		return 0; /* no event pending */
+	}
+	unsigned left = buf[7] & 0x3fu, n = 1;
+	if (left > SY_MORE_MAX) {
+		/* More than we read in one go: drop the stack, release everything. */
+		const uint8_t clr = SY_CLEAR_STACK;
+		(void)touch_write(&clr, 1);
+		touch_report(0, st.x, st.y);
+		return EIO;
+	}
+	if (left) {
+		err = touch_read(TP_ADDR, SY_READ_ALL, false, buf + SY_EVENT, left * SY_EVENT);
+		if (err) {
+			return err;
+		}
+		n += left;
+	}
+	uint32_t mask = st.active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		x[i] = st.x[i];
+		y[i] = st.y[i];
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *e = buf + i * SY_EVENT;
+		if (e[0] == 0) {
+			break;
+		}
+		if (touch_event(e, &mask, x, y)) {
+			return EIO;
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SWEET TOUCH: se fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET TOUCH: SE already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, st.clk_sel);
+	/*
+	 * 0152: 400 kHz, as Android ran it (no clock-frequency in the live DT: downstream i2c-qcom-geni's
+	 * default); Linux geni_i2c_clk_map for 19.2 MHz: div 2, t_high 5, t_low 12, t_cycle 24 (100 kHz:
+	 * 7, 10, 11, 26). Boot-arg sweettouchkhz=100 keeps the old speed.
+	 */
+	uint32_t khz = 400;
+	(void)PE_parse_boot_argn("sweettouchkhz", &khz, sizeof(khz));
+	if (khz == 100) {
+		touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+		touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u);
+	} else {
+		touch_wr(st.se, SE_MCLK, (2u << 4) | 1u);
+		touch_wr(st.se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	}
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("SWEET TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
+	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    touch_rd(st.se, 0x254) != 0) {
+		printf("SWEET TOUCH: packing readback mismatch; probes skipped\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SWEET TOUCH: mapping GCC/TLMM-south/SE (s6sy761 @%#x)\n", TP_ADDR);
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_SOUTH_PA, TOUCH_GPIO_CFG(TP_IRQ + 1));
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET TOUCH: TLMM cfg/io rst=%#x/%#x irq=%#x/%#x 1v8=%#x/%#x sda=%#x scl=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(TP_RST)), touch_rd(st.gpio, TOUCH_GPIO_IO(TP_RST)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(TP_IRQ)), touch_rd(st.gpio, TOUCH_GPIO_IO(TP_IRQ)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(TP_1V8)), touch_rd(st.gpio, TOUCH_GPIO_IO(TP_1V8)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(TP_SDA)), touch_rd(st.gpio, TOUCH_GPIO_CFG(TP_SCL)));
+	if (!touch_clocks() || !touch_se_init()) {
+		goto out;
+	}
+	/* Hold the IC in reset while the rails come up; IRQ stays an input. */
+	touch_gpio(TP_IRQ, 0, 0, 3, false, false);    /* DT: bias-disable, 8 mA */
+	touch_gpio(TP_RST, 0, 0, 3, true, false);     /* DT: 8 mA, low = reset */
+	int power_error = sweet_rpmh_vreg_enable("ldoa17", 3008);
+	if (power_error) {
+		printf("SWEET TOUCH: L17A RPMh enable failed %d; probes skipped\n", power_error);
+		goto out;
+	}
+	touch_gpio(TP_1V8, 0, 3, 3, false, false);    /* DT tp_1v8 active: pull-up */
+	touch_wait(10);
+	touch_gpio(TP_SDA, 1, 0, 0, false, false);    /* qup17, 2 mA, no bias */
+	touch_gpio(TP_SCL, 1, 0, 0, false, false);
+	touch_gpio(TP_RST, 0, 0, 3, true, true);      /* out of reset */
+	touch_wait(300);                              /* Linux waits 140 ms */
+	st.probing = true;
+	uint8_t ev[SY_EVENT], bs = 0, id[3], panel[11], fw = 0;
+	memset(ev, 0xa5, sizeof(ev));
+	int e1 = touch_read(TP_ADDR, SY_READ_ONE, false, ev, SY_EVENT);
+	if (!e1) {
+		touch_hex("first event", ev, SY_EVENT);
+	}
+	int e2 = touch_read(TP_ADDR, SY_BOOT_STATUS, false, &bs, 1);
+	int e3 = touch_read(TP_ADDR, SY_DEVICE_ID, false, id, sizeof(id));
+	int e4 = touch_read(TP_ADDR, SY_PANEL_INFO, false, panel, sizeof(panel));
+	int e5 = touch_read(TP_ADDR, SY_FW_INTEGRITY, false, &fw, 1);
+	st.probing = false;
+	printf("SWEET TOUCH: s6sy761 err=%d/%d/%d/%d/%d boot=%#x (app=0x20) devid=%02x%02x%02x fw=%#x (ok=0x80) irq-pin=%u\n",
+	    e1, e2, e3, e4, e5, bs, id[0], id[1], id[2], fw,
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(TP_IRQ)) & 1u);
+	if (!e4) {
+		touch_hex("panel info", panel, sizeof(panel));
+		printf("SWEET TOUCH: panel max x=%u y=%u tx=%u\n",
+		    ((unsigned)panel[0] << 8) | panel[1], ((unsigned)panel[2] << 8) | panel[3], panel[8]);
+	}
+	if (st.dead || e2 || bs != 0x20u) {
+		printf("SWEET TOUCH: S6SY761 not in application mode (dead=%d); stopping\n", st.dead);
+		goto out;
+	}
+	const uint8_t func[3] = {SY_TOUCH_FUNC, 0x01, 0x00}; /* SMBus word, LE */
+	const uint8_t on = SY_SENSE_ON;
+	int w1 = touch_write(func, sizeof(func));
+	int w2 = touch_write(&on, 1);
+	/*
+	 * 0152: every 4 ms (was 10): in a swipe CoreAnimation draws a frame when a touch sample has come, so
+	 * the sample rate is the swipe's frame rate (mtl2 run 13: 22-26 frames a second, every frame shown at
+	 * once, GPU never busy; hakios measured the same and went to 4 ms). Boot-arg sweettouchms.
+	 */
+	uint32_t poll_ms = 4;
+	(void)PE_parse_boot_argn("sweettouchms", &poll_ms, sizeof(poll_ms));
+	if (poll_ms < 1 || poll_ms > 50) {
+		poll_ms = 4;
+	}
+	printf("SWEET TOUCH: touch-function=%d sense-on=%d; polling %u ms, %ux%u irq-hint=%d\n",
+	    w1, w2, poll_ms, TP_W, TP_H, st.irq_hint);
+	if (w2) {
+		goto out;
+	}
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		/* Optional IRQ hint (active low) still reads every ~100 ms and while down. */
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(TP_IRQ)) & 1u) ||
+		    (++ticks % (100u / poll_ms)) == 0) {
+			int err = touch_s6sy();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y); /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(poll_ms);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_ufs.c ci-sweet/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_ufs.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,914 @@
+/*
+ * SWEET internal UFS root device.
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command.
+ *
+ * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void sweet_log_start(void);
+extern void sweet_sample_start(void);
+extern void sweet_keys_init(void);
+extern void sweet_touch_init(void);
+extern void sweet_haptic_init(void);	/* 0248 */
+extern void sweet_cpufreq_init(void);
+extern void sweet_usb_probe(void);
+extern void sweet_gpu_probe(void);
+extern void sweet_mailbox_probe(void);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
+#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg ufsrw=1 */
+	bool cache;                             /* boot-arg ufscache=1 */
+	bool wait;                              /* boot-arg ufswait=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
+static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer
+ * (to the device when write is set). Returns 0 or an errno.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	/* DD: 1 = memory to device, 2 = device to memory. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16 + cdb_len);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
+			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len) {
+		if (su.cache && write) {
+			dma_clean(DMA_BOUNCE, len);
+		} else {
+			dma_sync(DMA_BOUNCE, len);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	uint64_t spin_until = 0, sleep_interval = 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+	}
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			delay(1);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len && !(su.cache && write)) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
+
+/*
+ * WRITE(10) of count device blocks from the bounce buffer to lba. The range
+ * must lie inside the partition: this is the only place data goes out.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("SWEET UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("SWEET UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (rd) {
+			error = ufs_read_blocks(su.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial device blocks at either end: read, merge, write back. */
+			if (skip || (want % UFS_BLOCK)) {
+				error = ufs_read_blocks(su.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = ufs_write_blocks(su.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = su.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!su.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_ufs_lock);
+		int error = ufs_sync_cache();
+		lck_mtx_unlock(&sweet_ufs_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!su.writable) {
+		return EROFS;
+	}
+	return physio(sweet_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	sweet_log_start();
+	sweet_sample_start();
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+	sweet_keys_init();
+	sweet_touch_init();
+	sweet_haptic_init();	/* 0248: AW8697 vibration motor, boot-arg sweethaptic */
+	sweet_cpufreq_init();                   /* 0156 */
+	sweet_usb_probe();
+	sweet_gpu_probe();	/* GUACAMOLE: boot-arg sweetgpu=N */
+	sweet_mailbox_probe();	/* GUACAMOLE: boot-arg sweetmailbox=1 */
+	return 0;
+}
+
+/*
+ * Persistent console log ("sweetlog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
+ * the partition every ufslogsecs seconds (default 10), far behind the HFS
+ * image at its start. Device block 0 of that area is a header:
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from a recovery with
+ * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define SWEET_LOG_SIZE          (4u << 20)
+#define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
+#define SWEET_LOG_SECS          10u
+
+static char sweet_log_ring[SWEET_LOG_SIZE];
+static uint64_t _Atomic sweet_log_total;
+static int sweet_log_chan;
+static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void sweet_log_append(const char *c, int size);
+
+
+int sweet_ufs_read_partition(const char *part, uint64_t offset, uint32_t size, void **buf_out);
+int sweet_ufs_stamp_partition(const char *part, const uint8_t sector[512]);
+
+int
+sweet_ufs_read_partition(const char *part, uint64_t offset, uint32_t size,
+    void **buf_out)
+{
+	/* The root filesystem uses the same controller state and bounce buffer
+	 * (under sweet_ufs_lock): look the partition up once under the lock,
+	 * then copy chunk by chunk, each chunk under the lock with su's
+	 * partition bounds swapped in and restored before unlocking. */
+	if (size == 0 || size > 64u * 1024u * 1024u) {
+		return EINVAL;
+	}
+	vm_offset_t kva;
+	if (kmem_alloc(kernel_map, &kva, size, KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint64_t saved_first = su.first_block, saved_n = su.nblocks;
+	int err = ufs_find_partition(part);
+	uint64_t part_lba = su.first_block, part_n = su.nblocks;
+	su.first_block = saved_first;
+	su.nblocks = saved_n;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (err) {
+		kmem_free(kernel_map, kva, size);
+		return err;
+	}
+	uint8_t *dst = (uint8_t *)kva;
+	uint64_t lba0 = offset / UFS_BLOCK;
+	uint32_t total = (size + UFS_BLOCK - 1) / UFS_BLOCK, done = 0;
+	while (!err && done < total) {
+		uint32_t n = total - done;
+		if (n > BOUNCE_SIZE / UFS_BLOCK) {
+			n = BOUNCE_SIZE / UFS_BLOCK;
+		}
+		if (lba0 + done + n > part_n) {
+			err = EIO;
+			break;
+		}
+		lck_mtx_lock(&sweet_ufs_lock);
+		err = ufs_read_blocks(part_lba + lba0 + done, n);
+		if (!err) {
+			uint32_t doff = done * UFS_BLOCK, bytes = n * UFS_BLOCK;
+			if (doff + bytes > size) {
+				bytes = size - doff;
+			}
+			memcpy(dst + doff, (const uint8_t *)(su.dma + DMA_BOUNCE), bytes);
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		done += n;
+	}
+	if (err) {
+		kmem_free(kernel_map, kva, size);
+		return err;
+	}
+	*buf_out = (void *)kva;
+	return 0;
+}
+
+int
+sweet_ufs_stamp_partition(const char *part, const uint8_t sector[512])
+{
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint64_t saved_first = su.first_block, saved_n = su.nblocks;
+	int err = ufs_find_partition(part);
+	if (!err) {
+		/* ufs_write_blocks only writes inside su's bounds: bound it to the
+		 * named partition's first block for this one write. */
+		uint64_t lba = su.first_block;
+		su.nblocks = 1;
+		bzero((uint8_t *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+		memcpy((uint8_t *)(su.dma + DMA_BOUNCE), sector, 512);
+		err = ufs_write_blocks(lba, 1);
+	}
+	su.first_block = saved_first;
+	su.nblocks = saved_n;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return err;
+}
+
+void
+sweet_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (sweet_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t sweet_log_position(void);
+
+uint64_t
+sweet_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/bsd/dev/sweet_usb.c ci-sweet/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c	1970-01-01 01:00:00.000000000 +0100
+++ b/bsd/dev/sweet_usb.c	2026-11-20 20:53:28.555093896 +0100
@@ -0,0 +1,931 @@
+/*
+ * SWEET: USB bring-up, step 1 - read-only state probe.
+ *
+ * The phone's USB is a Synopsys DWC3 (USB 2.0 only, maximum-speed
+ * high-speed) at 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper, with a
+ * QUSB2 PHY at 0x088e2000; its power domain is the USB30_PRIM GDSC and its
+ * clocks come from GCC (offsets from Linux gcc-sdmmagpie.c). ABL uses this
+ * controller for fastboot; this probe only reports what state it is left
+ * in after `fastboot boot`. It never writes a register, and it touches the
+ * DWC3 / PHY register blocks only when the GCC status registers say their
+ * power domain and clocks are on (an access to a gated block would hang).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_usb_probe(void);
+static void sweet_usb_gadget_start(vm_offset_t dwc);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define GCC_PA                  0x00100000
+#define GCC_SIZE                0x00090000
+#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+#define CBCR_CLK_OFF            (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x0f010 },
+	{ "sleep", 0x0f014 },
+	{ "utmi", 0x0f018 },
+	{ "cfg-noc-axi", 0x0502c },
+	{ "aggre-axi", 0x8201c },
+	{ "ahb2phy", 0x6a004 },
+	{ "clkref", 0x8c010 },
+};
+
+#define DWC3_PA                 0x0a600000
+#define DWC3_SIZE               0x0000d000
+#define QUSB2_PA                0x088e2000
+#define QUSB2_SIZE              0x00000400
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+sweet_usb_probe(void)
+{
+	int enabled = 1;
+	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	bool clocks_on = true;
+
+	/* sweetusb=0 off, 1 (default) report state only, 2 also start the USB device */
+	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("SWEET USB: GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("SWEET USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
+		printf("SWEET USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
+	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+	if (!clocks_on) {
+		printf("SWEET USB: controller unpowered or unclocked; DWC3 not read\n");
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("SWEET USB: DWC3 map failed\n");
+		return;
+	}
+	printf("SWEET USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	printf("SWEET USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
+	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc708), usb_rd(dwc, 0xc70c),
+	    usb_rd(dwc, 0xc720));
+	printf("SWEET USB: DWC3 GEVNTADR 0x%08x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, 0xc404), usb_rd(dwc, 0xc400), usb_rd(dwc, 0xc408), usb_rd(dwc, 0xc40c),
+	    usb_rd(dwc, 0xc140));
+	if (enabled >= 2) {
+		sweet_usb_gadget_start(dwc);
+	}
+	if (cbcr[5] & CBCR_CLK_OFF) {
+		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
+		return;
+	}
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	if (phy == 0) {
+		return;
+	}
+	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
+	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
+	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
+	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
+	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg sweetusb=2). ABL leaves
+ * the DWC3 powered, clocked, in device mode and halted, with the PHY set
+ * up, so only the device controller is restarted: soft reset, an event
+ * buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the UFS driver. DMA is not cache coherent
+ * (DT qcom,gsi-disable-io-coherency): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+/*
+ * Qualcomm wrapper registers ("QSCRATCH", core base + 0xf8800). The
+ * controller only connects (pull-up on D+) while it sees a valid VBUS
+ * session; Linux dwc3-qcom forces that in software when the charger
+ * reports a cable (dwc3_qcom_vbus_override_enable).
+ */
+#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_HS_PHY_CTRL    0x10
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_SS_PHY_CTRL    0x30
+#define   LANE0_PWR_PRESENT     (1u << 24)
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+#define UD_SIZE         0x4000
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          32
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("SWEET USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static void
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-sweet", "Sweet iOS (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("SWEET USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("SWEET USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("SWEET USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("SWEET USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud_notify_connected();
+				ud_link_event(true);
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void
+ud_rx_arm(void)
+{
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL) {
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = ud.configured ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (ud.configured ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
