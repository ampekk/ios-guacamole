+static uint64_t sweet_surf_logged;      /* selectors / traps already logged (< 64) */
+
+/*
+ * Boot-arg sweetsurflog=WxH: what every task does with surfaces of that size
+ * (mapped by create/lookup/wrap, port made, lock, unlock), at most 200 lines.
+ * G4 run gl8: the home screen's icons are 180 x 180 surfaces backboardd makes
+ * for CoreAnimation's deferred image slots, and they stay all zero.
+ */
+static void
+sweet_surf_watch(const char *what, SweetSurface *s, uint64_t extra)
+{
+	static int parsed;
+	static uint32_t want_w, want_h, lines;
+	if (!parsed) {
+		char spec[32] = "";
+		parsed = 1;
+		if (PE_parse_boot_arg_str("sweetsurflog", spec, sizeof(spec))) {
+			const char *x = strchr(spec, 'x');
+			want_w = (uint32_t)strtoul(spec, NULL, 10);
+			want_h = x != NULL ? (uint32_t)strtoul(x + 1, NULL, 10) : 0;
+		}
+	}
+	if (want_w == 0 || s == NULL || s->width != want_w || s->height != want_h || lines >= 200) {
+		return;
+	}
+	lines++;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	/* 0127: how much of the pixels is not zero now (what a lock for writing left there) */
+	uint64_t set = 0, size = (uint64_t)s->bytesPerRow * s->height;
+	const uint8_t *pixels = (const uint8_t *)s->kernelAddress();
+	if (pixels != NULL && s->memory != NULL && size <= s->memory->getLength()) {
+		pixels += s->wrapDelta;
+		for (uint64_t i = 0; i < size; i++) {
+			set += pixels[i] != 0;
+		}
+	}
+	IOLog("SWEET SURF: watch %s %s id %u seed %u %#llx: %llu of %llu bytes set\n", name, what, s->id,
+	    s->state != NULL ? *(uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED) : 0,
+	    (unsigned long long)extra, (unsigned long long)set, (unsigned long long)size);
+	/*
+	 * 0128: and for a lock or unlock, who in the task asked (its user stack, raw addresses:
+	 * subtract the dyld cache slide libsweet-bbd logs). Interposing IOSurfaceLock in
+	 * backboardd did not catch CoreAnimation's write lock of the icon surfaces (gl11).
+	 */
+	if (strncmp(what, "lock", 4) == 0 || strncmp(what, "unlock", 6) == 0) {
+		uintptr_t frames[10];
+		struct backtrace_user_info info = BTUINFO_INIT;
+		unsigned int n = backtrace_user(frames, 10, NULL, &info);
+		char chain[200];
+		size_t used = 0;
+		chain[0] = 0;
+		for (unsigned int i = 0; i < n && used < sizeof(chain); i++) {
+			used += (size_t)snprintf(chain + used, sizeof(chain) - used, " %#lx", (unsigned long)frames[i]);
+		}
+		IOLog("SWEET SURF: watch %s %s id %u from%s\n", name, what, s->id, chain);
+	}
+}
+
+/*
+ * 0140: Safari's page area stays black (wifi25/26) while its own UI draws. Who in WebKit makes
+ * which surfaces, who maps them later (backboardd? MobileSafari?), and whether WebContent's
+ * pixels are there when it unlocks: at most 240 lines. The first 64 creates of the boot are
+ * all logged anyway, WebKit's processes start after them.
+ */
+static uint32_t sweet_wk_ids[64];
+static uint32_t sweet_wk_n, sweet_wk_lines;
+
+static bool
+sweet_wk_proc(char *name, size_t len)
+{
+	proc_selfname(name, (int)len);
+	return strncmp(name, "com.apple.WebKit", 16) == 0 || strcmp(name, "MobileSafari") == 0;
+}
+
+static void
+sweet_wk_log(const char *what, SweetSurface *s, IOReturn ret)
+{
+	char name[32];
+	bool wk = sweet_wk_proc(name, sizeof(name));
+	bool known = false;
+	for (uint32_t i = 0; s != NULL && i < sweet_wk_n && i < 64; i++) {
+		known |= sweet_wk_ids[i] == s->id;
+	}
+	if ((!wk && !known) || s == NULL || sweet_wk_lines >= 240) {
+		return;
+	}
+	if (wk && !known && strcmp(what, "create") == 0 && sweet_wk_n < 64) {
+		sweet_wk_ids[sweet_wk_n++] = s->id;
+	}
+	uint64_t set = 0, size = 0;
+	if (strcmp(what, "unlock") == 0 && s->memory != NULL) {
+		size = (uint64_t)s->bytesPerRow * s->height;
+		const uint8_t *pixels = (const uint8_t *)s->kernelAddress();
+		if (pixels != NULL && size <= s->memory->getLength()) {
+			pixels += s->wrapDelta;
+			for (uint64_t i = 0; i < size; i += 4) {
+				set += *(const uint32_t *)(const void *)(pixels + i) != 0;
+			}
+		}
+	}
+	sweet_wk_lines++;
+	IOLog("SWEET SURF: wk %s %s id %u %ux%u fmt 0x%x bpr %u -> 0x%x%s pixels set %llu of %llu\n", name, what,
+	    s->id, s->width, s->height, s->pixelFormat, s->bytesPerRow, ret, known && !wk ? " (a WebKit surface)" : "",
+	    (unsigned long long)set, (unsigned long long)(size / 4));
+}
+
+static void
+sweet_surf_log_once(const char *what, uint32_t n)
+{
+	uint32_t bit = (what[0] == 't' ? 48 : 0) + n;
+	if (bit >= 64 || (sweet_surf_logged & (1ULL << bit))) {
+		return;
+	}
+	sweet_surf_logged |= 1ULL << bit;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF: %s %s %u\n", name, what, n);
+}
