+ */
+#define kIOHIDDeviceDefaultAsyncRequestTimeout 1000ULL
+#define kIOHIDDeviceMinAsyncRequestTimeout     50ULL
+#define kIOHIDDeviceMaxAsyncRequestTimeout     1200000ULL
