+#if defined(ARM64_BOARD_CONFIG_SWEET)
+				if (thread->sched_pri < BASEPRI_RTQUEUES) {
+					return sweet_check_idle_hint(pset, processor, thread);     /* 0156 */
+				}
+#endif
