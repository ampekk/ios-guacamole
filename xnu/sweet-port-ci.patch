+bool
+IOSurfaceRootUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fRefs = OSArray::withCapacity(16);
+	return fLock != NULL && fRefs != NULL;
+}
+
+void
+IOSurfaceRootUserClient::free()
+{
+	OSSafeReleaseNULL(fRefs);
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+IOSurfaceRootUserClient::clientClose(void)
+{
+	IOLockLock(fLock);
+	fRefs->flushCollection();
+	IOLockUnlock(fLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Lock held. */
+SweetSurfaceRef *
+IOSurfaceRootUserClient::findRef(uint32_t id, unsigned int *index)
+{
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id == id) {
+			if (index != NULL) {
+				*index = i;
+			}
+			return ref;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Count one more create/lookup of s by this client, mapping it into the
+ * task the first time. Takes over the caller's user count on s.
+ *
+ * A lookup of a surface this client already has maps nothing and counts
+ * nothing (*existing): IOSurface.framework then gets base address -1 in the
+ * lock result and reuses its cached IOSurfaceClient. Counting it instead
+ * made the framework build a second client for the same id; releasing that
+ * one (traps 4 + 5) unmapped the memory under the first (backboardd
+ * snapshot crash in CGDataProviderCreateWithData).
+ */
+IOReturn
+IOSurfaceRootUserClient::addRef(SweetSurface *s, SweetSurfaceRef **refOut, bool *existing)
+{
+	*existing = false;
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(s->id, NULL);
+	if (ref != NULL && ref->surface == s) {
+		IOLockUnlock(fLock);
+		sweet_surface_put(s);
+		*refOut = ref;
+		*existing = true;
+		return kIOReturnSuccess;
+	}
+	IOLockUnlock(fLock);
+
+	ref = OSTypeAlloc(SweetSurfaceRef);
+	if (ref == NULL || !ref->init()) {
+		OSSafeReleaseNULL(ref);
+		sweet_surface_put(s);
+		return kIOReturnNoMemory;
+	}
+	s->retain();
+	ref->surface = s;
+	ref->count = 1;
+	ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache |
+	    (s->readOnly ? kIOMapReadOnly : 0));
+	ref->state = s->state->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
+	if (ref->data == NULL || ref->state == NULL) {
+		ref->release();
+		return kIOReturnVMError;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *raced = findRef(s->id, NULL);
+	if (raced != NULL && raced->surface == s) {
+		/* Another thread mapped it meanwhile: count there, drop ours. */
+		raced->count++;
+		IOLockUnlock(fLock);
+		ref->release();
+		*refOut = raced;
+		return kIOReturnSuccess;
+	}
+	fRefs->setObject(ref);
+	IOLockUnlock(fLock);
+	ref->release();         /* fRefs holds it */
+	*refOut = ref;
+	return kIOReturnSuccess;
+}
+
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+static void
+put64(uint8_t *p, uint32_t off, uint64_t v)
+{
+	memcpy(p + off, &v, 8);
+}
+
+/* IOSurface.framework's lock result (copied to IOSurfaceClient + 0x68). */
+static void
+sweet_surface_fill_result(SweetSurface *s, SweetSurfaceRef *ref, uint8_t *out)
+{
+	bzero(out, SWEET_SURFACE_RESULT_SIZE);
+	put64(out, 0x00, ref->data->getAddress() + s->wrapDelta);
+	put64(out, 0x08, ref->state->getAddress());
+	put64(out, 0x10, ref->state->getAddress() + SWEET_SURFACE_TIMESTAMPS);
+	put32(out, 0x18, s->id);
+	put32(out, 0x1c, s->allocSize);
+	put32(out, 0x20, s->width);
+	put32(out, 0x24, s->height);
+	put32(out, 0x28, s->bytesPerRow);
+	put32(out, 0x2c, s->offset);
+	put32(out, 0x30, s->pixelFormat);
+	put32(out, 0x34, s->allocSize);
+	put32(out, 0x38, s->planeCount);
+	memcpy(out + 0x40, &s->bytesPerElement, 2);
+	out[0x42] = s->elementWidth;
+	out[0x43] = s->elementHeight;
+	put32(out, 0x44, s->cacheMode);
+	put32(out, 0x50, s->parentID);
+	put32(out, 0x54, 1);
+	for (uint32_t i = 0; i < s->planeCount; i++) {
+		uint8_t *p = out + 0x68 + i * 0x80;
+		const struct sweet_surface_plane *pl = &s->planes[i];
+		put32(p, 0x00, pl->width);
+		put32(p, 0x04, pl->height);
+		put32(p, 0x08, pl->bytesPerRow);
+		put32(p, 0x0c, pl->offset);
+		/*
+		 * 0215: IOSurface.framework reads a plane's row bytes at +0x10 of its record, not +0x08
+		 * (IOSurfaceClientGetBytesPerRowOfPlane: client + 0xd0 + 0x80 * i + 0x10; the record is this result
+		 * block's +0x68, copied to the client's +0x68; research/iosurface/IOSurface). Every planar surface
+		 * answered IOSurfaceGetBytesPerRowOfPlane = 0: PhotosPosterProvider's '420f' photo (606x1145, planes at
+		 * 64 and 737344, rows 640) was read with the whole surface's 968, and whatever wrote its planes by the
+		 * plane's row wrote with 0. Width +0, height +4, offset +0xc, size +0x14, bytes per element +0x18 and
+		 * element width/height +0x1a/+0x1b were right. +0x08 is kept as it was (its meaning is not known here).
+		 */
+		put32(p, 0x10, pl->bytesPerRow);
+		put32(p, 0x14, pl->size);
+		memcpy(p + 0x18, &pl->bytesPerElement, 2);
+		p[0x1a] = pl->elementWidth;
+		p[0x1b] = pl->elementHeight;
+	}
+}
+
+static IOReturn
+sweet_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Map s for this client and answer with its lock result. Takes s's user count. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(SweetSurface *s, IOExternalMethodArguments *args)
+{
+	SweetSurfaceRef *ref = NULL;
+	bool existing = false;
+	IOReturn ret = addRef(s, &ref, &existing);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	sweet_surf_watch(existing ? "map (already)" : "map", s, ref->data->getAddress());
+	sweet_wk_log(existing ? "map (already)" : "map", s, kIOReturnSuccess);
+	uint8_t *out = (uint8_t *)IOMallocZeroData(SWEET_SURFACE_RESULT_SIZE);
+	if (out == NULL) {
+		ret = kIOReturnNoMemory;
+	} else {
+		sweet_surface_fill_result(s, ref, out);
+		if (existing) {
+			put64(out, 0x00, ~0ULL);        /* "already yours": use the cached client */
+		}
+		ret = sweet_struct_out(args, out, SWEET_SURFACE_RESULT_SIZE);
+		IOFreeData(out, SWEET_SURFACE_RESULT_SIZE);
+	}
+	if (ret != kIOReturnSuccess && !existing) {
+		/* The caller never learns the id: undo this create/lookup. */
+		trapRelease((void *)(uintptr_t)s->id, NULL, NULL, NULL, NULL, NULL);
+	}
+	return ret;
+}
+
+static IOMemoryDescriptor *sweet_wrap_range(task_t task, uint64_t at, uint64_t length, bool *readOnly);
+
+IOReturn
+IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
+{
+	const char *buf = (const char *)args->structureInput;
+	uint32_t len = args->structureInputSize;
+	char *copy = NULL;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len == 0 || len > SWEET_SURFACE_MAX_PROPS) {
+			return kIOReturnBadArgument;
+		}
+		copy = (char *)IOMallocData(len);
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		args->structureInputDescriptor->readBytes(0, copy, len);
+		buf = copy;
+	}
+	OSObject *obj = (buf != NULL && len > 0) ? OSUnserializeXML(buf, len) : NULL;
+	if (copy != NULL) {
+		IOFreeData(copy, len);
+	}
+	OSDictionary *props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		IOLog("SWEET SURF: create: bad property dictionary (%u bytes)\n", len);
+		return kIOReturnBadArgument;
+	}
+
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		props->release();
+		return kIOReturnNoMemory;
+	}
+	s->parentID = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+	ret = sweet_surface_layout(s, props);
+	/*
+	 * 0129: "IOSurfaceAddress" asks for a surface around the caller's own memory.
+	 * CoreAnimation's GL renderer makes one so for an image whose format has no IOSurface
+	 * pixel format (CA::Render::Image::retain_iosurface: IOSurfaceCreate with the image's
+	 * data address, then only a lock and an unlock): the home screen's app icons. This used
+	 * to get fresh zeroed memory instead, and the icons were drawn from zeros (G4 runs
+	 * gl8-gl12). The range is wired for the surface's life, as for selectors 6 and 7.
+	 */
+	OSNumber *address = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+	if (ret == kIOReturnSuccess && address != NULL && address->unsigned64BitValue() != 0) {
+		uint64_t at = address->unsigned64BitValue();
+		uint64_t need = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
+		if (need == 0) {
+			need = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+		}
+		uint64_t first = trunc_page_64(at);
+		bool readOnly = false;
+		IOMemoryDescriptor *md = sweet_wrap_range(fTask, at, need, &readOnly);
+		if (md != NULL) {
+			s->memory = md;
+			s->wrapped = true;
+			s->readOnly = readOnly;
+			s->wrapDelta = (uint32_t)(at - first);
+			s->mapCache = kIOMapDefaultCache;
+			if (!sweet_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		} else {
+			IOLog("SWEET SURF: create: IOSurfaceAddress %#llx: fresh memory instead\n", (unsigned long long)at);
+			address = NULL;
+		}
+	} else {
+		address = NULL;
+	}
+	if (ret == kIOReturnSuccess && address == NULL) {
+		IOBufferMemoryDescriptor *mem = NULL;
+		if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired) +
+		    s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+			mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+		}
+		if (mem == NULL) {
+			OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+			ret = kIOReturnNoMemory;
+		} else {
+			bzero(mem->getBytesNoCopy(), s->allocSize);
+			s->memory = mem;
+			s->mapCache = kIOMapDefaultCache;
+			if (!sweet_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		}
+	}
+	if (ret != kIOReturnSuccess || sweet_surface_creates_logged < 64) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_surface_creates_logged++;
+		IOLog("SWEET SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u -> 0x%x\n",
+		    name, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+		    s->bytesPerRow, s->planeCount, s->allocSize, props->getCount(), ret);
+	}
+	char wkname[32];
+	if (sweet_wk_proc(wkname, sizeof(wkname)) && sweet_wk_lines < 240) {
+		OSArray *pl = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+		OSDictionary *p0 = pl != NULL ? OSDynamicCast(OSDictionary, pl->getObject(0)) : NULL;
+		IOLog("SWEET SURF: wk %s asked fmt 0x%x %ux%u bpe %u bpr %u ew %u planes %u (0: bpe %u bpr %u %ux%u) -> bpe %u planes %u\n",
+		    wkname, sweet_dict_u32(props, "IOSurfacePixelFormat", 0), sweet_dict_u32(props, "IOSurfaceWidth", 0),
+		    sweet_dict_u32(props, "IOSurfaceHeight", 0), sweet_dict_u32(props, "IOSurfaceBytesPerElement", 0),
+		    sweet_dict_u32(props, "IOSurfaceBytesPerRow", 0), sweet_dict_u32(props, "IOSurfaceElementWidth", 0),
+		    pl != NULL ? pl->getCount() : 0, p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneBytesPerElement", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneBytesPerRow", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneWidth", 0) : 0,
+		    p0 != NULL ? sweet_dict_u32(p0, "IOSurfacePlaneHeight", 0) : 0, s->bytesPerElement, s->planeCount);
+	}
+	sweet_wk_log("create", s, ret);
+	props->release();
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);   /* takes the creator's user count */
+	s->release();
+	return ret;
+}
+
+/*
+ * 0130: wire [at, at + length) of task for a wrapped surface. Image data CoreAnimation got from
+ * a client is mapped read-only in backboardd, so wiring it for writing fails (gl13: every
+ * IOSurfaceAddress create "not wired"); then it is wired for reading only and *readOnly says
+ * so (the surface is mapped read-only everywhere).
+ */
+static IOMemoryDescriptor *
+sweet_wrap_range(task_t task, uint64_t at, uint64_t length, bool *readOnly)
+{
+	uint64_t first = trunc_page_64(at);
+	uint64_t size = round_page_64(at + length) - first;
+	IOReturn err = kIOReturnNoMemory;
+	for (int pass = 0; pass < 2; pass++) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(first, size,
+		    pass == 0 ? kIODirectionInOut : kIODirectionOut, task);
+		if (md == NULL) {
+			continue;
+		}
+		err = md->prepare(pass == 0 ? kIODirectionInOut : kIODirectionOut);
+		if (err == kIOReturnSuccess) {
+			*readOnly = pass == 1;
+			return md;
+		}
+		md->release();
+	}
+	IOLog("SWEET SURF: wrap %#llx (%llu bytes): not wired (%#x)\n", (unsigned long long)at,
+	    (unsigned long long)length, err);
+	return NULL;
+}
+
+/*
+ * IOSurfaceWrapClientImage (6, struct in of 0x20 bytes: +0 address, +8 width,
+ * +0xc height, +0x10 pixel format, +0x14 bytes per element, +0x18 bytes per
+ * row; layout read off iOS 16.7.16's IOSurfaceClientWrapClientImage) and
+ * IOSurfaceWrapClientMemory (7: scalars address, size): a surface made of the
+ * caller's own memory. CoreAnimation's GL renderer wraps images so, app icons
+ * among them (G4 run gl4: icons missing while 0123 refused these calls). The
+ * range stays prepared (wired) for as long as the surface lives; every task
+ * maps it as usual. From topaz (MakrSas/ios-topaz) 0132, APSL 2.0.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapClient(uint32_t selector, IOExternalMethodArguments *args)
+{
+	uint64_t address, size;
+	uint32_t width, height, format = 0, bpe, bpr;
+
+	if (selector == kSweetSurfaceWrapClientImage) {
+		const uint8_t *in = (const uint8_t *)args->structureInput;
+		if (in == NULL || args->structureInputSize < 0x1c) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(&address, in, 8);
+		memcpy(&width, in + 0x08, 4);
+		memcpy(&height, in + 0x0c, 4);
+		memcpy(&format, in + 0x10, 4);
+		memcpy(&bpe, in + 0x14, 4);
+		memcpy(&bpr, in + 0x18, 4);
+		if (width == 0 || height == 0 || bpe == 0 || bpe > 16 || bpr < (uint64_t)width * bpe) {
+			return kIOReturnBadArgument;
+		}
+		size = (uint64_t)bpr * height;
+	} else {
+		if (args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		address = args->scalarInput[0];
+		size = args->scalarInput[1];
+		width = (uint32_t)size;
+		height = 1;
+		bpe = 1;
+		bpr = (uint32_t)size;
+	}
+	if (address == 0 || size == 0 || size > (256ull << 20)) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t first = trunc_page_64(address);
+	bool readOnly = false;
+	IOMemoryDescriptor *md = sweet_wrap_range(fTask, address, size, &readOnly);
+	if (md == NULL) {
+		return kIOReturnVMError;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		md->complete();
+		md->release();
+		return kIOReturnNoMemory;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->readOnly = readOnly;
+	s->wrapDelta = (uint32_t)(address - first);
+	s->mapCache = kIOMapDefaultCache;
+	s->width = width;
+	s->height = height;
+	s->pixelFormat = format;
+	s->bytesPerElement = (uint16_t)bpe;
+	s->elementWidth = 1;
+	s->elementHeight = 1;
+	s->bytesPerRow = bpr;
+	s->allocSize = (uint32_t)size;
+	s->planeCount = 0;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return kIOReturnNoResources;
+	}
+	static uint32_t logged;
+	if (logged < 8) {
+		logged++;
+		IOLog("SWEET SURF: wrap %s id %u %ux%u fmt 0x%x bpe %u bpr %u size %llu at +0x%x\n",
+		    selector == kSweetSurfaceWrapClientImage ? "image" : "memory", s->id, width, height,
+		    format, bpe, bpr, size, s->wrapDelta);
+	}
+	IOReturn ret = returnSurface(s, args);  /* takes the creator's user count */
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint64_t arg0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kSweetSurfaceLimits: {
+		uint8_t limits[0x18] = { 0 };
+		put32(limits, 0x0, SWEET_SURFACE_ROW_ALIGN - 1);
+		put32(limits, 0x4, SWEET_SURFACE_ROW_ALIGN - 1);
+		/*
+		 * 0214: the maxima. IOSurface.framework (__iosConnectInitalize, research/iosurface/) keeps this block as
+		 * _ioSurfaceLimits and IOSurfaceGetPropertyMaximum answers BytesPerRow (+0x08), Width (+0x0c) and Height
+		 * (+0x10) from it as-is (their Plane* keys too). They were 0, so every size was over the maximum:
+		 * BaseBoard's +[IOSurface bs_IOSurfaceWithWidth:height:options:] returns nil when width or height exceeds
+		 * it, and PosterBoard snapshotted the wallpaper over no surface (black lock and home screens, every
+		 * poster). The values are what create() already enforces: SWEET_SURFACE_MAX_DIM a side, and the widest
+		 * row of that many 16-byte texels (an allocation over SWEET_SURFACE_MAX_ALLOC is still refused there).
+		 */
+		put32(limits, 0x8, SWEET_SURFACE_MAX_DIM * 16);
+		put32(limits, 0xc, SWEET_SURFACE_MAX_DIM);
+		put32(limits, 0x10, SWEET_SURFACE_MAX_DIM);
+		limits[0x16] = 1;
+		sweet_surf_log_once("sel", selector);
+		return sweet_struct_out(args, limits, sizeof(limits));
+	}
+	case kSweetSurfaceCreate:
+		return create(args);
+	case kSweetSurfaceWrapClientImage:
+	case kSweetSurfaceWrapClientMemory:
+		sweet_surf_log_once("sel", selector);
+		return wrapClient(selector, args);
+	case kSweetSurfaceLookup: {
+		SweetSurface *s = sweet_surface_copy((uint32_t)arg0);
+		IOReturn ret = kIOReturnNotFound;
+		if (s != NULL) {
+			ret = sweet_surface_get(s) ? returnSurface(s, args) : kIOReturnNotFound;
+			s->release();
+		}
+		sweet_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kSweetSurfaceLookupFromPort: {
+		OSObject *obj = NULL;
+		IOReturn ret = IOUserClient::copyObjectForPortNameInTask(fTask, (mach_port_name_t)arg0, &obj);
+		SweetSurface *s = OSDynamicCast(SweetSurface, obj);
+		if (ret == kIOReturnSuccess) {
+			ret = (s != NULL && sweet_surface_get(s)) ? returnSurface(s, args) : kIOReturnBadArgument;
+		}
+		OSSafeReleaseNULL(obj);
+		sweet_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kSweetSurfaceCreatePort: {
+		SweetSurface *s = sweet_surface_copy((uint32_t)arg0);
+		if (s == NULL || args->scalarOutputCount < 1) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		args->scalarOutput[0] = sweet_surface_port_in_task(s, fTask);
+		args->scalarOutputCount = 1;
+		sweet_surf_watch("port", s, args->scalarOutput[0]);
+		s->release();
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	default:
+		/*
+		 * A call that answers with a lock result (wrap client image 6 and
+		 * memory 7) must not succeed with zeroes: IOSurface.framework builds
+		 * a client from it with no shared state page, and CoreAnimation's
+		 * GL renderer then reads the EDR factor there
+		 * (IOSurfaceClientGetBulkAttachments, client+0x70 = 0): backboardd
+		 * crashed at 0x30, 108 times (G4 run gl2). Refused, the framework
+		 * returns NULL and CoreAnimation takes its other path. From topaz
+		 * (MakrSas/ios-topaz) 0131, same SweetSurface lineage, APSL 2.0.
+		 */
+		if ((args->structureOutputDescriptor != NULL &&
+		    args->structureOutputDescriptor->getLength() >= SWEET_SURFACE_RESULT_SIZE) ||
+		    (args->structureOutput != NULL && args->structureOutputSize >= SWEET_SURFACE_RESULT_SIZE)) {
+			sweet_surf_log_once("sel (refused: lock result)", selector);
+			return kIOReturnUnsupported;
+		}
+		/* Values, notifications, ownership, timestamps...: accept and ignore. */
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
+    void *, void *, void *, void *)
+{
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+sweet_surface_seed_out(SweetSurface *s, void *seedOut, bool bump)
+{
+	uint32_t seed = bump ? OSIncrementAtomic((volatile SInt32 *)sweet_surface_seed(s)) + 1 :
+	    *sweet_surface_seed(s);
+	if (seedOut != NULL && copyout(&seed, (user_addr_t)seedOut, sizeof(seed)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Retained surface this client created or looked up, or NULL. */
+static SweetSurface *
+sweet_surface_held(IOLock *lock, OSArray *refs, uint32_t id)
+{
+	SweetSurface *s = NULL;
+	IOLockLock(lock);
+	for (unsigned int i = 0; i < refs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)refs->getObject(i);
+		if (ref->surface->id == id) {
+			s = ref->surface;
+			s->retain();
+			break;
+		}
+	}
+	IOLockUnlock(lock);
+	return s;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void *id, void *options, void *seedOut,
+    void *, void *, void *)
+{
+	SweetSurface *s = sweet_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = sweet_surface_seed_out(s, seedOut, false);
+	sweet_surf_watch("lock", s, (uintptr_t)options);
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void *id, void *options, void *seedOut,
+    void *, void *, void *)
+{
+	SweetSurface *s = sweet_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = sweet_surface_seed_out(s, seedOut,
+	    !((uintptr_t)options & kIOSurfaceLockReadOnly));
+	sweet_surf_watch("unlock", s, (uintptr_t)options);
+	sweet_wk_log("unlock", s, kIOReturnSuccess);
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, void *)
+{
+	unsigned int index;
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, &index);
+	if (ref != NULL && --ref->count == 0) {
+		fRefs->removeObject(index);     /* unmaps and drops the user count */
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+static IOExternalTrap sweet_surface_traps[] = {
+	[kSweetSurfaceTrapIncrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kSweetSurfaceTrapDecrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kSweetSurfaceTrapLock]          = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapLock },
+	[kSweetSurfaceTrapUnlock]        = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUnlock },
+	[kSweetSurfaceTrapRelease]       = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+	[kSweetSurfaceTrapReleaseFailed] = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+};
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 index)
+{
+	if (index >= sizeof(sweet_surface_traps) / sizeof(sweet_surface_traps[0])) {
+		sweet_surf_log_once("trap", index);
+		return NULL;
+	}
+	sweet_surf_log_once("trap", index);
+	*targetP = this;
+	return &sweet_surface_traps[index];
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetSurface.h ci-sweet/iokit/Kernel/arm/SweetSurface.h
--- a/iokit/Kernel/arm/SweetSurface.h	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetSurface.h	2026-11-20 20:53:28.567094095 +0100
@@ -0,0 +1,69 @@
+/*
+ * Built-in IOSurface for SWEET (see SweetSurface.cpp).
+ *
+ * Shared with SweetFramebuffer.cpp: the framebuffer looks surfaces up by
+ * id when a swap names them and publishes the panel memory itself as the
+ * default framebuffer surface.
+ */
+#ifndef _SWEET_SURFACE_H
+#define _SWEET_SURFACE_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSObject.h>
+#include <mach/mach_types.h>
+
+#define SWEET_SURFACE_MAX_PLANES        20
+
+struct sweet_surface_plane {
+	uint32_t width, height, bytesPerRow, offset, size;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+};
+
+class SweetSurface : public OSObject {
+	OSDeclareDefaultStructors(SweetSurface);
+
+public:
+	uint32_t id;
+	uint32_t width, height, bytesPerRow, offset, pixelFormat, allocSize;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+	uint32_t cacheMode, planeCount, parentID;
+	struct sweet_surface_plane planes[SWEET_SURFACE_MAX_PLANES];
+
+	IOMemoryDescriptor       *memory;       /* pixels (buffer or physical) */
+	IOOptionBits              mapCache;     /* cache mode for user mappings */
+	IOBufferMemoryDescriptor *state;        /* shared state page, read-only for users */
+	IOMemoryMap              *kernelMap;    /* lazily created for kernel copies */
+	uint32_t                  wrapDelta;    /* wrapped client memory: where it starts in its first page */
+	bool                      wrapped;      /* memory is a prepared range of a task (IOSurfaceWrapClient*) */
+	bool                      readOnly;     /* ... that the task may only read: mapped read-only */
+	uint32_t                  drawn;        /* RedwoodGPU: the last submission naming it (0: none) */
+
+	bool init() APPLE_KEXT_OVERRIDE { wrapDelta = 0; wrapped = false; readOnly = false; drawn = 0; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+
+	/* Kernel address of the pixels (mapped on first use), or 0. */
+	uintptr_t kernelAddress();
+};
+
+/* Retained surface for an id, or NULL. */
+SweetSurface *sweet_surface_copy(uint32_t id);
+
+/*
+ * Publish physical memory (the panel framebuffer) as a surface. Returns a
+ * retained surface that stays in the id table until released by the caller
+ * and every user.
+ */
+SweetSurface *sweet_surface_create_physical(uint64_t phys, uint32_t width,
+    uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
+
+/* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
+mach_port_name_t sweet_surface_port_in_task(SweetSurface *surface, task_t task);
+
+#endif /* SWEET */
+#endif /* _SWEET_SURFACE_H */
diff -ruN ci-base/iokit/Kernel/arm/SweetVibrator.cpp ci-sweet/iokit/Kernel/arm/SweetVibrator.cpp
--- a/iokit/Kernel/arm/SweetVibrator.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetVibrator.cpp	2026-11-20 20:53:28.567094095 +0100
@@ -0,0 +1,224 @@
+/*
+ * 0249: the IOKit "vibrator" iOS's legacy vibration path drives, on the AW8697 motor (bsd/dev/sweet_haptic.c, 0248).
+ *
+ * MediaExperience's FigVibrator (research/haptics/ios-e/RESULTS.md, REQUEST-F.md) uses this path when VibeSynth has
+ * no hardware support (true here): IOServiceGetMatchingService(IOServiceNameMatching("vibrator")) once, then
+ * IORegistryEntrySetCFProperties on it:
+ *   start:   { intensity = SInt32 16.16 (0..1), hertz_millisecs = [ on-state, ms, off-state, ms, ... ], repeat = bool }
+ *            on-state: an intensity dictionary or true; off-state: false; durations SInt64 / SInt32 milliseconds
+ *   pattern: { hertz_millisecs = normalized pattern array, repeat = false }
+ *   stop:    a plain CFNumber 0 (not a dictionary)
+ * UIKit's feedback level 1 (MobileGestalt cBy4BcYs5YWtFHbBpt4C6A = true) plays its feedback as system sounds with
+ * vibration, which end here. Mapping onto the RAM waveforms (research/haptics/README.md, effect catalogue):
+ * an on-segment of at most 40 ms is a tap, waveform 1..5 by intensity (1 light .. 5 keyboard-like, the strongest
+ * 20 at full intensity and >= 25 ms); a longer one buzzes (waveform 10 looped) for its duration. Off-segments wait.
+ * "repeat" loops the pattern until the next stop or pattern (at most 60 s). Every request replaces the running one.
+ * Played on a thread call: setProperties returns at once.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <kern/thread_call.h>
+
+extern "C" {
+int sweet_haptic_ready(void);
+int sweet_haptic_wave(unsigned wave);
+int sweet_haptic_buzz(int on);
+unsigned sweet_haptic_stops(void);
+}
+
+#define VIB_SEGMENTS    32u
+
+class SweetVibrator : public IOService {
+	OSDeclareDefaultStructors(SweetVibrator);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+private:
+	static void run(thread_call_param_t self, thread_call_param_t);
+	void play(void);
+	bool waitFor(uint32_t gen, uint32_t ms);
+	IOLock *fLock;
+	thread_call_t fCall;
+	volatile uint32_t fGen;
+	struct { bool on; uint32_t level; uint32_t ms; } fSeg[VIB_SEGMENTS];   /* level: 0..65536 */
+	uint32_t fCount;
+	bool fRepeat;
+	uint32_t fRequests;
+	unsigned fStops;                /* 0250: sweet_haptic_stops() when the pattern started */
+};
+OSDefineMetaClassAndStructors(SweetVibrator, IOService);
+
+bool
+SweetVibrator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	/*
+	 * 0252: ONCE: a request arriving while a pattern still plays re-runs the call after it instead of starting a
+	 * second play() on another thread call worker; two players interleaving on the chip left it silent until
+	 * `haptic init`.
+	 */
+	fCall = thread_call_allocate_with_options(&SweetVibrator::run, this, THREAD_CALL_PRIORITY_KERNEL,
+	    THREAD_CALL_OPTIONS_ONCE);
+	if (fLock == NULL || fCall == NULL) {
+		return false;
+	}
+	setName("vibrator");                    /* IOServiceNameMatching("vibrator") */
+	registerService();
+	IOLog("SWEET VIBRATOR: \"vibrator\" registered (FigVibrator -> AW8697, motor %s)\n",
+	    sweet_haptic_ready() ? "ready" : "not configured yet: boot-arg sweethaptic=2");
+	return true;
+}
+
+static uint32_t
+vib_level(OSObject *o, uint32_t fallback)
+{
+	if (OSNumber *n = OSDynamicCast(OSNumber, o)) {
+		uint64_t v = n->unsigned64BitValue();
+		return v > 65536u ? 65536u : (uint32_t)v;
+	}
+	if (OSDictionary *d = OSDynamicCast(OSDictionary, o)) {
+		/* the intensity dictionary's key is not known yet: take the first number in it */
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+		uint32_t level = fallback;
+		if (it) {
+			while (OSString *k = OSDynamicCast(OSString, it->getNextObject())) {
+				if (OSNumber *n = OSDynamicCast(OSNumber, d->getObject(k))) {
+					uint64_t v = n->unsigned64BitValue();
+					level = v > 65536u ? 65536u : (uint32_t)v;
+					break;
+				}
+			}
+			it->release();
+		}
+		return level;
+	}
+	return fallback;
+}
+
+IOReturn
+SweetVibrator::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	IOLockLock(fLock);
+	fGen++;
+	fCount = 0;
+	fRepeat = false;
+	if (d != NULL) {
+		uint32_t level = vib_level(d->getObject("intensity"), 65536u);
+		OSArray *a = OSDynamicCast(OSArray, d->getObject("hertz_millisecs"));
+		for (unsigned i = 0; a != NULL && i + 1 < a->getCount() && fCount < VIB_SEGMENTS; i += 2) {
+			OSObject *state = a->getObject(i);
+			OSNumber *ms = OSDynamicCast(OSNumber, a->getObject(i + 1));
+			if (ms == NULL) {
+				continue;
+			}
+			bool on = state != kOSBooleanFalse && state != NULL;
+			fSeg[fCount].on = on;
+			fSeg[fCount].level = on ? vib_level(state, level) : 0;
+			uint64_t v = ms->unsigned64BitValue();
+			fSeg[fCount].ms = v > 10000u ? 10000u : (uint32_t)v;
+			fCount++;
+		}
+		fRepeat = d->getObject("repeat") == kOSBooleanTrue;
+	}
+	uint32_t n = ++fRequests, count = fCount;
+	bool repeat = fRepeat;
+	/*
+	 * 0250: every request, every segment (up to 8) and, for a non-dictionary, its class and value: a repeated
+	 * pattern played until the 60 s cap and the request lines (first 20 only) had rolled out of dmesg.
+	 */
+	char segs[8 * 18 + 8] = "";
+	for (uint32_t i = 0; i < count && i < 8; i++) {
+		char one[20];
+		snprintf(one, sizeof(one), " %s%u@%u", fSeg[i].on ? "+" : "-", fSeg[i].ms, fSeg[i].level >> 8);
+		strlcat(segs, one, sizeof(segs));
+	}
+	IOLockUnlock(fLock);
+	if (d == NULL) {
+		OSNumber *num = OSDynamicCast(OSNumber, properties);
+		IOLog("SWEET VIBRATOR: request #%u: stop (%s %llu)\n", n,
+		    properties ? properties->getMetaClass()->getClassName() : "null", num ? num->unsigned64BitValue() : 0ull);
+	} else {
+		OSObject *hm = d->getObject("hertz_millisecs");
+		IOLog("SWEET VIBRATOR: request #%u: %u segment(s)%s [ms@level/256]%s%s (keys %u, hertz_millisecs %s)\n", n, count,
+		    repeat ? " REPEAT" : "", segs, count > 8 ? " ..." : "", d->getCount(),
+		    hm ? hm->getMetaClass()->getClassName() : "missing");
+	}
+	(void)sweet_haptic_buzz(0);
+	if (count != 0) {
+		thread_call_enter(fCall);
+	}
+	return kIOReturnSuccess;
+}
+
+/* false: a newer request came in */
+bool
+SweetVibrator::waitFor(uint32_t gen, uint32_t ms)
+{
+	while (ms > 0) {
+		if (fGen != gen || sweet_haptic_stops() != fStops) {
+			return false;
+		}
+		uint32_t step = ms > 10 ? 10 : ms;
+		IOSleep(step);
+		ms -= step;
+	}
+	return fGen == gen;
+}
+
+void
+SweetVibrator::run(thread_call_param_t self, thread_call_param_t)
+{
+	((SweetVibrator *)self)->play();
+}
+
+void
+SweetVibrator::play(void)
+{
+	IOLockLock(fLock);
+	uint32_t gen = fGen, count = fCount;
+	bool repeat = fRepeat;
+	fStops = sweet_haptic_stops();
+	decltype(fSeg) seg;
+	memcpy(seg, fSeg, sizeof(seg));
+	IOLockUnlock(fLock);
+	uint32_t total = 0;
+	do {
+		for (uint32_t i = 0; i < count && fGen == gen && sweet_haptic_stops() == fStops; i++) {
+			uint32_t ms = seg[i].ms ? seg[i].ms : 1;
+			if (seg[i].on && ms <= 40) {
+				unsigned wave = 1u + (seg[i].level * 4u) / 65536u;          /* 1..5 */
+				if (seg[i].level >= 62000u && ms >= 25) {
+					wave = 20;                                          /* heavy */
+				}
+				(void)sweet_haptic_wave(wave);
+				(void)waitFor(gen, ms);
+			} else if (seg[i].on) {
+				(void)sweet_haptic_buzz(1);
+				bool same = waitFor(gen, ms);
+				if (same) {
+					(void)sweet_haptic_buzz(0);
+				}
+			} else {
+				(void)waitFor(gen, ms);
+			}
+			total += ms;
+		}
+	} while (repeat && fGen == gen && sweet_haptic_stops() == fStops && total < 30000u);   /* 0250: 30 s cap */
+	if (fGen == gen && sweet_haptic_stops() == fStops) {
+		(void)sweet_haptic_buzz(0);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetWatchdog.cpp ci-sweet/iokit/Kernel/arm/SweetWatchdog.cpp
--- a/iokit/Kernel/arm/SweetWatchdog.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetWatchdog.cpp	2026-11-20 20:53:28.567094095 +0100
@@ -0,0 +1,107 @@
+/*
+ * Built-in IOWatchdog for SWEET.
+ *
+ * watchdogd (launchd job with _PanicOnCrash) opens IOServiceMatching(
+ * "IOWatchdog") with type 1 and exits when it is missing, which panics the
+ * system. On Apple hardware the kext arms a SoC watchdog that resets the
+ * device unless watchdogd keeps checking in. SWEET has no reset path, so
+ * this service accepts every call (check-in 1, enable/disable userspace
+ * monitoring 3/4, 0/5, struct calls 2 and 9) and does nothing; each
+ * selector is logged the first time it is used.
+ *
+ * watchdogd also writes the device boot stage to the PMU: it looks up
+ * the IOService with IOPMUPrimary = 1 and crashes when there is none
+ * (customer builds ignore -wdt_no_pmu). SWEET has no Apple PMU, so this
+ * service carries IOPMUPrimary and accepts property writes.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+IOReturn
+IOWatchdog::setProperties(__unused OSObject *properties)
+{
+	return kIOReturnSuccess;
+}
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);
+	registerService();
+	IOLog("SWEET WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_wdt_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(sweet_wdt_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_wdt_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET WDT: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
