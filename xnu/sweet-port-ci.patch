+OSDefineMetaClassAndStructors(RedwoodGPU, IOService);
+
+bool
+RedwoodGPU::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "RedwoodGPUUserClient");
+	setName("RedwoodGPU");
+	registerService();
+	return true;
+}
+
+void
+RedwoodGPUStart(void)
+{
+	IOService * provider = IOService::getPlatform();
+	RedwoodGPU * gpu;
+	uint32_t cached = 0;
+
+	gGPUCached = PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached)) && cached != 0;
+	gGPULock = IOLockAlloc();
+	gpu = OSTypeAlloc(RedwoodGPU);
+	if (gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("RedwoodGPU: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("RedwoodGPU: the service did not start\n");
+	}
+	gpu->release();
+}
+
+/* The run is ending (redwood_adreno.c): nobody is in the middle of anything when the GPU goes. */
+void
+RedwoodGPUStop(void)
+{
+	IOLockLock(gGPULock);
+	redwood_gpu_stop();
+	IOLockUnlock(gGPULock);
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *            memory;         /* NULL: this handle is free */
+	uint8_t *                       kernel;         /* where it is in the kernel */
+	SweetSurface *                  surface;        /* whose memory it is, when not its own */
+	uint64_t                        address;        /* the GPU's for it */
+	uint64_t                        size;
+	uint32_t                        flags;
+	uint32_t                        seed;           /* the surface's when it was last pushed out of the cache, */
+	uint64_t                        pushed;         /* ... and when that was */
+	bool                            seen;           /* by the program: mapped, and from then on written by it */
+	uint32_t                        fence;          /* the last submission that names it (0: none has) */
+};
+
+/*
+ * A buffer given back while the GPU is still at it: its memory and its place in the GPU's
+ * address space are kept until the submission is done, and nobody waits for that. (A window
+ * server that makes a surface for every frame gives the last frame's back while the GPU draws
+ * this one: waiting there, for all the GPU had been given, cost it some five milliseconds a
+ * frame.)
+ */
+struct gpu_left {
+	IOMemoryDescriptor *            memory;
+	SweetSurface *                  surface;
+	uint64_t                        address, size;
+	uint32_t                        fence, flags;
+};
+#define GPU_LEFT                64
+
+/*
+ * A buffer of the program's own given back, and done with: kept, memory and place in the GPU's
+ * address space, for the next one of the same size and kind. CoreAnimation makes a new texture to
+ * draw a blur into for every frame of an animation with one (Search: 1082 x 1226, 6 MB with Mesa's
+ * rounding), and gives them back only later, a score at a time; Mesa keeps what is given back for
+ * a second and then lets it go. Each made afresh here took 2 to 3.5 ms of the window server's frame
+ * (memory got, cleared, made write-combined, and entered page by page into the GPU's address
+ * space). A buffer kept is given again as it is, not cleared: it was the same program's (Mesa's own
+ * cache gives buffers back the same way). At most GPU_KEPT_BYTES are kept (the one kept longest
+ * makes way), none for longer than GPU_KEPT_SECONDS. rc.jobs.fps, Search: 8 such textures made
+ * slowly instead of 77, the window server's frames drawn in 6.8 ms instead of 9.3-10 (median).
+ */
+struct gpu_kept {
+	IOMemoryDescriptor *            memory;         /* NULL: this place is free */
+	uint8_t *                       kernel;
+	uint64_t                        address, size, since;
+	uint32_t                        flags;
+};
+#define GPU_KEPT                48
+#define GPU_KEPT_BYTES          (160ull << 20)
+#define GPU_KEPT_SECONDS        60              /* a buffer not asked for again in so long is let go */
+#define GPU_KEEP_FROM           (256u << 10)    /* bytes: smaller ones are not worth it */
+static TUNABLE(uint32_t, gGPUKeep, "gpu_keep", 1);      /* boot-arg gpu_keep=0 (a test): none kept; gpu_keep=2: kept ones cleared when given again */
+
+class RedwoodGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(RedwoodGPUUserClient);
+
+	task_t                  fTask;
+	struct gpu_buffer *     fBuffers;               /* handle n is fBuffers[n - 1] */
+	uint32_t                fNextQueue;
+	uint32_t                fNextBuffer;            /* where the search for a free handle starts: one given back is not the next given */
+	uint32_t                fBufferCount;
+	uint64_t                fBufferBytes;
+	uint32_t                fSubmits;
+	uint32_t                fStrangers;             /* requests that named a buffer the client does not have */
+	struct gpu_left         fLeft[GPU_LEFT];
+	uint32_t                fLeftCount;
+	struct gpu_kept         fKept[GPU_KEPT];
+	uint64_t                fKeptBytes;
+
+	struct gpu_buffer * buffer(uint32_t handle);
+	struct gpu_buffer * newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size, uint32_t flags, uint32_t * handle);
+	void freeBuffer(struct gpu_buffer * b);
+	bool keep(IOMemoryDescriptor * memory, uint8_t * kernel, uint64_t address, uint64_t size, uint32_t flags);
+	void dropKept(struct gpu_kept * k);
+	void reap(void);
+	IOReturn gemNew(struct msm_gem_new * request);
+	IOReturn surfaceBuffer(struct redwood_surface * request);
+	IOReturn gemInfo(struct msm_gem_info * request);
+	IOReturn submit(struct msm_gem_submit * request);
+	IOReturn show(const struct redwood_show * request);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodGPUUserClient, IOUserClient);
+
+bool
+RedwoodGPUUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+RedwoodGPUUserClient::start(IOService * provider)
+{
+	if (!redwood_gpu_ready() || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct gpu_buffer, GPU_BUFFERS);
+	return fBuffers != NULL;
+}
+
+/*
+ * With the lock held, and the GPU done with everything it has been given (`idle`). If it is
+ * not -- it has stopped answering -- the buffer's memory stays the GPU's for good: it may yet be
+ * written, and must not be somebody else's by then.
+ */
+void
+RedwoodGPUUserClient::freeBuffer(struct gpu_buffer * b)
+{
+	bool busy = redwood_gpu_ready() && b->fence != 0 && !redwood_gpu_done(b->fence);
+
+	if (busy && fLeftCount == GPU_LEFT) {
+		busy = !gpuWait(b->fence, 1000);        /* (nowhere to keep it: this one is waited for) */
+	}
+	if (busy && fLeftCount < GPU_LEFT) {
+		struct gpu_left * left = &fLeft[fLeftCount++];
+
+		left->memory = b->memory;
+		left->surface = b->surface;
+		left->address = b->address;
+		left->size = b->size;
+		left->fence = b->fence;
+		left->flags = b->flags;
+	} else {
+		if (busy) {
+			static uint32_t said;
+
+			if (b->surface == NULL) {
+				b->memory->retain();
+			} else {
+				b->surface->memory->retain();
+			}
+			if (said++ < 8) {
+				IOLog("RedwoodGPU: the GPU is not done with what it was given: a buffer of %llu bytes stays its own\n", b->size);
+			}
+		} else if (b->surface == NULL && redwood_gpu_ready() && keep(b->memory, b->kernel, b->address, b->size, b->flags)) {
+			b->memory = NULL;               /* (now the kept one's) */
+		} else if (redwood_gpu_ready()) {
+			redwood_gpu_unmap(b->address, b->size);
+			redwood_gpu_address_free(b->address, b->size);
+		}
+		if (b->memory != NULL) {
+			b->memory->release();
+		}
+		if (b->surface != NULL) {
+			b->surface->release();
+		}
+	}
+	b->memory = NULL;
+	b->surface = NULL;
+	fBufferCount--;
+	fBufferBytes -= b->size;
+}
+
+/* The buffers that were given back early and that the GPU is done with now: freed. With the lock held. */
+void
+RedwoodGPUUserClient::reap(void)
+{
+	for (uint32_t i = 0; i < fLeftCount;) {
+		struct gpu_left * left = &fLeft[i];
+
+		if (redwood_gpu_ready() && !redwood_gpu_done(left->fence)) {
+			i++;
+			continue;
+		}
+		if (left->surface == NULL && redwood_gpu_ready() &&
+		    keep(left->memory, NULL, left->address, left->size, left->flags)) {
+			left->memory = NULL;
+		} else if (redwood_gpu_ready()) {
+			redwood_gpu_unmap(left->address, left->size);
+			redwood_gpu_address_free(left->address, left->size);
+		}
+		if (left->memory != NULL) {
+			left->memory->release();
+		}
+		if (left->surface != NULL) {
+			left->surface->release();
+		}
+		*left = fLeft[--fLeftCount];
+	}
+}
+
+IOReturn
+RedwoodGPUUserClient::clientClose(void)
+{
+	if (fBuffers != NULL) {
+		IOLockLock(gGPULock);
+		/* what the client had the GPU do last may still be going on, in these buffers */
+		if (redwood_gpu_ready()) {
+			gpuWait(redwood_gpu_last(), 1000);
+		}
+		for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		reap();
+		for (uint32_t i = 0; i < GPU_KEPT; i++) {
+			dropKept(&fKept[i]);
+		}
+		if (fLeftCount != 0) {
+			IOLog("RedwoodGPU: the GPU is not done with %u buffers of a program that is gone: they stay its own\n", fLeftCount);
+		}
+		IOLockUnlock(gGPULock);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+RedwoodGPUUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct gpu_buffer, GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+struct gpu_buffer *
+RedwoodGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > GPU_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		/* (a program that names a buffer it has given back draws into somebody else's next: worth knowing) */
+		if (handle != 0 && fStrangers++ < 16) {
+			IOLog("RedwoodGPU: buffer %u is asked for and is not there\n", handle);
+		}
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * A handle and addresses of the GPU's for `size` bytes of a memory descriptor, from byte `from`
+ * of it on (wired memory; both in whole pages). With the lock held; NULL: there is no room.
+ */
+struct gpu_buffer *
+RedwoodGPUUserClient::newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size, uint32_t flags, uint32_t * handle)
+{
+	struct gpu_buffer * b = NULL;
+	bool mapped = true;
+
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			*handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL || (b->address = redwood_gpu_address(size)) == 0) {
+		IOLog("RedwoodGPU: no %s left for a buffer of %llu bytes\n", b ? "addresses" : "handles", size);
+		return NULL;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(from + offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && redwood_gpu_map(b->address + offset, phys, flags & MSM_BO_GPU_READONLY);
+	}
+	redwood_gpu_mapped();
+	if (!mapped) {
+		redwood_gpu_unmap(b->address, size);
+		redwood_gpu_address_free(b->address, size);
+		IOLog("RedwoodGPU: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		return NULL;
+	}
+	b->size = size;
+	b->flags = flags;
+	b->seed = 0;
+	b->pushed = 0;
+	b->seen = false;
+	b->fence = 0;
+	b->surface = NULL;
+	fBufferCount++;
+	fBufferBytes += size;
+	return b;
+}
+
+/* With the lock held. */
+void
+RedwoodGPUUserClient::dropKept(struct gpu_kept * k)
+{
+	if (k->memory == NULL) {
+		return;
+	}
+	if (redwood_gpu_ready()) {
+		redwood_gpu_unmap(k->address, k->size);
+		redwood_gpu_address_free(k->address, k->size);
+	}
+	k->memory->release();
+	k->memory = NULL;
+	fKeptBytes -= k->size;
+}
+
+/* With the lock held, the GPU done with the buffer: kept if it is worth it (those kept longest make way). */
+bool
+RedwoodGPUUserClient::keep(IOMemoryDescriptor * memory, uint8_t * kernel, uint64_t address, uint64_t size, uint32_t flags)
+{
+	struct gpu_kept * place = NULL;
+
+	if (gGPUKeep == 0 || size < GPU_KEEP_FROM || size > GPU_KEPT_BYTES / 4 || memory == NULL ||
+	    (kernel == NULL && OSDynamicCast(IOBufferMemoryDescriptor, memory) == NULL)) {
+		return false;
+	}
+	for (;;) {
+		struct gpu_kept * oldest = NULL;
+
+		place = NULL;
+		for (uint32_t i = 0; i < GPU_KEPT; i++) {
+			if (fKept[i].memory == NULL) {
+				place = place != NULL ? place : &fKept[i];
+			} else if (oldest == NULL || fKept[i].since < oldest->since) {
+				oldest = &fKept[i];
+			}
+		}
+		if (place != NULL && fKeptBytes + size <= GPU_KEPT_BYTES) {
+			break;
+		}
+		dropKept(oldest);
+	}
+	place->memory = memory;
+	place->kernel = kernel != NULL ? kernel : (uint8_t *) OSDynamicCast(IOBufferMemoryDescriptor, memory)->getBytesNoCopy();
+	place->address = address;
+	place->size = size;
+	place->flags = flags;
+	place->since = mach_absolute_time();
+	fKeptBytes += size;
+	return true;
+}
+
+IOReturn
+RedwoodGPUUserClient::gemNew(struct msm_gem_new * request)
+{
+	uint64_t size = round_page_64(request->size), began = mach_absolute_time();
+	struct gpu_buffer * b;
+	IOBufferMemoryDescriptor * memory;
+
+	if (size == 0 || size > GPU_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	/* one kept of this size and kind, if there is one (the one kept last: likeliest still in the caches' way) */
+	IOLockLock(gGPULock);
+	struct gpu_kept * found = NULL;
+	uint64_t old;
+
+	nanoseconds_to_absolutetime(GPU_KEPT_SECONDS * NSEC_PER_SEC, &old);
+	for (uint32_t i = 0; i < GPU_KEPT; i++) {
+		struct gpu_kept * k = &fKept[i];
+
+		if (k->memory != NULL && began - k->since > old) {
+			dropKept(k);
+		}
+
+		if (k->memory != NULL && k->size == size && k->flags == request->flags && (found == NULL || k->since > found->since)) {
+			found = k;
+		}
+	}
+	for (uint32_t n = 0; found != NULL && n < GPU_BUFFERS; n++) {
+		uint32_t h = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[h].memory == NULL) {
+			b = &fBuffers[h];
+			bzero(b, sizeof(*b));
+			b->memory = found->memory;
+			b->kernel = found->kernel;
+			b->address = found->address;
+			b->size = found->size;
+			b->flags = found->flags;
+			fNextBuffer = h + 1;
+			fBufferCount++;
+			fBufferBytes += size;
+			request->handle = h + 1;
+			found->memory = NULL;
+			fKeptBytes -= size;
+			gGPUStat.given_again++;
+			IOLockUnlock(gGPULock);
+			if (gGPUKeep == 2) {
+				bzero(b->kernel, (size_t) b->size);
+			}
+			return kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	/* (the memory comes zeroed, and making it write-combined pushes the zeroes out of the cache) */
+	/* guacamole: all RAM is above 4 GiB; the GPU's SMMU context takes 36-bit addresses (sweet_gpu.c) */
+	memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
+	    (gGPUCached ? 0 : kIOMapWriteCombineCache), (vm_size_t) size, 0x0000000ffffff000ull);
+	if (memory == NULL) {
+		IOLog("RedwoodGPU: no memory for a buffer of %llu bytes (%u buffers, %llu MB with this client)\n", size, fBufferCount,
+		    fBufferBytes >> 20);
+		return kIOReturnNoMemory;
+	}
+	if (gGPUCached) {
+		redwood_gpu_to_memory(memory->getBytesNoCopy(), size);
+	}
+
+	IOLockLock(gGPULock);
+	b = newBuffer(memory, 0, size, request->flags, &request->handle);
+	if (b != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *) memory->getBytesNoCopy();
+		gGPUStat.made++;
+		gGPUStat.making += mach_absolute_time() - began;
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * The memory of an IOSurface as a buffer: its pixels, from the page after the surface's shared
+ * state on (MiniIOSurface.h). The surface is held for as long as the buffer is there. A surface
+ * that is a buffer of this client's already is that buffer again, as with Linux's handles: so
+ * the client must not be giving that buffer back at the same moment (freedreno asks under the
+ * lock it gives buffers back under). Asked only to describe (kRedwoodDescribe), no buffer is made.
+ */
+IOReturn
+RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
+{
+#if !REDWOOD_SURFACES
+	(void) request;
+	return kIOReturnUnsupported;
+#else
+	SweetSurface * s = sweet_surface_copy(request->surface);
+	struct gpu_buffer * b = NULL;
+	IOMemoryDescriptor * memory;
+	uint64_t size, began = mach_absolute_time();
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (s->memory == NULL || s->kernelAddress() == 0) {
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	/* 0132: a surface around a task's memory starts wrapDelta bytes into its first page */
+	size = round_page_64((uint64_t)s->wrapDelta + s->allocSize);
+	if (size > s->memory->getLength()) {
+		size = s->memory->getLength();
+	}
+	memory = IOSubMemoryDescriptor::withSubRange(s->memory, 0, size, kIODirectionInOut);
+	if (memory == NULL || size == 0 || size > GPU_BUFFER_MAX) {
+		OSSafeReleaseNULL(memory);
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	request->size = size;
+	request->offset = s->offset + s->wrapDelta;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (request->handle == kRedwoodDescribe) {
+		request->handle = 0;
+		memory->release();
+		s->release();
+		return kIOReturnSuccess;
+	}
+
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		memory->release();
+		s->release();
+	} else if ((b = newBuffer(s->memory, 0, size, 0, &request->handle)) != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *) s->kernelAddress();
+		b->surface = s;
+		gGPUStat.surfaces++;
+	}
+	gGPUStat.taking += mach_absolute_time() - began;
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+#endif /* REDWOOD_SURFACES */
+}
+
+IOReturn
+RedwoodGPUUserClient::gemInfo(struct msm_gem_info * request)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		ret = kIOReturnBadArgument;
+	} else if (request->info == MSM_INFO_GET_OFFSET) {
+		request->value = (uint64_t) request->handle << 32;      /* nobody maps by it here */
+	} else if (request->info == MSM_INFO_GET_IOVA) {
+		request->value = b->address;
+	} else if (request->info == MSM_INFO_GET_FLAGS) {
+		request->value = b->flags;
+	} else if (request->info != MSM_INFO_SET_NAME) {            /* a name for somebody's debugger: not kept */
+		ret = kIOReturnUnsupported;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::submit(struct msm_gem_submit * request)
+{
+	struct msm_gem_submit_bo * bos = NULL;
+	struct msm_gem_submit_cmd * cmds = NULL;
+	uint64_t addresses[GPU_SUBMIT_CMDS];
+	uint32_t words[GPU_SUBMIT_CMDS], count = 0;
+	uint64_t began, nanos, again;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (request->nr_cmds == 0 || request->nr_cmds > GPU_SUBMIT_CMDS || request->nr_bos == 0 || request->nr_bos > GPU_SUBMIT_BOS) {
+		IOLog("RedwoodGPU: a submission of %u command buffers in %u buffers: not taken\n", request->nr_cmds, request->nr_bos);
+		return kIOReturnBadArgument;
+	}
+	bos = IONew(struct msm_gem_submit_bo, request->nr_bos);
+	cmds = IONew(struct msm_gem_submit_cmd, request->nr_cmds);
+	if (bos == NULL || cmds == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if (copyin((user_addr_t) request->bos, bos, request->nr_bos * sizeof(*bos)) != 0 ||
+	    copyin((user_addr_t) request->cmds, cmds, request->nr_cmds * sizeof(*cmds)) != 0) {
+		ret = kIOReturnVMError;
+		goto out;
+	}
+	IOLockLock(gGPULock);
+	/*
+	 * The GPU reads memory and writes memory. What this processor's cache holds of an IOSurface
+	 * (somebody has written it, or has read it, as the display's driver does, and the GPU is to
+	 * draw into it again) goes out of the cache now: when the surface is said to have changed
+	 * (its seed: who writes one is to lock it, and so does a program that has had the GPU draw
+	 * into one: userland/src/eagl.c), and in any case once in a few milliseconds, which is once
+	 * a frame and not once a submission: not everybody who draws into a surface says so (an
+	 * application drawing a picture that is on the screen meanwhile). A surface this program
+	 * has mapped, every time. The buffers made here need none of that, unless they are
+	 * ordinary memory (gpu_cached=1).
+	 */
+	began = mach_absolute_time();
+	nanoseconds_to_absolutetime(GPU_PUSH_AGAIN_MS * NSEC_PER_MSEC, &again);
+	for (uint32_t i = 0; i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b == NULL) {
+			continue;
+		}
+#if REDWOOD_SURFACES
+		if (b->surface != NULL) {
+			uint32_t seed = *(volatile uint32_t *) ((uint8_t *) b->surface->state->getBytesNoCopy() + 0xc);
+
+			if (seed == b->seed && !b->seen && began - b->pushed < again) {
+				continue;
+			}
+			b->seed = seed;
+			b->pushed = began;
+		} else
+#endif
+		if (!b->seen || !gGPUCached) {
+			continue;
+		}
+		redwood_gpu_to_memory(b->kernel, b->size);
+		gGPUStat.flushed += b->size;
+	}
+	redwood_gpu_to_memory(NULL, 0);                 /* (and what was written last is in memory: a barrier) */
+	gGPUStat.flushing += mach_absolute_time() - began;
+	gGPUStat.buffers += request->nr_bos;
+	for (uint32_t i = 0; i < request->nr_cmds; i++) {
+		struct gpu_buffer * b = cmds[i].submit_idx < request->nr_bos ? buffer(bos[cmds[i].submit_idx].handle) : NULL;
+
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;                               /* the other kinds are for a GPU shared between address spaces */
+		}
+		if (b == NULL || cmds[i].nr_relocs != 0 || (cmds[i].size & 3) || (cmds[i].submit_offset & 3) ||
+		    (uint64_t) cmds[i].submit_offset + cmds[i].size > b->size) {
+			IOLog("RedwoodGPU: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, cmds[i].submit_idx, cmds[i].submit_offset, cmds[i].size, cmds[i].nr_relocs);
+			IOLockUnlock(gGPULock);
+			goto out;
+		}
+		addresses[count] = b->address + cmds[i].submit_offset;
+		words[count++] = cmds[i].size / 4;
+	}
+	request->fence = redwood_gpu_submit(addresses, words, count);
+	if (gpu_log && request->fence != 0) {
+		/* "tl: Q FENCE at US: N buffers, B of 4 MB or more, W words of commands": what was given (tl: q: what it took) */
+		uint32_t big = 0, all_words = 0;
+		uint64_t ns;
+
+		for (uint32_t i = 0; i < request->nr_bos; i++) {
+			struct gpu_buffer * b = buffer(bos[i].handle);
+
+			big += b != NULL && b->size >= (4u << 20);
+		}
+		for (uint32_t i = 0; i < count; i++) {
+			all_words += words[i];
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		redwood_tl("tl: Q %u at %llu: %u buffers, %u big, %u words\n", request->fence, ns / 1000, request->nr_bos, big, all_words);
+	}
+	if (request->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+		request->fence_fd = -1;
+	}
+	/*
+	 * The surfaces named are being drawn into, or read, until this submission is done: the
+	 * display's driver waits for that before it puts one on the panel (MiniIOSurfaceDrawn()).
+	 * (freedreno names every buffer for reading and writing alike, so which it is cannot be
+	 * told; the last submission of a frame names the surface the frame is drawn into.)
+	 */
+	for (uint32_t i = 0; request->fence != 0 && i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b != NULL) {
+			b->fence = request->fence;
+#if REDWOOD_SURFACES
+			if (b->surface != NULL) {
+				b->surface->drawn = request->fence;
+			}
+#endif
+		}
+	}
+	reap();
+	if (request->fence == 0 && !gGPUReported) {
+		gGPUReported = true;
+		redwood_gpu_report("the ring is full");
+	}
+	if (fSubmits++ < 4) {
+		IOLog("RedwoodGPU: submission %u: %u command buffers, the first at %#llx, %u words\n", request->fence, count,
+		    addresses[0], words[0]);
+	}
+	/* every five seconds in which something was submitted: how much, and what it cost here */
+	gGPUStat.submissions++;
+	gGPUStat.commands += count;
+	if (gGPUStat.since == 0) {
+		gGPUStat.since = began;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - gGPUStat.since, &nanos);
+	if (nanos >= 5 * NSEC_PER_SEC) {
+		uint64_t flushing, waiting, taking, worked;
+		uint32_t timed, by[7];
+
+		absolutetime_to_nanoseconds(gGPUStat.flushing, &flushing);
+		absolutetime_to_nanoseconds(gGPUStat.waiting, &waiting);
+		absolutetime_to_nanoseconds(gGPUStat.taking, &taking);
+		redwood_gpu_worked(&worked, &timed, by);
+		uint64_t making;
+
+		absolutetime_to_nanoseconds(gGPUStat.making, &making);
+		IOLog("RedwoodGPU: buffers: %u made in %llu us each, %u kept ones given again (%llu MB kept)\n", gGPUStat.made,
+		    gGPUStat.made ? making / NSEC_PER_USEC / gGPUStat.made : 0, gGPUStat.given_again, fKeptBytes >> 20);
+		IOLog("RedwoodGPU: %u submissions in %llu ms: %u command buffers and %u buffers named, %llu KB out of the cache "
+		    "in %llu us a submission; the GPU worked %llu us on each of %u (%u under 0.1 ms, %u under 0.25, %u under 0.5, "
+		    "%u under 1, %u under 2, %u under 4, %u longer; %llu ms in all); %u waits of %llu us, %u over before they "
+		    "began; %u IOSurfaces taken as buffers in %llu us each; %u buffers, %llu MB\n",
+		    gGPUStat.submissions, nanos / NSEC_PER_MSEC, gGPUStat.commands, gGPUStat.buffers,
+		    (gGPUStat.flushed >> 10) / gGPUStat.submissions, flushing / NSEC_PER_USEC / gGPUStat.submissions,
+		    timed ? worked / timed : 0, timed, by[0], by[1], by[2], by[3], by[4], by[5], by[6], worked / 1000,
+		    gGPUStat.waits, gGPUStat.waits ? waiting / NSEC_PER_USEC / gGPUStat.waits : 0, gGPUStat.over,
+		    gGPUStat.surfaces, gGPUStat.surfaces ? taking / NSEC_PER_USEC / gGPUStat.surfaces : 0, fBufferCount,
+		    fBufferBytes >> 20);
+		bzero(&gGPUStat, sizeof(gGPUStat));
+	}
+	IOLockUnlock(gGPULock);
+	ret = request->fence != 0 ? kIOReturnSuccess : kIOReturnTimeout;
+out:
+	if (bos != NULL) {
+		IODelete(bos, struct msm_gem_submit_bo, request->nr_bos);
+	}
+	if (cmds != NULL) {
+		IODelete(cmds, struct msm_gem_submit_cmd, request->nr_cmds);
+	}
+	return ret;
+}
+
+/* Pixels of the caller's (32 bits each, blue first) copied to the panel: for a test to show what it has drawn. */
+IOReturn
+RedwoodGPUUserClient::show(const struct redwood_show * request)
+{
+	uint64_t size = (uint64_t) request->rowBytes * request->height;
+	uint8_t * pixels;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (request->width == 0 || request->width > 4096 || request->height == 0 || request->height > 4096 ||
+	    request->rowBytes < 4 * request->width) {
+		return kIOReturnBadArgument;
+	}
+	pixels = (uint8_t *) IOMallocData(size);
+	if (pixels == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (copyin((user_addr_t) request->pixels, pixels, size) != 0) {
+		ret = kIOReturnVMError;
+	} else {
+		ret = kIOReturnUnsupported;     /* topaz: no test display path */
+	}
+	IOFreeData(pixels, size);
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gGPULock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		b->seen = true;
+		*memory = b->memory;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_submit submit;
+		struct msm_wait_fence waitFence;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+		struct redwood_surface surface;
+		struct redwood_show show;
+	} r;
+	size_t size = args->structureInputSize;
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t zero = 0, patience, waitBegan;
+
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!redwood_gpu_ready() && selector != kRedwoodShow) {
+		return kIOReturnNotReady;                       /* given back: the run is ending */
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	switch (selector) {
+	case kMsmGetParam:
+		ret = redwood_gpu_parameter(r.param.param, &r.param.value) ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	case kMsmSetParam:                              /* the program's name, for Linux's lists of who uses the GPU */
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep:                            /* is the GPU done with a buffer: with all it has been given, here */
+		waitBegan = mach_absolute_time();
+		IOLockLock(gGPULock);
+		patience = (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 : millisecondsUntil(&r.cpuPrep.timeout);
+		if (!gpuWait(redwood_gpu_last(), patience)) {
+			ret = kIOReturnBusy;
+			if (patience == 0 && !(r.cpuPrep.op & MSM_PREP_NOSYNC)) {
+				waitOver(&r.cpuPrep.timeout, redwood_gpu_last());
+			}
+		}
+		IOLockUnlock(gGPULock);
+		slowWait("cpu-prep", waitBegan);
+		break;
+	case kMsmGemSubmit:
+		ret = submit(&r.submit);
+		break;
+	case kMsmWaitFence:
+		waitBegan = mach_absolute_time();
+		IOLockLock(gGPULock);
+		patience = millisecondsUntil(&r.waitFence.timeout);
+		if (!gpuWait(r.waitFence.fence, patience)) {
+			ret = kIOReturnTimeout;
+			if (patience == 0) {
+				waitOver(&r.waitFence.timeout, r.waitFence.fence);
+			}
+		}
+		IOLockUnlock(gGPULock);
+		slowWait("fence", waitBegan);
+		break;
+	case kMsmGemMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:                      /* how often the GPU has faulted on this client's commands */
+		if (r.query.data != 0 && r.query.len >= sizeof(zero)) {
+			copyout(&zero, (user_addr_t) r.query.data, sizeof(zero));
+		}
+		break;
+	case kDrmGemClose:
+		IOLockLock(gGPULock);
+		b = buffer(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			freeBuffer(b);
+			reap();
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kRedwoodSurface:
+		ret = surfaceBuffer(&r.surface);
+		break;
+	case kRedwoodShow:
+		ret = show(&r.show);
+		break;
+	default:
+		IOLog("RedwoodGPU: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t) size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/RedwoodWLAN.cpp ci-sweet/iokit/Kernel/arm/RedwoodWLAN.cpp
--- a/iokit/Kernel/arm/RedwoodWLAN.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/RedwoodWLAN.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,137 @@
+/*
+ * RedwoodWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/redwood_net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/redwood_apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ * So: a controller of the class IO80211Controller under the platform, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. Both classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; neither has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void RedwoodWLANStart(const char * interface, const uint8_t * address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class RedwoodWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(RedwoodWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+RedwoodWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("RedwoodWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+RedwoodWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	RedwoodWLAN * wlan = OSTypeAlloc(RedwoodWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("RedwoodWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "RedwoodWLANController")) == NULL) {
+		wlan->release();
+		IOLog("RedwoodWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "RedwoodWLAN") == NULL) {
+		IOLog("RedwoodWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
diff -ruN ci-base/iokit/Kernel/arm/SweetAMFI.cpp ci-sweet/iokit/Kernel/arm/SweetAMFI.cpp
--- a/iokit/Kernel/arm/SweetAMFI.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetAMFI.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,97 @@
+/*
+ * A stand-in for AppleMobileFileIntegrity's IOService, which this kernel
+ * does not have (no AMFI kext). Userland looks it up by class name:
+ * ExtensionFoundation's +[NSDictionary _EX_dictionaryWithSignedURL:] reads
+ * signed caches (the extension point cache) only after asking AMFI whether
+ * the file's cdhash is in the trust cache. Without an answer, sandboxed
+ * readers (lsd) get no extension point cache, so MobileInstallation rejects
+ * every app extension ("Extension cache does not have an entry for ..."),
+ * LaunchServices registers none, and e.g. PosterBoard finds no poster
+ * providers (black wallpaper).
+ *
+ * User client, IOConnectCallMethod:
+ *   6 trust cache query  [1] + struct cdhash -> 0 (trusted)
+ * Every cdhash is trusted: code signing is not enforced here anyway, and
+ * there is no trust cache to look in. Other selectors are logged once and
+ * answered kIOReturnUnsupported, which is what their callers already got
+ * from the missing service. Boot-arg sweetamfi=0 leaves the service out.
+ *
+ * From ios-flame (NWylynko/ios-flame, MIT for its additions; this file is
+ * part of XNU, APSL 2.0) patch 0103, unchanged. guacamole had the same
+ * symptom: PosterBoard saw only the Weather poster and crash-looped.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <pexpert/pexpert.h>
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+IOService *
+AppleMobileFileIntegrity::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetamfi", &on, sizeof(on));
+	return on ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity published (trust cache queries answer trusted)\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	static uint32_t logged;	/* one line per selector */
+	if (selector == 6) {
+		if (!(logged & (1u << 6))) {
+			logged |= 1u << 6;
+			IOLog("SWEET AMFI: trust cache query (%u-byte cdhash): trusted\n", args->structureInputSize);
+		}
+		return kIOReturnSuccess;
+	}
+	if (selector < 32 && !(logged & (1u << selector))) {
+		logged |= 1u << selector;
+		IOLog("SWEET AMFI: selector %u (in %u/%u) unsupported\n", selector, args->scalarInputCount,
+		    args->structureInputSize);
+	}
+	return kIOReturnUnsupported;
+}
+#endif
diff -ruN ci-base/iokit/Kernel/arm/SweetAccelerator.cpp ci-sweet/iokit/Kernel/arm/SweetAccelerator.cpp
--- a/iokit/Kernel/arm/SweetAccelerator.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,722 @@
+/*
+ * 0144: the GPU user client Turnip's darwin backend speaks (userland/turnip: Mesa + UniXNU's
+ * turnip-darwin-kmd.patch, tu_knl_darwin.cc), for Metal through metal2vulkan (userland/metal2,
+ * SweetMetal2.bundle). The NativeAdreno ABI v1 (SweetGPUABI.h): struct methods, selector = method,
+ * or tunnelled as {'NTNL', method, payload} through any selector.
+ *
+ * Adapted from ios-flame (NWylynko/ios-flame, MIT) xnu/patches 0096/0115/0116/0117/0122
+ * (iokit/Kernel/arm/SweetAccelerator.cpp, v2 part), on the Pixel 4's same Adreno 640; here on
+ * guacamole's GPU core (bsd/dev/sweet_gpu.c: sweet_gpu_* of 0144 over redwood_gpu_*). ios-flame's
+ * v1 (template SweetMetal) is not carried.
+ *
+ * The client picks GPU addresses inside its own window (sweet_gpu_window_alloc). Buffers come from
+ * the GPU pool (RAM XNU does not manage), write-combined for the CPU, non-cacheable for the GPU;
+ * imports pin the client's own pages (IOSurfaces), whose CPU caches the client maintains itself.
+ * Submits take up to 16 IBs (msm's a6xx_submit wrapping).
+ *
+ * Metal finds the GPU through IOAcceleratorES (SweetFramebuffer.cpp publishes it): with boot-arg
+ * sweetmtl=2 it carries MetalPluginName SweetMetal2 / MetalPluginClassName SweetMTL2Device and
+ * this user client, and Metal loads /System/Library/Extensions/SweetMetal2.bundle.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include "SweetGPUABI.h"
+
+extern "C" {
+void proc_selfname(char *buf, int size);
+bool redwood_gpu_ready(void);
+int sweet_gpu_window_alloc(uint64_t bytes, uint64_t *base);
+void sweet_gpu_window_free(uint64_t base, uint64_t bytes);
+int sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages);
+void sweet_gpu_unmap_at(uint64_t iova, uint64_t bytes);
+uint32_t sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy);
+int sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns);
+uint64_t sweet_gpu_timestamp(void);
+int sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa);
+uint64_t sweet_gpu_pool_avail(void);
+void sweet_gpu_pool_free(uint64_t pa, uint64_t bytes);
+int proc_selfpid(void);
+uint32_t sweet_mtl_pid_submits(int pid, uint32_t *last_fence);
+uint32_t redwood_gpu_last(void);
+uint32_t sweet_gpu_done_fence(void);            /* 0175, sweet_gpu.c */
+}
+
+/*
+ * 0169: the last GPU job each process queued, and how many it has queued. The display (SweetFramebuffer.cpp)
+ * reads it for the process that swaps (backboardd): which fence a frame's drawing ends at, and whether that
+ * drawing reached the ring before the swap. A small table; a pid not in it reads as no submits.
+ */
+#define SWEET_MTL_PIDS  16
+static struct {
+	int pid;
+	uint32_t fence, submits;
+} sweet_mtl_pid[SWEET_MTL_PIDS];
+static unsigned sweet_mtl_pid_next;
+
+static void
+sweet_mtl_note_submit(int pid, uint32_t fence)
+{
+	unsigned i;
+	for (i = 0; i < SWEET_MTL_PIDS; i++) {
+		if (sweet_mtl_pid[i].pid == pid) {
+			break;
+		}
+	}
+	if (i == SWEET_MTL_PIDS) {
+		/* a new process: take the oldest slot (two first submits at once may both land: harmless counts) */
+		i = __atomic_fetch_add(&sweet_mtl_pid_next, 1, __ATOMIC_RELAXED) % SWEET_MTL_PIDS;
+		__atomic_store_n(&sweet_mtl_pid[i].submits, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&sweet_mtl_pid[i].pid, pid, __ATOMIC_RELEASE);
+	}
+	__atomic_store_n(&sweet_mtl_pid[i].fence, fence, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&sweet_mtl_pid[i].submits, 1, __ATOMIC_RELEASE);
+}
+
+uint32_t
+sweet_mtl_pid_submits(int pid, uint32_t *last_fence)
+{
+	for (unsigned i = 0; i < SWEET_MTL_PIDS; i++) {
+		if (__atomic_load_n(&sweet_mtl_pid[i].pid, __ATOMIC_ACQUIRE) == pid) {
+			*last_fence = __atomic_load_n(&sweet_mtl_pid[i].fence, __ATOMIC_ACQUIRE);
+			return __atomic_load_n(&sweet_mtl_pid[i].submits, __ATOMIC_ACQUIRE);
+		}
+	}
+	*last_fence = 0;
+	return 0;
+}
+
+#define SWEET_V2_OPEN_TYPE      0x4147  /* the darwin backend's default ('AG', as the AGX plugin's) */
+#define SWEET_V2_OPEN_DIRECT    2
+#define SWEET_V2_TUNNEL         0x4e544e4cu     /* 'NTNL' */
+#define SWEET_V2_MAX_BOS        65536
+#define SWEET_V2_PAGEBUF        1024            /* 4K pages per sweet_gpu_map_at call */
+/* 0148: GPU VA is 64 GB now (sweet_gpu.c GVA_USER_END) */
+#define SWEET_V2_WIN_SYSTEM     0x100000000ull  /* backboardd, SpringBoard: 4 GB (every app's layers) */
+#define SWEET_V2_WIN_WEBKIT     0x80000000ull   /* WebKit's processes: 2 GB (pool buffers plus every imported page tile) */
+#define SWEET_V2_WIN_CLIENT     0x40000000ull   /* everyone else: 1 GB */
+
+/* One buffer object (slot + 1 = handle = CPU-map token) */
+struct SweetV2BO {
+	IOMemoryDescriptor *md;         /* NULL: free slot */
+	uint64_t bytes;                 /* 4K multiple, as asked */
+	uint64_t iova;                  /* GPU address while mapped, else 0 */
+	uint64_t pool_pa;               /* allocated: its memory in the GPU pool */
+	bool imported;                  /* the client's own pages (no CPU-map token) */
+};
+
+class SweetAcceleratorUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAcceleratorUserClient);
+
+	task_t   fTask;
+	IOLock  *fLock;
+	uint32_t fLastFence;            /* waited for before this client's memory is unmapped */
+	uint64_t fWinBase, fWinSize;    /* this connection's GPU addresses */
+	SweetV2BO *fBO;
+	uint32_t fBOCap;
+	uint64_t *fPageBuf;
+	uint64_t fFaults;
+	uint64_t fPoolBytes, fPoolPeak; /* GPU pool memory this client holds */
+	char fName[32];
+	bool fSystem;                   /* backboardd / SpringBoard: no pool cap, and the reserve is theirs */
+	bool fCapLogged;
+	uint32_t fFailLogs;             /* 0174: failed methods logged */
+
+	bool v2PoolAllowed(uint64_t len);
+	IOReturn v2Method(uint32_t method, const void *in, uint32_t inSize, void *out, uint32_t *outSize);
+	SweetV2BO *v2Find(uint64_t handle);
+	IOReturn v2NewSlot(IOMemoryDescriptor *md, uint64_t bytes, bool imported, uint64_t *handle);
+	void v2Release(SweetV2BO *bo);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAcceleratorUserClient, IOUserClient);
+
+bool
+SweetAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	if (type != SWEET_V2_OPEN_TYPE && type != SWEET_V2_OPEN_DIRECT) {
+		return false;   /* Metal's own open types (Apple's AGX) are not served */
+	}
+	if (!redwood_gpu_ready()) {
+		IOLog("SWEET MTL: GPU not ready: no client\n");
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fBOCap = 256;
+	fBO = IONewZero(SweetV2BO, fBOCap);
+	fPageBuf = IONew(uint64_t, SWEET_V2_PAGEBUF);
+	proc_selfname(fName, sizeof(fName));
+	fSystem = !strcmp(fName, "backboardd") || !strcmp(fName, "SpringBoard");
+	/*
+	 * mtl2 run 3: Safari's GPU process ran out of 256 MB with 130 MB of buffers and ~8 MB tiles
+	 * (OutOfMemory(Device)); run 4: WebContent too, once it draws the pages itself
+	 */
+	fWinSize = fSystem ? SWEET_V2_WIN_SYSTEM : !strncmp(fName, "com.apple.WebKit.", 17) ? SWEET_V2_WIN_WEBKIT :
+	    SWEET_V2_WIN_CLIENT;
+	if (fLock == NULL || fBO == NULL || fPageBuf == NULL || sweet_gpu_window_alloc(fWinSize, &fWinBase)) {
+		IOLog("SWEET MTL: %s: no GPU window\n", fName);
+		fWinSize = 0;
+		return false;
+	}
+	IOLog("SWEET MTL: %s opened: GPU VA %#llx + %llu MB\n", fName, fWinBase, fWinSize >> 20);
+	return true;
+}
+
+/*
+ * The GPU pool is shared by every process (688 MB): one app must not take what the compositor needs.
+ * Others hold at most sweetgpucap MB each (default 192) and never take the last sweetgpureserve MB
+ * (default 128), which stay for backboardd and SpringBoard. A refused buffer is
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY in Turnip.
+ */
+bool
+SweetAcceleratorUserClient::v2PoolAllowed(uint64_t len)
+{
+	static uint32_t cap_mb, reserve_mb;
+	if (cap_mb == 0) {
+		/* 0147: the pool is 2.7 GB with the range above XNU (was 688 MB): 768 MB a process, 256 kept */
+		uint32_t v = 768;
+		PE_parse_boot_argn("sweetgpucap", &v, sizeof(v));
+		reserve_mb = 256;
+		PE_parse_boot_argn("sweetgpureserve", &reserve_mb, sizeof(reserve_mb));
+		cap_mb = v ? v : 0xffffffffu;
+	}
+	if (fSystem) {
+		return sweet_gpu_pool_avail() >= len;
+	}
+	/*
+	 * 0146: Turnip's command streams and small state buffers (1 MB or less) may use the reserve:
+	 * Turnip does not check them (tu_cs_reserve asserts) and wrote through NULL when one was refused
+	 * (mtl2 run 8: web.telegram.org's WebContent at 224 MB, "the compositor's reserve", SIGSEGV in
+	 * tu_init_hw). Textures, which metal2vulkan refuses cleanly, still keep out of it.
+	 */
+	if (len <= (1ULL << 20) && sweet_gpu_pool_avail() >= len + (16ULL << 20)) {
+		return true;
+	}
+	const char *why = NULL;
+	if (fPoolBytes + len > ((uint64_t)cap_mb << 20)) {
+		why = "its cap";
+	} else if (sweet_gpu_pool_avail() < len + ((uint64_t)reserve_mb << 20)) {
+		why = "the compositor's reserve";
+	}
+	if (why != NULL && !fCapLogged) {
+		fCapLogged = true;
+		IOLog("SWEET MTL: %s: %llu MB buffer refused (holds %llu MB, %llu MB of the pool free): %s\n", fName,
+		    len >> 20, fPoolBytes >> 20, sweet_gpu_pool_avail() >> 20, why);
+	}
+	return why == NULL;
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetAcceleratorUserClient::free(void)
+{
+	/*
+	 * Submits are asynchronous: a client that exits (or crashes) may leave work queued. Unmapping its
+	 * memory under the GPU would fault, or hand the VAs and pages to someone else while the GPU still
+	 * writes them: wait for its last fence first.
+	 */
+	if (fLastFence != 0 && sweet_gpu_wait_fence_ns(fLastFence, 2000000000ULL)) {
+		IOLog("SWEET MTL: %s freed with fence %u still pending\n", fName, fLastFence);
+	}
+	if (fBO != NULL) {
+		IOLog("SWEET MTL: %s closed (GPU pool: %llu MB held, peak %llu MB)\n", fName, fPoolBytes >> 20, fPoolPeak >> 20);
+		for (uint32_t i = 0; i < fBOCap; i++) {
+			v2Release(&fBO[i]);
+		}
+		IODelete(fBO, SweetV2BO, fBOCap);
+		fBO = NULL;
+	}
+	if (fPageBuf != NULL) {
+		IODelete(fPageBuf, uint64_t, SWEET_V2_PAGEBUF);
+		fPageBuf = NULL;
+	}
+	if (fWinSize != 0) {
+		sweet_gpu_window_free(fWinBase, fWinSize);
+		fWinSize = 0;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	/* token = slot + 1; write-combined, as the buffer was made (imports keep the client's own mapping) */
+	IOLockLock(fLock);
+	IOMemoryDescriptor *md = type >= 1 && type <= fBOCap && !fBO[type - 1].imported ? fBO[type - 1].md : NULL;
+	if (md != NULL) {
+		md->retain();
+	}
+	IOLockUnlock(fLock);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*options = (*options & ~kIOMapCacheMask) | kIOMapWriteCombineCache;
+	*memory = md;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	/* struct methods: tunnelled {'NTNL', method, payload} through any selector, or selector = method */
+	const uint32_t *w = (const uint32_t *)args->structureInput;
+	uint32_t isz = args->structureInput != NULL ? args->structureInputSize : 0;
+	void *o = args->structureOutputDescriptor == NULL ? args->structureOutput : NULL;
+	uint32_t osz = o != NULL ? args->structureOutputSize : 0;
+	IOReturn r;
+	if (isz >= 8 && w[0] == SWEET_V2_TUNNEL) {
+		r = w[1] == 0xffffffffu ? kIOReturnSuccess : v2Method(w[1], w + 2, isz - 8, o, &osz);
+	} else {
+		r = v2Method(selector, isz ? args->structureInput : NULL, isz, o, &osz);
+	}
+	if (o != NULL) {
+		args->structureOutputSize = osz;
+	}
+	/*
+	 * 0174: every refused method, by client (the first 40, then every 1000th): Turnip turns a refused submit or a
+	 * timed-out wait into VK_ERROR_DEVICE_LOST for good (backboardd: "commandBuffer refused: DeviceLost", then
+	 * every composition it draws is black).
+	 */
+	if (r != kIOReturnSuccess) {
+		/*
+		 * 0175: a WaitFence with timeout 0 is Turnip polling ("done yet?"): its kIOReturnTimeout is the normal
+		 * "not yet", thousands a second, not a failure. Only real waits that ran out, and everything else, are logged.
+		 */
+		bool tunnel = isz >= 8 && w[0] == SWEET_V2_TUNNEL;
+		uint32_t method = tunnel ? w[1] : selector;
+		const void *payload = tunnel ? (const void *)(w + 2) : (const void *)args->structureInput;
+		uint32_t psz = tunnel ? isz - 8 : isz;
+		uint64_t timeout_ns = 0, fence = 0;
+		if (method == NativeAdrenoMethodWaitFence && payload != NULL && psz >= sizeof(NativeAdrenoAbiWaitFence)) {
+			const NativeAdrenoAbiWaitFence *wf = (const NativeAdrenoAbiWaitFence *)payload;
+			fence = wf->fence;
+			timeout_ns = wf->timeout_ns;
+		}
+		/* 0179: Turnip's 1 ms wait loop is polling too (hundreds of lines a second pushed everything else out) */
+		bool poll = method == NativeAdrenoMethodWaitFence && r == kIOReturnTimeout && timeout_ns < 20000000ull;
+		if (!poll) {
+			uint32_t n = ++fFailLogs;
+			if (n <= 60 || n % 100 == 0) {
+				IOLog("SWEET MTL: %s method %u failed: 0x%x (#%u; fence %llu, wait %llu ms; GPU done %u of %u; pool free %llu MB)\n",
+				    fName, method, r, n, fence, timeout_ns / 1000000ull, sweet_gpu_done_fence(), redwood_gpu_last(),
+				    sweet_gpu_pool_avail() >> 20);
+			}
+		}
+	}
+	return r;
+}
+
+/* ---- the NativeAdreno ABI (SweetGPUABI.h) ---- */
+
+SweetV2BO *
+SweetAcceleratorUserClient::v2Find(uint64_t handle)
+{
+	return handle >= 1 && handle <= fBOCap && fBO[handle - 1].md != NULL ? &fBO[handle - 1] : NULL;
+}
+
+/* With fLock held: the first free slot (the table doubles when full) */
+IOReturn
+SweetAcceleratorUserClient::v2NewSlot(IOMemoryDescriptor *md, uint64_t bytes, bool imported, uint64_t *handle)
+{
+	uint32_t i = 0;
+	while (i < fBOCap && fBO[i].md != NULL) {
+		i++;
+	}
+	if (i == fBOCap) {
+		if (fBOCap >= SWEET_V2_MAX_BOS) {
+			return kIOReturnNoResources;
+		}
+		SweetV2BO *n = IONewZero(SweetV2BO, fBOCap * 2);
+		if (n == NULL) {
+			return kIOReturnNoMemory;
+		}
+		memcpy(n, fBO, sizeof(*n) * fBOCap);
+		IODelete(fBO, SweetV2BO, fBOCap);
+		fBO = n;
+		fBOCap *= 2;
+	}
+	fBO[i].md = md;
+	fBO[i].bytes = bytes;
+	fBO[i].iova = 0;
+	fBO[i].imported = imported;
+	*handle = i + 1;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Pool memory still mapped into some task (a client that freed a buffer before unmapping it, or one
+ * that died): its descriptor waits here until IOKit has dropped every mapping (retain count back to
+ * ours), then the memory goes back to the pool. Swept on every allocation.
+ */
+static IOLock *sweet_zombie_lock;
+static OSArray *sweet_zombies;          /* OSData {IOMemoryDescriptor *, pa} */
+
+struct sweet_zombie {
+	IOMemoryDescriptor *md;
+	uint64_t pa;
+};
+
+static void
+sweet_zombie_sweep(void)
+{
+	if (sweet_zombie_lock == NULL) {
+		return;
+	}
+	IOLockLock(sweet_zombie_lock);
+	for (unsigned i = 0; sweet_zombies != NULL && i < sweet_zombies->getCount();) {
+		OSData *d = OSDynamicCast(OSData, sweet_zombies->getObject(i));
+		const struct sweet_zombie *z = d != NULL ? (const struct sweet_zombie *)d->getBytesNoCopy() : NULL;
+		if (z != NULL && z->md->getRetainCount() <= 1) {
+			uint64_t len = z->md->getLength(), pa = z->pa;
+			z->md->release();
+			sweet_gpu_pool_free(pa, len);
+			sweet_zombies->removeObject(i);
+			continue;
+		}
+		i++;
+	}
+	IOLockUnlock(sweet_zombie_lock);
+}
+
+static void
+sweet_pool_release(IOMemoryDescriptor *md, uint64_t pa)
+{
+	if (md->getRetainCount() <= 1) {
+		uint64_t len = md->getLength();
+		md->release();
+		sweet_gpu_pool_free(pa, len);
+		return;
+	}
+	if (sweet_zombie_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, &sweet_zombie_lock)) {
+			IOLockFree(l);
+		}
+	}
+	IOLockLock(sweet_zombie_lock);
+	if (sweet_zombies == NULL) {
+		sweet_zombies = OSArray::withCapacity(16);
+	}
+	struct sweet_zombie z = { md, pa };
+	OSData *d = OSData::withBytes(&z, sizeof(z));
+	if (sweet_zombies != NULL && d != NULL) {
+		sweet_zombies->setObject(d);
+	}
+	OSSafeReleaseNULL(d);
+	IOLockUnlock(sweet_zombie_lock);
+}
+
+/* Unmap from the GPU, unwire, drop (pool memory: once no task maps it any more) */
+void
+SweetAcceleratorUserClient::v2Release(SweetV2BO *bo)
+{
+	if (bo->md == NULL) {
+		return;
+	}
+	if (bo->iova != 0) {
+		sweet_gpu_unmap_at(bo->iova, bo->bytes);
+	}
+	if (bo->imported) {
+		bo->md->complete();
+		bo->md->release();
+	} else {
+		fPoolBytes -= bo->md->getLength();
+		sweet_pool_release(bo->md, bo->pool_pa);
+	}
+	bzero(bo, sizeof(*bo));
+}
+
+IOReturn
+SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize, void *out, uint32_t *outSize)
+{
+	static uint32_t logged;
+#define V2_IN(T)        if (in == NULL || inSize != sizeof(T)) return kIOReturnBadArgument; const T *rq = (const T *)in
+#define V2_OUT(T)       if (out == NULL || *outSize < sizeof(T)) return kIOReturnBadArgument; T *rp = (T *)out; \
+	                bzero(rp, sizeof(T)); *outSize = sizeof(T)
+	if (!(logged & (1u << (method & 31)))) {
+		logged |= 1u << (method & 31);
+		IOLog("SWEET MTL: method %u first used by %s (in %u)\n", method, fName, inSize);
+	}
+	switch (method) {
+	case NativeAdrenoMethodQuery: {
+		V2_OUT(NativeAdrenoAbiParams);
+		rp->abi_version = NativeAdrenoAbiVersion;
+		rp->input_bits = 36;            /* the GPU context's TCR T0SZ = 28 (sweet_gpu.c stage 7, 0148) */
+		rp->output_bits = 36;
+		rp->flags = NativeAdrenoParamsHostImport;
+		rp->max_bo_bytes = 1ULL << NativeAdrenoAbiMaxBoBytesShift;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetDeviceInfo: {
+		V2_OUT(NativeAdrenoAbiDeviceInfo);
+		/* what sweet_gpu.c programs (redwood_gpu_parameter): GMEM 1 MB at 0x100000, UBWC hbb 15, swizzle 6 */
+		rp->chip_id = 0x06040001;
+		rp->gmem_bytes = 0x100000;
+		rp->gmem_base = 0x100000;
+		rp->uche_trap_base = 0x1fffffffff000ULL;
+		rp->va_start = fWinBase;
+		rp->va_size = fWinSize;
+		rp->highest_bank_bit = 15;
+		rp->ubwc_swizzle = 0x6;
+		rp->macrotile_mode = 0;
+		rp->ubwc_version = 3;
+		rp->flags = NativeAdrenoDeviceClientIova;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoAlloc: {
+		V2_IN(NativeAdrenoAbiBoAlloc);
+		V2_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->bytes == 0 || (rq->bytes & 4095) || rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift) ||
+		    rq->align_log2 < 12 || rq->align_log2 > 24 || rq->contiguous > 1) {
+			return kIOReturnBadArgument;
+		}
+		/* memory XNU does not manage (no cacheable alias), zeroed through a WC kernel view */
+		sweet_zombie_sweep();
+		uint64_t len = round_page_64(rq->bytes), pa = 0;
+		if (!v2PoolAllowed(len) || sweet_gpu_pool_alloc(len, &pa)) {
+			return kIOReturnNoMemory;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa, len, kIODirectionInOut);
+		IOMemoryMap *km = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+		if (km == NULL) {
+			OSSafeReleaseNULL(md);
+			sweet_gpu_pool_free(pa, len);
+			return kIOReturnNoMemory;
+		}
+		bzero((void *)km->getVirtualAddress(), len);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		km->release();
+		IOLockLock(fLock);
+		uint64_t h = 0;
+		IOReturn r = v2NewSlot(md, rq->bytes, false, &h);
+		if (r == kIOReturnSuccess) {
+			fBO[h - 1].pool_pa = pa;
+			fPoolBytes += len;
+			if (fPoolBytes > fPoolPeak) {
+				fPoolPeak = fPoolBytes;
+			}
+			if ((fPoolBytes >> 25) != ((fPoolBytes - len) >> 25)) {
+				IOLog("SWEET MTL: %s holds %llu MB of GPU pool (%llu MB buffer)\n", fName, fPoolBytes >> 20, len >> 20);
+			}
+		}
+		IOLockUnlock(fLock);
+		if (r != kIOReturnSuccess) {
+			md->release();
+			sweet_gpu_pool_free(pa, len);
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoImport: {
+		V2_IN(NativeAdrenoAbiBoImport);
+		V2_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->address == 0 || ((rq->address | rq->bytes) & 4095) || rq->bytes == 0 ||
+		    rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift)) {
+			return kIOReturnBadArgument;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(rq->address, rq->bytes, kIODirectionInOut, fTask);
+		if (md != NULL && md->prepare() != kIOReturnSuccess) {
+			md->release();  /* read-only pages: pinned for reading */
+			md = IOMemoryDescriptor::withAddressRange(rq->address, rq->bytes, kIODirectionOut, fTask);
+			if (md != NULL && md->prepare() != kIOReturnSuccess) {
+				md->release();
+				md = NULL;
+			}
+		}
+		if (md == NULL) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		uint64_t h = 0;
+		IOReturn r = v2NewSlot(md, rq->bytes, true, &h);
+		IOLockUnlock(fLock);
+		if (r != kIOReturnSuccess) {
+			md->complete();
+			md->release();
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoMap: {
+		V2_IN(NativeAdrenoAbiBoMap);
+		V2_OUT(NativeAdrenoAbiBoMapReply);
+		if (!(rq->permissions & 1) || (rq->permissions & ~3u) || (rq->iova & 4095) || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		SweetV2BO *bo = v2Find(rq->handle);
+		IOReturn r = kIOReturnSuccess;
+		if (bo == NULL) {
+			r = kIOReturnBadArgument;
+		} else if (bo->iova != 0) {
+			r = kIOReturnBusy;
+		} else if (rq->iova < fWinBase || rq->iova + bo->bytes > fWinBase + fWinSize || rq->iova + bo->bytes < rq->iova) {
+			r = kIOReturnBadArgument;
+		}
+		/* the pages in 4K steps (16K VM pages, any 4K-aligned import), mapped in pieces */
+		for (uint64_t off = 0; r == kIOReturnSuccess && off < bo->bytes;) {
+			uint32_t n = 0;
+			uint64_t start = off;
+			for (; n < SWEET_V2_PAGEBUF && off < bo->bytes; n++, off += 4096) {
+				IOByteCount seg = 0;
+				addr64_t pa = bo->md->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+				if (pa == 0 || (pa & 4095)) {
+					r = kIOReturnVMError;
+					break;
+				}
+				fPageBuf[n] = pa;
+			}
+			if (r == kIOReturnSuccess && sweet_gpu_map_at(rq->iova + start, fPageBuf, n)) {
+				r = kIOReturnNoResources;
+			}
+		}
+		if (r == kIOReturnSuccess) {
+			bo->iova = rq->iova;
+			rp->iova = rq->iova;
+		} else if (bo != NULL && bo->iova == 0 && r != kIOReturnBadArgument && r != kIOReturnBusy) {
+			sweet_gpu_unmap_at(rq->iova, bo->bytes);
+		}
+		IOLockUnlock(fLock);
+		return r;
+	}
+	case NativeAdrenoMethodBoFree: {
+		V2_IN(NativeAdrenoAbiBoFree);
+		IOLockLock(fLock);
+		SweetV2BO *bo = v2Find(rq->handle);
+		if (bo != NULL) {
+			v2Release(bo);
+		}
+		IOLockUnlock(fLock);
+		return bo != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+	case NativeAdrenoMethodBoCpuMap: {
+		V2_IN(NativeAdrenoAbiBoCpuMap);
+		V2_OUT(NativeAdrenoAbiBoCpuMapReply);
+		IOLockLock(fLock);
+		SweetV2BO *bo = v2Find(rq->handle);
+		IOReturn r = bo == NULL || bo->imported ? kIOReturnBadArgument : kIOReturnSuccess;
+		if (r == kIOReturnSuccess) {
+			rp->token = (uint32_t)rq->handle;       /* clientMemoryForType type */
+			rp->bytes = bo->md->getLength();
+		}
+		IOLockUnlock(fLock);
+		return r;
+	}
+	case NativeAdrenoMethodBoCpuUnmap:
+		return kIOReturnSuccess;        /* the mapping is the client's (IOConnectUnmapMemory64) */
+	case NativeAdrenoMethodSubmit: {
+		V2_IN(NativeAdrenoAbiSubmit);
+		V2_OUT(NativeAdrenoAbiSubmitReply);
+		if (rq->buffer_count == 0 || rq->buffer_count > NativeAdrenoAbiMaxBuffers || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t iova[NativeAdrenoAbiMaxBuffers];
+		uint32_t dw[NativeAdrenoAbiMaxBuffers];
+		for (uint32_t i = 0; i < rq->buffer_count; i++) {
+			const NativeAdrenoAbiSubmitBuffer *b = &rq->buffers[i];
+			if ((b->bytes & 3) || b->bytes == 0 || b->bytes / 4 > 0xfffff || b->iova < fWinBase ||
+			    b->iova + b->bytes > fWinBase + fWinSize) {
+				return kIOReturnBadArgument;
+			}
+			iova[i] = b->iova;
+			dw[i] = (uint32_t)(b->bytes / 4);
+		}
+		if (rq->wait_fence != 0 && sweet_gpu_wait_fence_ns((uint32_t)rq->wait_fence, rq->wait_timeout_ns)) {
+			return kIOReturnTimeout;
+		}
+		bool busy = false;
+		uint32_t fence = sweet_gpu_submit_v2(iova, dw, rq->buffer_count, &busy);
+		/*
+		 * 0174: a full ring is not an error: the GPU is behind (a game plus backboardd plus the display's blits),
+		 * and refusing made Turnip declare the device lost. Wait for room, up to 2 s (a hung GPU stays an error).
+		 */
+		/*
+		 * 0176: only with boot-arg sweetmtlringwait=1. With the wait the GPU hung for good in Subway Surfers (UI
+		 * frozen, done fence stuck one job into the game's work): off by default again until that is understood.
+		 */
+		static int ringWait = -1;
+		if (ringWait < 0) {
+			uint32_t on = 0;
+			(void)PE_parse_boot_argn("sweetmtlringwait", &on, sizeof(on));
+			ringWait = on != 0;
+		}
+		for (unsigned waited = 0; ringWait && fence == 0 && busy && waited < 2000; waited++) {
+			IOSleep(1);
+			fence = sweet_gpu_submit_v2(iova, dw, rq->buffer_count, &busy);
+			if (fence != 0 && waited >= 20) {
+				IOLog("SWEET MTL: %s waited %u ms for ring space\n", fName, waited + 1);
+			}
+		}
+		if (fence == 0) {
+			return busy ? kIOReturnBusy : kIOReturnNotReady;
+		}
+		fLastFence = fence;
+		sweet_mtl_note_submit(proc_selfpid(), fence);  /* 0169 */
+		rp->fence = fence;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodWaitFence: {
+		V2_IN(NativeAdrenoAbiWaitFence);
+		return sweet_gpu_wait_fence_ns((uint32_t)rq->fence, rq->timeout_ns) ? kIOReturnTimeout : kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetTimestamp: {
+		V2_OUT(NativeAdrenoAbiTimestamp);
+		rp->ticks = sweet_gpu_timestamp();
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetStatus: {
+		V2_OUT(NativeAdrenoAbiStatus);
+		rp->faults = fFaults;           /* no GPU recovery here yet: nothing is lost */
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodSetMetadata:
+		return kIOReturnSuccess;        /* only for dma-buf exports, which Darwin has not */
+	case NativeAdrenoMethodGetMetadata: {
+		V2_OUT(NativeAdrenoAbiMetadata);
+		return kIOReturnSuccess;        /* bytes 0 */
+	}
+	case NativeAdrenoMethodCreateQueue: {
+		V2_OUT(NativeAdrenoAbiQueueReply);
+		rp->queue = 1;                  /* one ring: every queue is queue 0 */
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodCloseQueue:
+		return kIOReturnSuccess;
+	default:
+		return kIOReturnUnsupported;
+	}
+#undef V2_IN
+#undef V2_OUT
+}
+#endif /* SWEET */
diff -ruN ci-base/iokit/Kernel/arm/SweetAudio.cpp ci-sweet/iokit/Kernel/arm/SweetAudio.cpp
--- a/iokit/Kernel/arm/SweetAudio.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/iokit/Kernel/arm/SweetAudio.cpp	2026-11-20 20:53:28.563094029 +0100
@@ -0,0 +1,604 @@
+/*
+ * Built-in IOAudio2 stand-in for SWEET (0226): a silent "IOAudio2Device" so CoreAudio has a built-in device.
+ *
+ * Why: on iOS every audio route (speaker, receiver, Bluetooth A2DP/HFP) is a port of VirtualAudio's default virtual
+ * device ('vdef'), which aggregates the physical built-in devices. On an iPhone X those are IOAudio2 devices of the
+ * CS42L75 codec / CS35L26 amp kexts (not in this kernel), so VirtualAudio crashed (image v12 removed it) and
+ * Bluetooth headphones could be listed but never selected ("Unable to find endpoint", "Couldn't get the VAD",
+ * -66680 Default-InputOutput; research/audio/README.md).
+ *
+ * Contract (research/audio/coreaudio-ioa2-client-contract.md, iOS 16.7 CoreAudio HALS_IOA2*): matched by class name
+ * IOServiceMatching("IOAudio2Device"), user client type 0; registry: device UID / device name / input streams /
+ * output streams / controls / clock domain / io buffer frame size / transport type / latencies / safety offsets;
+ * stream dictionaries with stream ID, ring buffer frame size and format dictionaries; selectors 2 set control
+ * (2 scalars in, 1 out), 3 config change ack (32-byte struct), 5 set stream format (1 scalar + 40-byte ASBD),
+ * 6 set stream active (2 scalars), 10 / 11 start / stop IO with flags (1 scalar in, 1 out); memory type 0 = engine
+ * status page (>= 0x28 bytes), 0x10000000 + stream ID = that stream's ring.
+ *
+ * NOT known and guessed here (first round, to be corrected from logs): the identity values (UID/name), the format
+ * dictionary layout, and the status page fields. The page is written as AOP's status page is read: 0x00 sample time
+ * of the last ring wrap, 0x08 host time (mach_absolute_time) of it, 0x10 and 0x18 an equal sequence counter.
+ * Output is discarded, input is zeros; a thread call advances the clock once per ring pass.
+ * Every selector, memory type and format is logged ("SWEET AUDIO: ..."). Boot-arg sweetaudio=0: not published.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+#include <mach/message.h>
+
+/* 0230: as IOUserClient.cpp sends its async replies */
+extern "C" kern_return_t mach_msg_send_from_kernel_with_options(mach_msg_header_t *msg, mach_msg_size_t send_size,
+    mach_msg_option_t option, mach_msg_timeout_t timeout_val);
+
+#define SWEET_AUDIO_RATE        48000u
+#define SWEET_AUDIO_RING        4096u           /* frames per ring pass: 85.3 ms */
+#define SWEET_AUDIO_IN_STREAM   1u              /* IOAudio2 convention: 1 input, 2 output */
+#define SWEET_AUDIO_OUT_STREAM  2u
+/*
+ * 0233: 4 output channels. VirtualAudio's codec setup looks for the HAL properties ('mute','outp', element 4 / 3)
+ * (speaker / receiver); with 2 channels CoreAudio did not turn 0228's mute controls on elements 3 and 4 into those
+ * properties (no "creating a speaker port"; apps then failed with AQMEIO "Error -1 getting output port ID").
+ */
+#define SWEET_AUDIO_OUT_CH      4u
+
+static void
+sweet_set_num(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 64);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+
+static void
+sweet_set_str(OSDictionary *d, const char *key, const char *v)
+{
+	OSString *s = OSString::withCString(v);
+	if (s != NULL) {
+		d->setObject(key, s);
+		s->release();
+	}
+}
+
+/*
+ * one linear PCM format: signed 16-bit packed, interleaved. 0227: "sample rate" is 32.32 fixed point (CoreAudio's
+ * HALS_IOA2UCDevice::GetStreamInfoByID_CurrentFormat reads a UInt64; research/audio/device-tree-virtualaudio-identities.md)
+ */
+static OSDictionary *
+sweet_audio_format(uint32_t channels)
+{
+	OSDictionary *f = OSDictionary::withCapacity(10);
+	if (f == NULL) {
+		return NULL;
+	}
+	/*
+	 * 0231: min / max as 32.32 too. Plain 48000 read as 32.32 is 0 Hz: VirtualAudio's list of physical formats held
+	 * [16/0/2] only, so it "did not contain the current physical stream format" [16/48000/2], set 16/0/2 and timed
+	 * out after 2 s waiting for it ("property [pft /glob/0]", "Error 'what' ensuring valid physical stream format").
+	 */
+	sweet_set_num(f, "sample rate", (uint64_t)SWEET_AUDIO_RATE << 32);
+	sweet_set_num(f, "min sample rate", (uint64_t)SWEET_AUDIO_RATE << 32);
+	sweet_set_num(f, "max sample rate", (uint64_t)SWEET_AUDIO_RATE << 32);
+	sweet_set_num(f, "format ID", 0x6c70636d)  /* 'lpcm' */;
+	sweet_set_num(f, "format flags", 0x4 | 0x8);    /* signed integer, packed */
+	sweet_set_num(f, "bytes per packet", 2 * channels);
+	sweet_set_num(f, "frames per packet", 1);
+	sweet_set_num(f, "bytes per frame", 2 * channels);
+	sweet_set_num(f, "channels per frame", channels);
+	sweet_set_num(f, "bits per channel", 16);
+	return f;
+}
+
+static OSDictionary *
+sweet_audio_stream(uint32_t id, uint32_t channels, uint32_t terminal)
+{
+	OSDictionary *s = OSDictionary::withCapacity(12);
+	OSDictionary *f = sweet_audio_format(channels);
+	OSArray *formats = f != NULL ? OSArray::withObjects((const OSObject **)&f, 1, 1) : NULL;
+	if (s == NULL || f == NULL || formats == NULL) {
+		OSSafeReleaseNULL(s);
+		OSSafeReleaseNULL(f);
+		OSSafeReleaseNULL(formats);
+		return NULL;
+	}
+	sweet_set_num(s, "stream ID", id);
+	sweet_set_num(s, "ring buffer frame size", SWEET_AUDIO_RING);
+	sweet_set_num(s, "latency", 0);
+	sweet_set_num(s, "safety offset", 64);
+	sweet_set_num(s, "min sample rate", (uint64_t)SWEET_AUDIO_RATE << 32);   /* 0231: 32.32 */
+	sweet_set_num(s, "max sample rate", (uint64_t)SWEET_AUDIO_RATE << 32);
+	/*
+	 * the current format both as a dictionary and as the first supported / available one. 0227: CoreAudio reads it
+	 * as "current format" ("there is no current format" with 0226's "format") and wants "starting channel" (UInt32,
+	 * "there is no starting channel number"); channels of each direction start at 1.
+	 */
+	s->setObject("format", f);
+	s->setObject("current format", f);
+	sweet_set_num(s, "starting channel", 1);
+	sweet_set_num(s, "terminal type", terminal);   /* 0228: 'spkr' / 'micr' (CoreAudio key "terminal type") */
+	s->setObject("supported formats", formats);
+	s->setObject("available formats", formats);
+	f->release();
+	formats->release();
+	return s;
+}
+
+class IOAudio2Device : public IOService {
+	OSDeclareDefaultStructors(IOAudio2Device);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+
+	IOBufferMemoryDescriptor *status;
+	IOBufferMemoryDescriptor *ring[3];      /* by stream ID (1 input, 2 output) */
+	thread_call_t clockCall;
+	uint64_t anchor, period, passes, seq;
+	bool running;
+
+	void publish(void);
+	void tick(void);
+	void startIO(void);
+	void stopIO(void);
+};
+
+OSDefineMetaClassAndStructors(IOAudio2Device, IOService);
+
+static IOAudio2Device *sweet_audio;
+static IOLock *sweet_audio_lock;
+
+static void
+sweet_audio_tick(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	((IOAudio2Device *)p0)->tick();
+}
+
+void
+IOAudio2Device::publish(void)
+{
+	volatile uint64_t *w = (volatile uint64_t *)status->getBytesNoCopy();
+	seq++;
+	w[2] = seq;
+	__builtin_arm_dmb(0xb);                 /* ish: counter before the values (seqlock writer) */
+	w[0] = passes * SWEET_AUDIO_RING;
+	w[1] = anchor + passes * period;
+	__builtin_arm_dmb(0xb);
+	w[3] = seq;
+}
+
+void
+IOAudio2Device::tick(void)
+{
+	IOLockLock(sweet_audio_lock);
+	if (running) {
+		/* catch up if the call ran late, so sample and host time stay on one line */
+		uint64_t now = mach_absolute_time();
+		while (anchor + (passes + 1) * period <= now) {
+			passes++;
+		}
+		/* input stays silent: the ring is never written */
+		publish();
+		thread_call_enter_delayed(clockCall, anchor + (passes + 1) * period);
+	}
+	IOLockUnlock(sweet_audio_lock);
+}
+
+void
+IOAudio2Device::startIO(void)
+{
+	IOLockLock(sweet_audio_lock);
+	if (!running) {
+		running = true;
+		anchor = mach_absolute_time();
+		passes = 0;
+		publish();
+		thread_call_enter_delayed(clockCall, anchor + period);
+	}
+	IOLockUnlock(sweet_audio_lock);
+}
+
+void
+IOAudio2Device::stopIO(void)
+{
+	IOLockLock(sweet_audio_lock);
+	running = false;
+	IOLockUnlock(sweet_audio_lock);
+	thread_call_cancel(clockCall);
+}
+
+bool
+IOAudio2Device::start(IOService *provider)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetaudio", &on, sizeof(on));
+	if (!on) {
+		IOLog("SWEET AUDIO: off (sweetaudio=0)\n");
+		return false;
+	}
+	if (sweet_audio != NULL || !IOService::start(provider)) {
+		return false;
+	}
+	sweet_audio_lock = IOLockAlloc();
+	status = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	ring[SWEET_AUDIO_IN_STREAM] = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut | kIOMemoryKernelUserShared,
+	    round_page(SWEET_AUDIO_RING * 2), page_size);
+	ring[SWEET_AUDIO_OUT_STREAM] = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut | kIOMemoryKernelUserShared,
+	    round_page(SWEET_AUDIO_RING * 2 * SWEET_AUDIO_OUT_CH), page_size);
+	clockCall = thread_call_allocate_with_options(sweet_audio_tick, this, THREAD_CALL_PRIORITY_HIGH, THREAD_CALL_OPTIONS_ONCE);
+	if (sweet_audio_lock == NULL || status == NULL || ring[1] == NULL || ring[2] == NULL || clockCall == NULL) {
+		IOLog("SWEET AUDIO: out of memory\n");
+		return false;
+	}
+	bzero(status->getBytesNoCopy(), page_size);
+	bzero(ring[1]->getBytesNoCopy(), ring[1]->getLength());
+	bzero(ring[2]->getBytesNoCopy(), ring[2]->getLength());
+	nanoseconds_to_absolutetime((uint64_t)SWEET_AUDIO_RING * NSEC_PER_SEC / SWEET_AUDIO_RATE, &period);
+
+	/*
+	 * 0234: terminal types from boot-args too (FourCC as a number), so other device personalities can be tried with
+	 * only a new boot image: e.g. sweetaudiotp=0x6d627573 ('mbus') sweetaudioterm=0x68647068 ('hdph')
+	 * sweetaudiointerm=0x686d6963 ('hmic') for a wired-headset-like device. Defaults as 0228: 'spkr' / 'micr'.
+	 */
+	uint32_t outTerm = 0x73706b72, inTerm = 0x6d696372;     /* 'spkr', 'micr' */
+	(void)PE_parse_boot_argn("sweetaudioterm", &outTerm, sizeof(outTerm));
+	(void)PE_parse_boot_argn("sweetaudiointerm", &inTerm, sizeof(inTerm));
+	OSDictionary *in = sweet_audio_stream(SWEET_AUDIO_IN_STREAM, 1, inTerm);
+	OSDictionary *out = sweet_audio_stream(SWEET_AUDIO_OUT_STREAM, SWEET_AUDIO_OUT_CH, outTerm);
+	OSArray *ins = in != NULL ? OSArray::withObjects((const OSObject **)&in, 1, 1) : NULL;
+	OSArray *outs = out != NULL ? OSArray::withObjects((const OSObject **)&out, 1, 1) : NULL;
+	/*
+	 * 0228: VirtualAudio's codec setup creates "Built-In Speaker" only if the device has the property ('mute',
+	 * 'outp', element 4), "Built-In Receiver" for element 3 (research/audio/devicefactory-codec-addendum.md). CoreAudio
+	 * turns IOAudio2 controls into those properties; keys per codec-controls-addendum.md.
+	 */
+	OSArray *controls = OSArray::withCapacity(2);
+	for (uint32_t el = 3; controls != NULL && el <= 4; el++) {
+		OSDictionary *c = OSDictionary::withCapacity(6);
+		if (c == NULL) {
+			break;
+		}
+		sweet_set_num(c, "control ID", 1000 + el);
+		sweet_set_num(c, "class", 0x6d757465);         /* 'mute' */
+		sweet_set_num(c, "base class", 0x6374726c);    /* 'ctrl': IOAudio2 control base class */
+		sweet_set_num(c, "scope", 0x6f757470);         /* 'outp' */
+		sweet_set_num(c, "element", el);
+		sweet_set_num(c, "value", 0);
+		controls->setObject(c);
+		c->release();
+	}
+	if (ins != NULL) {
+		setProperty("input streams", ins);
+	}
+	if (outs != NULL) {
+		setProperty("output streams", outs);
+	}
+	if (controls != NULL) {
+		setProperty("controls", controls);
+	}
+	OSSafeReleaseNULL(in);
+	OSSafeReleaseNULL(out);
+	OSSafeReleaseNULL(ins);
+	OSSafeReleaseNULL(outs);
+	OSSafeReleaseNULL(controls);
+	setProperty("device UID", "SweetBuiltInAudio");
+	setProperty("device name", "Built-In Audio");
+	setProperty("clock domain", 1ULL, 32);
+	/*
+	 * 0254: boot-args sweetaudiouid=STRING / sweetaudioname=STRING replace the device UID / name. On the real D22 the
+	 * built-in audio comes from audio-data IOAudio2 devices whose ADT "data-sources" carry the names "Codec",
+	 * "Halogen", "Loopback", "Actuator", "Baseband" (research/ipsw-x/d22ap.adt), and VirtualAudio's configuration
+	 * factory (research/audio/codec-identity-2235.md) builds its Codec object (speaker / receiver / built-in mic ports)
+	 * from entries keyed "Codec", "Speaker", "Voice", "Reference", ... Test: sweetaudiouid=Codec with the transport
+	 * left at 'bltn' (sweetaudiotp=0x626c746e), which DeviceFactory_Aspen leaves to that configuration path.
+	 */
+	{
+		char uid[64], nm[64];
+		if (PE_parse_boot_arg_str("sweetaudiouid", uid, sizeof(uid)) && uid[0] != 0) {
+			setProperty("device UID", uid);
+		}
+		if (PE_parse_boot_arg_str("sweetaudioname", nm, sizeof(nm)) && nm[0] != 0) {
+			setProperty("device name", nm);
+		}
+	}
+	/*
+	 * 0232: the device's own nominal rate (32.32). Without it CoreAudio reported kAudioDevicePropertyNominalSampleRate
+	 * 0 for the device: VirtualAudio set 48000, read 0, waited 2 s ("timed out ... [nsrt/glob/0] ... on id 33", "Error
+	 * 'what' setting sample rate to 48000.000000 Hz on HAL device 33"), fell back to 44100 and failed. The IOAudio2
+	 * key is not confirmed, so the likely names are all published (an unread key is harmless).
+	 */
+	setProperty("sample rate", (unsigned long long)SWEET_AUDIO_RATE << 32, 64);
+	setProperty("nominal sample rate", (unsigned long long)SWEET_AUDIO_RATE << 32, 64);
+	setProperty("current sample rate", (unsigned long long)SWEET_AUDIO_RATE << 32, 64);
+	setProperty("io buffer frame size", 512ULL, 32);
+	/*
+	 * 0228: VirtualAudio's DeviceFactory_Aspen has no case for 'bltn' (no device object: listed, never adopted).
+	 * Handled values: null pci thun strk dprt hdmi mbus usb vlri pair blue. Default 'null' (Device_Null_Aspen, after
+	 * which the common codec setup checks the mute elements); boot-arg sweetaudiotp=<32-bit FourCC value> overrides.
+	 */
+	uint32_t tp = 0x6e756c6c;                       /* 'null' */
+	(void)PE_parse_boot_argn("sweetaudiotp", &tp, sizeof(tp));
+	setProperty("transport type", (unsigned long long)tp, 32);
+	IOLog("SWEET AUDIO: transport %#x, out terminal %#x, in terminal %#x (boot-args sweetaudiotp / sweetaudioterm / "
+	    "sweetaudiointerm)\n", tp, outTerm, inTerm);
+	setProperty("input latency", 0ULL, 32);
+	setProperty("output latency", 0ULL, 32);
+	setProperty("input safety offset", 64ULL, 32);
+	setProperty("output safety offset", 64ULL, 32);
+	setProperty(kIOUserClientClassKey, "IOAudio2DeviceUserClient");
+	sweet_audio = this;
+	registerService();
+	IOLog("SWEET AUDIO: IOAudio2Device \"SweetBuiltInAudio\" registered (silent: %u Hz, out stream %u %u ch, in stream %u "
+	    "1 ch, s16, ring %u frames)\n", SWEET_AUDIO_RATE, SWEET_AUDIO_OUT_STREAM, SWEET_AUDIO_OUT_CH, SWEET_AUDIO_IN_STREAM,
+	    SWEET_AUDIO_RING);
+	return true;
+}
+
+/*
+ * 0229: CoreAudio writes registry properties (HALB_UCObject::SetProperty -> IORegistryEntrySetCFProperties); the
+ * IOService default answers kIOReturnUnsupported, and VirtualAudio then dropped the device: "Could not add
+ * PhysicalDevice ID: 33 UID: SweetBuiltInAudio. Reason: CAException (-536870201)" (2026-11-10). Accept every key,
+ * keep it as a property of the object written to, log the first 24 writes.
+ */
+static uint32_t sweet_audio_setprops_logged;
+
+static IOReturn
+sweet_audio_set_properties(IORegistryEntry *entry, const char *what, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	while (OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject())) {
+		OSObject *value = dict->getObject(key);
+		if (sweet_audio_setprops_logged < 24) {
+			OSNumber *n = OSDynamicCast(OSNumber, value);
+			OSString *s = OSDynamicCast(OSString, value);
+			if (n != NULL) {
+				IOLog("SWEET AUDIO: %s sets %s property \"%s\" = %llu (%#llx)\n", name, what, key->getCStringNoCopy(),
+				    n->unsigned64BitValue(), n->unsigned64BitValue());
+			} else {
+				IOLog("SWEET AUDIO: %s sets %s property \"%s\" = %s\n", name, what, key->getCStringNoCopy(),
+				    s != NULL ? s->getCStringNoCopy() : value != NULL ? value->getMetaClass()->getClassName() : "null");
+			}
+			sweet_audio_setprops_logged++;
+		}
+		if (value != NULL) {
+			entry->setProperty(key, value);
+		}
+	}
+	it->release();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAudio2Device::setProperties(OSObject *properties)
+{
+	return sweet_audio_set_properties(this, "device", properties);
+}
+
+class IOAudio2DeviceUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOAudio2DeviceUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	bool started;
+	mach_port_t notifyPort;                 /* 0230: from registerNotificationPort */
+	uint32_t notifyRef;
+	void notify(uint32_t type, uint32_t arg0);
+};
+
+OSDefineMetaClassAndStructors(IOAudio2DeviceUserClient, IOUserClient);
+
+static uint64_t sweet_audio_logged;     /* selectors already logged (< 64) */
+static uint32_t sweet_audio_maps_logged;
+
+IOReturn
+IOAudio2DeviceUserClient::setProperties(OSObject *properties)
+{
+	return sweet_audio_set_properties(this, "user client", properties);
+}
+
+IOReturn
+IOAudio2DeviceUserClient::clientClose(void)
+{
+	if (started && sweet_audio != NULL) {
+		sweet_audio->stopIO();
+	}
+	if (notifyPort != MACH_PORT_NULL) {
+		releaseNotificationPort(notifyPort);
+		notifyPort = MACH_PORT_NULL;
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/*
+ * 0230: IOAudio2 notifications, as the HAL's receive handler parses them (research/audio/coreaudio-ioa2-client-
+ * contract.md): 24-byte Mach header, refCon (4 bytes) at 0x18, event count (4) at 0x1c, then 32-byte events from
+ * 0x20: ID (4), FourCC type (4), 24-byte payload. A real driver sends 'conf' after a configuration change (the HAL
+ * hands it back unchanged with selector 3), 'goin' after start and 'halt' after stop. 0226-0229 sent none, and the
+ * HAL looped: set format, 2 s, StopIOProcID, "CAException ... ProcessRoute: 'what'", never starting IO.
+ */
+struct sweet_audio_event {
+	uint32_t id;
+	uint32_t type;
+	uint32_t arg[6];
+};
+struct sweet_audio_msg {
+	mach_msg_header_t header;
+	uint32_t refCon;
+	uint32_t count;
+	struct sweet_audio_event event;
+};
+
+static uint32_t sweet_audio_notes_logged;
+
+void
+IOAudio2DeviceUserClient::notify(uint32_t type, uint32_t arg0)
+{
+	if (notifyPort == MACH_PORT_NULL) {
+		return;
+	}
+	struct sweet_audio_msg m;
+	bzero(&m, sizeof(m));
+	m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+	m.header.msgh_size = sizeof(m);
+	m.header.msgh_remote_port = notifyPort;
+	m.header.msgh_local_port = MACH_PORT_NULL;
+	m.header.msgh_id = 0;
+	m.refCon = notifyRef;
+	m.count = 1;
+	m.event.id = 0;
+	m.event.type = type;
+	m.event.arg[0] = arg0;
+	kern_return_t kr = mach_msg_send_from_kernel_with_options(&m.header, sizeof(m), MACH_SEND_TIMEOUT, MACH_MSG_TIMEOUT_NONE);
+	if (sweet_audio_notes_logged < 40) {
+		IOLog("SWEET AUDIO: sent '%c%c%c%c' (arg %u) -> %#x\n", (char)(type >> 24), (char)(type >> 16), (char)(type >> 8),
+		    (char)type, arg0, kr);
+		sweet_audio_notes_logged++;
+	}
+}
+
+IOReturn
+IOAudio2DeviceUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	if (notifyPort != MACH_PORT_NULL && notifyPort != port) {
+		releaseNotificationPort(notifyPort);
+	}
+	notifyPort = port;
+	notifyRef = (uint32_t)refCon;
+	IOLog("SWEET AUDIO: %s notification port type %u refCon %#llx (0230: conf / goin / halt are sent)\n", name, type,
+	    (unsigned long long)refCon);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAudio2DeviceUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOBufferMemoryDescriptor *md = NULL;
+	if (sweet_audio != NULL) {
+		if (type == 0) {
+			md = sweet_audio->status;
+		} else if (type == 0x10000000 + SWEET_AUDIO_IN_STREAM || type == 0x10000000 + SWEET_AUDIO_OUT_STREAM) {
+			md = sweet_audio->ring[type - 0x10000000];
+		}
+	}
+	if (sweet_audio_maps_logged < 16) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AUDIO: %s map type %#x -> %s\n", name, type, md != NULL ? "ok" : "unsupported");
+		sweet_audio_maps_logged++;
+	}
+	if (md == NULL) {
+		return kIOReturnUnsupported;
+	}
+	md->retain();
+	*memory = md;
+	*options = 0;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAudio2DeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	switch (selector) {
+	case 2:         /* set control value: echo the requested value */
+		if (args->scalarInputCount >= 2 && args->scalarOutputCount >= 1) {
+			args->scalarOutput[0] = args->scalarInput[1];
+		}
+		break;
+	case 5:         /* set stream format: log the ASBD (only the one published format exists) */
+		if (args->structureInputSize >= 40 && args->structureInput != NULL) {
+			const uint8_t *a = (const uint8_t *)args->structureInput;
+			uint64_t rate;
+			uint32_t fmt, flags, bpf, ch, bits;
+			memcpy(&rate, a, 8);
+			memcpy(&fmt, a + 8, 4);
+			memcpy(&flags, a + 12, 4);
+			memcpy(&bpf, a + 24, 4);
+			memcpy(&ch, a + 28, 4);
+			memcpy(&bits, a + 32, 4);
+			IOLog("SWEET AUDIO: %s set format stream %llu: rate bits %#llx fmt %#x flags %#x %u B/frame %u ch %u bits\n",
+			    name, args->scalarInputCount ? args->scalarInput[0] : 0ULL, rate, fmt, flags, bpf, ch, bits);
+		}
+		notify(0x636f6e66 /* 'conf' */, args->scalarInputCount ? (uint32_t)args->scalarInput[0] : 0);
+		break;
+	case 4:         /* 0232: set sample rate (32.32): only 48000 exists; logged, confirmed with 'conf' as a real driver does */
+		IOLog("SWEET AUDIO: %s set sample rate %#llx (%llu Hz)\n", name, args->scalarInputCount ? args->scalarInput[0] : 0ULL,
+		    args->scalarInputCount ? args->scalarInput[0] >> 32 : 0ULL);
+		notify(0x636f6e66 /* 'conf' */, 0);
+		break;
+	case 3:         /* 0230: the HAL acknowledges a 'conf' */
+		IOLog("SWEET AUDIO: %s config change ack (%u bytes)\n", name, args->structureInputSize);
+		break;
+	case 6:         /* 0230: stream active */
+		IOLog("SWEET AUDIO: %s stream %llu active %llu\n", name, args->scalarInputCount ? args->scalarInput[0] : 0ULL,
+		    args->scalarInputCount > 1 ? args->scalarInput[1] : 0ULL);
+		break;
+	case 10:        /* start IO */
+		if (sweet_audio != NULL) {
+			sweet_audio->startIO();
+			started = true;
+		}
+		IOLog("SWEET AUDIO: %s start IO (flags %#llx)\n", name, args->scalarInputCount ? args->scalarInput[0] : 0ULL);
+		notify(0x676f696e /* 'goin' */, 0);
+		break;
+	case 11:        /* stop IO */
+		if (sweet_audio != NULL && started) {
+			sweet_audio->stopIO();
+			started = false;
+		}
+		IOLog("SWEET AUDIO: %s stop IO (flags %#llx)\n", name, args->scalarInputCount ? args->scalarInput[0] : 0ULL);
+		notify(0x68616c74 /* 'halt' */, 0);
+		break;
+	default:        /* anything else: accepted */
+		break;
+	}
+	if (selector >= 64 || !(sweet_audio_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_audio_logged |= 1ULL << selector;
+		}
+		IOLog("SWEET AUDIO: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
