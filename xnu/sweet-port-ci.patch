+	 * flagged layer / of any other top layer, and those with >= 16 of 64 samples black.
+	 */
+	uint32_t seen_game, black_game, seen_other, black_other;
+	uint64_t comp_time;
+	uint32_t sel[128];
+} sweet_fb_stats;
